<script>
  const waitFor = async (selector: string, attempts = 500) => {
    for (let index = 0; index < attempts; index += 1) {
      const node = document.querySelector(selector);
      if (node instanceof HTMLElement) return node;
      await new Promise((resolve) => setTimeout(resolve, 25));
    }
    return null;
  };

  const parseDisplayedNumber = (value: string) => {
    const normalized = value.trim().toLowerCase().replace(/,/g, '');
    const match = normalized.match(/-?\d+(?:\.\d+)?/);
    if (!match) return null;
    const number = Number(match[0]);
    if (!Number.isFinite(number)) return null;
    if (normalized.includes('k')) return number * 1000;
    if (normalized.includes('m')) return number * 1000000;
    return number;
  };

  const formatValue = (value: number, maximumFractionDigits = 1) => new Intl.NumberFormat('en-US', {
    maximumFractionDigits,
  }).format(value);

  const compactAxisValue = (value: number) => {
    const absolute = Math.abs(value);
    if (absolute >= 1000000) {
      const scaled = value / 1000000;
      return `${formatValue(scaled, Number.isInteger(scaled) ? 0 : 1)}m`;
    }
    if (absolute >= 1000) {
      const scaled = value / 1000;
      return `${formatValue(scaled, Number.isInteger(scaled) ? 0 : 1)}k`;
    }
    return formatValue(value, Number.isInteger(value) ? 0 : 1);
  };

  const hoursToMilesText = (value: string) => value.replace(
    /(-?[\d,.]+(?:\.\d+)?)\s+hours\b/gi,
    (_match, raw: string) => {
      const hours = Number(raw.replace(/,/g, ''));
      if (!Number.isFinite(hours)) return _match;
      return `${formatValue(hours * 2, 1)} miles`;
    },
  );

  function addArchiveLinks() {
    const heading = document.querySelector('#snapshot-heading');
    if (heading) heading.textContent = '8 long-term windows into the archive';

    const labels: Record<string, string> = {
      dance: 'dance',
      work: 'work',
      language: 'language study',
      treadmill: 'treadmill',
    };

    Object.entries(labels).forEach(([metric, label]) => {
      const card = document.querySelector<HTMLElement>(`.snapshot-card--${metric}`);
      if (!card || card.querySelector('.snapshot-card__link')) return;

      const button = document.createElement('button');
      button.className = 'snapshot-card__link';
      button.type = 'button';
      button.dataset.openMetric = metric;
      button.innerHTML = `Explore ${label} <span aria-hidden="true">→</span>`;
      button.addEventListener('click', () => {
        const target = document.querySelector<HTMLButtonElement>(`.canonical-explorer .canonical-metric[data-metric="${metric}"]`);
        target?.click();
        document.querySelector('#graphs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      card.append(button);
    });
  }

  function enforceMetricSelection(shell: HTMLElement, metric: string) {
    shell.querySelectorAll<HTMLElement>('.canonical-metric').forEach((button) => {
      const active = button.dataset.metric === metric;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  }

  function patchTreadmillExplorer(shell: HTMLElement) {
    const activeMetric = shell.querySelector<HTMLElement>('.canonical-metric.is-active')?.dataset.metric;
    if (activeMetric !== 'treadmill') return;

    const host = shell.querySelector<HTMLElement>('[data-canonical-chart]');
    const chart = host?.querySelector<SVGSVGElement>('svg');
    if (chart && chart.dataset.treadmillMiles !== 'true') {
      chart.querySelectorAll<SVGTextElement>('.canonical-axis[text-anchor="end"]').forEach((label) => {
        const value = parseDisplayedNumber(label.textContent || '');
        if (value !== null) label.textContent = compactAxisValue(value * 2);
      });
      chart.querySelectorAll<SVGTextElement>('.canonical-axis-title').forEach((title) => {
        if (/hours/i.test(title.textContent || '')) title.textContent = (title.textContent || '').replace(/hours/gi, 'miles');
      });
      chart.dataset.treadmillMiles = 'true';
    }

    ['[data-summary-total]', '[data-summary-average]', '[data-summary-peak]'].forEach((selector) => {
      const node = shell.querySelector(selector);
      if (node && /hours/i.test(node.textContent || '')) node.textContent = hoursToMilesText(node.textContent || '');
    });

    const unit = shell.querySelector('[data-chart-unit]');
    if (unit) unit.textContent = 'miles';
  }

  function patchDiaryAxis(shell: HTMLElement) {
    const activeMetric = shell.querySelector<HTMLElement>('.canonical-metric.is-active')?.dataset.metric;
    if (activeMetric !== 'diary') return;

    const chart = shell.querySelector<SVGSVGElement>('[data-canonical-chart] svg');
    if (!chart || chart.dataset.diaryCompactAxis === 'true') return;
    chart.querySelectorAll<SVGTextElement>('.canonical-axis[text-anchor="end"]').forEach((label) => {
      const value = parseDisplayedNumber(label.textContent || '');
      if (value !== null) label.textContent = compactAxisValue(value);
    });
    chart.dataset.diaryCompactAxis = 'true';
  }

  function patchTooltip(shell: HTMLElement) {
    const tooltip = document.querySelector<HTMLElement>('.stats-chart-tooltip');
    if (!tooltip) return;
    const activeMetric = shell.querySelector<HTMLElement>('.canonical-metric.is-active')?.dataset.metric;
    if (activeMetric === 'treadmill' && /hours/i.test(tooltip.textContent || '')) {
      tooltip.textContent = hoursToMilesText(tooltip.textContent || '');
    }
  }

  async function init() {
    const dashboard = await waitFor('.stats-dashboard');
    const shell = await waitFor('.canonical-explorer');
    if (!dashboard || !shell || dashboard.dataset.finalStatsPolish === 'true') return;
    dashboard.dataset.finalStatsPolish = 'true';

    let selectedMetric = shell.querySelector<HTMLElement>('.canonical-metric.is-active')?.dataset.metric || 'guitar';
    let scheduled = 0;

    const apply = () => {
      window.clearTimeout(scheduled);
      scheduled = window.setTimeout(() => {
        addArchiveLinks();
        enforceMetricSelection(shell, selectedMetric);
        patchTreadmillExplorer(shell);
        patchDiaryAxis(shell);
        patchTooltip(shell);
      }, 70);
    };

    shell.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLElement>('.canonical-metric');
      if (!button?.dataset.metric) return;
      selectedMetric = button.dataset.metric;
      enforceMetricSelection(shell, selectedMetric);
      apply();
      setTimeout(() => enforceMetricSelection(shell, selectedMetric), 0);
      setTimeout(() => enforceMetricSelection(shell, selectedMetric), 180);
    }, true);

    shell.addEventListener('change', apply);
    new MutationObserver(apply).observe(shell, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });
    new MutationObserver(apply).observe(dashboard, { childList: true, subtree: true });

    const tooltip = await waitFor('.stats-chart-tooltip');
    if (tooltip) new MutationObserver(() => patchTooltip(shell)).observe(tooltip, { childList: true, characterData: true, subtree: true });

    apply();
    setTimeout(apply, 700);
    setTimeout(apply, 1800);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else void init();
</script>
