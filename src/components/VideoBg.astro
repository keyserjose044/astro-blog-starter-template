---
import LiveArchivePulse from './LiveArchivePulse.astro';
import PulseAudiobookCover from './PulseAudiobookCover.astro';

/**
 * Full-page animated background wrapper for LifeLoggerz.
 *
 * The poster paints immediately. The optimized MP4 is small enough to preload
 * and autoplay without holding up the rest of the page.
 */

const base = import.meta.env.BASE_URL || '/';
const backgroundVideoSrc = `${base}backgrounds/waves.mp4?v=4`;
const backgroundPosterSrc = `${base}backgrounds/waves-poster.webp`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base.replace(/\/+$/, '') || '/';
const isHome = normalizedPath === '/' || normalizedPath === normalizedBase;
---

<div class="page-with-video-bg">
  <video
    src={backgroundVideoSrc}
    poster={backgroundPosterSrc}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
    class="page-with-video-bg__video"
    data-lifeloggerz-background
  ></video>

  <div class="page-with-video-bg__content">
    <slot />

    {isHome ? (
      <div class="live-archive-pulse-host" data-live-archive-pulse-host hidden>
        <LiveArchivePulse />
        <PulseAudiobookCover />
      </div>
    ) : null}
  </div>
</div>

<script is:inline>
  if (typeof window !== 'undefined') {
    const playBackgrounds = () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          element.muted = true;
          element.defaultMuted = true;
          if (document.visibilityState === 'visible') {
            element.play().catch(() => {});
          }
        });
    };

    const mountLiveArchivePulse = () => {
      const host = document.querySelector('[data-live-archive-pulse-host]');
      if (!(host instanceof HTMLElement) || host.dataset.mounted === 'true') return;

      const featuredSection = document.querySelector('main.home-main .featured-section');
      if (!(featuredSection instanceof HTMLElement)) return;

      featuredSection.insertAdjacentElement('afterend', host);
      host.hidden = false;
      host.dataset.mounted = 'true';
      document.dispatchEvent(new CustomEvent('lifeloggerz:pulse-mounted'));
    };

    const startPageEnhancements = () => {
      playBackgrounds();
      mountLiveArchivePulse();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startPageEnhancements, { once: true });
    } else {
      startPageEnhancements();
    }

    document.addEventListener('visibilitychange', () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          if (document.visibilityState === 'hidden') {
            element.pause();
          } else {
            element.play().catch(() => {});
          }
        });
    });

    window.addEventListener('pageshow', startPageEnhancements);
  }
</script>

<style>
  .live-archive-pulse-host {
    display: contents;
  }

  .live-archive-pulse-host[hidden] {
    display: none;
  }
</style>

<style is:global>
  /* Homepage-specific responsive composition. */
  @media (min-width: 901px) {
    .page-with-video-bg main.home-main .hero {
      display: flex;
      width: 100%;
      max-width: 1180px;
      flex-direction: column;
      align-items: center;
      margin: 0 auto clamp(1.8rem, 3vw, 2.5rem);
      text-align: center;
    }

    .page-with-video-bg main.home-main .hero > .eyebrow {
      margin-bottom: 0.55rem;
    }

    .page-with-video-bg main.home-main .hero-title {
      max-width: 100%;
      font-size: clamp(5rem, 7vw, 7rem);
      line-height: 0.9;
    }

    .page-with-video-bg main.home-main .hero-lower {
      display: block;
      width: 100%;
      margin-top: 1rem;
    }

    .page-with-video-bg main.home-main .hero-lede {
      max-width: 30ch;
      margin: 0 auto;
      font-size: clamp(2.2rem, 3.25vw, 3.2rem);
      line-height: 1.01;
    }

    .page-with-video-bg main.home-main .hero-aside {
      max-width: 900px;
      margin: 0.95rem auto 0;
    }

    .page-with-video-bg main.home-main .hero-subcopy {
      max-width: 72ch;
      margin: 0 auto 1rem;
      font-size: clamp(1rem, 1.12vw, 1.08rem);
      line-height: 1.55;
    }

    .page-with-video-bg main.home-main .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 700px) {
    .page-with-video-bg main.home-main {
      width: min(calc(100% - 2rem), 430px);
      max-width: 430px;
    }

    .page-with-video-bg main.home-main .featured-section {
      position: relative;
      margin-bottom: 2.35rem;
    }

    .page-with-video-bg main.home-main .featured-heading {
      align-items: flex-end;
      margin-bottom: 0.75rem;
    }

    .page-with-video-bg main.home-main .featured-heading::after {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.38rem;
      margin-bottom: 0.08rem;
      padding: 0.36rem 0.55rem;
      border: 1px solid rgba(15, 76, 255, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.84);
      color: #0f4cff;
      content: 'Swipe →  ●  ○  ○';
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1;
      white-space: nowrap;
      box-shadow: 0 6px 16px rgba(15, 18, 25, 0.06);
    }

    .page-with-video-bg main.home-main .guide-grid {
      display: flex;
      grid-template-columns: none;
      gap: 0.8rem;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0.1rem 0 0.65rem;
      scroll-padding-inline: 0;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .page-with-video-bg main.home-main .guide-grid::-webkit-scrollbar {
      display: none;
    }

    .page-with-video-bg main.home-main .guide-card {
      position: relative;
      display: flex;
      flex: 0 0 calc(100% - 1.35rem);
      flex-direction: column;
      grid-template-columns: none;
      overflow: hidden;
      border-radius: 18px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      box-shadow: 0 12px 28px rgba(15, 18, 25, 0.09);
    }

    /* Put the visually strongest Daily Snapshot first on phones. */
    .page-with-video-bg main.home-main .guide-card:nth-child(2) { order: 1; }
    .page-with-video-bg main.home-main .guide-card:nth-child(1) { order: 2; }
    .page-with-video-bg main.home-main .guide-card:nth-child(3) { order: 3; }

    .page-with-video-bg main.home-main .guide-copy .card-eyebrow {
      font-size: 0;
    }

    .page-with-video-bg main.home-main .guide-copy .card-eyebrow::after {
      font-size: 0.62rem;
      letter-spacing: 0.075em;
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(2) .card-eyebrow::after {
      content: '01 · DAILY SNAPSHOT';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(1) .card-eyebrow::after {
      content: '02 · RAW DATA';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(3) .card-eyebrow::after {
      content: '03 · TEMPLATE';
    }

    .page-with-video-bg main.home-main .guide-media {
      position: relative;
      width: 100%;
      height: clamp(142px, 39vw, 170px);
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid rgba(var(--gray-light), 0.92);
    }

    .page-with-video-bg main.home-main .guide-media::after {
      position: absolute;
      right: 0.65rem;
      bottom: 0.6rem;
      padding: 0.38rem 0.55rem;
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: 999px;
      background: rgba(15, 18, 25, 0.76);
      color: #fff;
      content: 'Tap to open ↗';
      font-size: 0.64rem;
      font-weight: 800;
      line-height: 1;
      box-shadow: 0 5px 14px rgba(15, 18, 25, 0.16);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .page-with-video-bg main.home-main .guide-copy {
      min-height: 108px;
      padding: 0.78rem 0.88rem 0.82rem;
    }

    .page-with-video-bg main.home-main .guide-copy h3 {
      margin: 0.3rem 0 0.24rem;
      font-size: 1.08rem;
      line-height: 1.12;
    }

    .page-with-video-bg main.home-main .guide-description--mobile {
      font-size: 0.81rem;
      line-height: 1.36;
    }

    .page-with-video-bg main.home-main .guide-copy .card-link {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .page-with-video-bg main.home-main {
      width: calc(100% - 1.6rem);
    }

    .page-with-video-bg main.home-main .guide-card {
      flex-basis: calc(100% - 1rem);
    }

    .page-with-video-bg main.home-main .featured-heading::after {
      padding-inline: 0.45rem;
      content: 'Swipe →  ● ○ ○';
      font-size: 0.58rem;
    }
  }
</style>
