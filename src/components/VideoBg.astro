---
import LiveArchivePulse from './LiveArchivePulse.astro';

/**
 * Full-page animated background wrapper for LifeLoggerz.
 *
 * The poster paints immediately. The optimized MP4 is small enough to preload
 * and autoplay without holding up the rest of the page.
 */

const base = import.meta.env.BASE_URL || '/';
const backgroundVideoSrc = `${base}backgrounds/waves.mp4?v=4`;
const backgroundPosterSrc = `${base}backgrounds/waves-poster.webp`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base.replace(/\/+$/, '') || '/';
const isHome = normalizedPath === '/' || normalizedPath === normalizedBase;
---

<div class="page-with-video-bg">
  <video
    src={backgroundVideoSrc}
    poster={backgroundPosterSrc}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
    class="page-with-video-bg__video"
    data-lifeloggerz-background
  ></video>

  <div class="page-with-video-bg__content">
    <slot />

    {isHome ? (
      <div class="live-archive-pulse-host" data-live-archive-pulse-host hidden>
        <LiveArchivePulse />
      </div>
    ) : null}
  </div>
</div>

<script is:inline>
  if (typeof window !== 'undefined') {
    const playBackgrounds = () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          element.muted = true;
          element.defaultMuted = true;
          if (document.visibilityState === 'visible') {
            element.play().catch(() => {});
          }
        });
    };

    const mountLiveArchivePulse = () => {
      const host = document.querySelector('[data-live-archive-pulse-host]');
      if (!(host instanceof HTMLElement) || host.dataset.mounted === 'true') return;

      const featuredSection = document.querySelector('main.home-main .featured-section');
      if (!(featuredSection instanceof HTMLElement)) return;

      featuredSection.insertAdjacentElement('afterend', host);
      host.hidden = false;
      host.dataset.mounted = 'true';
      document.dispatchEvent(new CustomEvent('lifeloggerz:pulse-mounted'));
    };

    const startPageEnhancements = () => {
      playBackgrounds();
      mountLiveArchivePulse();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startPageEnhancements, { once: true });
    } else {
      startPageEnhancements();
    }

    document.addEventListener('visibilitychange', () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          if (document.visibilityState === 'hidden') {
            element.pause();
          } else {
            element.play().catch(() => {});
          }
        });
    });

    window.addEventListener('pageshow', startPageEnhancements);
  }
</script>

<style>
  .live-archive-pulse-host {
    display: contents;
  }

  .live-archive-pulse-host[hidden] {
    display: none;
  }
</style>
