---
import LiveArchivePulse from './LiveArchivePulse.astro';
import PulseAudiobookCover from './PulseAudiobookCover.astro';

/**
 * Full-page animated background wrapper for LifeLoggerz.
 *
 * The poster paints immediately. The optimized MP4 is small enough to preload
 * and autoplay without holding up the rest of the page.
 */

const base = import.meta.env.BASE_URL || '/';
const backgroundVideoSrc = `${base}backgrounds/waves.mp4?v=4`;
const backgroundPosterSrc = `${base}backgrounds/waves-poster.webp`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base.replace(/\/+$/, '') || '/';
const isHome = normalizedPath === '/' || normalizedPath === normalizedBase;
---

<div class="page-with-video-bg">
  <video
    src={backgroundVideoSrc}
    poster={backgroundPosterSrc}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
    class="page-with-video-bg__video"
    data-lifeloggerz-background
  ></video>

  <div class="page-with-video-bg__content">
    <slot />

    {isHome ? (
      <div class="live-archive-pulse-host" data-live-archive-pulse-host hidden>
        <LiveArchivePulse />
        <PulseAudiobookCover />
      </div>
    ) : null}
  </div>
</div>

<script is:inline>
  if (typeof window !== 'undefined') {
    const playBackgrounds = () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          element.muted = true;
          element.defaultMuted = true;
          if (document.visibilityState === 'visible') {
            element.play().catch(() => {});
          }
        });
    };

    const mountLiveArchivePulse = () => {
      const host = document.querySelector('[data-live-archive-pulse-host]');
      if (!(host instanceof HTMLElement) || host.dataset.mounted === 'true') return;

      const featuredSection = document.querySelector('main.home-main .featured-section');
      if (!(featuredSection instanceof HTMLElement)) return;

      featuredSection.insertAdjacentElement('afterend', host);
      host.hidden = false;
      host.dataset.mounted = 'true';
      document.dispatchEvent(new CustomEvent('lifeloggerz:pulse-mounted'));
    };

    const setupGuideSwipeCue = () => {
      const grid = document.querySelector('main.home-main .guide-grid');
      const heading = document.querySelector('main.home-main .featured-heading');
      if (!(grid instanceof HTMLElement) || !(heading instanceof HTMLElement)) return;
      if (grid.dataset.swipeCueReady === 'true') return;

      let frame = 0;
      const sync = () => {
        frame = 0;
        const cards = Array.from(grid.querySelectorAll('.guide-card'))
          .filter((card) => card instanceof HTMLElement)
          .sort((a, b) => a.offsetLeft - b.offsetLeft);
        if (!cards.length) return;

        const center = grid.scrollLeft + grid.clientWidth / 2;
        let activeIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        cards.forEach((card, index) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const distance = Math.abs(cardCenter - center);
          if (distance < closestDistance) {
            closestDistance = distance;
            activeIndex = index;
          }
        });

        heading.dataset.swipeIndex = String(activeIndex + 1);
      };

      const scheduleSync = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(sync);
      };

      grid.dataset.swipeCueReady = 'true';
      grid.addEventListener('scroll', scheduleSync, { passive: true });
      window.addEventListener('resize', scheduleSync, { passive: true });
      window.requestAnimationFrame(sync);
    };

    const startPageEnhancements = () => {
      playBackgrounds();
      mountLiveArchivePulse();
      setupGuideSwipeCue();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startPageEnhancements, { once: true });
    } else {
      startPageEnhancements();
    }

    document.addEventListener('visibilitychange', () => {
      document
        .querySelectorAll('[data-lifeloggerz-background]')
        .forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          if (document.visibilityState === 'hidden') {
            element.pause();
          } else {
            element.play().catch(() => {});
          }
        });
    });

    window.addEventListener('pageshow', startPageEnhancements);
  }
</script>

<style>
  .live-archive-pulse-host {
    display: contents;
  }

  .live-archive-pulse-host[hidden] {
    display: none;
  }
</style>

<style is:global>
  /* Homepage-specific responsive composition. */
  @media (min-width: 901px) {
    .page-with-video-bg main.home-main {
      padding-top: 1rem;
    }

    .page-with-video-bg main.home-main .hero {
      display: flex;
      width: 100%;
      max-width: 1180px;
      flex-direction: column;
      align-items: center;
      margin: 0 auto clamp(0.95rem, 1.55vw, 1.25rem);
      text-align: center;
    }

    .page-with-video-bg main.home-main .hero > .eyebrow {
      margin-bottom: 0.3rem;
    }

    .page-with-video-bg main.home-main .hero-title {
      max-width: 100%;
      font-size: clamp(4.25rem, 5.35vw, 5.55rem);
      letter-spacing: -0.072em;
      line-height: 0.88;
    }

    .page-with-video-bg main.home-main .hero-lower {
      display: block;
      width: 100%;
      margin-top: 0.5rem;
    }

    .page-with-video-bg main.home-main .hero-lede {
      max-width: 50ch;
      margin: 0 auto;
      font-size: clamp(1.82rem, 2.28vw, 2.28rem);
      line-height: 1.02;
    }

    .page-with-video-bg main.home-main .hero-aside {
      max-width: 1060px;
      margin: 0.42rem auto 0;
    }

    .page-with-video-bg main.home-main .hero-subcopy {
      max-width: 92ch;
      margin: 0 auto 0.58rem;
      font-size: clamp(0.92rem, 0.98vw, 0.98rem);
      line-height: 1.4;
    }

    .page-with-video-bg main.home-main .hero-actions {
      justify-content: center;
    }

    .page-with-video-bg main.home-main .hero-actions .button {
      min-height: 39px;
      padding: 0.52rem 0.9rem;
      font-size: 0.88rem;
    }

    .page-with-video-bg main.home-main .featured-section {
      max-width: 1160px;
      margin-inline: auto;
    }

    .page-with-video-bg main.home-main .featured-heading {
      margin-bottom: 0.62rem;
    }

    .page-with-video-bg main.home-main .featured-intro {
      margin-top: 0.38rem;
    }

    .page-with-video-bg main.home-main .guide-grid {
      gap: 1rem;
    }

    .page-with-video-bg main.home-main .guide-card {
      border-color: rgba(180, 190, 205, 0.72);
      box-shadow: 0 15px 34px rgba(15, 18, 25, 0.09);
    }

    .page-with-video-bg main.home-main .guide-media {
      height: clamp(148px, 11.7vw, 174px);
    }

    .page-with-video-bg main.home-main .guide-copy {
      min-height: 138px;
      padding: 0.86rem 0.96rem 0.9rem;
    }

    .page-with-video-bg main.home-main .guide-description--desktop {
      -webkit-line-clamp: 2;
    }

    .page-with-video-bg main.home-main .guide-copy .card-link {
      padding-top: 0.48rem;
    }
  }

  /* Let large monitors use their canvas instead of concentrating the whole opening in the middle. */
  @media (min-width: 1280px) {
    .page-with-video-bg main.home-main {
      width: min(1440px, calc(100% - 4rem));
      max-width: 1440px;
    }

    .page-with-video-bg main.home-main .hero {
      max-width: 1320px;
    }

    .page-with-video-bg main.home-main .featured-section {
      width: 100%;
      max-width: 1400px;
    }

    .page-with-video-bg main.home-main .guide-grid {
      gap: 1.25rem;
    }

    .page-with-video-bg main.home-main .guide-media {
      height: clamp(154px, 10.5vw, 188px);
    }
  }

  @media (max-width: 700px) {
    .page-with-video-bg main.home-main {
      width: 100%;
      max-width: 430px;
      margin-inline: auto !important;
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .page-with-video-bg main.home-main .featured-section {
      position: relative;
      width: 100%;
      margin-bottom: 2.35rem;
    }

    .page-with-video-bg main.home-main .featured-heading {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: center;
      align-items: center;
      column-gap: 0.6rem;
      row-gap: 0.22rem;
      margin-bottom: 0.62rem;
      text-align: center;
    }

    .page-with-video-bg main.home-main .featured-heading > div {
      display: contents;
    }

    .page-with-video-bg main.home-main .featured-heading > div > .eyebrow {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    .page-with-video-bg main.home-main .featured-heading > div > h2 {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: center;
    }

    .page-with-video-bg main.home-main .featured-heading > div > .featured-intro {
      grid-column: 1 / -1;
      text-align: center;
    }

    .page-with-video-bg main.home-main .featured-heading::after {
      position: static;
      grid-column: 2;
      grid-row: 1;
      display: inline-flex;
      align-items: center;
      justify-self: center;
      margin: 0;
      padding: 0.34rem 0.52rem;
      border: 1px solid rgba(15, 76, 255, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.88);
      color: #0f4cff;
      content: 'Swipe →  ●  ○  ○';
      font-size: 0.61rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1;
      white-space: nowrap;
      box-shadow: 0 6px 16px rgba(15, 18, 25, 0.06);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .page-with-video-bg main.home-main .featured-heading[data-swipe-index='2']::after {
      content: 'Swipe →  ○  ●  ○';
    }

    .page-with-video-bg main.home-main .featured-heading[data-swipe-index='3']::after {
      content: 'Swipe →  ○  ○  ●';
    }

    .page-with-video-bg main.home-main .featured-heading > .see-all {
      display: none;
    }

    .page-with-video-bg main.home-main .guide-grid {
      display: flex;
      width: 100%;
      grid-template-columns: none;
      gap: 0.8rem;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0.1rem 0.12rem 0.65rem;
      scroll-padding-inline: 0.12rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .page-with-video-bg main.home-main .guide-grid::-webkit-scrollbar {
      display: none;
    }

    .page-with-video-bg main.home-main .guide-card {
      position: relative;
      display: flex;
      flex: 0 0 calc(100% - 1.35rem);
      flex-direction: column;
      grid-template-columns: none;
      overflow: hidden;
      border-radius: 18px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      box-shadow: 0 12px 28px rgba(15, 18, 25, 0.09);
    }

    /* Lead with the outcome, then reveal the system, then offer the starting point. */
    .page-with-video-bg main.home-main .guide-card:nth-child(2) { order: 1; }
    .page-with-video-bg main.home-main .guide-card:nth-child(1) { order: 2; }
    .page-with-video-bg main.home-main .guide-card:nth-child(3) { order: 3; }

    .page-with-video-bg main.home-main .guide-copy .card-eyebrow {
      font-size: 0;
    }

    .page-with-video-bg main.home-main .guide-copy .card-eyebrow::after {
      font-size: 0.62rem;
      letter-spacing: 0.075em;
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(2) .card-eyebrow::after {
      content: '01 · SEE THE RESULT';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(1) .card-eyebrow::after {
      content: '02 · SEE THE SYSTEM';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(3) .card-eyebrow::after {
      content: '03 · START YOUR OWN';
    }

    .page-with-video-bg main.home-main .guide-media {
      position: relative;
      width: 100%;
      height: clamp(142px, 39vw, 170px);
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid rgba(var(--gray-light), 0.92);
    }

    .page-with-video-bg main.home-main .guide-media::after {
      position: absolute;
      right: 0.65rem;
      bottom: 0.6rem;
      padding: 0.38rem 0.55rem;
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: 999px;
      background: rgba(15, 18, 25, 0.76);
      color: #fff;
      content: 'Tap to open ↗';
      font-size: 0.64rem;
      font-weight: 800;
      line-height: 1;
      box-shadow: 0 5px 14px rgba(15, 18, 25, 0.16);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .page-with-video-bg main.home-main .guide-copy {
      min-height: 108px;
      padding: 0.78rem 0.88rem 0.82rem;
    }

    .page-with-video-bg main.home-main .guide-copy h3 {
      margin: 0.3rem 0 0.24rem;
      font-size: 1.08rem;
      line-height: 1.12;
    }

    .page-with-video-bg main.home-main .guide-description--mobile {
      font-size: 0;
      line-height: 1.36;
    }

    .page-with-video-bg main.home-main .guide-description--mobile::after {
      font-size: 0.81rem;
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(2) .guide-description--mobile::after {
      content: 'See what one logged day becomes.';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(1) .guide-description--mobile::after {
      content: 'See the raw sheet that feeds the archive.';
    }

    .page-with-video-bg main.home-main .guide-card:nth-child(3) .guide-description--mobile::after {
      content: 'Copy the system and begin your own.';
    }

    .page-with-video-bg main.home-main .guide-copy .card-link {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .page-with-video-bg main.home-main {
      width: 100%;
      max-width: 430px;
      margin-inline: auto !important;
      padding-right: 0.8rem;
      padding-left: 0.8rem;
    }

    .page-with-video-bg main.home-main .guide-card {
      flex-basis: calc(100% - 1rem);
    }

    .page-with-video-bg main.home-main .featured-heading {
      column-gap: 0.45rem;
    }

    .page-with-video-bg main.home-main .featured-heading::after {
      padding-inline: 0.44rem;
      font-size: 0.57rem;
    }
  }
</style>
