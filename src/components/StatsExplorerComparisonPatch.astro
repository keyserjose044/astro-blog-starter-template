<style is:global>
  .stats-chart-tooltip {
    position: fixed;
    z-index: 250;
    max-width: min(300px, calc(100vw - 24px));
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 0.72rem;
    background: rgba(15, 23, 42, 0.96);
    color: #fff;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.24);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.35;
    pointer-events: none;
    transform: translate(12px, -110%);
    white-space: normal;
  }

  .stats-chart-tooltip[hidden] { display: none; }

  .stats-chart-point {
    cursor: crosshair;
    transition: r 120ms ease, stroke-width 120ms ease, opacity 120ms ease;
  }

  .stats-chart-point:hover,
  .stats-chart-point:focus {
    stroke: #fff;
    stroke-width: 2.2;
    opacity: 1;
    outline: none;
  }

  .daily-correlation-shell [data-correlation-granularity] {
    min-width: 145px;
  }

  :global(html.dark) .stats-chart-tooltip,
  :global(body.dark) .stats-chart-tooltip {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(248, 250, 252, 0.97);
    color: #0f172a;
  }
</style>

<script>
  import { getDailyMeta, getYears } from '../utils/dailyData';
  import type { DailyMeta, DailyRecord } from '../utils/dailyData';

  const NS = 'http://www.w3.org/2000/svg';
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const YEAR_COLORS = ['#2563eb', '#e11d48', '#059669', '#d97706', '#7c3aed', '#0891b2', '#be123c', '#4d7c0f'];

  type MetricKey = 'guitar' | 'audiobook' | 'running' | 'diary' | 'dance' | 'work' | 'language' | 'treadmill';
  type ViewKey = 'monthly' | 'daily' | 'cumulative';
  type CorrelationKey = 'sleep' | 'work' | 'dance' | 'guitar' | 'audiobook' | 'running' | 'treadmill' | 'language' | 'diary';
  type Point = { label: string; date?: string; value: number | null; future: boolean };
  type Metric = {
    label: string;
    icon: string;
    unit: string;
    digits: number;
    value: (record: DailyRecord) => number | null;
  };
  type CorrelationMetric = {
    label: string;
    unit: string;
    mode: 'sum' | 'average';
    value: (record: DailyRecord) => number | null;
  };
  type ScatterPoint = { x: number; y: number; label: string };

  const METRICS: Record<MetricKey, Metric> = {
    guitar: { label: 'Guitar', icon: '🎸', unit: 'hours', digits: 1, value: (record) => record.hobbies.guitarMinutes === null ? null : record.hobbies.guitarMinutes / 60 },
    audiobook: { label: 'Audiobooks', icon: '📚', unit: 'hours', digits: 1, value: (record) => record.audiobook.minutes === null ? null : record.audiobook.minutes / 60 },
    running: { label: 'Running', icon: '🏃', unit: 'miles', digits: 1, value: (record) => record.hobbies.runningMiles },
    diary: { label: 'Diary', icon: '📓', unit: 'words', digits: 0, value: (record) => record.diary.words },
    dance: { label: 'Dance', icon: '💃', unit: 'hours', digits: 1, value: (record) => record.hobbies.danceMinutes === null ? null : record.hobbies.danceMinutes / 60 },
    work: { label: 'Work & study', icon: '🧠', unit: 'hours', digits: 1, value: (record) => record.work.hours },
    language: { label: 'Language study', icon: '🌍', unit: 'hours', digits: 1, value: (record) => record.hobbies.languageMinutes === null ? null : record.hobbies.languageMinutes / 60 },
    treadmill: { label: 'Treadmill', icon: '🚶', unit: 'hours', digits: 1, value: (record) => record.hobbies.treadmillMinutes === null ? null : record.hobbies.treadmillMinutes / 60 },
  };

  const CORRELATIONS: Record<CorrelationKey, CorrelationMetric> = {
    sleep: { label: 'Sleep', unit: 'hours', mode: 'average', value: (record) => record.sleep.hours },
    work: { label: 'Work & study', unit: 'hours', mode: 'sum', value: (record) => record.work.hours },
    dance: { label: 'Dance', unit: 'hours', mode: 'sum', value: (record) => record.hobbies.danceMinutes === null ? null : record.hobbies.danceMinutes / 60 },
    guitar: { label: 'Guitar', unit: 'hours', mode: 'sum', value: (record) => record.hobbies.guitarMinutes === null ? null : record.hobbies.guitarMinutes / 60 },
    audiobook: { label: 'Audiobooks', unit: 'hours', mode: 'sum', value: (record) => record.audiobook.minutes === null ? null : record.audiobook.minutes / 60 },
    running: { label: 'Running', unit: 'miles', mode: 'sum', value: (record) => record.hobbies.runningMiles },
    treadmill: { label: 'Treadmill', unit: 'hours', mode: 'sum', value: (record) => record.hobbies.treadmillMinutes === null ? null : record.hobbies.treadmillMinutes / 60 },
    language: { label: 'Language study', unit: 'hours', mode: 'sum', value: (record) => record.hobbies.languageMinutes === null ? null : record.hobbies.languageMinutes / 60 },
    diary: { label: 'Diary words', unit: 'words', mode: 'average', value: (record) => record.diary.words },
  };

  const parseIso = (value: string) => new Date(`${value}T12:00:00`);
  const toIso = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  const format = (value: number | null, digits = 0) => value === null || !Number.isFinite(value)
    ? '—'
    : new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
  const sum = (values: Array<number | null>) => values.reduce((total, value) => total + (value ?? 0), 0);
  const average = (values: Array<number | null>) => {
    const valid = values.filter((value): value is number => value !== null && Number.isFinite(value));
    return valid.length ? sum(valid) / valid.length : null;
  };
  const svg = (tag: string, attrs: Record<string, string | number> = {}) => {
    const node = document.createElementNS(NS, tag);
    Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, String(value)));
    return node;
  };
  const setText = (root: ParentNode, selector: string, value: string) => {
    const node = root.querySelector(selector);
    if (node) node.textContent = value;
  };
  const waitFor = async (selector: string, attempts = 500) => {
    for (let index = 0; index < attempts; index += 1) {
      const node = document.querySelector(selector);
      if (node instanceof HTMLElement) return node;
      await new Promise((resolve) => setTimeout(resolve, 25));
    }
    return null;
  };

  function niceScale(maximumValue: number) {
    const maximum = Math.max(0, maximumValue);
    const roughStep = Math.max(Number.EPSILON, maximum / 5);
    const magnitude = 10 ** Math.floor(Math.log10(roughStep));
    const normalized = roughStep / magnitude;
    const niceNormalized = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
    const step = Math.max(1, niceNormalized * magnitude);
    const niceMaximum = Math.max(step, Math.ceil(maximum / step) * step);
    return { maximum: niceMaximum, step, intervals: Math.max(1, Math.round(niceMaximum / step)) };
  }

  function monotonePath(points: Array<{ x: number; y: number }>) {
    if (!points.length) return '';
    if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;
    if (points.length === 2) return `M ${points[0].x} ${points[0].y} L ${points[1].x} ${points[1].y}`;

    const count = points.length;
    const widths = new Array<number>(count - 1);
    const slopes = new Array<number>(count - 1);
    const tangents = new Array<number>(count);

    for (let index = 0; index < count - 1; index += 1) {
      widths[index] = points[index + 1].x - points[index].x;
      slopes[index] = widths[index] ? (points[index + 1].y - points[index].y) / widths[index] : 0;
    }

    tangents[0] = slopes[0];
    tangents[count - 1] = slopes[count - 2];
    for (let index = 1; index < count - 1; index += 1) {
      if (slopes[index - 1] === 0 || slopes[index] === 0 || Math.sign(slopes[index - 1]) !== Math.sign(slopes[index])) {
        tangents[index] = 0;
      } else {
        const firstWeight = 2 * widths[index] + widths[index - 1];
        const secondWeight = widths[index] + 2 * widths[index - 1];
        tangents[index] = (firstWeight + secondWeight) /
          (firstWeight / slopes[index - 1] + secondWeight / slopes[index]);
      }
    }

    let path = `M ${points[0].x} ${points[0].y}`;
    for (let index = 0; index < count - 1; index += 1) {
      const width = widths[index];
      path += ` C ${points[index].x + width / 3} ${points[index].y + tangents[index] * width / 3}, ${points[index + 1].x - width / 3} ${points[index + 1].y - tangents[index + 1] * width / 3}, ${points[index + 1].x} ${points[index + 1].y}`;
    }
    return path;
  }

  function tooltipElement() {
    let tooltip = document.querySelector('.stats-chart-tooltip') as HTMLElement | null;
    if (!tooltip) {
      tooltip = document.createElement('div');
      tooltip.className = 'stats-chart-tooltip';
      tooltip.hidden = true;
      tooltip.setAttribute('role', 'tooltip');
      document.body.append(tooltip);
    }
    return tooltip;
  }

  function positionTooltip(tooltip: HTMLElement, clientX: number, clientY: number) {
    tooltip.style.left = `${clientX}px`;
    tooltip.style.top = `${clientY}px`;
    requestAnimationFrame(() => {
      const box = tooltip.getBoundingClientRect();
      if (box.right > window.innerWidth - 8) tooltip.style.left = `${Math.max(8, clientX - box.width - 20)}px`;
      if (box.top < 8) tooltip.style.top = `${Math.min(window.innerHeight - 8, clientY + box.height + 18)}px`;
    });
  }

  function bindTooltip(target: SVGElement, text: string) {
    target.classList.add('stats-chart-point');
    target.setAttribute('aria-label', text);
    target.querySelector('title')?.remove();
    const tooltip = tooltipElement();
    const showAtPointer = (event: Event) => {
      const pointer = event as PointerEvent;
      tooltip.textContent = text;
      tooltip.hidden = false;
      positionTooltip(tooltip, pointer.clientX, pointer.clientY);
    };
    const showAtElement = () => {
      const box = target.getBoundingClientRect();
      tooltip.textContent = text;
      tooltip.hidden = false;
      positionTooltip(tooltip, box.left + box.width / 2, box.top);
    };
    const hide = () => { tooltip.hidden = true; };
    target.addEventListener('pointerenter', showAtPointer);
    target.addEventListener('pointermove', showAtPointer);
    target.addEventListener('pointerleave', hide);
    target.addEventListener('focus', showAtElement);
    target.addEventListener('blur', hide);
  }

  function recordsForYear(records: DailyRecord[], year: number) {
    return records.filter((record) => Number(record.date.slice(0, 4)) === year);
  }

  function monthlySeries(records: DailyRecord[], year: number, metric: Metric, meta: DailyMeta): Point[] {
    const yearRecords = recordsForYear(records, year);
    const throughYear = Number((meta.dataThrough || '').slice(0, 4));
    const throughMonth = meta.dataThrough && throughYear === year ? Number(meta.dataThrough.slice(5, 7)) - 1 : 11;

    return MONTHS.map((label, month) => {
      const values = yearRecords
        .filter((record) => parseIso(record.date).getMonth() === month)
        .map(metric.value)
        .filter((value): value is number => value !== null && Number.isFinite(value));
      const future = year === throughYear && month > throughMonth;
      return { label, value: future || !values.length ? null : sum(values), future };
    });
  }

  function cumulativeSeries(points: Point[]) {
    let running = 0;
    return points.map((point) => {
      if (point.future) return { ...point, value: null };
      if (point.value !== null) running += point.value;
      return { ...point, value: point.value === null && running === 0 ? null : running };
    });
  }

  function dailySeries(records: DailyRecord[], year: number, metric: Metric, meta: DailyMeta): Point[] {
    const map = new Map(recordsForYear(records, year).map((record) => [record.date, record]));
    const points: Point[] = [];
    for (const date = new Date(year, 0, 1, 12); date <= new Date(year, 11, 31, 12); date.setDate(date.getDate() + 1)) {
      const iso = toIso(date);
      const record = map.get(iso);
      const future = Boolean(meta.dataThrough && iso > meta.dataThrough);
      points.push({
        label: new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(date),
        date: iso,
        value: future || !record ? null : metric.value(record),
        future,
      });
    }
    return points;
  }

  function appendIntegerYAxis(
    chart: SVGSVGElement,
    scale: { maximum: number; step: number; intervals: number },
    margin: { left: number; right: number; top: number; bottom: number },
    width: number,
    height: number,
  ) {
    const innerHeight = height - margin.top - margin.bottom;
    for (let index = 0; index <= scale.intervals; index += 1) {
      const value = scale.maximum - scale.step * index;
      const y = margin.top + innerHeight * index / scale.intervals;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'canonical-grid' }));
      const label = svg('text', { x: margin.left - 10, y: y + 4, 'text-anchor': 'end', class: 'canonical-axis' });
      label.textContent = String(Math.round(value));
      chart.append(label);
    }
  }

  function drawExplorerLines(
    host: HTMLElement,
    series: Array<{ year: number; color: string; selected: boolean; dashed: boolean; points: Point[] }>,
    metric: Metric,
    view: Exclude<ViewKey, 'daily'>,
  ) {
    const width = 1000;
    const height = 400;
    const margin = { left: 72, right: 24, top: 30, bottom: 60 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const values = series.flatMap((item) => item.points.map((point) => point.value)).filter((value): value is number => value !== null);
    const scale = niceScale(Math.max(0, ...values));
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `${metric.label} ${view} chart`, 'data-stats-polished': 'true' });
    appendIntegerYAxis(chart, scale, margin, width, height);

    const slot = innerWidth / 11;
    const x = (month: number) => margin.left + slot * month;
    const y = (value: number) => margin.top + innerHeight - (value / scale.maximum) * innerHeight;

    const selectedSeries = series.find((item) => item.selected);
    const firstFuture = selectedSeries?.points.findIndex((point) => point.future) ?? -1;
    if (firstFuture >= 0) {
      const startX = Math.max(margin.left, x(firstFuture) - slot / 2);
      chart.append(svg('rect', { x: startX, y: margin.top, width: width - margin.right - startX, height: innerHeight, fill: 'rgba(148,163,184,.08)' }));
    }

    [...series].sort((first, second) => Number(first.selected) - Number(second.selected)).forEach((item) => {
      const segments: Array<Array<{ x: number; y: number }>> = [];
      let current: Array<{ x: number; y: number }> = [];
      item.points.forEach((point, month) => {
        if (point.value === null) {
          if (current.length) segments.push(current);
          current = [];
        } else {
          current.push({ x: x(month), y: y(point.value) });
        }
      });
      if (current.length) segments.push(current);

      segments.forEach((segment) => chart.append(svg('path', {
        d: monotonePath(segment),
        fill: 'none',
        stroke: item.color,
        'stroke-width': item.selected ? 4 : 2.5,
        'stroke-linecap': 'round',
        'stroke-linejoin': 'round',
        opacity: item.selected ? 1 : 0.82,
        ...(item.dashed ? { 'stroke-dasharray': '8 7' } : {}),
      })));

      item.points.forEach((point, month) => {
        if (point.value === null) return;
        const circle = svg('circle', {
          cx: x(month),
          cy: y(point.value),
          r: item.selected ? 4.5 : 3.4,
          fill: item.color,
          tabindex: 0,
          opacity: item.selected ? 1 : 0.88,
        });
        bindTooltip(circle, `${point.label} ${item.year} · ${format(point.value, metric.digits)} ${metric.unit}`);
        chart.append(circle);
      });
    });

    MONTHS.forEach((month, index) => {
      const label = svg('text', { x: x(index), y: height - 28, 'text-anchor': 'middle', class: 'canonical-axis' });
      label.textContent = month;
      chart.append(label);
    });
    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = metric.unit;
    chart.append(yTitle);
    const xTitle = svg('text', { x: margin.left + innerWidth / 2, y: height - 7, 'text-anchor': 'middle', class: 'canonical-axis-title' });
    xTitle.textContent = 'Month';
    chart.append(xTitle);
    host.replaceChildren(chart);
  }

  function drawExplorerDaily(host: HTMLElement, points: Point[], metric: Metric, year: number) {
    const width = 1100;
    const height = 400;
    const margin = { left: 72, right: 24, top: 30, bottom: 60 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const values = points.map((point) => point.value).filter((value): value is number => value !== null);
    const scale = niceScale(Math.max(0, ...values));
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `${metric.label} daily chart for ${year}`, 'data-stats-polished': 'true' });
    appendIntegerYAxis(chart, scale, margin, width, height);

    const slot = innerWidth / points.length;
    const barWidth = Math.max(1, slot * 0.78);
    const firstFuture = points.findIndex((point) => point.future);
    if (firstFuture >= 0) {
      const startX = margin.left + firstFuture * slot;
      chart.append(svg('rect', { x: startX, y: margin.top, width: width - margin.right - startX, height: innerHeight, fill: 'rgba(148,163,184,.08)' }));
    }

    points.forEach((point, index) => {
      if (point.future) return;
      const heightValue = point.value === null ? 3 : Math.max(point.value === 0 ? 2 : 3, (point.value / scale.maximum) * innerHeight);
      const rect = svg('rect', {
        x: margin.left + slot * index + (slot - barWidth) / 2,
        y: margin.top + innerHeight - heightValue,
        width: barWidth,
        height: heightValue,
        rx: Math.min(2, barWidth / 2),
        fill: point.value === null ? '#cbd5e1' : point.value === 0 ? '#94a3b8' : '#2563eb',
        tabindex: 0,
      });
      bindTooltip(rect, `${point.label}, ${year} · ${point.value === null ? 'Not logged' : `${format(point.value, metric.digits)} ${metric.unit}`}`);
      if (point.date) rect.addEventListener('click', () => location.href = `/day/?date=${point.date}`);
      chart.append(rect);
    });

    for (let month = 0; month < 12; month += 1) {
      const date = new Date(year, month, 1, 12);
      const dayIndex = Math.floor((date.getTime() - new Date(year, 0, 1, 12).getTime()) / 86400000);
      const label = svg('text', { x: margin.left + slot * dayIndex, y: height - 28, 'text-anchor': 'start', class: 'canonical-axis' });
      label.textContent = MONTHS[month];
      chart.append(label);
    }
    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = metric.unit;
    chart.append(yTitle);
    const xTitle = svg('text', { x: margin.left + innerWidth / 2, y: height - 7, 'text-anchor': 'middle', class: 'canonical-axis-title' });
    xTitle.textContent = 'Date';
    chart.append(xTitle);
    host.replaceChildren(chart);
  }

  function yearColor(year: number, selectedYear: number, index: number) {
    return year === selectedYear ? '#2563eb' : YEAR_COLORS[(index + 1) % YEAR_COLORS.length];
  }

  async function initExplorer(records: DailyRecord[], meta: DailyMeta) {
    const shell = await waitFor('.canonical-explorer');
    if (!shell || shell.dataset.chartPolish === 'true') return;
    shell.dataset.chartPolish = 'true';

    const compareSelect = shell.querySelector('[data-canonical-compare]') as HTMLSelectElement | null;
    const yearSelect = shell.querySelector('[data-canonical-year]') as HTMLSelectElement | null;
    const host = shell.querySelector('[data-canonical-chart]') as HTMLElement | null;
    if (!compareSelect || !yearSelect || !host) return;

    if (!Array.from(compareSelect.options).some((option) => option.value === 'all')) {
      const allOption = document.createElement('option');
      allOption.value = 'all';
      allOption.textContent = 'All years';
      compareSelect.insertBefore(allOption, compareSelect.options[1] || null);
    }
    if (new URL(location.href).searchParams.get('compare') === 'all') compareSelect.value = 'all';

    let timer = 0;
    const render = () => {
      const activeMetric = shell.querySelector<HTMLElement>('.canonical-metric.is-active')?.dataset.metric as MetricKey | undefined;
      const activeView = shell.querySelector<HTMLElement>('.canonical-view.is-active')?.dataset.view as ViewKey | undefined;
      if (!activeMetric || !activeView) return;
      const metric = METRICS[activeMetric];
      const selectedYear = Number(yearSelect.value);

      if (activeView === 'daily') {
        drawExplorerDaily(host, dailySeries(records, selectedYear, metric, meta), metric, selectedYear);
        return;
      }

      const years = compareSelect.value === 'all'
        ? meta.availableYears.slice().sort((first, second) => first - second)
        : compareSelect.value
          ? [selectedYear, Number(compareSelect.value)]
          : [selectedYear];
      const uniqueYears = Array.from(new Set(years));
      const series = uniqueYears.map((year, index) => {
        const monthly = monthlySeries(records, year, metric, meta);
        return {
          year,
          color: yearColor(year, selectedYear, index),
          selected: year === selectedYear,
          dashed: compareSelect.value !== 'all' && year !== selectedYear,
          points: activeView === 'cumulative' ? cumulativeSeries(monthly) : monthly,
        };
      });
      drawExplorerLines(host, series, metric, activeView);

      const subtitle = shell.querySelector('[data-chart-subtitle]');
      if (subtitle && compareSelect.value === 'all') subtitle.textContent = activeView === 'cumulative'
        ? 'All available years superimposed as cumulative monthly totals'
        : 'All available years superimposed as monthly totals';
      const legend = shell.querySelector('[data-canonical-legend]');
      if (legend) legend.innerHTML = series
        .map((item) => `<span><i style="--legend-color:${item.color}"></i>${item.year}${item.selected ? ' selected' : ''}</span>`)
        .join('');
    };
    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 80);
    };

    shell.addEventListener('click', (event) => {
      if ((event.target as Element | null)?.closest('[data-metric], [data-view]')) schedule();
    });
    shell.addEventListener('change', schedule);
    new MutationObserver(() => {
      if (!host.querySelector('svg[data-stats-polished="true"]')) schedule();
    }).observe(host, { childList: true });
    schedule();
  }

  function monthlyCorrelation(records: DailyRecord[], metric: CorrelationMetric) {
    const groups = new Map<string, DailyRecord[]>();
    records.forEach((record) => {
      const key = record.date.slice(0, 7);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(record);
    });
    return Array.from(groups, ([key, group]) => {
      const values = group.map(metric.value).filter((value): value is number => value !== null && Number.isFinite(value));
      return { key, value: values.length ? metric.mode === 'average' ? average(values) : sum(values) : null };
    }).sort((first, second) => first.key.localeCompare(second.key));
  }

  function pearson(points: ScatterPoint[]) {
    if (points.length < 3) return null;
    const xMean = average(points.map((point) => point.x));
    const yMean = average(points.map((point) => point.y));
    if (xMean === null || yMean === null) return null;
    let numerator = 0;
    let xSquares = 0;
    let ySquares = 0;
    points.forEach((point) => {
      const xDifference = point.x - xMean;
      const yDifference = point.y - yMean;
      numerator += xDifference * yDifference;
      xSquares += xDifference * xDifference;
      ySquares += yDifference * yDifference;
    });
    const denominator = Math.sqrt(xSquares * ySquares);
    return denominator ? numerator / denominator : null;
  }

  function relationshipLabel(value: number | null) {
    if (value === null) return 'Insufficient data';
    const size = Math.abs(value);
    const strength = size < 0.2 ? 'Negligible' : size < 0.4 ? 'Weak' : size < 0.6 ? 'Moderate' : size < 0.8 ? 'Strong' : 'Very strong';
    return `${strength} ${size < 0.05 ? '' : value > 0 ? 'positive' : 'negative'} relationship`.replace(/\s+/g, ' ');
  }

  function drawCorrelation(
    host: HTMLElement,
    pairs: ScatterPoint[],
    xMetric: CorrelationMetric,
    yMetric: CorrelationMetric,
    granularity: 'daily' | 'monthly',
  ) {
    const width = 900;
    const height = 440;
    const margin = { left: 82, right: 28, top: 30, bottom: 72 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const xScale = niceScale(Math.max(0, ...pairs.map((point) => point.x)));
    const yScale = niceScale(Math.max(0, ...pairs.map((point) => point.y)));
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `${xMetric.label} compared with ${yMetric.label}`, 'data-stats-polished-correlation': 'true' });

    for (let index = 0; index <= yScale.intervals; index += 1) {
      const value = yScale.maximum - yScale.step * index;
      const y = margin.top + innerHeight * index / yScale.intervals;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'daily-grid' }));
      const label = svg('text', { x: margin.left - 10, y: y + 4, 'text-anchor': 'end', class: 'daily-axis' });
      label.textContent = String(Math.round(value));
      chart.append(label);
    }
    for (let index = 0; index <= xScale.intervals; index += 1) {
      const value = xScale.step * index;
      const x = margin.left + innerWidth * index / xScale.intervals;
      const label = svg('text', { x, y: height - 38, 'text-anchor': 'middle', class: 'daily-axis' });
      label.textContent = String(Math.round(value));
      chart.append(label);
    }

    const xPosition = (value: number) => margin.left + value / xScale.maximum * innerWidth;
    const yPosition = (value: number) => margin.top + innerHeight - value / yScale.maximum * innerHeight;
    const opacity = granularity === 'daily' ? Math.max(0.18, Math.min(0.45, 90 / Math.max(1, pairs.length))) : 0.82;
    const radius = granularity === 'daily' ? 3.1 : 5;

    pairs.forEach((pair) => {
      const circle = svg('circle', { cx: xPosition(pair.x), cy: yPosition(pair.y), r: radius, fill: '#2563eb', opacity, tabindex: 0 });
      bindTooltip(circle, `${pair.label} · ${xMetric.label}: ${format(pair.x, 2)} ${xMetric.unit} · ${yMetric.label}: ${format(pair.y, 2)} ${yMetric.unit}`);
      chart.append(circle);
    });

    if (pairs.length >= 2) {
      const xMean = average(pairs.map((pair) => pair.x))!;
      const yMean = average(pairs.map((pair) => pair.y))!;
      const denominator = sum(pairs.map((pair) => (pair.x - xMean) ** 2));
      if (denominator > 0) {
        const slope = sum(pairs.map((pair) => (pair.x - xMean) * (pair.y - yMean))) / denominator;
        const intercept = yMean - slope * xMean;
        const startValue = Math.max(0, intercept);
        const endValue = Math.max(0, intercept + slope * xScale.maximum);
        chart.append(svg('line', {
          x1: margin.left,
          y1: yPosition(startValue),
          x2: width - margin.right,
          y2: yPosition(endValue),
          stroke: '#d97706',
          'stroke-width': 2.4,
        }));
      }
    }

    const xTitle = svg('text', { x: margin.left + innerWidth / 2, y: height - 8, 'text-anchor': 'middle', class: 'daily-axis-title' });
    xTitle.textContent = `${xMetric.label} (${xMetric.unit})`;
    chart.append(xTitle);
    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'daily-axis-title' });
    yTitle.textContent = `${yMetric.label} (${yMetric.unit})`;
    chart.append(yTitle);
    host.replaceChildren(chart);
  }

  async function initCorrelation(records: DailyRecord[], meta: DailyMeta) {
    const shell = await waitFor('.daily-correlation-shell');
    if (!shell || shell.dataset.dailyCorrelation === 'true') return;
    shell.dataset.dailyCorrelation = 'true';

    const controls = shell.querySelector('.daily-analysis-controls');
    const xSelect = shell.querySelector('[data-correlation-x]') as HTMLSelectElement | null;
    const ySelect = shell.querySelector('[data-correlation-y]') as HTMLSelectElement | null;
    const yearSelect = shell.querySelector('[data-correlation-year]') as HTMLSelectElement | null;
    const host = shell.querySelector('[data-correlation-chart]') as HTMLElement | null;
    if (!controls || !xSelect || !ySelect || !yearSelect || !host) return;

    const granularityLabel = document.createElement('label');
    granularityLabel.innerHTML = 'Granularity<select data-correlation-granularity><option value="daily">Daily dots</option><option value="monthly">Monthly dots</option></select>';
    controls.insertBefore(granularityLabel, yearSelect.closest('label'));
    const granularitySelect = granularityLabel.querySelector('select') as HTMLSelectElement;

    const description = document.querySelector('#correlations .section-heading > p:last-child');
    if (description) description.textContent = 'Switch between daily dots for detailed day-to-day relationships and monthly dots for broader, less noisy patterns.';

    let timer = 0;
    const render = () => {
      if (xSelect.value === ySelect.value) ySelect.value = Object.keys(CORRELATIONS).find((key) => key !== xSelect.value) || 'work';
      const xMetric = CORRELATIONS[xSelect.value as CorrelationKey];
      const yMetric = CORRELATIONS[ySelect.value as CorrelationKey];
      const selectedRecords = yearSelect.value === 'all' ? records : records.filter((record) => record.date.startsWith(`${yearSelect.value}-`));
      const granularity = granularitySelect.value as 'daily' | 'monthly';
      let pairs: ScatterPoint[];

      if (granularity === 'daily') {
        pairs = selectedRecords.map((record) => ({
          x: xMetric.value(record),
          y: yMetric.value(record),
          label: new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(parseIso(record.date)),
        })).filter((pair): pair is ScatterPoint => pair.x !== null && pair.y !== null && Number.isFinite(pair.x) && Number.isFinite(pair.y));
      } else {
        const xMonthly = monthlyCorrelation(selectedRecords, xMetric);
        const yMap = new Map(monthlyCorrelation(selectedRecords, yMetric).map((item) => [item.key, item.value]));
        pairs = xMonthly.map((item) => ({ x: item.value, y: yMap.get(item.key) ?? null, label: item.key }))
          .filter((pair): pair is ScatterPoint => pair.x !== null && pair.y !== null && Number.isFinite(pair.x) && Number.isFinite(pair.y));
      }

      const correlation = pearson(pairs);
      setText(shell, '[data-correlation-r]', correlation === null ? 'Not available' : format(correlation, 2));
      setText(shell, '[data-correlation-pairs]', `${pairs.length} ${granularity === 'daily' ? 'days' : 'months'}`);
      setText(shell, '[data-correlation-label]', relationshipLabel(correlation));
      setText(shell, '[data-correlation-note]', pairs.length < 3
        ? `At least three paired ${granularity === 'daily' ? 'days' : 'months'} are required.`
        : granularity === 'daily'
          ? `${xMetric.label} and ${yMetric.label} share ${pairs.length} paired days. Daily correlations reveal short-term relationships but can be noisy and zero-heavy.`
          : `${xMetric.label} and ${yMetric.label} share ${pairs.length} paired months. Monthly aggregation reduces day-to-day noise. Correlation describes association, not causation.`);
      drawCorrelation(host, pairs, xMetric, yMetric, granularity);
    };
    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 90);
    };

    shell.addEventListener('change', schedule);
    new MutationObserver(() => {
      if (!host.querySelector('svg[data-stats-polished-correlation="true"]')) schedule();
    }).observe(host, { childList: true });
    schedule();
  }

  async function init() {
    try {
      const meta = await getDailyMeta();
      const records = await getYears(meta.availableYears);
      await Promise.all([initExplorer(records, meta), initCorrelation(records, meta)]);
    } catch (error) {
      console.error('Stats chart interaction enhancement failed', error);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else void init();
</script>
