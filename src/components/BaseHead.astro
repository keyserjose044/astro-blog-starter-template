---
// Import the global.css file here so that it is included on
// all pages through the use of <BaseHead /> component.
import '../styles/global.css';
import { DAILY_DATA_API_URL } from '../utils/dailyData';

interface Props {
  title: string;
  description: string;
  image?: string; // path or absolute URL
}

const { title, description, image = '/about-lifeloggerz.webp' } = Astro.props;

// Build absolute URLs for canonical + social tags
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteImageURL = new URL(image, Astro.site);

// For reliable favicon paths on GitHub Pages or subpaths
const base = import.meta.env.BASE_URL || '/';
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isAboutPage = normalizedPath === '/about' || normalizedPath.endsWith('/about');
const isBooksPage = normalizedPath === '/books' || normalizedPath.endsWith('/books');
const isAlbumsPage = normalizedPath === '/albums' || normalizedPath.endsWith('/albums');
const isArtPage = normalizedPath === '/art' || normalizedPath.endsWith('/art');
const aboutAssetVersion = '20260801-1426';
const booksAssetVersion = '20260801-1535';
const albumsAssetVersion = '20260726-1535';
const artAssetVersion = '20260727-1945';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Favicon & app icons -->
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="alternate icon" type="image/png" href={`${base}favicon.webp`} />
<link rel="shortcut icon" href={`${base}favicon.ico`} />
<link rel="apple-touch-icon" href={`${base}favicon.webp`} />
<meta name="theme-color" content="#ffffff" />

<!-- Preload the font files that actually exist in /public/fonts -->
<link rel="preload" href={`${base}fonts/atkinson-regular.woff`} as="font" type="font/woff" crossorigin />
<link rel="preload" href={`${base}fonts/atkinson-bold.woff`} as="font" type="font/woff" crossorigin />

{isAboutPage ? <meta name="lifeloggerz-about-assets" content={aboutAssetVersion} /> : null}
{isAboutPage ? <link rel="stylesheet" href={`${base}styles/about-adornment-personality.css?v=${aboutAssetVersion}`} /> : null}

{isBooksPage ? <meta name="lifeloggerz-books-assets" content={booksAssetVersion} /> : null}
{isBooksPage ? <meta name="lifeloggerz-daily-data-api" content={DAILY_DATA_API_URL} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-atlas.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-atlas-insights.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-atlas-refinement.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-final-polish.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-calendar.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-calendar-refinement.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-calendar-enhancements.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-calendar-final-polish.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-views-expansion.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-view-visibility-fix.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-records-redesign.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-mobile-polish.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-mobile-pass-2.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-mobile-pass-2-guardrails.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-final-stability.css?v=${booksAssetVersion}`} /> : null}
{isBooksPage ? <link rel="stylesheet" href={`${base}styles/books-desktop-calendar-milestones.css?v=${booksAssetVersion}`} /> : null}

{isAlbumsPage ? <meta name="lifeloggerz-albums-assets" content={albumsAssetVersion} /> : null}
{isAlbumsPage ? <link rel="stylesheet" href={`${base}styles/albums-explorer.css?v=${albumsAssetVersion}`} /> : null}
{isAlbumsPage ? <link rel="stylesheet" href={`${base}styles/albums-explorer-responsive.css?v=${albumsAssetVersion}`} /> : null}

{isArtPage ? <meta name="lifeloggerz-art-assets" content={artAssetVersion} /> : null}
{isArtPage ? <link rel="stylesheet" href={`${base}styles/art-explorer.css?v=${artAssetVersion}`} /> : null}
{isArtPage ? <link rel="stylesheet" href={`${base}styles/art-explorer-light.css?v=${artAssetVersion}`} /> : null}
{isArtPage ? <link rel="stylesheet" href={`${base}styles/art-gallery-masonry.css?v=${artAssetVersion}`} /> : null}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.toString()} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Mobile polish -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0b" />
<meta name="color-scheme" content="light dark" />

<!-- Robots -->
<meta name="robots" content="index,follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageURL.toString()} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageURL.toString()} />

{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-atlas.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-final-polish.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-atlas-insights.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-calendar.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-calendar-enhancements.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-calendar-tuning.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-expansion-stability.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-views-expansion.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-expansion-fixes.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-records-redesign.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-records-stability.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-mobile-polish.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-mobile-pass-2.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-final-stability.js?v=${booksAssetVersion}`}></script> : null}
{isBooksPage ? <script is:inline type="module" src={`${base}scripts/books-desktop-authors-fast.js?v=${booksAssetVersion}`}></script> : null}
{isAlbumsPage ? <script is:inline type="module" src={`${base}scripts/albums-explorer-core.js?v=${albumsAssetVersion}`}></script> : null}
{isArtPage ? <script is:inline src={`${base}scripts/art-image-fallback.js?v=${artAssetVersion}`}></script> : null}
{isArtPage ? <script is:inline type="module" src={`${base}scripts/art-explorer-core.js?v=${artAssetVersion}`}></script> : null}
{isArtPage ? <script is:inline type="module" src={`${base}scripts/art-gallery-masonry.js?v=${artAssetVersion}`}></script> : null}
