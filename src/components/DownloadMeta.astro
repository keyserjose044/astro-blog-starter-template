---
interface Props {
  /** Final destination (the actual file or Google Sheets link) */
  href: string;
  updated: string;
  text?: string;

  /** Optional guide action displayed beside the file action */
  guideHref?: string;
  guideText?: string;

  /** Preferred: explicit counter key, e.g. "template/2026-raw-data-template" */
  downloadKey?: string;

  /** Historical downloads to add to the live counter */
  countOffset?: number;

  /** Optional fallbacks if you don't provide downloadKey */
  type?: string;
  slug?: string;
}

const {
  href,
  updated,
  text = "Download",
  guideHref,
  guideText = "View guide",
  downloadKey,
  countOffset = 0,
  type,
  slug,
} = Astro.props as Props;

if (!href || !updated) {
  throw new Error("DownloadMeta.astro requires href and updated");
}

const SITE_ORIGIN = "https://lifeloggerz.com";
const COUNT_ORIGIN = "https://v.lifeloggerz.com";

function toAbsolute(url: string): string {
  try { return new URL(url, SITE_ORIGIN).toString(); }
  catch { return SITE_ORIGIN; }
}

function parseCounterKeyFromDHref(url: string): string | null {
  try {
    const u = new URL(url, SITE_ORIGIN);
    const m = u.pathname.match(/^\/d\/([^/]+)\/(.+)$/);
    if (!m) return null;
    return `${m[1]}/${decodeURIComponent(m[2])}`;
  } catch { return null; }
}

function deriveKeyFromPropsOrFilename(url: string): string {
  if (type && slug) return `${type}/${slug}`;

  const u = new URL(url, SITE_ORIGIN);
  const last = (u.pathname.split("/").pop() || "").toLowerCase();
  const inferredSlug = last.replace(/\.[^.]+$/, "") || "file";
  const inferredType = (last.split(".").pop() || "file").toLowerCase();

  return `${inferredType}/${inferredSlug}`;
}

const counterKey =
  downloadKey ||
  parseCounterKeyFromDHref(href) ||
  deriveKeyFromPropsOrFilename(href);

const finalUrl = toAbsolute(href);
const [keyType, keySlug] = counterKey.split("/", 2);
const dlHref = `/d/${encodeURIComponent(keyType)}/${encodeURIComponent(keySlug)}?to=${encodeURIComponent(finalUrl)}`;
const countUrl = `${COUNT_ORIGIN}/count/downloads?key=${encodeURIComponent(counterKey)}`;

const isSameOrigin = finalUrl.startsWith(SITE_ORIGIN);
const looksLikeFile =
  /\.(pdf|docx?|xlsx?|pptx?|zip|png|jpe?g|gif|csv|txt|mp3|mp4|webm|wav)$/i.test(finalUrl);
const addDownloadAttr = isSameOrigin && looksLikeFile;
const countId = "dl-count-" + Math.random().toString(36).slice(2, 8);
---

<div class="download-meta-shell">
  <div class="download-meta">
    <span>Updated {updated}</span>
    <span class="meta-sep" aria-hidden="true">·</span>
    <span id={countId}>— Downloads</span>

    <script
      src="/downloadcount.js?v=20260726-2"
      defer
      data-download-count
      data-el={countId}
      data-key={counterKey}
      data-url={countUrl}
      data-offset={String(countOffset)}
    ></script>
  </div>

  <div class="actions">
    {guideHref && (
      <a class="btn btn--secondary" href={guideHref}>
        {guideText}
      </a>
    )}
    <a class="btn btn--primary" href={dlHref} {...(addDownloadAttr ? { download: "" } : {})}>
      {text}
    </a>
  </div>
</div>

<style>
  .download-meta-shell {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .download-meta {
    display: inline-flex;
    max-width: 100%;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    color: #6b7280;
    font-size: clamp(0.74rem, 2.5vw, 0.84rem);
    line-height: 1.25;
    text-align: center;
    white-space: nowrap;
  }

  .download-meta .meta-sep { opacity: 0.65; }

  .actions {
    display: flex;
    width: 100%;
    margin-top: 0.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .btn {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0.44rem 0.82rem;
    border: 1px solid var(--accent, #405cf5);
    border-radius: 9999px;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background: var(--accent, #405cf5);
    color: white;
    box-shadow: 0 5px 16px var(--ring, rgba(64,92,245,0.22));
  }

  .btn--primary:hover {
    transform: translateY(-1px);
    color: white;
    box-shadow: 0 8px 20px var(--ring, rgba(64,92,245,0.24));
  }

  .btn--secondary {
    background: white;
    color: var(--accent, #405cf5);
    box-shadow: none;
  }

  .btn--secondary:hover {
    transform: translateY(-1px);
    background: #eef1ff;
    color: var(--accent, #405cf5);
  }

  .btn:focus-visible {
    outline: 3px solid var(--ring, rgba(64,92,245,0.25));
    outline-offset: 3px;
  }

  @media (max-width: 360px) {
    .actions { gap: 0.4rem; }
    .btn { padding-inline: 0.68rem; font-size: 0.8rem; }
  }
</style>
