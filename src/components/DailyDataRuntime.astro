<style is:global>
  .daily-live-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin:1rem 0}.daily-live-summary article{padding:.8rem;border:1px solid rgba(148,163,184,.22);border-radius:.9rem;background:rgba(255,255,255,.78)}.daily-live-summary span{display:block;color:#64748b;font-size:.72rem;font-weight:800;text-transform:uppercase}.daily-live-summary strong{display:block;margin-top:.3rem;color:#0f172a;font-size:1.25rem}.daily-live-controls{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.8rem;margin:1rem 0}.daily-live-controls>div{display:grid;gap:.35rem}.daily-live-controls label{color:#64748b;font-size:.72rem;font-weight:800;text-transform:uppercase}.daily-live-buttons{display:flex;flex-wrap:wrap;gap:.4rem}.daily-live-buttons button{padding:.45rem .7rem;border:1px solid rgba(148,163,184,.3);border-radius:999px;background:#fff;color:#475569;font:inherit;font-size:.8rem;cursor:pointer}.daily-live-buttons button.is-active{border-color:#2563eb;background:#dbeafe;color:#1d4ed8}.daily-live-chart-shell{padding:1rem;border:1px solid rgba(148,163,184,.22);border-radius:1rem;background:rgba(255,255,255,.8)}.daily-live-chart-head{display:flex;justify-content:space-between;gap:1rem;margin-bottom:.75rem}.daily-live-chart-head span{color:#64748b;font-size:.78rem}.daily-live-chart{overflow-x:auto;min-height:230px;padding:.5rem;border-radius:.8rem;background:repeating-linear-gradient(to top,rgba(148,163,184,.13) 0 1px,transparent 1px 25%),#f8fafc}.daily-live-bars{display:grid;align-items:end;gap:3px;width:max(100%,var(--chart-width));height:210px}.daily-live-bar{display:block;align-self:end;height:var(--bar-height);min-height:2px;border-radius:4px 4px 1px 1px;background:linear-gradient(180deg,#60a5fa,#2563eb)}.daily-live-bar.is-zero{height:2px;background:#94a3b8}.daily-live-bar.is-missing{height:100%;min-height:0;background:repeating-linear-gradient(135deg,transparent 0 4px,rgba(148,163,184,.35) 4px 6px)}.daily-live-calendar{display:grid;grid-template-columns:repeat(7,18px);grid-auto-rows:18px;gap:4px;width:max-content}.daily-live-cell{border-radius:3px;background:#e2e8f0}.daily-live-cell.level-1{background:#bfdbfe}.daily-live-cell.level-2{background:#93c5fd}.daily-live-cell.level-3{background:#60a5fa}.daily-live-cell.level-4{background:#2563eb}.daily-live-cell.is-missing{background:repeating-linear-gradient(135deg,#e2e8f0 0 3px,#f8fafc 3px 5px)}.daily-live-empty{display:grid;min-height:210px;place-items:center;color:#64748b;text-align:center}.day-live-scrubber{margin:0 0 1rem;padding:.9rem 1rem;border:1px solid rgba(148,163,184,.25);border-radius:1.1rem;background:rgba(255,255,255,.88)}.day-live-scrubber__head{display:flex;justify-content:space-between;gap:1rem}.day-live-scrubber span{color:#64748b;font-size:.72rem;font-weight:800;text-transform:uppercase}.day-live-scrubber strong{display:block;margin-top:.15rem}.day-live-scrubber output{color:#2563eb;font-weight:800}.day-live-scrubber input{width:100%;margin-top:.65rem;accent-color:#2563eb}.day-live-year{display:grid;gap:.28rem}.day-live-year span{color:#64748b;font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.day-live-year select{min-height:2.75rem;padding:.65rem .8rem;border:1px solid rgba(148,163,184,.25);border-radius:.8rem;background:#fff;color:#0f172a;font:inherit;font-weight:700}.day-live-time{display:grid;gap:.55rem;margin-top:1rem}.day-live-time>div{display:grid;gap:.3rem}.day-live-time__label{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.83rem}.day-live-time__label small{color:#64748b}.day-live-track{height:.55rem;border-radius:999px;background:#e2e8f0;overflow:hidden}.day-live-track i{display:block;width:var(--time-width);height:100%;border-radius:inherit;background:linear-gradient(90deg,#2563eb,#60a5fa)}.day-live-activities{display:grid;gap:.2rem;margin-top:1rem}.day-live-activities>div{display:grid;grid-template-columns:auto 1fr auto auto;gap:.6rem;align-items:center;padding:.62rem 0;border-bottom:1px solid rgba(148,163,184,.22)}.day-live-activities>div:last-child{border-bottom:0}.day-live-activities small{color:#64748b}.day-live-activities [data-state=active]{color:#059669}.day-live-context{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin-bottom:1.15rem}.day-live-context article{padding:1rem;border:1px solid rgba(148,163,184,.25);border-radius:1.1rem;background:rgba(255,255,255,.88)}.day-live-context h3{margin:0;color:#0f172a}.day-live-context p{margin:.45rem 0 0!important;color:#64748b!important;font-size:.84rem;line-height:1.5}.day-live-pair{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;margin-top:.8rem}.day-live-pair div{padding:.65rem;border-radius:.75rem;background:#f8fafc}.day-live-pair span{display:block;color:#64748b;font-size:.7rem;text-transform:uppercase}.day-live-pair strong{display:block;margin-top:.18rem;font-size:1.25rem}.day-live-meals{display:grid;gap:.35rem;margin-top:.7rem}.day-live-meals div{display:flex;justify-content:space-between;gap:.5rem;padding:.35rem 0;border-bottom:1px solid rgba(148,163,184,.2);font-size:.8rem}.day-live-meals div:last-child{border-bottom:0}.day-live-pills{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.65rem}.day-live-pills span{padding:.28rem .48rem;border-radius:999px;background:#dbeafe;color:#1d4ed8;font-size:.68rem;font-weight:750}.day-live-comparison{display:grid;gap:.4rem;margin-top:1rem}.day-live-comparison>div{display:grid;grid-template-columns:1fr auto minmax(7rem,auto);gap:.6rem;padding:.6rem 0;border-bottom:1px solid rgba(148,163,184,.22)}.day-live-comparison small{color:#64748b;text-align:right}.same-date-card dl{display:grid;grid-template-columns:repeat(2,1fr);gap:.4rem;margin:.65rem 0 0}.same-date-card dt{color:#64748b;font-size:.68rem}.same-date-card dd{margin:0;font-weight:750}.day-live-error{margin:0 0 1rem;padding:.8rem 1rem;border:1px solid rgba(220,38,38,.25);border-radius:.9rem;background:#fee2e2;color:#991b1b;font-weight:700}
  @media(max-width:900px){.daily-live-summary,.day-live-context{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.daily-live-summary,.day-live-context{grid-template-columns:1fr}.day-live-activities>div{grid-template-columns:auto 1fr auto}.day-live-activities small{grid-column:2/-1}.day-live-comparison>div{grid-template-columns:1fr auto}.day-live-comparison small{grid-column:1/-1;text-align:left}}
