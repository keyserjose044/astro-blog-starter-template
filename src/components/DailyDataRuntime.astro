<script>
  import { getDailyMeta, getDay, getSameDate, getSeries, getYear } from '../utils/dailyData';
  import type { DailyMeta, DailyRecord, DailySeriesPoint } from '../utils/dailyData';

  const MIN_DATE = '2023-01-01';
  const RUN_MINUTES_PER_MILE = 10;
  const parseIso = (value: string) => new Date(`${value}T12:00:00`);
  const toIso = (date: Date) => `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
  const longDate = (value: string) => new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).format(parseIso(value));
  const shortDate = (value: string) => new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric'}).format(parseIso(value));
  const number = (value: number|null, digits=0) => value===null||!Number.isFinite(value)?'—':new Intl.NumberFormat('en-US',{maximumFractionDigits:digits}).format(value);
  const dayOfYear = (date: Date) => Math.floor((date.getTime()-new Date(date.getFullYear(),0,0,12).getTime())/86400000);
  const yearDays = (year:number) => new Date(year,1,29).getMonth()===1?366:365;
  const fromDay = (year:number,day:number) => {const d=new Date(year,0,1,12);d.setDate(day);return d;};
  const avg = (values:Array<number|null>) => {const valid=values.filter((v):v is number=>v!==null&&Number.isFinite(v));return valid.length?valid.reduce((a,b)=>a+b,0)/valid.length:null;};
  const text = (root:ParentNode,selector:string,value:string) => {const node=root.querySelector(selector);if(node)node.textContent=value;};
  const waitFor = async (selector:string, attempts=80):Promise<HTMLElement|null> => {
    for(let i=0;i<attempts;i+=1){const node=document.querySelector(selector);if(node instanceof HTMLElement)return node;await new Promise(r=>setTimeout(r,25));}
    return null;
  };

  const metricMap = {
    guitar:{api:'guitarMinutes',label:'Guitar',unit:'minutes',digits:0},
    audiobooks:{api:'audiobookMinutes',label:'Audiobooks',unit:'minutes',digits:0},
    running:{api:'runningMiles',label:'Running',unit:'miles',digits:1},
    diary:{api:'diaryWords',label:'Diary',unit:'words',digits:0},
  } as const;
  type MetricKey=keyof typeof metricMap;

  async function initStats(){
    const dashboard=document.querySelector('.stats-dashboard');
    if(!(dashboard instanceof HTMLElement)||dashboard.dataset.dailyLive==='true')return;
    dashboard.dataset.dailyLive='true';
    const preview=await waitFor('.stats-dashboard .daily-preview');
    const mode=await waitFor('.stats-dashboard .daily-mode');
    let meta:DailyMeta|null=null;
    try{
      meta=await getDailyMeta();
      const date=meta.latestCompleteDate||meta.dataThrough;
      if(date&&preview){
        const record=await getDay(date);
        const pieces=longDate(record.date).split(', ');
        text(preview,'[data-daily-preview-weekday]',pieces[0]||'Archive day');
        text(preview,'[data-daily-preview-date]',pieces.slice(1).join(', '));
        const values=[number(record.sleep.hours,1),number(record.hobbies.guitarMinutes),number(record.hobbies.totalDistanceMiles,1),number(record.diary.words)];
        preview.querySelectorAll('.daily-preview__metrics strong').forEach((node,index)=>node.textContent=values[index]||'—');
        text(preview,'.daily-preview__date p',record.status==='complete'?'Latest completed public-safe Archive record.':'Latest record is partial; missing values remain blank.');
        const status=preview.querySelector('.daily-preview__status');
        if(status instanceof HTMLElement){status.dataset.state='live';status.replaceChildren();const dot=document.createElement('span');dot.setAttribute('aria-hidden','true');status.append(dot,document.createTextNode(' Live daily archive'));}
        const link=preview.querySelector('a');if(link instanceof HTMLAnchorElement){link.href=`/day/?date=${record.date}`;if(link.firstChild)link.firstChild.textContent='Open this day ';}
      }
    }catch(error){if(preview)text(preview,'.daily-preview__date p',error instanceof Error?error.message:'Daily archive unavailable.');}
    if(!mode)return;
    mode.innerHTML=`<div class="daily-mode__topline"><div><p class="daily-mode__eyebrow">Daily archive view</p><h3 data-live-title>Daily values</h3><p class="daily-mode__lede">Each mark is one actual Archive day. Missing values remain distinct from recorded zeroes.</p></div><span class="daily-mode__badge" data-live-status>Ready</span></div><div class="daily-live-controls"><div><label>Range</label><div class="daily-live-buttons" data-range><button data-value="30">30 days</button><button class="is-active" data-value="90">90 days</button><button data-value="ytd">Year to date</button><button data-value="year">Full year</button></div></div><div><label>Chart</label><div class="daily-live-buttons" data-chart-type><button class="is-active" data-value="timeline">Timeline</button><button data-value="calendar">Calendar</button></div></div></div><div class="daily-live-summary"><article><span>Period total</span><strong data-total>—</strong></article><article><span>Average logged day</span><strong data-average>—</strong></article><article><span>Peak day</span><strong data-peak>—</strong></article><article><span>Active days</span><strong data-active>—</strong></article></div><div class="daily-live-chart-shell"><div class="daily-live-chart-head"><div><strong data-chart-title>Daily chart</strong><span data-period></span></div><span data-unit></span></div><div class="daily-live-chart" data-chart><div class="daily-live-empty">Choose Daily to load the archive.</div></div></div><div class="daily-preview__footer"><p data-updated>Daily metadata loaded.</p><a href="/day/">Open the full Day Explorer <span aria-hidden="true">→</span></a></div>`;
    let range='90',chartType='timeline',request=0;
    const currentMetric=():MetricKey=>{const raw=dashboard.querySelector('.metric-tab--active')?.getAttribute('data-metric')||'guitar';return raw in metricMap?raw as MetricKey:'guitar';};
    const currentYear=()=>{const selected=Number((dashboard.querySelector('#graph-year') as HTMLSelectElement|null)?.value);if(meta?.availableYears.includes(selected))return selected;return Number((meta?.latestCompleteDate||meta?.dataThrough||'').slice(0,4))||new Date().getFullYear();};
    const render=async()=>{
      if(mode.hidden)return;const requestId=++request;const host=mode.querySelector('[data-chart]');if(!(host instanceof HTMLElement))return;host.innerHTML='<div class="daily-live-empty">Loading daily values…</div>';text(mode,'[data-live-status]','Loading…');
      try{
        meta=meta||await getDailyMeta();const key=currentMetric(),config=metricMap[key],year=currentYear();let points=await getSeries(config.api,year);if(requestId!==request)return;
        if(range==='30'||range==='90'){const end=points.length?parseIso(points[points.length-1].date):new Date();const start=new Date(end);start.setDate(start.getDate()-Number(range)+1);points=points.filter(p=>parseIso(p.date)>=start);}
        if(range==='ytd'&&meta.dataThrough){const cutoff=`${year}${meta.dataThrough.slice(4)}`;points=points.filter(p=>p.date<=cutoff);}
        const values=points.map(p=>p.value).filter((v):v is number=>v!==null&&Number.isFinite(v));const total=values.reduce((a,b)=>a+b,0),average=values.length?total/values.length:null;const peak=points.reduce<DailySeriesPoint|null>((best,p)=>p.value===null?best:!best||best.value===null||p.value>best.value?p:best,null);const active=values.filter(v=>v>0).length;
        text(mode,'[data-live-title]',`${config.label} by day`);text(mode,'[data-chart-title]',`${config.label} · ${year}`);text(mode,'[data-unit]',config.unit);text(mode,'[data-period]',points.length?`${shortDate(points[0].date)}–${shortDate(points[points.length-1].date)}`:String(year));text(mode,'[data-total]',`${number(total,config.digits)} ${config.unit}`);text(mode,'[data-average]',`${number(average,config.digits)} ${config.unit}`);text(mode,'[data-peak]',peak&&peak.value!==null?`${number(peak.value,config.digits)} · ${shortDate(peak.date)}`:'—');text(mode,'[data-active]',`${active} of ${points.length}`);text(mode,'[data-live-status]',`${points.length} days`);text(mode,'[data-updated]',meta.updatedAt?`Archive refreshed ${new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(new Date(meta.updatedAt))}.`:'Live daily archive.');
        if(!points.length){host.innerHTML='<div class="daily-live-empty">No daily records are available for this period.</div>';return;}
        const max=Math.max(0,...points.map(p=>p.value||0));
        if(chartType==='calendar'){
          const grid=document.createElement('div');grid.className='daily-live-calendar';const first=parseIso(points[0].date).getDay();for(let i=0;i<first;i++){const blank=document.createElement('span');blank.className='daily-live-cell';blank.style.visibility='hidden';grid.append(blank);}points.forEach(p=>{const cell=document.createElement('a');cell.className='daily-live-cell';cell.href=`/day/?date=${p.date}`;if(p.value===null)cell.classList.add('is-missing');else{const level=p.value<=0?0:Math.min(4,Math.max(1,Math.ceil((max?p.value/max:0)*4)));cell.classList.add(`level-${level}`);}cell.title=`${longDate(p.date)}: ${p.value===null?'not logged':`${number(p.value,config.digits)} ${config.unit}`}`;grid.append(cell);});host.replaceChildren(grid);
        }else{
          const bars=document.createElement('div');bars.className='daily-live-bars';bars.style.gridTemplateColumns=`repeat(${points.length},minmax(6px,1fr))`;bars.style.setProperty('--chart-width',`${Math.max(760,points.length*11)}px`);points.forEach(p=>{const bar=document.createElement('a');bar.className='daily-live-bar';bar.href=`/day/?date=${p.date}`;if(p.value===null)bar.classList.add('is-missing');else if(p.value===0)bar.classList.add('is-zero');bar.style.setProperty('--bar-height',`${p.value===null||max<=0?0:Math.max(2,p.value/max*100)}%`);bar.title=`${longDate(p.date)}: ${p.value===null?'not logged':`${number(p.value,config.digits)} ${config.unit}`}`;bars.append(bar);});host.replaceChildren(bars);
        }
      }catch(error){host.textContent=error instanceof Error?error.message:'Daily chart unavailable.';text(mode,'[data-live-status]','Unavailable');}
    };
    mode.querySelectorAll('[data-range] button').forEach(button=>button.addEventListener('click',()=>{range=(button as HTMLElement).dataset.value||'90';mode.querySelectorAll('[data-range] button').forEach(b=>b.classList.remove('is-active'));button.classList.add('is-active');render();}));
    mode.querySelectorAll('[data-chart-type] button').forEach(button=>button.addEventListener('click',()=>{chartType=(button as HTMLElement).dataset.value||'timeline';mode.querySelectorAll('[data-chart-type] button').forEach(b=>b.classList.remove('is-active'));button.classList.add('is-active');render();}));
    dashboard.querySelectorAll('[data-metric]').forEach(button=>button.addEventListener('click',()=>setTimeout(render,0)));dashboard.querySelector('#graph-year')?.addEventListener('change',render);new MutationObserver(()=>{if(!mode.hidden)render();}).observe(mode,{attributes:true,attributeFilter:['hidden']});
  }

  async function initDay(){
    const root=document.querySelector('[data-day-explorer]');if(!(root instanceof HTMLElement)||root.dataset.dailyLive==='true')return;root.dataset.dailyLive='true';
    const input=root.querySelector('#day-date'),prev=root.querySelector('[data-day-previous]'),next=root.querySelector('[data-day-next]'),today=root.querySelector('[data-day-today]'),random=root.querySelector('[data-day-random]');if(!(input instanceof HTMLInputElement))return;
    const toolbar=root.querySelector('.day-toolbar');if(!(toolbar instanceof HTMLElement))return;
    const yearLabel=document.createElement('label');yearLabel.className='day-live-year';yearLabel.innerHTML='<span>Year</span><select aria-label="Choose archive year"></select>';const yearSelect=yearLabel.querySelector('select')!;toolbar.insertBefore(yearLabel,today);
    const latest=document.createElement('button');latest.type='button';latest.className='day-action-button';latest.textContent='Latest complete';toolbar.insertBefore(latest,today);
    const scrub=document.createElement('section');scrub.className='day-live-scrubber';scrub.innerHTML='<div class="day-live-scrubber__head"><div><span>Year timeline</span><strong data-scrub-label>Archive year</strong></div><output data-scrub-output>—</output></div><input type="range" min="1" max="365" value="1" aria-label="Day of selected year">';toolbar.after(scrub);const slider=scrub.querySelector('input')!;
    const heroText=root.querySelector('.day-hero__lede');if(heroText)heroText.textContent='Move through the public-safe layer of the archive one day at a time. Private notes, people, places, and exact meals remain outside this feed.';
    const heroStatus=root.querySelector('.day-hero__status');const statusLabel=()=>heroStatus?.lastChild;
    const setStatus=(value:string,state:string)=>{if(heroStatus instanceof HTMLElement){heroStatus.dataset.state=state;if(statusLabel())statusLabel()!.textContent=` ${value}`;}};
    const error=document.createElement('div');error.className='day-live-error';error.hidden=true;scrub.after(error);
    let meta:DailyMeta|null=null,current:DailyRecord|null=null,token=0;const years=new Map<number,DailyRecord[]>();
    const setError=(value='')=>{error.hidden=!value;error.textContent=value;};
    const setCard=(index:number,value:number|null,note:string,digits=0)=>{const card=root.querySelectorAll('.day-metric-card')[index];if(!card)return;text(card,'strong',number(value,digits));text(card,'small',value===null?'Not available':note);};
    const loadYear=async(year:number)=>{if(!years.has(year))years.set(year,await getYear(year));return years.get(year)||[];};
    const renderContext=(record:DailyRecord)=>{
      let context=root.querySelector('.day-live-context');if(!context){context=document.createElement('section');context.className='day-live-context';const firstGrid=root.querySelector('.day-grid-two');firstGrid?.after(context);}
      const meal=(type:string|null)=>type?({ordinary:'Ordinary',restaurant:'Ate out',provided:'Provided',skipped:'Skipped'}[type]||type):'—';const event=record.dayEvent==='positive'?['★ Positive','Triumph or good event marker']:record.dayEvent==='negative'?['! Negative','Failure, defeat, or bad-event marker']:['○ Unclassified','No positive or negative marker'];const flags=record.weather.flags.length?record.weather.flags.join(' · '):'No temperature flags';
      context.innerHTML=`<article><p class="day-eyebrow">Weather</p><h3>Temperature</h3><div class="day-live-pair"><div><span>High</span><strong>${record.weather.highF===null?'—':`${number(record.weather.highF)}°F`}</strong></div><div><span>Low</span><strong>${record.weather.lowF===null?'—':`${number(record.weather.lowF)}°F`}</strong></div></div><p>${flags}</p></article><article><p class="day-eyebrow">Food pattern</p><h3>Meal categories</h3><div class="day-live-meals"><div><span>Breakfast</span><strong>${meal(record.food.breakfastType)}</strong></div><div><span>Lunch</span><strong>${meal(record.food.lunchType)}</strong></div><div><span>Dinner</span><strong>${meal(record.food.dinnerType)}</strong></div></div></article><article><p class="day-eyebrow">Day marker</p><h3>${event[0]}</h3><p>${event[1]}</p><div class="day-live-pills"><span>${record.status} record</span></div></article><article><p class="day-eyebrow">Audiobook</p><h3>${record.audiobook.title||'No title recorded'}</h3><p>${record.audiobook.minutes===null?'Listening unavailable':`${number(record.audiobook.minutes)} minutes`}${record.audiobook.timestamp?` · ${record.audiobook.timestamp}`:''}</p><div class="day-live-pills">${record.audiobook.started?'<span>New title</span>':''}<span>${record.audiobook.minutes&&record.audiobook.minutes>0?'Listening day':'No listening'}</span></div></article>`;
    };
    const renderTime=(record:DailyRecord)=>{const panel=root.querySelector('.timeline-placeholder');if(!(panel instanceof HTMLElement))return;const values=[['🧠','Work',record.work.hours===null?null:record.work.hours*60],['📚','Audiobooks',record.audiobook.minutes],['🚶','Treadmill',record.hobbies.treadmillMinutes],['🏃','Running estimate',record.hobbies.runningMiles===null?null:record.hobbies.runningMiles*RUN_MINUTES_PER_MILE],['🎸','Guitar',record.hobbies.guitarMinutes],['💃','Dance',record.hobbies.danceMinutes],['🌍','Languages',record.hobbies.languageMinutes]] as const;const max=Math.max(0,...values.map(v=>v[2]||0));panel.className='day-live-time';panel.replaceChildren();values.forEach(([icon,label,value])=>{const row=document.createElement('div');row.innerHTML=`<div class="day-live-time__label"><span>${icon}</span><strong>${label}</strong><small>${value===null?'—':`${number(value)} min`}</small></div><div class="day-live-track"><i style="--time-width:${value===null||max<=0?0:Math.max(2,value/max*100)}%"></i></div>`;panel.append(row);});};
    const renderActivities=(record:DailyRecord)=>{const host=root.querySelector('.habit-placeholder');if(!(host instanceof HTMLElement))return;host.className='day-live-activities';host.replaceChildren();const items=[['📖','Bible reading',record.hobbies.bibleChapter,record.hobbies.bibleChapter||'—'],['🔤','Dictionary',record.hobbies.dictionaryPage,record.hobbies.dictionaryPage===null?'—':`Page ${number(record.hobbies.dictionaryPage)}`],['🌍','Language study',record.hobbies.languageMinutes,record.hobbies.languageMinutes===null?'—':`${number(record.hobbies.languageMinutes)} min`],['🏃','Running',record.hobbies.runningMiles,record.hobbies.runningMiles===null?'—':`${number(record.hobbies.runningMiles,1)} mi`],['🚶','Treadmill',record.hobbies.treadmillMinutes,record.hobbies.treadmillMinutes===null?'—':`${number(record.hobbies.treadmillMinutes)} min`],['🎸','Guitar',record.hobbies.guitarMinutes,record.hobbies.guitarMinutes===null?'—':`${number(record.hobbies.guitarMinutes)} min`],['💃','Dance',record.hobbies.danceMinutes,record.hobbies.danceMinutes===null?'—':`${number(record.hobbies.danceMinutes)} min`],['🎧','Audiobook',record.audiobook.minutes,record.audiobook.minutes===null?'—':`${number(record.audiobook.minutes)} min`]];items.forEach(([icon,label,raw,display])=>{const row=document.createElement('div');const state=raw===null||raw===''?'missing':typeof raw==='number'&&raw===0?'zero':'active';row.innerHTML=`<span>${icon}</span><strong>${label}</strong><span>${display}</span><small data-state="${state}">${state==='active'?'Logged':state==='zero'?'None':'Unavailable'}</small>`;host.append(row);});};
    const renderComparisons=async(record:DailyRecord,request:number)=>{const host=root.querySelector('.comparison-placeholder');if(!(host instanceof HTMLElement))return;host.className='day-live-comparison';host.innerHTML='<p>Loading selected-year baseline…</p>';try{const list=await loadYear(Number(record.date.slice(0,4)));if(request!==token)return;const config=[['Sleep',record.sleep.hours,avg(list.map(r=>r.sleep.hours)),'hr',1],['Work',record.work.hours,avg(list.map(r=>r.work.hours)),'hr',1],['Guitar',record.hobbies.guitarMinutes,avg(list.map(r=>r.hobbies.guitarMinutes)),'min',0],['Movement',record.hobbies.totalDistanceMiles,avg(list.map(r=>r.hobbies.totalDistanceMiles)),'mi',1]] as const;host.replaceChildren();config.forEach(([label,value,baseline,unit,digits])=>{const row=document.createElement('div');const diff=value===null||baseline===null?null:value-baseline;row.innerHTML=`<span>${label}</span><strong>${value===null?'—':`${number(value,digits)} ${unit}`}</strong><small>${diff===null?'No comparison':Math.abs(diff)<.05?'Near year average':`${number(Math.abs(diff),digits)} ${unit} ${diff>0?'above':'below'} average`}</small>`;host.append(row);});}catch(e){host.textContent=e instanceof Error?e.message:'Year comparison unavailable.';}};
    const renderSame=async(record:DailyRecord,request:number)=>{const host=root.querySelector('[data-same-date-grid]');if(!(host instanceof HTMLElement))return;host.textContent='Loading same-date records…';try{const d=parseIso(record.date),list=await getSameDate(d.getMonth()+1,d.getDate());if(request!==token)return;host.replaceChildren();list.forEach(item=>{const button=document.createElement('button');button.type='button';button.className='same-date-card';if(item.date===record.date)button.setAttribute('aria-current','date');button.innerHTML=`<strong>${item.date.slice(0,4)}</strong><span>${item.day||'Day'} · ${item.status}</span><dl><div><dt>Sleep</dt><dd>${item.sleep.hours===null?'—':`${number(item.sleep.hours,1)} hr`}</dd></div><div><dt>Diary</dt><dd>${number(item.diary.words)}</dd></div><div><dt>Movement</dt><dd>${item.hobbies.totalDistanceMiles===null?'—':`${number(item.hobbies.totalDistanceMiles,1)} mi`}</dd></div><div><dt>Guitar</dt><dd>${item.hobbies.guitarMinutes===null?'—':`${number(item.hobbies.guitarMinutes)} min`}</dd></div></dl>`;button.addEventListener('click',()=>setDate(item.date));host.append(button);});}catch(e){host.textContent=e instanceof Error?e.message:'Same-date records unavailable.';}};
    const render=async(record:DailyRecord,request:number)=>{current=record;const formatted=longDate(record.date).split(', ');text(root,'[data-selected-weekday]',formatted[0]||record.day||'Archive day');text(root,'[data-selected-date]',formatted.slice(1).join(', '));const d=parseIso(record.date);text(root,'[data-day-number]',`Day ${dayOfYear(d)} of ${d.getFullYear()}`);const metaLine=root.querySelector('.selected-day__meta span:last-child');if(metaLine)metaLine.textContent=record.status==='complete'?'Complete public-safe record':'Partial public-safe record';text(root,'.selected-day__badge',record.status==='complete'?'Public-safe record':'Partial record');input.value=record.date;yearSelect.value=record.date.slice(0,4);slider.max=String(yearDays(d.getFullYear()));slider.value=String(dayOfYear(d));text(scrub,'[data-scrub-label]',`${d.getFullYear()} archive`);text(scrub,'[data-scrub-output]',`${shortDate(record.date)} · day ${dayOfYear(d)}`);if(prev instanceof HTMLButtonElement)prev.disabled=record.date<=MIN_DATE;if(next instanceof HTMLButtonElement)next.disabled=!meta?.dataThrough||record.date>=meta.dataThrough;setCard(0,record.sleep.hours,record.sleep.category?`${record.sleep.category} sleep`:'Hours logged',1);setCard(1,record.work.hours,record.work.category?`${record.work.category} work`:'Hours logged',1);setCard(2,record.hobbies.guitarMinutes,'Practice logged');setCard(3,record.hobbies.totalDistanceMiles,'Running + treadmill miles',1);setCard(4,record.audiobook.minutes,record.audiobook.started?'New title started':'Listening logged');setCard(5,record.diary.words,'Words written');renderTime(record);renderActivities(record);renderContext(record);renderComparisons(record,request);renderSame(record,request);const notes=root.querySelector('.notes-placeholder');if(notes){text(notes,'strong',record.public?.summary?'Public summary':'No public summary is available for this date.');text(notes,'p',record.public?.summary||'The private Summary of the Day is never sent to this page. A separate curated summary can appear here later.');}const url=new URL(location.href);url.searchParams.set('date',record.date);history.replaceState({},'',url);};
    const setDate=async(value:string)=>{if(!meta)return;const date=value<MIN_DATE?MIN_DATE:meta.dataThrough&&value>meta.dataThrough?meta.dataThrough:value;const request=++token;setError();setStatus('Loading selected day…','loading');root.setAttribute('aria-busy','true');try{const record=await getDay(date);if(request!==token)return;await render(record,request);setStatus(record.status==='complete'?'Live daily record':'Live partial record','live');}catch(e){if(request!==token)return;setError(e instanceof Error?e.message:'Daily record unavailable.');setStatus('Daily record unavailable','error');}finally{if(request===token)root.setAttribute('aria-busy','false');}};
    const move=(amount:number)=>{if(!current||!meta?.dataThrough)return;const d=parseIso(current.date);d.setDate(d.getDate()+amount);const value=toIso(d);if(value>=MIN_DATE&&value<=meta.dataThrough)setDate(value);};
    try{meta=await getDailyMeta();input.max=meta.dataThrough||'';meta.availableYears.forEach(y=>{const o=document.createElement('option');o.value=String(y);o.textContent=String(y);yearSelect.append(o);});input.addEventListener('change',()=>setDate(input.value));prev?.addEventListener('click',()=>move(-1));next?.addEventListener('click',()=>move(1));latest.addEventListener('click',()=>meta?.latestCompleteDate&&setDate(meta.latestCompleteDate));today?.addEventListener('click',()=>meta?.dataThrough&&setDate(meta.dataThrough));random?.addEventListener('click',()=>{if(!meta?.dataThrough)return;const start=parseIso(MIN_DATE).getTime(),days=Math.floor((parseIso(meta.dataThrough).getTime()-start)/86400000),d=new Date(start);d.setDate(d.getDate()+Math.floor(Math.random()*(days+1)));setDate(toIso(d));});yearSelect.addEventListener('change',()=>{if(!current)return;const d=parseIso(current.date),candidate=new Date(Number(yearSelect.value),d.getMonth(),d.getDate(),12);if(candidate.getMonth()!==d.getMonth())candidate.setDate(0);setDate(toIso(candidate));});slider.addEventListener('input',()=>{const d=fromDay(Number(yearSelect.value),Number(slider.value));text(scrub,'[data-scrub-output]',`${shortDate(toIso(d))} · day ${slider.value}`);});slider.addEventListener('change',()=>setDate(toIso(fromDay(Number(yearSelect.value),Number(slider.value)))));const requested=new URL(location.href).searchParams.get('date');const initial=requested&&/^\d{4}-\d{2}-\d{2}$/.test(requested)&&requested>=MIN_DATE&&(!meta.dataThrough||requested<=meta.dataThrough)?requested:meta.latestCompleteDate||meta.dataThrough||MIN_DATE;await setDate(initial);}catch(e){setError(e instanceof Error?e.message:'Daily archive could not be initialized.');setStatus('Daily archive unavailable','error');root.setAttribute('aria-busy','false');}
  }

  const boot=()=>{initStats();initDay();};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
</script>
