    .jose-directory-search{grid-column:auto}
    .jose-directory-status{align-items:flex-start;flex-direction:column}
    .jose-directory-status span{text-align:left}
    .jose-prototype-note{text-align:left}
  }
  @media(prefers-reduced-motion:reduce){.jose-node-float{animation:none}.jose-node-orb,.jose-lines line,.jose-directory-summary-mark{transition:none}}
</style>

<script is:inline data-astro-rerun>
  (() => {
    const section = document.querySelector('[data-jose-constellation]');
    if (!section || section.dataset.joseInitialized === 'true') return;
    section.dataset.joseInitialized = 'true';

    const stage = section.querySelector('[data-jose-stage]');
    const svg = section.querySelector('[data-jose-lines]');
    const signature = section.querySelector('[data-jose-signature]');
    const flourish = section.querySelector('[data-jose-flourish]');
    const slider = section.querySelector('[data-jose-slider]');
    const progressOutput = section.querySelector('[data-jose-progress]');
    const replay = section.querySelector('[data-jose-replay]');
    const shuffleButton = section.querySelector('[data-jose-shuffle]');
    const poolScript = section.querySelector('[data-jose-pool]');
    const cardIcon = section.querySelector('[data-jose-card-icon]');
    const cardCategory = section.querySelector('[data-jose-card-category]');
    const cardTitle = section.querySelector('[data-jose-card-title]');
    const cardInfo = section.querySelector('[data-jose-card-info]');
    const cardClose = section.querySelector('[data-jose-card-close]');
    const searchInput = section.querySelector('[data-jose-search]');
    const typeFilter = section.querySelector('[data-jose-type-filter]');
    const countryFilter = section.querySelector('[data-jose-country-filter]');
    const clearFilters = section.querySelector('[data-jose-clear]');
    const resultCount = section.querySelector('[data-jose-result-count]');
    const noResults = section.querySelector('[data-jose-no-results]');
    const nodes = Array.from(section.querySelectorAll('[data-jose-node]'));
    const outerNodes = nodes.filter((node) => node.dataset.ring === 'outer');
    const lines = Array.from(section.querySelectorAll('[data-from][data-to]'));
    const directoryItems = Array.from(section.querySelectorAll('[data-jose-directory-item]'));
    const featureButtons = Array.from(section.querySelectorAll('[data-feature-person]'));

    if (!stage || !svg || !signature || !flourish || !slider || !progressOutput || !replay || !shuffleButton || !poolScript || !cardIcon || !cardCategory || !cardTitle || !cardInfo || !cardClose || !searchInput || !typeFilter || !countryFilter || !clearFilters || !resultCount || !noResults) return;

    let josePool = [];
    try {
      josePool = JSON.parse(poolScript.textContent || '[]');
    } catch {
      josePool = [];
    }
    if (!josePool.length) return;

    const poolById = new Map(josePool.map((person) => [person.id, person]));
    const nodeBySlotId = new Map(nodes.map((node) => [node.dataset.joseNode, node]));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const easeOut = (value) => 1 - Math.pow(1 - value, 3);
    const normalize = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    let progress = reduceMotion ? 100 : 0;
    let animationFrame = 0;
    let connectorFrame = 0;
    let shuffleTimer = 0;
    let hasAutoPlayed = false;
    let pinnedSlotId = null;
    let featureCursor = 0;

    const defaultCard = () => {
      cardIcon.textContent = '✦';
      cardCategory.textContent = 'Explore the constellation';
      cardTitle.textContent = 'Hover, focus, or tap a José';
      cardInfo.textContent = 'Hover gives you a quick look. Click or tap pins a José here while you explore the rest of the constellation.';
      cardClose.hidden = true;
      nodes.forEach((node) => node.classList.remove('is-active', 'is-pinned'));
      lines.forEach((line) => line.classList.remove('is-active-edge'));
    };

    const showCard = (node, pinned = false) => {
      if (!node) return;
      const slotId = node.dataset.joseNode;
      const orb = node.querySelector('.jose-node-orb');
      cardIcon.textContent = orb ? orb.textContent.trim() : 'J';
      cardCategory.textContent = `${node.dataset.joseType || 'José'} · ${node.dataset.joseCountry || 'Constellation'}`;
      cardTitle.textContent = node.dataset.joseTitle || 'José';
      cardInfo.textContent = node.dataset.joseInfo || '';
      cardClose.hidden = !pinned;

      nodes.forEach((candidate) => {
        candidate.classList.toggle('is-active', candidate === node);
        candidate.classList.toggle('is-pinned', pinned && candidate === node);
      });
      lines.forEach((line) => {
        line.classList.toggle('is-active-edge', line.dataset.from === slotId || line.dataset.to === slotId);
      });
    };

    const setLineGeometry = () => {
      const stageRect = stage.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      if (!stageRect.width || !stageRect.height || !viewBox.width || !viewBox.height) return;
      const scaleX = viewBox.width / stageRect.width;
      const scaleY = viewBox.height / stageRect.height;

      lines.forEach((line) => {
        const fromNode = nodeBySlotId.get(line.dataset.from);
        const toNode = nodeBySlotId.get(line.dataset.to);
        if (!fromNode || !toNode) return;
        const fromOrb = fromNode.querySelector('.jose-node-orb') || fromNode;
        const toOrb = toNode.querySelector('.jose-node-orb') || toNode;
        const fromRect = fromOrb.getBoundingClientRect();
        const toRect = toOrb.getBoundingClientRect();
        line.setAttribute('x1', String((fromRect.left + fromRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y1', String((fromRect.top + fromRect.height / 2 - stageRect.top) * scaleY));
        line.setAttribute('x2', String((toRect.left + toRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y2', String((toRect.top + toRect.height / 2 - stageRect.top) * scaleY));
      });
    };

    const populateNode = (node, person) => {
      if (!node || !person) return;
      const orb = node.querySelector('.jose-node-orb');
      const label = node.querySelector('.jose-node-label');
      node.dataset.personId = person.id;
      node.dataset.joseTitle = person.label;
      node.dataset.joseType = person.type;
      node.dataset.joseCountry = person.country;
      node.dataset.joseInfo = person.info;
      node.setAttribute('aria-label', `Learn about ${person.label}`);
      if (orb) orb.textContent = person.icon;
      if (label) label.textContent = person.label;
    };

    const visibleNodeForPerson = (personId) => nodes.find((node) => node.dataset.personId === personId);

    const updateDirectoryStates = () => {
      const visibleIds = new Set(nodes.map((node) => node.dataset.personId));
      featureButtons.forEach((button) => {
        const personId = button.dataset.featurePerson;
        const visible = visibleIds.has(personId);
        button.dataset.visible = String(visible);
        button.textContent = visible ? 'View above ↑' : 'Put in ring ↑';
      });
    };

    const applyProgress = (rawValue, syncSlider = true) => {
      progress = clamp(Number(rawValue) || 0, 0, 100);
      if (syncSlider) slider.value = String(Math.round(progress));
      progressOutput.textContent = `${Math.round(progress)}%`;

      const signatureProgress = easeOut(clamp(progress / 30));
      signature.style.opacity = signatureProgress > .01 ? '1' : '0';
      signature.style.clipPath = `inset(0 ${100 - signatureProgress * 100}% 0 0)`;
      const flourishProgress = easeOut(clamp((progress - 18) / 22));
      flourish.style.strokeDashoffset = String(1 - flourishProgress);

      nodes.forEach((node) => {
        const start = Number(node.dataset.reveal || 0);
        const local = easeOut(clamp((progress - start) / 7));
        node.style.opacity = String(local);
        node.style.transform = `translate(-50%,-50%) scale(${0.72 + local * 0.28})`;
        node.style.pointerEvents = local > .88 ? 'auto' : 'none';
      });

      lines.forEach((line) => {
        const start = Number(line.dataset.reveal || 0);
        const local = easeOut(clamp((progress - start) / 6));
        const baseOpacity = line.dataset.kind === 'outer' ? .48 : line.dataset.kind === 'spoke' ? .42 : .68;
        line.style.opacity = String(local * baseOpacity);
      });
      requestAnimationFrame(setLineGeometry);
    };

    const stopAnimation = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const animateToFull = () => {
      stopAnimation();
      if (reduceMotion) {
        applyProgress(100);
        return;
      }
      applyProgress(0);
      const startedAt = performance.now();
      const duration = 5200;
      const tick = (now) => {
        const elapsed = clamp((now - startedAt) / duration);
        applyProgress(easeOut(elapsed) * 100);
        if (elapsed < 1) animationFrame = requestAnimationFrame(tick);
        else animationFrame = 0;
      };
      animationFrame = requestAnimationFrame(tick);
    };

    const shuffled = (array) => {
      const copy = [...array];
      for (let index = copy.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
      }
      return copy;
    };

    const diversifiedSample = (count) => {
      const groups = new Map();
      josePool.forEach((person) => {
        if (!groups.has(person.type)) groups.set(person.type, []);
        groups.get(person.type).push(person);
      });
      groups.forEach((group, key) => groups.set(key, shuffled(group)));
      const selected = [];
      let typeOrder = shuffled([...groups.keys()]);
      while (selected.length < count) {
        let advanced = false;
        typeOrder.forEach((type) => {
          if (selected.length >= count) return;
          const group = groups.get(type);
          if (group && group.length) {
            selected.push(group.pop());
            advanced = true;
          }
        });
        if (!advanced) break;
        typeOrder = shuffled(typeOrder);
      }
      return selected;
    };

    const shuffleCast = () => {
      stopAnimation();
      hasAutoPlayed = true;
      pinnedSlotId = null;
      defaultCard();
      if (shuffleTimer) window.clearTimeout(shuffleTimer);
      stage.classList.add('is-shuffling');
      shuffleButton.disabled = true;
      shuffleTimer = window.setTimeout(() => {
        const selection = diversifiedSample(nodes.length);
        selection.forEach((person, index) => populateNode(nodes[index], person));
        applyProgress(100);
        updateDirectoryStates();
        stage.classList.remove('is-shuffling');
        shuffleButton.disabled = false;
      }, reduceMotion ? 0 : 180);
    };

    const startConnectorLoop = () => {
      if (reduceMotion || connectorFrame) return;
      const tick = () => {
        setLineGeometry();
        connectorFrame = requestAnimationFrame(tick);
      };
      connectorFrame = requestAnimationFrame(tick);
    };

    const stopConnectorLoop = () => {
      if (connectorFrame) cancelAnimationFrame(connectorFrame);
      connectorFrame = 0;
    };

    const takeManualControl = () => {
      stopAnimation();
      hasAutoPlayed = true;
    };

    const focusPerson = (personId) => {
      const person = poolById.get(personId);
      if (!person) return;
      let node = visibleNodeForPerson(personId);
      if (!node) {
        node = outerNodes[featureCursor % outerNodes.length];
        featureCursor += 1;
        pinnedSlotId = null;
        populateNode(node, person);
        applyProgress(100);
        updateDirectoryStates();
      }
      pinnedSlotId = node.dataset.joseNode;
      showCard(node, true);
      node.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      window.setTimeout(() => node.focus({ preventScroll: true }), reduceMotion ? 0 : 320);
    };

    const applyDirectoryFilters = () => {
      const query = normalize(searchInput.value);
      const selectedType = typeFilter.value;
      const selectedCountry = countryFilter.value;
      let visible = 0;
      directoryItems.forEach((item) => {
        const matchesQuery = !query || normalize(item.dataset.search).includes(query);
        const matchesType = !selectedType || item.dataset.type === selectedType;
        const matchesCountry = !selectedCountry || item.dataset.country === selectedCountry;
        const matches = matchesQuery && matchesType && matchesCountry;
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      resultCount.textContent = `Showing ${visible} of ${directoryItems.length}`;
      noResults.hidden = visible !== 0;
    };

    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => {
        if (!pinnedSlotId) showCard(node, false);
      });
      node.addEventListener('mouseleave', () => {
        if (!pinnedSlotId) defaultCard();
      });
      node.addEventListener('focus', () => {
        if (!pinnedSlotId) showCard(node, false);
      });
      node.addEventListener('blur', () => {
        if (!pinnedSlotId) defaultCard();
      });
      node.addEventListener('click', () => {
        const slotId = node.dataset.joseNode;
        pinnedSlotId = pinnedSlotId === slotId ? null : slotId;
        if (pinnedSlotId) showCard(node, true);
        else defaultCard();
      });
    });

    featureButtons.forEach((button) => {
      button.addEventListener('click', () => focusPerson(button.dataset.featurePerson));
    });

    cardClose.addEventListener('click', () => {
      pinnedSlotId = null;
      defaultCard();
    });

    slider.addEventListener('pointerdown', takeManualControl);
    slider.addEventListener('touchstart', takeManualControl, { passive: true });
    slider.addEventListener('input', () => {
      takeManualControl();
      applyProgress(slider.value, false);
    });
    slider.addEventListener('change', () => applyProgress(slider.value, false));

    replay.addEventListener('click', () => {
      pinnedSlotId = null;
      defaultCard();
      hasAutoPlayed = true;
      animateToFull();
    });
    shuffleButton.addEventListener('click', shuffleCast);

    searchInput.addEventListener('input', applyDirectoryFilters);
    typeFilter.addEventListener('change', applyDirectoryFilters);
    countryFilter.addEventListener('change', applyDirectoryFilters);
    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      typeFilter.value = '';
      countryFilter.value = '';
      applyDirectoryFilters();
      searchInput.focus();
    });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(setLineGeometry);
      resizeObserver.observe(stage);
    } else {
      window.addEventListener('resize', setLineGeometry, { passive: true });
    }

    defaultCard();
    updateDirectoryStates();
    applyDirectoryFilters();
    applyProgress(progress);
    requestAnimationFrame(setLineGeometry);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startConnectorLoop();
            if (!hasAutoPlayed) {
              hasAutoPlayed = true;
              animateToFull();
            }
          } else {
            stopConnectorLoop();
          }
        });
      }, { threshold: .13 });
      observer.observe(stage);
    } else {
      hasAutoPlayed = true;
      animateToFull();
      startConnectorLoop();
    }
  })();
</script>
