const slots = [
  ...innerSlots.map((slot) => ({ ...slot, ring: 'inner' })),
  ...outerSlots.map((slot) => ({ ...slot, ring: 'outer' })),
];

const initialIds = [
  'jose-jose', 'napoleon', 'carreras', 'marti', 'rizal', 'mourinho', 'feliciano', 'perales', 'saramago', 'san-martin', 'posada', 'orozco', 'cuervo', 'jimenez',
  'ortega', 'jose-andres', 'altuve', 'ferrer', 'capablanca', 'hernandez', 'morelos', 'vasconcelos', 'revueltas', 'moncayo', 'cuevas', 'el-puma', 'mujica', 'abreu', 'bautista', 'joseph', 'yusuf', 'giuseppe',
];

const poolById = new Map(josePool.map((person) => [person.id, person]));
const initialNodes = slots.map((slot, index) => {
  const person = poolById.get(initialIds[index]);
  if (!person) throw new Error(`Missing José entry: ${initialIds[index]}`);
  return { ...slot, person };
});

const nodeReveal = Object.fromEntries(slots.map((slot) => [slot.id, slot.reveal]));
const innerIds = innerSlots.map((slot) => slot.id);
const outerIds = outerSlots.map((slot) => slot.id);
const edges = [];

innerIds.forEach((id, index) => {
  edges.push({ from: id, to: innerIds[(index + 1) % innerIds.length], kind: 'inner' });
  if (index % 3 === 0) edges.push({ from: id, to: innerIds[(index + 2) % innerIds.length], kind: 'inner-secondary' });
});
outerIds.forEach((id, index) => {
  edges.push({ from: id, to: outerIds[(index + 1) % outerIds.length], kind: 'outer' });
});
innerIds.forEach((id, index) => {
  if (index % 2 === 0) {
    const outerIndex = Math.round((index / innerIds.length) * outerIds.length) % outerIds.length;
    edges.push({ from: id, to: outerIds[outerIndex], kind: 'spoke' });
  }
});

const types = [...new Set(josePool.map((person) => person.type))].sort((a, b) => a.localeCompare(b));
const countries = [...new Set(josePool.map((person) => person.country))].sort((a, b) => a.localeCompare(b));
---

<section class="about-section jose-constellation" id="jose-constellation" aria-labelledby="jose-constellation-title" data-jose-constellation>
  <div class="about-section-head jose-constellation-head">
    <p class="about-eyebrow">A name becomes a map</p>
    <h2 id="jose-constellation-title">The José constellation</h2>
    <p>
      My name is hardly mine alone. Two rings show a rotating sample of people, name cousins, and cultural references connected to José; the archive below holds the larger collection.
    </p>
  </div>

  <div class="jose-prototype-badge" aria-label="José constellation archive status">
    <span aria-hidden="true">✦</span> {josePool.length} archived · {slots.length} visible · 2 rings
  </div>

  <div class="jose-stage" data-jose-stage>
    <svg class="jose-lines" viewBox="0 0 1000 760" preserveAspectRatio="none" aria-hidden="true" data-jose-lines>
      {edges.map((edge) => (
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="0"
          data-from={edge.from}
          data-to={edge.to}
          data-kind={edge.kind}
          data-reveal={Math.max(nodeReveal[edge.from], nodeReveal[edge.to]) + 2}
        />
      ))}
    </svg>

    <div class="jose-center" aria-label="A stylized José signature at the center of the constellation">
      <div class="jose-signature" aria-hidden="true">
        <span class="jose-signature-word" data-jose-signature>José</span>
        <svg class="jose-signature-flourish" viewBox="0 0 340 80" aria-hidden="true">
          <path data-jose-flourish pathLength="1" d="M10 40 C72 55, 169 64, 300 28 C326 20, 334 33, 306 45 C274 58, 225 56, 180 51" />
        </svg>
      </div>
      <span class="jose-center-caption">the José at the center</span>
    </div>

    {initialNodes.map((node) => (
      <button
        class="jose-node"
        type="button"
        data-jose-node={node.id}
        data-ring={node.ring}
        data-reveal={node.reveal}
        data-person-id={node.person.id}
        data-jose-title={node.person.label}
        data-jose-type={node.person.type}
        data-jose-country={node.person.country}
        data-jose-info={node.person.info}
        style={`--x:${node.x}%;--y:${node.y}%;--float-delay:${node.floatDelay}s;`}
        aria-label={`Learn about ${node.person.label}`}
      >
        <span class="jose-node-float">
          <span class="jose-node-orb" aria-hidden="true">{node.person.icon}</span>
          <span class="jose-node-label">{node.person.label}</span>
        </span>
      </button>
    ))}
  </div>

  <div class="jose-inspector" data-jose-inspector aria-live="polite">
    <div class="jose-inspector-icon" aria-hidden="true" data-jose-card-icon>✦</div>
    <div class="jose-inspector-copy">
      <span class="jose-inspector-kicker" data-jose-card-category>Explore the constellation</span>
      <strong data-jose-card-title>Hover, focus, or tap a José</strong>
      <p data-jose-card-info>Hover gives you a quick look. Click or tap pins a José here while you explore the rest of the constellation.</p>
    </div>
    <button class="jose-inspector-close" type="button" data-jose-card-close hidden aria-label="Close pinned José information">×</button>
  </div>

  <div class="jose-controls" aria-label="José constellation controls">
    <div class="jose-slider-control">
      <div class="jose-slider-meta">
        <label for="jose-constellation-slider">Build the constellation</label>
        <output for="jose-constellation-slider" data-jose-progress aria-live="polite">0%</output>
      </div>
      <input id="jose-constellation-slider" type="range" min="0" max="100" value="0" step="1" data-jose-slider />
    </div>
    <div class="jose-action-buttons">
      <button class="jose-control-button" type="button" data-jose-replay aria-label="Replay the José constellation animation">↻ Replay</button>
      <button class="jose-control-button jose-shuffle" type="button" data-jose-shuffle aria-label="Shuffle the visible José constellation">⤨ Shuffle cast</button>
    </div>
  </div>

  <details class="jose-directory" data-jose-directory>
    <summary>
      <span>
        <strong>Explore all {josePool.length} Josés</strong>
        <small>Search the starter archive, filter it, or put any entry into the constellation.</small>
      </span>
      <span class="jose-directory-summary-mark" aria-hidden="true">＋</span>
    </summary>

    <div class="jose-directory-body">
      <div class="jose-directory-tools">
        <label class="jose-directory-search">
          <span>Search</span>
          <input type="search" placeholder="José, country, field…" autocomplete="off" data-jose-search />
        </label>
        <label>
          <span>Field</span>
          <select data-jose-type-filter>
            <option value="">All fields</option>
            {types.map((type) => <option value={type}>{type}</option>)}
          </select>
        </label>
        <label>
          <span>Place / language</span>
          <select data-jose-country-filter>
            <option value="">All places</option>
            {countries.map((country) => <option value={country}>{country}</option>)}
          </select>
        </label>
        <button class="jose-directory-clear" type="button" data-jose-clear>Clear</button>
      </div>

      <div class="jose-directory-status">
        <strong data-jose-result-count>Showing {josePool.length} of {josePool.length}</strong>
        <span>Shuffle changes the 32 visible names; this archive remains the source pool.</span>
      </div>

      <div class="jose-directory-grid" data-jose-directory-grid>
        {josePool.map((person) => (
          <article
            class="jose-directory-card"
            data-jose-directory-item
            data-person-id={person.id}
            data-type={person.type}
            data-country={person.country}
            data-search={`${person.label} ${person.type} ${person.country} ${person.info}`}
          >
            <div class="jose-directory-card-head">
              <span class="jose-directory-icon" aria-hidden="true">{person.icon}</span>
              <div>
                <h3>{person.label}</h3>
                <span>{person.type} · {person.country}</span>
              </div>
            </div>
            <p>{person.info}</p>
            <button class="jose-directory-feature" type="button" data-feature-person={person.id}>Put in ring ↑</button>
          </article>
        ))}
      </div>
      <p class="jose-directory-empty" data-jose-no-results hidden>No Josés match those filters yet.</p>
    </div>
  </details>

  <p class="jose-prototype-note">
    Sixty-four is only a seed. The constellation can stay selective even if the archive eventually grows into hundreds or thousands of names.
  </p>

  <script is:inline type="application/json" data-jose-pool set:html={JSON.stringify(josePool)}></script>
</section>

<style>
  .jose-constellation{position:relative}
  .jose-constellation-head{margin-bottom:1rem}
