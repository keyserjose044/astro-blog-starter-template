---
const nodes = [
  { id: 'jose-jose', label: 'José José', icon: '🎙️', x: 12, y: 20, mx: 18, my: 10, reveal: 17, floatDelay: -0.6 },
  { id: 'napoleon', label: 'José María Napoleón', icon: '🎵', x: 35, y: 9, mx: 72, my: 9, reveal: 24, floatDelay: -2.2 },
  { id: 'marti', label: 'José Martí', icon: '✒️', x: 66, y: 11, mx: 88, my: 27, reveal: 31, floatDelay: -1.1 },
  { id: 'rizal', label: 'José Rizal', icon: '📚', x: 88, y: 24, mx: 84, my: 47, reveal: 39, floatDelay: -3.5 },
  { id: 'feliciano', label: 'José Feliciano', icon: '🎸', x: 92, y: 57, mx: 88, my: 68, reveal: 48, floatDelay: -1.8 },
  { id: 'saramago', label: 'José Saramago', icon: '📖', x: 80, y: 82, mx: 72, my: 89, reveal: 58, floatDelay: -4.1 },
  { id: 'posada', label: 'José G. Posada', icon: '🖋️', x: 54, y: 91, mx: 39, my: 91, reveal: 67, floatDelay: -2.8 },
  { id: 'joseph', label: 'Joseph', icon: '📜', x: 27, y: 86, mx: 14, my: 81, reveal: 75, floatDelay: -0.9 },
  { id: 'yusuf', label: 'Yusuf', icon: '◈', x: 8, y: 70, mx: 10, my: 59, reveal: 83, floatDelay: -3.2 },
  { id: 'giuseppe', label: 'Giuseppe', icon: 'G', x: 6, y: 43, mx: 14, my: 35, reveal: 90, floatDelay: -1.5 },
];

const nodeReveal = Object.fromEntries(nodes.map((node) => [node.id, node.reveal]));
const edges = [
  ['jose-jose', 'napoleon'],
  ['napoleon', 'marti'],
  ['marti', 'rizal'],
  ['rizal', 'feliciano'],
  ['feliciano', 'saramago'],
  ['saramago', 'posada'],
  ['posada', 'joseph'],
  ['joseph', 'yusuf'],
  ['yusuf', 'giuseppe'],
  ['giuseppe', 'jose-jose'],
  ['jose-jose', 'joseph'],
  ['napoleon', 'posada'],
  ['marti', 'saramago'],
  ['rizal', 'posada'],
  ['giuseppe', 'napoleon'],
];
---

<section class="about-section jose-constellation" id="jose-constellation" aria-labelledby="jose-constellation-title" data-jose-constellation>
  <div class="about-section-head jose-constellation-head">
    <p class="about-eyebrow">A name becomes a map</p>
    <h2 id="jose-constellation-title">The José constellation</h2>
    <p>
      My name is hardly mine alone. This is a playful orbit of other Josés and close name cousins around the signature that makes this one mine.
    </p>
  </div>

  <div class="jose-prototype-badge" aria-label="Prototype using placeholder portraits">
    <span aria-hidden="true">✦</span> Prototype · placeholder portraits
  </div>

  <div class="jose-stage" data-jose-stage>
    <svg class="jose-lines" viewBox="0 0 1000 620" preserveAspectRatio="none" aria-hidden="true" data-jose-lines>
      {edges.map(([from, to]) => (
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="0"
          data-from={from}
          data-to={to}
          data-reveal={Math.max(nodeReveal[from], nodeReveal[to]) + 3}
        />
      ))}
    </svg>

    <div class="jose-center" aria-label="A stylized José signature at the center of the constellation">
      <div class="jose-signature" aria-hidden="true">
        <span class="jose-signature-word" data-jose-signature>José</span>
        <svg class="jose-signature-flourish" viewBox="0 0 260 58" aria-hidden="true">
          <path data-jose-flourish pathLength="1" d="M18 34 C70 50, 144 53, 232 23 C246 18, 247 36, 222 41" />
        </svg>
      </div>
      <span class="jose-center-caption">the José at the center</span>
    </div>

    {nodes.map((node) => (
      <div
        class="jose-node"
        data-jose-node={node.id}
        data-reveal={node.reveal}
        style={`--x:${node.x}%;--y:${node.y}%;--mx:${node.mx}%;--my:${node.my}%;--float-delay:${node.floatDelay}s;`}
        title={`Placeholder for ${node.label}`}
      >
        <div class="jose-node-float">
          <span class="jose-node-orb" aria-hidden="true">{node.icon}</span>
          <span class="jose-node-label">{node.label}</span>
          <span class="jose-node-placeholder">placeholder</span>
        </div>
      </div>
    ))}
  </div>

  <div class="jose-controls" aria-label="José constellation animation controls">
    <div class="jose-slider-control">
      <div class="jose-slider-meta">
        <label for="jose-constellation-slider">Build the constellation</label>
        <output for="jose-constellation-slider" data-jose-progress>0%</output>
      </div>
      <input id="jose-constellation-slider" type="range" min="0" max="100" value="0" step="1" data-jose-slider />
    </div>
    <button class="jose-replay" type="button" data-jose-replay aria-label="Replay the José constellation animation">↻ Replay</button>
  </div>

  <p class="jose-prototype-note">
    The icons are stand-ins for now. Later each node can become a real portrait, cutout, object, or symbol while keeping this same orbiting web.
  </p>
</section>

<style>
  .jose-constellation{
    position:relative;
  }
  .jose-constellation-head{
    margin-bottom:1rem;
  }
  .jose-prototype-badge{
    display:flex;
    width:max-content;
    max-width:100%;
    align-items:center;
    gap:.4rem;
    margin:0 auto .8rem;
    padding:.32rem .58rem;
    border:1px solid #d4dfd9;
    border-radius:999px;
    background:var(--as-green-soft,#eaf3ee);
    color:var(--as-green-dark,#174433);
    font-size:.64rem;
    font-weight:850;
    letter-spacing:.055em;
    line-height:1.2;
    text-transform:uppercase;
  }
  .jose-stage{
    position:relative;
    min-height:clamp(530px,58vw,640px);
    overflow:hidden;
    border:1px solid var(--as-border,#dfe3e7);
    border-radius:28px;
    background:
      radial-gradient(circle at 50% 48%,rgba(36,92,70,.095),transparent 24%),
      radial-gradient(circle at 82% 18%,rgba(154,106,63,.09),transparent 20%),
      linear-gradient(145deg,#fbfcfb,#fff 58%,#f7f8f6);
    box-shadow:0 12px 34px rgba(25,33,44,.06);
    isolation:isolate;
  }
  .jose-stage::before{
    position:absolute;
    inset:0;
    z-index:-1;
    opacity:.28;
    background-image:radial-gradient(circle,rgba(36,92,70,.32) 1px,transparent 1.5px);
    background-size:38px 38px;
    content:'';
    mask-image:radial-gradient(circle at 50% 50%,#000,transparent 78%);
  }
  .jose-lines{
    position:absolute;
    inset:0;
    z-index:1;
    width:100%;
    height:100%;
    pointer-events:none;
  }
  .jose-lines line{
    opacity:0;
    stroke:rgba(36,92,70,.42);
    stroke-width:1.35;
    stroke-dasharray:7 10;
    stroke-linecap:round;
    vector-effect:non-scaling-stroke;
  }
  .jose-center{
    position:absolute;
    top:50%;
    left:51%;
    z-index:3;
    display:flex;
    width:min(38%,430px);
    min-width:260px;
    transform:translate(-50%,-50%);
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    pointer-events:none;
  }
  .jose-signature{
    position:relative;
    width:100%;
    padding:.35rem .6rem 1rem;
    transform:rotate(-4deg);
  }
  .jose-signature-word{
    display:inline-block;
    opacity:0;
    clip-path:inset(0 100% 0 0);
    color:var(--as-green-dark,#174433);
    font-family:"Segoe Script","Brush Script MT","Lucida Handwriting","URW Chancery L",cursive;
    font-size:clamp(4.25rem,8.2vw,7.25rem);
    font-style:italic;
    font-weight:500;
    letter-spacing:-.1em;
    line-height:.95;
    white-space:nowrap;
    text-shadow:0 2px 0 rgba(255,255,255,.75);
  }
  .jose-signature-flourish{
    position:absolute;
    right:-3%;
    bottom:-.05rem;
    left:-2%;
    width:105%;
    height:3rem;
    overflow:visible;
  }
  .jose-signature-flourish path{
    fill:none;
    stroke:var(--as-green-dark,#174433);
    stroke-width:2.2;
    stroke-linecap:round;
    stroke-dasharray:1;
    stroke-dashoffset:1;
    vector-effect:non-scaling-stroke;
  }
  .jose-center-caption{
    margin-top:.15rem;
    color:var(--as-muted,#5c626c);
    font-size:.64rem;
    font-weight:800;
    letter-spacing:.09em;
    text-transform:uppercase;
  }
  .jose-node{
    position:absolute;
    top:var(--y);
    left:var(--x);
    z-index:4;
    width:98px;
    opacity:0;
    transform:translate(-50%,-50%) scale(.68);
    transform-origin:center;
    text-align:center;
    will-change:transform,opacity;
  }
  .jose-node-float{
    display:flex;
    flex-direction:column;
    align-items:center;
    animation:jose-node-float 5.8s ease-in-out infinite;
    animation-delay:var(--float-delay);
  }
  .jose-node-orb{
    display:grid;
    width:64px;
    height:64px;
    place-items:center;
    border:1px solid rgba(36,92,70,.22);
    border-radius:50%;
    background:rgba(255,255,255,.96);
    box-shadow:0 8px 20px rgba(25,33,44,.09),0 0 0 5px rgba(234,243,238,.58);
    color:var(--as-green-dark,#174433);
    font-family:Georgia,"Times New Roman",serif;
    font-size:1.4rem;
    font-weight:800;
    transition:transform 180ms ease,box-shadow 180ms ease,border-color 180ms ease;
  }
  .jose-node:hover .jose-node-orb{
    transform:scale(1.08);
    border-color:rgba(36,92,70,.45);
    box-shadow:0 10px 24px rgba(25,33,44,.12),0 0 0 6px rgba(234,243,238,.8);
  }
  .jose-node-label{
    display:block;
    max-width:98px;
    margin-top:.42rem;
    color:var(--as-ink,#17191d);
    font-size:.7rem;
    font-weight:850;
    line-height:1.12;
  }
  .jose-node-placeholder{
    display:block;
    margin-top:.18rem;
    color:var(--as-muted,#5c626c);
    font-size:.5rem;
    font-weight:750;
    letter-spacing:.07em;
    line-height:1;
    text-transform:uppercase;
  }
  .jose-controls{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:.8rem 1rem;
    max-width:800px;
    margin:1rem auto 0;
    align-items:end;
  }
  .jose-slider-control{
    min-width:0;
  }
  .jose-slider-meta{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    margin-bottom:.3rem;
  }
  .jose-slider-meta label{
    color:var(--as-ink,#17191d);
    font-size:.76rem;
    font-weight:850;
  }
  .jose-slider-meta output{
    color:var(--as-green-dark,#174433);
    font-size:.7rem;
    font-weight:850;
    font-variant-numeric:tabular-nums;
  }
  .jose-slider-control input[type="range"]{
    width:100%;
    margin:0;
    accent-color:var(--as-green,#245c46);
    cursor:ew-resize;
  }
  .jose-replay{
    min-height:40px;
    padding:.58rem .78rem;
    border:1px solid #ccd3d8;
    border-radius:10px;
    background:#fff;
    color:var(--as-green-dark,#174433);
    font:inherit;
    font-size:.74rem;
    font-weight:850;
    cursor:pointer;
  }
  .jose-replay:hover{
    border-color:#aebcb4;
    background:var(--as-green-soft,#eaf3ee);
  }
  .jose-replay:focus-visible,
  .jose-slider-control input:focus-visible{
    outline:3px solid #f0b84b;
    outline-offset:3px;
  }
  .jose-prototype-note{
    max-width:720px;
    margin:.72rem auto 0!important;
    color:var(--as-muted,#5c626c)!important;
    font-size:.72rem;
    line-height:1.45;
    text-align:center;
  }
  @keyframes jose-node-float{
    0%,100%{transform:translate3d(0,-2px,0) rotate(-.8deg)}
    50%{transform:translate3d(2px,3px,0) rotate(.8deg)}
  }
  @media(max-width:760px){
    .jose-stage{
      min-height:760px;
      border-radius:22px;
    }
    .jose-stage::before{
      background-size:32px 32px;
    }
    .jose-center{
      top:50%;
      left:51%;
      width:48%;
      min-width:170px;
    }
    .jose-signature-word{
      font-size:clamp(3.25rem,16vw,5rem);
    }
    .jose-node{
      top:var(--my);
      left:var(--mx);
      width:82px;
    }
    .jose-node-orb{
      width:52px;
      height:52px;
      font-size:1.08rem;
      box-shadow:0 6px 16px rgba(25,33,44,.08),0 0 0 4px rgba(234,243,238,.62);
    }
    .jose-node-label{
      max-width:82px;
      font-size:.62rem;
    }
    .jose-node-placeholder{
      font-size:.44rem;
    }
  }
  @media(max-width:560px){
    .jose-constellation-head{
      text-align:left;
    }
    .jose-prototype-badge{
      margin-left:0;
    }
    .jose-stage{
      min-height:720px;
    }
    .jose-controls{
      grid-template-columns:1fr;
    }
    .jose-replay{
      width:max-content;
    }
    .jose-prototype-note{
      text-align:left;
    }
  }
  @media(prefers-reduced-motion:reduce){
    .jose-node-float{
      animation:none;
    }
    .jose-node-orb{
      transition:none;
    }
  }
</style>

<script>
  const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
  const easeOut = (value) => 1 - Math.pow(1 - value, 3);

  document.querySelectorAll('[data-jose-constellation]').forEach((section) => {
    const stage = section.querySelector('[data-jose-stage]');
    const svg = section.querySelector('[data-jose-lines]');
    const signature = section.querySelector('[data-jose-signature]');
    const flourish = section.querySelector('[data-jose-flourish]');
    const slider = section.querySelector('[data-jose-slider]');
    const progressOutput = section.querySelector('[data-jose-progress]');
    const replay = section.querySelector('[data-jose-replay]');
    const nodes = Array.from(section.querySelectorAll('[data-jose-node]'));
    const lines = Array.from(section.querySelectorAll('[data-from][data-to]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!stage || !svg || !signature || !flourish || !slider || !progressOutput || !replay) return;

    let animationFrame = 0;
    let connectorFrame = 0;
    let hasPlayed = false;

    const setLineGeometry = () => {
      const stageRect = stage.getBoundingClientRect();
      if (!stageRect.width || !stageRect.height) return;

      const viewBox = svg.viewBox.baseVal;
      const scaleX = viewBox.width / stageRect.width;
      const scaleY = viewBox.height / stageRect.height;

      lines.forEach((line) => {
        const fromNode = section.querySelector(`[data-jose-node="${line.dataset.from}"]`);
        const toNode = section.querySelector(`[data-jose-node="${line.dataset.to}"]`);
        if (!fromNode || !toNode) return;

        const fromOrb = fromNode.querySelector('.jose-node-orb') || fromNode;
        const toOrb = toNode.querySelector('.jose-node-orb') || toNode;
        const fromRect = fromOrb.getBoundingClientRect();
        const toRect = toOrb.getBoundingClientRect();

        line.setAttribute('x1', String((fromRect.left + fromRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y1', String((fromRect.top + fromRect.height / 2 - stageRect.top) * scaleY));
        line.setAttribute('x2', String((toRect.left + toRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y2', String((toRect.top + toRect.height / 2 - stageRect.top) * scaleY));
      });
    };

    const setProgress = (rawValue) => {
      const value = clamp(Number(rawValue), 0, 100);
      slider.value = String(Math.round(value));
      progressOutput.textContent = `${Math.round(value)}%`;

      const signatureProgress = easeOut(clamp(value / 38));
      signature.style.opacity = signatureProgress > 0.015 ? '1' : '0';
      signature.style.clipPath = `inset(0 ${100 - signatureProgress * 100}% 0 0)`;

      const flourishProgress = easeOut(clamp((value - 24) / 24));
      flourish.style.strokeDashoffset = String(1 - flourishProgress);

      nodes.forEach((node) => {
        const start = Number(node.dataset.reveal || 0);
        const local = easeOut(clamp((value - start) / 10));
        node.style.opacity = String(local);
        node.style.transform = `translate(-50%,-50%) scale(${0.68 + local * 0.32})`;
      });

      lines.forEach((line) => {
        const start = Number(line.dataset.reveal || 0);
        const local = easeOut(clamp((value - start) / 9));
        line.style.opacity = String(local * 0.72);
      });
    };

    const cancelProgressAnimation = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const play = () => {
      cancelProgressAnimation();
      if (reduceMotion) {
        setProgress(100);
        return;
      }

      const duration = 4600;
      const startedAt = performance.now();
      setProgress(0);

      const tick = (now) => {
        const elapsed = clamp((now - startedAt) / duration);
        setProgress(easeOut(elapsed) * 100);
        if (elapsed < 1) animationFrame = requestAnimationFrame(tick);
        else animationFrame = 0;
      };

      animationFrame = requestAnimationFrame(tick);
    };

    const startConnectorLoop = () => {
      if (reduceMotion || connectorFrame) return;
      const tick = () => {
        setLineGeometry();
        connectorFrame = requestAnimationFrame(tick);
      };
      connectorFrame = requestAnimationFrame(tick);
    };

    const stopConnectorLoop = () => {
      if (connectorFrame) cancelAnimationFrame(connectorFrame);
      connectorFrame = 0;
    };

    setProgress(reduceMotion ? 100 : 0);
    requestAnimationFrame(setLineGeometry);

    slider.addEventListener('input', () => {
      cancelProgressAnimation();
      setProgress(slider.value);
    });

    replay.addEventListener('click', play);

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(setLineGeometry);
      resizeObserver.observe(stage);
    } else {
      window.addEventListener('resize', setLineGeometry, { passive: true });
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startConnectorLoop();
            if (!hasPlayed) {
              hasPlayed = true;
              play();
            }
          } else {
            stopConnectorLoop();
          }
        });
      }, { threshold: 0.18 });
      observer.observe(stage);
    } else {
      hasPlayed = true;
      play();
      startConnectorLoop();
    }
  });
</script>
