---
const nodes = [
  { id: 'jose-jose', label: 'José José', icon: '🎙️', x: 50, y: 7, mx: 50, my: 8, reveal: 14, floatDelay: -0.6 },
  { id: 'napoleon', label: 'José María Napoleón', icon: '🎵', x: 68, y: 9, mx: 72, my: 10, reveal: 19, floatDelay: -2.2 },
  { id: 'carreras', label: 'José Carreras', icon: '🎼', x: 82, y: 18, mx: 86, my: 18, reveal: 24, floatDelay: -1.4 },
  { id: 'marti', label: 'José Martí', icon: '✒️', x: 91, y: 32, mx: 88, my: 29, reveal: 29, floatDelay: -1.1 },
  { id: 'rizal', label: 'José Rizal', icon: '📚', x: 93, y: 50, mx: 88, my: 42, reveal: 34, floatDelay: -3.5 },
  { id: 'mourinho', label: 'José Mourinho', icon: '⚽', x: 90, y: 68, mx: 88, my: 57, reveal: 39, floatDelay: -2.7 },
  { id: 'feliciano', label: 'José Feliciano', icon: '🎸', x: 80, y: 83, mx: 86, my: 72, reveal: 44, floatDelay: -1.8 },
  { id: 'perales', label: 'José Luis Perales', icon: '🎶', x: 65, y: 91, mx: 72, my: 88, reveal: 49, floatDelay: -2.4 },
  { id: 'saramago', label: 'José Saramago', icon: '📖', x: 50, y: 94, mx: 50, my: 92, reveal: 54, floatDelay: -4.1 },
  { id: 'san-martin', label: 'José de San Martín', icon: '⚔️', x: 35, y: 91, mx: 28, my: 88, reveal: 59, floatDelay: -3.1 },
  { id: 'posada', label: 'José G. Posada', icon: '🖋️', x: 20, y: 83, mx: 14, my: 72, reveal: 64, floatDelay: -2.8 },
  { id: 'orozco', label: 'José C. Orozco', icon: '🎨', x: 10, y: 68, mx: 12, my: 57, reveal: 69, floatDelay: -1.9 },
  { id: 'joseph', label: 'Joseph', icon: '📜', x: 7, y: 50, mx: 12, my: 42, reveal: 74, floatDelay: -0.9 },
  { id: 'yusuf', label: 'Yusuf', icon: '◈', x: 10, y: 32, mx: 12, my: 29, reveal: 79, floatDelay: -3.2 },
  { id: 'giuseppe', label: 'Giuseppe', icon: 'G', x: 20, y: 18, mx: 14, my: 18, reveal: 84, floatDelay: -1.5 },
  { id: 'cuervo', label: 'José Cuervo', icon: '◆', x: 35, y: 9, mx: 28, my: 10, reveal: 89, floatDelay: -3.8 },
];

const nodeReveal = Object.fromEntries(nodes.map((node) => [node.id, node.reveal]));
const ringIds = nodes.map((node) => node.id);
const edges = [];

ringIds.forEach((id, index) => {
  edges.push([id, ringIds[(index + 1) % ringIds.length]]);
});

ringIds.forEach((id, index) => {
  if (index % 2 === 0) edges.push([id, ringIds[(index + 2) % ringIds.length]]);
});
---

<section class="about-section jose-constellation" id="jose-constellation" aria-labelledby="jose-constellation-title" data-jose-constellation>
  <div class="about-section-head jose-constellation-head">
    <p class="about-eyebrow">A name becomes a map</p>
    <h2 id="jose-constellation-title">The José constellation</h2>
    <p>
      My name is hardly mine alone. This is a playful orbit of other Josés and close name cousins around the signature that makes this one mine.
    </p>
  </div>

  <div class="jose-prototype-badge" aria-label="Prototype using placeholder portraits">
    <span aria-hidden="true">✦</span> Prototype · placeholder portraits
  </div>

  <div class="jose-stage" data-jose-stage>
    <svg class="jose-lines" viewBox="0 0 1000 650" preserveAspectRatio="none" aria-hidden="true" data-jose-lines>
      {edges.map(([from, to]) => (
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="0"
          data-from={from}
          data-to={to}
          data-reveal={Math.max(nodeReveal[from], nodeReveal[to]) + 2}
        />
      ))}
    </svg>

    <div class="jose-center" aria-label="A stylized José signature at the center of the constellation">
      <div class="jose-signature" aria-hidden="true">
        <span class="jose-signature-word" data-jose-signature>José</span>
        <svg class="jose-signature-flourish" viewBox="0 0 320 74" aria-hidden="true">
          <path data-jose-flourish pathLength="1" d="M12 37 C76 55, 169 61, 281 27 C304 20, 312 31, 291 41 C268 52, 232 53, 197 49" />
        </svg>
      </div>
      <span class="jose-center-caption">the José at the center</span>
    </div>

    {nodes.map((node) => (
      <div
        class="jose-node"
        data-jose-node={node.id}
        data-reveal={node.reveal}
        style={`--x:${node.x}%;--y:${node.y}%;--mx:${node.mx}%;--my:${node.my}%;--float-delay:${node.floatDelay}s;`}
        title={`Placeholder for ${node.label}`}
      >
        <div class="jose-node-float">
          <span class="jose-node-orb" aria-hidden="true">{node.icon}</span>
          <span class="jose-node-label">{node.label}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="jose-controls" aria-label="José constellation animation controls">
    <div class="jose-slider-control">
      <div class="jose-slider-meta">
        <label for="jose-constellation-slider">Build the constellation</label>
        <output for="jose-constellation-slider" data-jose-progress aria-live="polite">0%</output>
      </div>
      <input id="jose-constellation-slider" type="range" min="0" max="100" value="0" step="1" data-jose-slider />
    </div>
    <button class="jose-replay" type="button" data-jose-replay aria-label="Replay the José constellation animation">↻ Replay</button>
  </div>

  <p class="jose-prototype-note">
    The icons are stand-ins for now. Later each node can become a real portrait, cutout, object, or symbol while keeping this same orbiting web.
  </p>
</section>

<style>
  .jose-constellation{position:relative}
  .jose-constellation-head{margin-bottom:1rem}
  .jose-prototype-badge{display:flex;width:max-content;max-width:100%;align-items:center;gap:.4rem;margin:0 auto .8rem;padding:.32rem .58rem;border:1px solid #d4dfd9;border-radius:999px;background:var(--as-green-soft,#eaf3ee);color:var(--as-green-dark,#174433);font-size:.64rem;font-weight:850;letter-spacing:.055em;line-height:1.2;text-transform:uppercase}
  .jose-stage{position:relative;min-height:clamp(590px,60vw,670px);overflow:hidden;border:1px solid var(--as-border,#dfe3e7);border-radius:28px;background:radial-gradient(circle at 50% 50%,rgba(36,92,70,.08),transparent 23%),radial-gradient(circle at 78% 20%,rgba(154,106,63,.07),transparent 19%),linear-gradient(145deg,#fbfcfb,#fff 58%,#f7f8f6);box-shadow:0 12px 34px rgba(25,33,44,.06);isolation:isolate}
  .jose-stage::before{position:absolute;inset:0;z-index:-1;opacity:.24;background-image:radial-gradient(circle,rgba(36,92,70,.28) 1px,transparent 1.5px);background-size:38px 38px;content:'';mask-image:radial-gradient(circle at 50% 50%,#000,transparent 80%)}
  .jose-lines{position:absolute;inset:0;z-index:1;width:100%;height:100%;pointer-events:none}
  .jose-lines line{opacity:0;stroke:rgba(36,92,70,.42);stroke-width:1.3;stroke-dasharray:7 10;stroke-linecap:round;vector-effect:non-scaling-stroke}
  .jose-center{position:absolute;top:50%;left:50%;z-index:3;display:flex;width:min(31%,350px);min-width:230px;transform:translate(-50%,-50%);flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}
  .jose-center::before{position:absolute;inset:-28% -24%;z-index:-1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.98) 0 43%,rgba(255,255,255,.78) 61%,rgba(255,255,255,0) 76%);content:''}
  .jose-signature{position:relative;width:100%;padding:.25rem .5rem 1.15rem;transform:rotate(-5deg)}
  .jose-signature-word{display:inline-block;opacity:0;clip-path:inset(0 100% 0 0);color:var(--as-green-dark,#174433);font-family:"Snell Roundhand","Segoe Script","Brush Script MT","Lucida Handwriting",cursive;font-size:clamp(4rem,7vw,6.4rem);font-style:italic;font-weight:400;letter-spacing:-.13em;line-height:.9;white-space:nowrap;text-shadow:0 2px 0 rgba(255,255,255,.82)}
  .jose-signature-flourish{position:absolute;right:-9%;bottom:-.1rem;left:-7%;width:116%;height:3.4rem;overflow:visible}
  .jose-signature-flourish path{fill:none;stroke:var(--as-green-dark,#174433);stroke-width:1.8;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;vector-effect:non-scaling-stroke}
  .jose-center-caption{margin-top:.08rem;color:var(--as-muted,#5c626c);font-size:.61rem;font-weight:800;letter-spacing:.105em;text-transform:uppercase}
  .jose-node{position:absolute;top:var(--y);left:var(--x);z-index:4;width:96px;opacity:0;transform:translate(-50%,-50%) scale(.72);transform-origin:center;text-align:center;will-change:transform,opacity}
  .jose-node-float{display:flex;flex-direction:column;align-items:center;animation:jose-node-float 5.8s ease-in-out infinite;animation-delay:var(--float-delay)}
  .jose-node-orb{display:grid;width:56px;height:56px;place-items:center;border:1px solid rgba(36,92,70,.22);border-radius:50%;background:rgba(255,255,255,.97);box-shadow:0 7px 18px rgba(25,33,44,.085),0 0 0 4px rgba(234,243,238,.6);color:var(--as-green-dark,#174433);font-family:Georgia,"Times New Roman",serif;font-size:1.16rem;font-weight:800;transition:transform 180ms ease,box-shadow 180ms ease,border-color 180ms ease}
  .jose-node:hover .jose-node-orb{transform:scale(1.09);border-color:rgba(36,92,70,.46);box-shadow:0 10px 24px rgba(25,33,44,.12),0 0 0 6px rgba(234,243,238,.8)}
  .jose-node-label{display:block;max-width:96px;margin-top:.4rem;color:var(--as-ink,#17191d);font-size:.66rem;font-weight:850;line-height:1.08;text-wrap:balance}
  .jose-controls{position:relative;z-index:10;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.8rem 1rem;max-width:800px;margin:1rem auto 0;align-items:end;isolation:isolate;pointer-events:auto}
  .jose-slider-control{min-width:0;pointer-events:auto}
  .jose-slider-meta{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.3rem}
  .jose-slider-meta label{color:var(--as-ink,#17191d);font-size:.76rem;font-weight:850}
  .jose-slider-meta output{color:var(--as-green-dark,#174433);font-size:.7rem;font-weight:850;font-variant-numeric:tabular-nums}
  .jose-slider-control input[type="range"]{position:relative;z-index:11;width:100%;height:28px;margin:0;padding:0;accent-color:var(--as-green,#245c46);cursor:ew-resize;pointer-events:auto;touch-action:pan-y}
  .jose-replay{position:relative;z-index:11;min-height:40px;padding:.58rem .78rem;border:1px solid #ccd3d8;border-radius:10px;background:#fff;color:var(--as-green-dark,#174433);font:inherit;font-size:.74rem;font-weight:850;cursor:pointer;pointer-events:auto;touch-action:manipulation}
  .jose-replay:hover{border-color:#aebcb4;background:var(--as-green-soft,#eaf3ee)}
  .jose-replay:active{transform:translateY(1px)}
  .jose-replay:focus-visible,.jose-slider-control input:focus-visible{outline:3px solid #f0b84b;outline-offset:3px}
  .jose-prototype-note{max-width:720px;margin:.72rem auto 0!important;color:var(--as-muted,#5c626c)!important;font-size:.72rem;line-height:1.45;text-align:center}
  @keyframes jose-node-float{0%,100%{transform:translate3d(0,-2px,0) rotate(-.7deg)}50%{transform:translate3d(2px,3px,0) rotate(.7deg)}}
  @media(max-width:760px){
    .jose-stage{min-height:820px;border-radius:22px}
    .jose-stage::before{background-size:32px 32px}
    .jose-center{top:50%;left:50%;width:49%;min-width:165px}
    .jose-center::before{inset:-34% -28%}
    .jose-signature-word{font-size:clamp(3.1rem,15vw,4.8rem)}
    .jose-node{top:var(--my);left:var(--mx);width:78px}
    .jose-node-orb{width:48px;height:48px;font-size:1rem;box-shadow:0 6px 15px rgba(25,33,44,.08),0 0 0 4px rgba(234,243,238,.62)}
    .jose-node-label{max-width:78px;font-size:.58rem}
  }
  @media(max-width:560px){
    .jose-constellation-head{text-align:left}
    .jose-prototype-badge{margin-left:0}
    .jose-stage{min-height:780px}
    .jose-controls{grid-template-columns:1fr}
    .jose-replay{width:max-content}
    .jose-prototype-note{text-align:left}
  }
  @media(prefers-reduced-motion:reduce){.jose-node-float{animation:none}.jose-node-orb{transition:none}}
</style>

<script is:inline data-astro-rerun>
  (() => {
    const section = document.querySelector('[data-jose-constellation]');
    if (!section || section.dataset.joseInitialized === 'true') return;
    section.dataset.joseInitialized = 'true';

    const stage = section.querySelector('[data-jose-stage]');
    const svg = section.querySelector('[data-jose-lines]');
    const signature = section.querySelector('[data-jose-signature]');
    const flourish = section.querySelector('[data-jose-flourish]');
    const slider = section.querySelector('[data-jose-slider]');
    const progressOutput = section.querySelector('[data-jose-progress]');
    const replay = section.querySelector('[data-jose-replay]');
    const nodes = Array.from(section.querySelectorAll('[data-jose-node]'));
    const lines = Array.from(section.querySelectorAll('[data-from][data-to]'));

    if (!stage || !svg || !signature || !flourish || !slider || !progressOutput || !replay) return;

    const nodeById = new Map(nodes.map((node) => [node.dataset.joseNode, node]));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const easeOut = (value) => 1 - Math.pow(1 - value, 3);

    let progress = reduceMotion ? 100 : 0;
    let animationFrame = 0;
    let connectorFrame = 0;
    let hasAutoPlayed = false;

    const setLineGeometry = () => {
      const stageRect = stage.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      if (!stageRect.width || !stageRect.height || !viewBox.width || !viewBox.height) return;

      const scaleX = viewBox.width / stageRect.width;
      const scaleY = viewBox.height / stageRect.height;

      lines.forEach((line) => {
        const fromNode = nodeById.get(line.dataset.from);
        const toNode = nodeById.get(line.dataset.to);
        if (!fromNode || !toNode) return;

        const fromOrb = fromNode.querySelector('.jose-node-orb') || fromNode;
        const toOrb = toNode.querySelector('.jose-node-orb') || toNode;
        const fromRect = fromOrb.getBoundingClientRect();
        const toRect = toOrb.getBoundingClientRect();

        line.setAttribute('x1', String((fromRect.left + fromRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y1', String((fromRect.top + fromRect.height / 2 - stageRect.top) * scaleY));
        line.setAttribute('x2', String((toRect.left + toRect.width / 2 - stageRect.left) * scaleX));
        line.setAttribute('y2', String((toRect.top + toRect.height / 2 - stageRect.top) * scaleY));
      });
    };

    const applyProgress = (rawValue, syncSlider = true) => {
      progress = clamp(Number(rawValue) || 0, 0, 100);

      if (syncSlider) slider.value = String(Math.round(progress));
      progressOutput.textContent = `${Math.round(progress)}%`;

      const signatureProgress = easeOut(clamp(progress / 34));
      signature.style.opacity = signatureProgress > .01 ? '1' : '0';
      signature.style.clipPath = `inset(0 ${100 - signatureProgress * 100}% 0 0)`;

      const flourishProgress = easeOut(clamp((progress - 20) / 24));
      flourish.style.strokeDashoffset = String(1 - flourishProgress);

      nodes.forEach((node) => {
        const start = Number(node.dataset.reveal || 0);
        const local = easeOut(clamp((progress - start) / 8));
        node.style.opacity = String(local);
        node.style.transform = `translate(-50%,-50%) scale(${0.72 + local * 0.28})`;
        node.style.pointerEvents = local > .9 ? 'auto' : 'none';
      });

      lines.forEach((line) => {
        const start = Number(line.dataset.reveal || 0);
        const local = easeOut(clamp((progress - start) / 7));
        line.style.opacity = String(local * .72);
      });

      requestAnimationFrame(setLineGeometry);
    };

    const stopAnimation = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const animateToFull = () => {
      stopAnimation();
      if (reduceMotion) {
        applyProgress(100);
        return;
      }

      applyProgress(0);
      const startedAt = performance.now();
      const duration = 4300;

      const tick = (now) => {
        const elapsed = clamp((now - startedAt) / duration);
        applyProgress(easeOut(elapsed) * 100);
        if (elapsed < 1) animationFrame = requestAnimationFrame(tick);
        else animationFrame = 0;
      };

      animationFrame = requestAnimationFrame(tick);
    };

    const startConnectorLoop = () => {
      if (reduceMotion || connectorFrame) return;
      const tick = () => {
        setLineGeometry();
        connectorFrame = requestAnimationFrame(tick);
      };
      connectorFrame = requestAnimationFrame(tick);
    };

    const stopConnectorLoop = () => {
      if (connectorFrame) cancelAnimationFrame(connectorFrame);
      connectorFrame = 0;
    };

    const takeManualControl = () => {
      stopAnimation();
      hasAutoPlayed = true;
    };

    slider.addEventListener('pointerdown', takeManualControl);
    slider.addEventListener('touchstart', takeManualControl, { passive: true });
    slider.addEventListener('input', () => {
      takeManualControl();
      applyProgress(slider.value, false);
    });
    slider.addEventListener('change', () => applyProgress(slider.value, false));

    replay.addEventListener('click', () => {
      hasAutoPlayed = true;
      animateToFull();
    });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(setLineGeometry);
      resizeObserver.observe(stage);
    } else {
      window.addEventListener('resize', setLineGeometry, { passive: true });
    }

    applyProgress(progress);
    requestAnimationFrame(setLineGeometry);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startConnectorLoop();
            if (!hasAutoPlayed) {
              hasAutoPlayed = true;
              animateToFull();
            }
          } else {
            stopConnectorLoop();
          }
        });
      }, { threshold: .16 });
      observer.observe(stage);
    } else {
      hasAutoPlayed = true;
      animateToFull();
      startConnectorLoop();
    }
  })();
</script>
