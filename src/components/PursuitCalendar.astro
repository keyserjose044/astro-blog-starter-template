---
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const dataUrl = `${base}data/pursuits.json`;
---

<section class="calendar-section" data-pursuit-calendar data-source={dataUrl} aria-labelledby="pursuit-calendar-title">
  <div class="calendar-heading">
    <div>
      <p class="eyebrow">Practice across time</p>
      <h2 id="pursuit-calendar-title">The pursuits calendar</h2>
      <p class="calendar-intro">A day-level view of guitar, dance, running, and language work. The interface is ready now; the archive feed can be filled from Google Sheets later.</p>
    </div>
    <div class="calendar-summary" aria-live="polite">
      <div><strong data-summary-days>0</strong><span>active days</span></div>
      <div><strong data-summary-minutes>0</strong><span>logged minutes</span></div>
      <div><strong data-summary-types>0</strong><span>pursuits</span></div>
    </div>
  </div>

  <div class="calendar-shell">
    <div class="calendar-toolbar">
      <div class="month-controls">
        <button type="button" data-calendar-prev aria-label="Previous month">←</button>
        <button type="button" data-calendar-today>Today</button>
        <button type="button" data-calendar-next aria-label="Next month">→</button>
      </div>
      <h3 data-calendar-label>Loading calendar…</h3>
      <div class="calendar-legend" aria-label="Pursuit color legend">
        <span><i class="guitar"></i>Guitar</span>
        <span><i class="dance"></i>Dance</span>
        <span><i class="running"></i>Running</span>
        <span><i class="languages"></i>Languages</span>
      </div>
    </div>

    <div class="weekdays" aria-hidden="true">
      <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
    </div>
    <div class="calendar-grid" data-calendar-grid role="grid" aria-label="Pursuit activity by day"></div>
    <p class="calendar-status" data-calendar-status aria-live="polite">Loading the local pursuit archive…</p>
  </div>
</section>

<script>
  type PursuitName = 'guitar' | 'dance' | 'running' | 'languages';
  type PursuitEvent = {
    date: string;
    pursuit: PursuitName;
    minutes?: number;
    label?: string;
    detail?: string;
  };
  type PursuitFeed = { version?: number; updatedAt?: string | null; events?: PursuitEvent[] } | PursuitEvent[];

  const root = document.querySelector<HTMLElement>('[data-pursuit-calendar]');

  if (root) {
    const source = root.dataset.source || '/data/pursuits.json';
    const grid = root.querySelector<HTMLElement>('[data-calendar-grid]');
    const label = root.querySelector<HTMLElement>('[data-calendar-label]');
    const status = root.querySelector<HTMLElement>('[data-calendar-status]');
    const summaryDays = root.querySelector<HTMLElement>('[data-summary-days]');
    const summaryMinutes = root.querySelector<HTMLElement>('[data-summary-minutes]');
    const summaryTypes = root.querySelector<HTMLElement>('[data-summary-types]');
    const previous = root.querySelector<HTMLButtonElement>('[data-calendar-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-calendar-next]');
    const todayButton = root.querySelector<HTMLButtonElement>('[data-calendar-today]');

    let events: PursuitEvent[] = [];
    const now = new Date();
    let viewYear = now.getFullYear();
    let viewMonth = now.getMonth();

    const safeDate = (value: string) => {
      const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
      if (!match) return null;
      const date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
      return Number.isNaN(date.valueOf()) ? null : date;
    };

    const keyFor = (year: number, month: number, day: number) =>
      `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

    const escapeHtml = (value: string) =>
      value.replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
      })[character] || character);

    const render = () => {
      if (!grid || !label || !status) return;

      const monthStart = new Date(viewYear, viewMonth, 1);
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      const previousMonthDays = new Date(viewYear, viewMonth, 0).getDate();
      const startOffset = monthStart.getDay();
      const cells = 42;
      const monthEvents = events.filter((event) => {
        const date = safeDate(event.date);
        return date && date.getFullYear() === viewYear && date.getMonth() === viewMonth;
      });

      label.textContent = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      const activeDates = new Set(monthEvents.map((event) => event.date));
      const totalMinutes = monthEvents.reduce((sum, event) => sum + (Number(event.minutes) || 0), 0);
      const activeTypes = new Set(monthEvents.map((event) => event.pursuit));
      if (summaryDays) summaryDays.textContent = activeDates.size.toLocaleString('en-US');
      if (summaryMinutes) summaryMinutes.textContent = totalMinutes.toLocaleString('en-US');
      if (summaryTypes) summaryTypes.textContent = activeTypes.size.toLocaleString('en-US');

      const html: string[] = [];
      for (let index = 0; index < cells; index += 1) {
        const relativeDay = index - startOffset + 1;
        let cellYear = viewYear;
        let cellMonth = viewMonth;
        let day = relativeDay;
        let outside = false;

        if (relativeDay < 1) {
          outside = true;
          day = previousMonthDays + relativeDay;
          cellMonth -= 1;
          if (cellMonth < 0) { cellMonth = 11; cellYear -= 1; }
        } else if (relativeDay > daysInMonth) {
          outside = true;
          day = relativeDay - daysInMonth;
          cellMonth += 1;
          if (cellMonth > 11) { cellMonth = 0; cellYear += 1; }
        }

        const dateKey = keyFor(cellYear, cellMonth, day);
        const dayEvents = events.filter((event) => event.date === dateKey);
        const isToday = dateKey === keyFor(now.getFullYear(), now.getMonth(), now.getDate());
        const eventMarkup = dayEvents.slice(0, 3).map((event) => {
          const text = event.label || `${event.pursuit}${event.minutes ? ` · ${event.minutes} min` : ''}`;
          return `<span class="event event--${event.pursuit}" title="${escapeHtml(event.detail || text)}">${escapeHtml(text)}</span>`;
        }).join('');
        const more = dayEvents.length > 3 ? `<span class="event-more">+${dayEvents.length - 3} more</span>` : '';
        const dayLabel = new Date(cellYear, cellMonth, day).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

        html.push(`
          <article class="day${outside ? ' day--outside' : ''}${isToday ? ' day--today' : ''}${dayEvents.length ? ' day--active' : ''}" role="gridcell" aria-label="${dayLabel}${dayEvents.length ? `, ${dayEvents.length} activities` : ', no activities'}">
            <span class="day-number">${day}</span>
            <div class="day-events">${eventMarkup}${more}</div>
          </article>
        `);
      }

      grid.innerHTML = html.join('');
      status.textContent = monthEvents.length
        ? `${monthEvents.length.toLocaleString('en-US')} logged pursuit ${monthEvents.length === 1 ? 'entry' : 'entries'} in this month.`
        : 'No archive entries are connected for this month yet. The calendar will populate when the Google Sheets export is added.';
    };

    previous?.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      render();
    });

    next?.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      render();
    });

    todayButton?.addEventListener('click', () => {
      viewYear = now.getFullYear();
      viewMonth = now.getMonth();
      render();
    });

    fetch(source)
      .then((response) => {
        if (!response.ok) throw new Error(`Calendar feed returned ${response.status}`);
        return response.json() as Promise<PursuitFeed>;
      })
      .then((feed) => {
        const incoming = Array.isArray(feed) ? feed : feed.events || [];
        events = incoming.filter((event) => safeDate(event.date) && ['guitar', 'dance', 'running', 'languages'].includes(event.pursuit));
        render();
      })
      .catch((error) => {
        console.warn('[Pursuits calendar]', error);
        events = [];
        render();
        if (status) status.textContent = 'The calendar interface loaded, but the pursuit data file could not be read.';
      });

    render();
  }
</script>

<style>
  .calendar-section { max-width:1380px; margin:0 auto; padding:8px clamp(14px,3vw,48px) 54px; }
  .calendar-heading { display:flex; align-items:end; justify-content:space-between; gap:28px; margin-bottom:18px; }
  .eyebrow { margin:0 0 5px; color:#405cf5; font-size:.72rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  .calendar-heading h2 { margin:0; color:#111827; font-size:clamp(1.8rem,4vw,3.2rem); letter-spacing:-.045em; }
  .calendar-intro { max-width:760px; margin:8px 0 0; color:#626978; line-height:1.65; }
  .calendar-summary { display:grid; grid-template-columns:repeat(3,minmax(90px,1fr)); gap:9px; min-width:min(100%,360px); }
  .calendar-summary div { padding:13px; border:1px solid #e4e8ef; border-radius:15px; background:rgba(255,255,255,.9); text-align:center; box-shadow:0 8px 22px rgba(15,23,42,.05); }
  .calendar-summary strong { display:block; color:#111827; font-size:1.35rem; }
  .calendar-summary span { display:block; margin-top:2px; color:#707786; font-size:.69rem; }
  .calendar-shell { overflow:hidden; border:1px solid #dfe4ec; border-radius:24px; background:rgba(255,255,255,.92); box-shadow:0 18px 48px rgba(15,23,42,.09); }
  .calendar-toolbar { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:14px; padding:16px 18px; border-bottom:1px solid #e5e9f0; }
  .calendar-toolbar h3 { margin:0; color:#161b27; font-size:1.15rem; text-align:center; }
  .month-controls { display:flex; gap:7px; }
  .month-controls button { min-height:36px; padding:7px 11px; border:1px solid #dfe4ec; border-radius:10px; background:#fff; color:#303746; font:inherit; font-size:.78rem; font-weight:800; cursor:pointer; }
  .month-controls button:hover { background:#f0f2ff; border-color:#cbd2ff; }
  .calendar-legend { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:7px 11px; color:#656d7b; font-size:.69rem; }
  .calendar-legend span { display:inline-flex; align-items:center; gap:5px; }
  .calendar-legend i { width:8px; height:8px; border-radius:50%; }
  .calendar-legend .guitar { background:#c77a30; }
  .calendar-legend .dance { background:#c3428f; }
  .calendar-legend .running { background:#278a63; }
  .calendar-legend .languages { background:#405cf5; }
  .weekdays { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); border-bottom:1px solid #e7ebf1; background:#f8fafc; }
  .weekdays span { padding:9px; color:#737b8a; font-size:.67rem; font-weight:850; letter-spacing:.08em; text-align:center; text-transform:uppercase; }
  .calendar-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); }
  .day { min-height:118px; padding:8px; border-right:1px solid #e8ebf1; border-bottom:1px solid #e8ebf1; background:rgba(255,255,255,.82); }
  .day:nth-child(7n) { border-right:0; }
  .day:nth-last-child(-n+7) { border-bottom:0; }
  .day--outside { background:#f8f9fb; color:#a1a7b2; }
  .day--today { box-shadow:inset 0 0 0 2px #405cf5; }
  .day--active { background:linear-gradient(145deg,#fff,#fafbff); }
  .day-number { display:inline-grid; place-items:center; width:25px; height:25px; border-radius:50%; font-size:.75rem; font-weight:850; }
  .day--today .day-number { background:#405cf5; color:#fff; }
  .day-events { display:grid; gap:4px; margin-top:5px; }
  .event { display:block; overflow:hidden; padding:4px 6px; border-left:3px solid currentColor; border-radius:5px; background:#f5f6f8; color:#394150; font-size:.64rem; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; }
  .event--guitar { color:#9a591f; background:#fff5e9; }
  .event--dance { color:#9f286e; background:#fff0f8; }
  .event--running { color:#1e7654; background:#edf9f3; }
  .event--languages { color:#3049c9; background:#f0f2ff; }
  .event-more { color:#737b8a; font-size:.61rem; font-weight:750; }
  .calendar-status { margin:0; padding:12px 16px; border-top:1px solid #e7ebf1; color:#6b7280; font-size:.76rem; text-align:center; }
  @media (max-width:900px) {
    .calendar-heading { display:block; }
    .calendar-summary { margin-top:16px; }
    .calendar-toolbar { grid-template-columns:1fr auto; }
    .calendar-toolbar h3 { grid-column:1 / -1; grid-row:1; }
    .month-controls { grid-column:1; grid-row:2; }
    .calendar-legend { grid-column:2; grid-row:2; }
    .day { min-height:96px; }
  }
  @media (max-width:650px) {
    .calendar-section { padding-inline:10px; }
    .calendar-summary { grid-template-columns:repeat(3,1fr); min-width:0; }
    .calendar-summary div { padding:10px 5px; }
    .calendar-toolbar { display:flex; flex-direction:column; align-items:stretch; }
    .month-controls, .calendar-legend { justify-content:center; }
    .weekdays span { padding:7px 2px; font-size:.58rem; }
    .day { min-height:72px; padding:4px; }
    .day-number { width:21px; height:21px; font-size:.67rem; }
    .event { height:6px; padding:0; border:0; border-radius:999px; color:transparent; font-size:0; }
    .event-more { display:none; }
  }
</style>
