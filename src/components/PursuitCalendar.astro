---
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const dayBase = `${base}day/`;
---

<section class="calendar-section" data-pursuit-calendar data-day-base={dayBase} data-calendar-view="month" aria-labelledby="pursuit-calendar-title">
  <div class="calendar-heading">
    <div>
      <p class="calendar-eyebrow">Practice across time</p>
      <h2 id="pursuit-calendar-title">The pursuits calendar</h2>
      <p class="calendar-intro">A day-level view of guitar, dance, running, and language study calculated directly from the public-safe daily Archive.</p>
    </div>
    <div class="calendar-summary" aria-live="polite">
      <div><strong data-summary-days>—</strong><span>active days</span></div>
      <div><strong data-summary-hours>—</strong><span>tracked hours</span></div>
      <div><strong data-summary-types>—</strong><span>pursuits shown</span></div>
    </div>
  </div>

  <div class="calendar-shell">
    <div class="calendar-toolbar">
      <div class="toolbar-main">
        <div class="month-controls">
          <button type="button" data-calendar-prev aria-label="Previous month">←</button>
          <button type="button" data-calendar-latest>Latest</button>
          <button type="button" data-calendar-next aria-label="Next month">→</button>
        </div>

        <div class="calendar-period">
          <h3 data-calendar-label>Loading calendar…</h3>
          <label>Year<select data-calendar-year aria-label="Choose calendar year"></select></label>
        </div>

        <div class="view-toggle" role="group" aria-label="Calendar view">
          <button type="button" data-calendar-view-button="month" aria-pressed="true">Month</button>
          <button type="button" data-calendar-view-button="year" aria-pressed="false">Year</button>
        </div>
      </div>

      <div class="calendar-filters" aria-label="Filter pursuits">
        <span class="filter-group filter-group--guitar">
          <button class="filter-option" type="button" data-pursuit-filter="guitar" aria-pressed="true"><i></i><span>Guitar</span></button>
          <button class="filter-solo" type="button" data-pursuit-solo="guitar" aria-label="Show only Guitar" title="Solo Guitar">solo</button>
        </span>
        <span class="filter-group filter-group--dance">
          <button class="filter-option" type="button" data-pursuit-filter="dance" aria-pressed="true"><i></i><span>Dance</span></button>
          <button class="filter-solo" type="button" data-pursuit-solo="dance" aria-label="Show only Dance" title="Solo Dance">solo</button>
        </span>
        <span class="filter-group filter-group--running">
          <button class="filter-option" type="button" data-pursuit-filter="running" aria-pressed="true"><i></i><span>Running</span></button>
          <button class="filter-solo" type="button" data-pursuit-solo="running" aria-label="Show only Running" title="Solo Running">solo</button>
        </span>
        <span class="filter-group filter-group--languages">
          <button class="filter-option" type="button" data-pursuit-filter="languages" aria-pressed="true"><i></i><span>Languages</span></button>
          <button class="filter-solo" type="button" data-pursuit-solo="languages" aria-label="Show only Languages" title="Solo Languages">solo</button>
        </span>
        <span class="filter-actions" aria-label="Filter shortcuts">
          <button type="button" data-filter-all>All</button>
          <button type="button" data-filter-clear>Clear</button>
        </span>
      </div>
    </div>

    <div class="weekdays" aria-hidden="true">
      <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
    </div>
    <div class="calendar-grid" data-calendar-grid data-view="month" role="grid" aria-label="Pursuit activity by day"></div>

    <section class="calendar-breakdown" data-calendar-breakdown aria-labelledby="calendar-breakdown-title">
      <div class="breakdown-heading">
        <div>
          <p>Filtered monthly breakdown</p>
          <h4 id="calendar-breakdown-title" data-breakdown-title>Month at a glance</h4>
        </div>
        <span>Updates with the pursuits selected above.</span>
      </div>
      <div class="breakdown-grid" data-breakdown-grid aria-live="polite"></div>
    </section>

    <div class="calendar-footer">
      <p class="calendar-status" data-calendar-status aria-live="polite">Connecting to the daily Archive…</p>
      <p>Running time is estimated at 10 minutes per mile only for the combined-hour summary.</p>
    </div>
  </div>
</section>

<script>
  import { getDailyMeta, getYear } from '../utils/dailyData';
  import type { DailyMeta, DailyRecord } from '../utils/dailyData';

  type PursuitName = 'guitar' | 'dance' | 'running' | 'languages';
  type CalendarView = 'month' | 'year';
  type PursuitEvent = { pursuit: PursuitName; label: string; detail: string; minutes: number };

  const root = document.querySelector<HTMLElement>('[data-pursuit-calendar]');
  if (root && root.dataset.ready !== 'true') {
    root.dataset.ready = 'true';

    const grid = root.querySelector<HTMLElement>('[data-calendar-grid]');
    const label = root.querySelector<HTMLElement>('[data-calendar-label]');
    const status = root.querySelector<HTMLElement>('[data-calendar-status]');
    const summaryDays = root.querySelector<HTMLElement>('[data-summary-days]');
    const summaryHours = root.querySelector<HTMLElement>('[data-summary-hours]');
    const summaryTypes = root.querySelector<HTMLElement>('[data-summary-types]');
    const previous = root.querySelector<HTMLButtonElement>('[data-calendar-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-calendar-next]');
    const latest = root.querySelector<HTMLButtonElement>('[data-calendar-latest]');
    const yearSelect = root.querySelector<HTMLSelectElement>('[data-calendar-year]');
    const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-calendar-view-button]'));
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pursuit-filter]'));
    const soloButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pursuit-solo]'));
    const filterAll = root.querySelector<HTMLButtonElement>('[data-filter-all]');
    const filterClear = root.querySelector<HTMLButtonElement>('[data-filter-clear]');
    const breakdown = root.querySelector<HTMLElement>('[data-calendar-breakdown]');
    const breakdownTitle = root.querySelector<HTMLElement>('[data-breakdown-title]');
    const breakdownGrid = root.querySelector<HTMLElement>('[data-breakdown-grid]');
    const dayBase = root.dataset.dayBase || '/day/';

    let meta: DailyMeta | null = null;
    let viewYear = new Date().getFullYear();
    let viewMonth = new Date().getMonth();
    let viewMode: CalendarView = 'month';
    let requestToken = 0;
    const yearCache = new Map<number, Promise<DailyRecord[]>>();

    const pursuitOrder: PursuitName[] = ['guitar', 'dance', 'running', 'languages'];
    const pursuitLabels: Record<PursuitName, string> = { guitar: 'Guitar', dance: 'Dance', running: 'Running', languages: 'Languages' };
    const pursuitIcons: Record<PursuitName, string> = { guitar: '🎸', dance: '💃', running: '🏃', languages: '🌍' };

    const parseIso = (value: string) => new Date(`${value}T12:00:00`);
    const keyFor = (year: number, month: number, day: number) => `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    const format = (value: number, digits = 0) => new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
    const loadYear = (year: number) => {
      if (!yearCache.has(year)) yearCache.set(year, getYear(year));
      return yearCache.get(year)!;
    };
    const selectedPursuits = () => new Set<PursuitName>(
      filterButtons
        .filter((button) => button.getAttribute('aria-pressed') === 'true')
        .map((button) => button.dataset.pursuitFilter as PursuitName),
    );
    const setFilter = (button: HTMLButtonElement, selected: boolean) => button.setAttribute('aria-pressed', String(selected));

    const eventsFor = (record: DailyRecord): PursuitEvent[] => {
      const events: PursuitEvent[] = [];
      if ((record.hobbies.guitarMinutes ?? 0) > 0) events.push({ pursuit: 'guitar', label: `Guitar · ${format(record.hobbies.guitarMinutes!)} min`, detail: `${format(record.hobbies.guitarMinutes!)} minutes of guitar`, minutes: record.hobbies.guitarMinutes! });
      if ((record.hobbies.danceMinutes ?? 0) > 0) events.push({ pursuit: 'dance', label: `Dance · ${format(record.hobbies.danceMinutes!)} min`, detail: `${format(record.hobbies.danceMinutes!)} minutes of dance`, minutes: record.hobbies.danceMinutes! });
      if ((record.hobbies.runningMiles ?? 0) > 0) events.push({ pursuit: 'running', label: `Running · ${format(record.hobbies.runningMiles!, 1)} mi`, detail: `${format(record.hobbies.runningMiles!, 1)} running miles`, minutes: record.hobbies.runningMiles! * 10 });
      if ((record.hobbies.languageMinutes ?? 0) > 0) events.push({ pursuit: 'languages', label: `Languages · ${format(record.hobbies.languageMinutes!)} min`, detail: `${format(record.hobbies.languageMinutes!)} minutes of language study`, minutes: record.hobbies.languageMinutes! });
      return events;
    };

    const intensityFor = (event: PursuitEvent) => {
      const caps: Record<PursuitName, number> = { guitar: 120, dance: 180, running: 60, languages: 180 };
      return Math.round(Math.min(100, Math.max(16, (event.minutes / caps[event.pursuit]) * 100)));
    };

    const durationLabel = (minutes: number) => minutes >= 60 ? `${format(minutes / 60, 1)} h` : `${format(minutes)} min`;

    const pursuitMetric = (pursuit: PursuitName, records: DailyRecord[]) => {
      if (pursuit === 'running') {
        const miles = records.reduce((sum, record) => sum + (record.hobbies.runningMiles ?? 0), 0);
        const days = records.filter((record) => (record.hobbies.runningMiles ?? 0) > 0).length;
        return { value: `${format(miles, 1)} mi`, days };
      }
      const minutes = records.reduce((sum, record) => {
        if (pursuit === 'guitar') return sum + (record.hobbies.guitarMinutes ?? 0);
        if (pursuit === 'dance') return sum + (record.hobbies.danceMinutes ?? 0);
        return sum + (record.hobbies.languageMinutes ?? 0);
      }, 0);
      const days = records.filter((record) => {
        if (pursuit === 'guitar') return (record.hobbies.guitarMinutes ?? 0) > 0;
        if (pursuit === 'dance') return (record.hobbies.danceMinutes ?? 0) > 0;
        return (record.hobbies.languageMinutes ?? 0) > 0;
      }).length;
      return { value: durationLabel(minutes), days };
    };

    const renderBreakdown = (records: DailyRecord[], selected: Set<PursuitName>, monthStart: Date) => {
      if (!breakdown || !breakdownGrid || !breakdownTitle) return;
      breakdown.hidden = viewMode !== 'month';
      if (viewMode !== 'month') return;
      breakdownTitle.textContent = `${monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} at a glance`;
      const visible = pursuitOrder.filter((pursuit) => selected.has(pursuit));
      if (!visible.length) {
        breakdownGrid.innerHTML = '<p class="breakdown-empty">Select a pursuit above to see its monthly total.</p>';
        return;
      }
      breakdownGrid.innerHTML = visible.map((pursuit) => {
        const metric = pursuitMetric(pursuit, records);
        return `<article class="breakdown-card breakdown-card--${pursuit}"><span class="breakdown-icon" aria-hidden="true">${pursuitIcons[pursuit]}</span><div><p>${pursuitLabels[pursuit]}</p><strong>${metric.value}</strong><small>${format(metric.days)} active ${metric.days === 1 ? 'day' : 'days'}</small></div></article>`;
      }).join('');
    };

    const canMoveNext = () => {
      if (!meta?.dataThrough) return false;
      const through = parseIso(meta.dataThrough);
      if (viewMode === 'year') return viewYear < through.getFullYear();
      return viewYear < through.getFullYear() || (viewYear === through.getFullYear() && viewMonth < through.getMonth());
    };

    const canMovePrevious = () => {
      if (!meta?.availableYears.length) return false;
      const firstYear = Math.min(...meta.availableYears);
      if (viewMode === 'year') return viewYear > firstYear;
      return viewYear > firstYear || viewMonth > 0;
    };

    const syncControls = () => {
      if (previous) {
        previous.disabled = !canMovePrevious();
        previous.setAttribute('aria-label', viewMode === 'year' ? 'Previous year' : 'Previous month');
      }
      if (next) {
        next.disabled = !canMoveNext();
        next.setAttribute('aria-label', viewMode === 'year' ? 'Next year' : 'Next month');
      }
      if (yearSelect) yearSelect.value = String(viewYear);
      viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.calendarViewButton === viewMode)));
      root.dataset.calendarView = viewMode;
      if (grid) grid.dataset.view = viewMode;
      if (breakdown) breakdown.hidden = viewMode !== 'month';
    };

    const renderYear = (records: DailyRecord[], selected: Set<PursuitName>) => {
      if (!grid || !label || !status || !meta) return;
      const map = new Map(records.map((record) => [record.date, record]));
      const visibleEventsFor = (record: DailyRecord) => eventsFor(record).filter((event) => selected.has(event.pursuit));
      const yearEvents = records.flatMap(visibleEventsFor);
      const activeDates = records.filter((record) => visibleEventsFor(record).length > 0).length;
      const totalMinutes = yearEvents.reduce((total, event) => total + event.minutes, 0);

      label.textContent = String(viewYear);
      if (summaryDays) summaryDays.textContent = format(activeDates);
      if (summaryHours) summaryHours.textContent = format(totalMinutes / 60, 1);
      if (summaryTypes) summaryTypes.textContent = format(selected.size);

      const months: string[] = [];
      for (let month = 0; month < 12; month += 1) {
        const monthStart = new Date(viewYear, month, 1, 12);
        const monthName = monthStart.toLocaleDateString('en-US', { month: 'long' });
        const startOffset = monthStart.getDay();
        const daysInMonth = new Date(viewYear, month + 1, 0, 12).getDate();
        const cells: string[] = [];
        for (let blank = 0; blank < startOffset; blank += 1) cells.push('<span class="year-day year-day--blank" aria-hidden="true"></span>');
        for (let day = 1; day <= daysInMonth; day += 1) {
          const dateKey = keyFor(viewYear, month, day);
          const record = map.get(dateKey);
          const events = record ? visibleEventsFor(record) : [];
          const future = Boolean(meta.dataThrough && dateKey > meta.dataThrough);
          const dayLabel = new Date(viewYear, month, day, 12).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
          const marks = events.map((event) => `<i class="year-mark year-mark--${event.pursuit}" style="--mark-fill:${intensityFor(event)}%"></i>`).join('');
          const details = events.length ? ` · ${events.map((event) => event.detail).join(' · ')}` : '';
          const content = `<span class="year-day-number">${day}</span><span class="year-day-marks">${marks}</span>`;
          if (!future && record) {
            cells.push(`<a class="year-day${events.length ? ' year-day--active' : ''}" role="gridcell" href="${dayBase}?date=${dateKey}" title="${dayLabel}${details}" aria-label="${dayLabel}${events.length ? `, ${events.length} visible pursuits` : ', no visible pursuits'}">${content}</a>`);
          } else {
            cells.push(`<span class="year-day${future ? ' year-day--future' : ''}" role="gridcell" aria-label="${dayLabel}${future ? ', future date' : ', no record'}">${content}</span>`);
          }
        }
        months.push(`<section class="year-month" aria-label="${monthName} ${viewYear}"><h4>${monthName}</h4><div class="year-weekdays" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div><div class="year-days" role="grid">${cells.join('')}</div></section>`);
      }

      grid.innerHTML = `<div class="year-months">${months.join('')}</div>`;
      status.textContent = selected.size === 0
        ? 'Select a pursuit to explore its history across the year.'
        : yearEvents.length
          ? `${format(yearEvents.length)} visible pursuit ${yearEvents.length === 1 ? 'entry' : 'entries'} across ${format(activeDates)} active ${activeDates === 1 ? 'day' : 'days'} in ${viewYear}.`
          : `No activity for the selected pursuits was recorded in ${viewYear}.`;
    };

    const renderMonth = (records: DailyRecord[], selected: Set<PursuitName>) => {
      if (!grid || !label || !status || !meta) return;
      const map = new Map(records.map((record) => [record.date, record]));
      const visibleEventsFor = (record: DailyRecord) => eventsFor(record).filter((event) => selected.has(event.pursuit));
      const monthStart = new Date(viewYear, viewMonth, 1, 12);
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0, 12).getDate();
      const previousMonthDays = new Date(viewYear, viewMonth, 0, 12).getDate();
      const startOffset = monthStart.getDay();
      const cellCount = Math.ceil((startOffset + daysInMonth) / 7) * 7;
      const monthRecords = records.filter((record) => Number(record.date.slice(5, 7)) - 1 === viewMonth);
      const monthEvents = monthRecords.flatMap(visibleEventsFor);
      const activeDates = monthRecords.filter((record) => visibleEventsFor(record).length > 0).length;
      const totalMinutes = monthEvents.reduce((total, event) => total + event.minutes, 0);

      label.textContent = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      if (summaryDays) summaryDays.textContent = format(activeDates);
      if (summaryHours) summaryHours.textContent = format(totalMinutes / 60, 1);
      if (summaryTypes) summaryTypes.textContent = format(selected.size);
      renderBreakdown(monthRecords, selected, monthStart);

      const html: string[] = [];
      for (let index = 0; index < cellCount; index += 1) {
        const relativeDay = index - startOffset + 1;
        let cellYear = viewYear;
        let cellMonth = viewMonth;
        let day = relativeDay;
        let outside = false;
        if (relativeDay < 1) {
          outside = true;
          day = previousMonthDays + relativeDay;
          cellMonth -= 1;
          if (cellMonth < 0) { cellMonth = 11; cellYear -= 1; }
        } else if (relativeDay > daysInMonth) {
          outside = true;
          day = relativeDay - daysInMonth;
          cellMonth += 1;
          if (cellMonth > 11) { cellMonth = 0; cellYear += 1; }
        }
        const dateKey = keyFor(cellYear, cellMonth, day);
        const record = map.get(dateKey);
        const events = record ? visibleEventsFor(record) : [];
        const future = Boolean(meta.dataThrough && dateKey > meta.dataThrough);
        const dayLabel = new Date(cellYear, cellMonth, day, 12).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
        const chips = events.map((event) => `<span class="event event--${event.pursuit}" style="--event-fill:${intensityFor(event)}%" title="${event.detail}"><span>${event.label}</span></span>`).join('');
        const content = `<span class="day-number">${day}</span><div class="day-events">${chips}</div>`;
        if (!outside && !future && record) {
          html.push(`<a class="day${events.length ? ' day--active' : ''}" role="gridcell" href="${dayBase}?date=${dateKey}" aria-label="${dayLabel}${events.length ? `, ${events.length} visible pursuits` : ', no visible pursuits'}">${content}</a>`);
        } else {
          html.push(`<article class="day${outside ? ' day--outside' : ''}${future ? ' day--future' : ''}" role="gridcell" aria-label="${dayLabel}${future ? ', future date' : ', outside current month'}">${content}</article>`);
        }
      }

      grid.innerHTML = html.join('');
      status.textContent = selected.size === 0
        ? 'Select a pursuit to explore its history.'
        : monthEvents.length
          ? `${format(monthEvents.length)} visible pursuit ${monthEvents.length === 1 ? 'entry' : 'entries'} across ${format(activeDates)} active ${activeDates === 1 ? 'day' : 'days'}.`
          : 'No activity for the selected pursuits was recorded in this month.';
    };

    const render = async () => {
      if (!grid || !label || !status || !meta) return;
      const token = ++requestToken;
      const selected = selectedPursuits();
      status.textContent = 'Loading pursuit activity…';
      grid.setAttribute('aria-busy', 'true');
      syncControls();
      try {
        const records = await loadYear(viewYear);
        if (token !== requestToken) return;
        if (viewMode === 'year') renderYear(records, selected);
        else renderMonth(records, selected);
      } catch (error) {
        if (token !== requestToken) return;
        grid.innerHTML = '<p class="calendar-error">The pursuit calendar is temporarily unavailable.</p>';
        if (breakdownGrid) breakdownGrid.innerHTML = '';
        status.textContent = error instanceof Error ? error.message : 'The daily Archive could not be loaded.';
      } finally {
        if (token === requestToken) grid.removeAttribute('aria-busy');
      }
    };

    const movePeriod = (amount: number) => {
      if (viewMode === 'year') viewYear += amount;
      else {
        viewMonth += amount;
        if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
        if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      }
      void render();
    };

    previous?.addEventListener('click', () => { if (canMovePrevious()) movePeriod(-1); });
    next?.addEventListener('click', () => { if (canMoveNext()) movePeriod(1); });
    latest?.addEventListener('click', () => {
      if (!meta?.dataThrough) return;
      const through = parseIso(meta.dataThrough);
      viewYear = through.getFullYear();
      viewMonth = through.getMonth();
      void render();
    });
    yearSelect?.addEventListener('change', () => {
      viewYear = Number(yearSelect.value);
      if (meta?.dataThrough && viewMode === 'month') {
        const through = parseIso(meta.dataThrough);
        if (viewYear === through.getFullYear() && viewMonth > through.getMonth()) viewMonth = through.getMonth();
      }
      void render();
    });
    viewButtons.forEach((button) => button.addEventListener('click', () => {
      const nextView = button.dataset.calendarViewButton as CalendarView;
      if (nextView === viewMode) return;
      viewMode = nextView;
      void render();
    }));
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      setFilter(button, button.getAttribute('aria-pressed') !== 'true');
      void render();
    }));
    soloButtons.forEach((button) => button.addEventListener('click', () => {
      const pursuit = button.dataset.pursuitSolo;
      filterButtons.forEach((filterButton) => setFilter(filterButton, filterButton.dataset.pursuitFilter === pursuit));
      void render();
    }));
    filterAll?.addEventListener('click', () => {
      filterButtons.forEach((button) => setFilter(button, true));
      void render();
    });
    filterClear?.addEventListener('click', () => {
      filterButtons.forEach((button) => setFilter(button, false));
      void render();
    });

    getDailyMeta().then((incoming) => {
      meta = incoming;
      const through = incoming.dataThrough ? parseIso(incoming.dataThrough) : new Date();
      viewYear = through.getFullYear();
      viewMonth = through.getMonth();
      incoming.availableYears.slice().sort((a, b) => b - a).forEach((year) => {
        const option = document.createElement('option');
        option.value = String(year);
        option.textContent = String(year);
        yearSelect?.append(option);
      });
      void render();
    }).catch((error) => {
      if (status) status.textContent = error instanceof Error ? error.message : 'The daily Archive could not be initialized.';
      if (grid) grid.innerHTML = '<p class="calendar-error">The pursuit calendar is temporarily unavailable.</p>';
    });
  }
</script>

<style>
  .calendar-section{max-width:1380px;margin:0 auto;padding:8px clamp(14px,3vw,48px) 54px}
  .calendar-heading{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:18px}
  .calendar-eyebrow{margin:0 0 5px;color:#405cf5;font-size:.72rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
  .calendar-heading h2{margin:0;color:#111827;font-size:clamp(1.8rem,4vw,3.2rem);letter-spacing:-.045em}
  .calendar-intro{max-width:760px;margin:8px 0 0;color:#626978;line-height:1.65}
  .calendar-summary{display:grid;grid-template-columns:repeat(3,minmax(90px,1fr));gap:9px;min-width:min(100%,360px)}
  .calendar-summary div{padding:13px;border:1px solid #e4e8ef;border-radius:15px;background:rgba(255,255,255,.9);text-align:center;box-shadow:0 8px 22px rgba(15,23,42,.05)}
  .calendar-summary strong{display:block;color:#111827;font-size:1.35rem}.calendar-summary span{display:block;margin-top:2px;color:#707786;font-size:.69rem}
  .calendar-shell{overflow:hidden;border:1px solid #dfe4ec;border-radius:24px;background:rgba(255,255,255,.92);box-shadow:0 18px 48px rgba(15,23,42,.09)}
  .calendar-toolbar{padding:14px 18px 12px;border-bottom:1px solid #e5e9f0;background:rgba(255,255,255,.78)}
  .toolbar-main{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;min-height:38px}
