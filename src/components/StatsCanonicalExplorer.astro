<style is:global>
  #graphs > .explorer-shell,
  #hobby-time .hobby-shell,
  #hobby-time .daily-hobby-shell {
    display: none !important;
  }

  .canonical-explorer,
  .canonical-hobby {
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.09);
  }

  .canonical-toolbar {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
    background: linear-gradient(120deg, rgba(235, 242, 255, 0.88), rgba(235, 250, 243, 0.8));
  }

  .canonical-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .canonical-metric,
  .canonical-view,
  .canonical-style-button {
    min-height: 44px;
    padding: 0.58rem 0.7rem;
    border: 1px solid rgba(15, 23, 42, 0.13);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    color: #475467;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
  }

  .canonical-metric.is-active,
  .canonical-view.is-active,
  .canonical-style-button.is-active {
    border-color: #111827;
    background: #111827;
    color: #fff;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.16);
  }

  .canonical-control-row {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(150px, 0.55fr) minmax(170px, 0.65fr);
    gap: 0.8rem;
    align-items: end;
  }

  .canonical-views {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .canonical-field {
    display: grid;
    gap: 0.42rem;
    color: #667085;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .canonical-field select {
    min-height: 44px;
    padding: 0.58rem 0.75rem;
    border: 1px solid rgba(15, 23, 42, 0.13);
    border-radius: 14px;
    background: #fff;
    color: #111827;
    font: inherit;
    font-weight: 750;
  }

  .canonical-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
    padding: 1rem 1.25rem;
  }

  .canonical-summary article {
    padding: 0.85rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.95rem;
    background: #f8fafc;
  }

  .canonical-summary span {
    display: block;
    color: #64748b;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .canonical-summary strong {
    display: block;
    margin-top: 0.35rem;
    color: #0f172a;
    font-size: 1.15rem;
  }

  .canonical-chart-panel {
    margin: 0 1.25rem 1.25rem;
    padding: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.82);
  }

  .canonical-chart-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }

  .canonical-chart-heading strong,
  .canonical-chart-heading span {
    display: block;
  }

  .canonical-chart-heading span {
    margin-top: 0.2rem;
    color: #64748b;
    font-size: 0.8rem;
  }

  .canonical-chart {
    min-height: 350px;
    overflow-x: auto;
    border-radius: 0.85rem;
    background: #f8fafc;
  }

  .canonical-chart svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .canonical-axis {
    fill: #64748b;
    font-size: 12px;
  }

  .canonical-axis-title {
    fill: #475569;
    font-size: 12px;
    font-weight: 700;
  }

  .canonical-grid {
    stroke: rgba(148, 163, 184, 0.25);
    stroke-width: 1;
  }

  .canonical-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 0 1.25rem 1.2rem;
    color: #64748b;
    font-size: 0.84rem;
  }

  .canonical-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .canonical-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .canonical-legend i {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: var(--legend-color);
  }

  .canonical-hobby-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
    background: linear-gradient(120deg, rgba(235, 242, 255, 0.88), rgba(255, 247, 221, 0.75));
  }

  .canonical-hobby-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .canonical-hobby-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .canonical-hobby-toggle span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.48rem 0.68rem;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 999px;
    background: #fff;
    color: #475569;
    font-size: 0.78rem;
    font-weight: 750;
    cursor: pointer;
  }

  .canonical-hobby-toggle input:checked + span {
    border-color: var(--metric-color);
    box-shadow: inset 0 0 0 1px var(--metric-color);
    color: #0f172a;
  }

  .canonical-hobby-style {
    display: flex;
    gap: 0.42rem;
  }

  .canonical-hobby-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    padding: 1rem 1.25rem;
  }

  .canonical-hobby-summary article {
    padding: 0.85rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.95rem;
    background: #f8fafc;
  }

  .canonical-hobby-summary span {
    display: block;
    color: #64748b;
    font-size: 0.7rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .canonical-hobby-summary strong {
    display: block;
    margin-top: 0.35rem;
    color: #0f172a;
    font-size: 1.15rem;
  }

  .canonical-hobby-chart {
    padding: 0 1.25rem 1rem;
    overflow-x: auto;
  }

  .canonical-hobby-chart svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .canonical-hobby-shares {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0 1.25rem 1.25rem;
  }

  .canonical-hobby-shares article {
    padding: 0.75rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 0.85rem;
  }

  .canonical-hobby-shares span {
    display: block;
    color: #64748b;
    font-size: 0.72rem;
  }

  .canonical-hobby-shares strong {
    display: block;
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .canonical-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .canonical-control-row { grid-template-columns: 1fr 1fr; }
    .canonical-control-row > :first-child { grid-column: 1 / -1; }
    .canonical-summary,
    .canonical-hobby-shares { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .canonical-control-row,
    .canonical-summary,
    .canonical-hobby-summary,
    .canonical-hobby-shares { grid-template-columns: 1fr; }
    .canonical-control-row > :first-child { grid-column: auto; }
    .canonical-footer,
    .canonical-hobby-controls { align-items: stretch; flex-direction: column; }
  }

  :global(html.dark) .canonical-explorer,
  :global(html.dark) .canonical-hobby,
  :global(html.dark) .canonical-field select,
  :global(html.dark) .canonical-metric,
  :global(html.dark) .canonical-view,
  :global(html.dark) .canonical-style-button,
  :global(html.dark) .canonical-chart-panel,
  :global(html.dark) .canonical-hobby-toggle span,
  :global(body.dark) .canonical-explorer,
  :global(body.dark) .canonical-hobby,
  :global(body.dark) .canonical-field select,
  :global(body.dark) .canonical-metric,
  :global(body.dark) .canonical-view,
  :global(body.dark) .canonical-style-button,
  :global(body.dark) .canonical-chart-panel,
  :global(body.dark) .canonical-hobby-toggle span {
    background: #111827;
    color: #f8fafc;
    border-color: rgba(148, 163, 184, 0.2);
  }

  :global(html.dark) .canonical-summary article,
  :global(html.dark) .canonical-hobby-summary article,
  :global(body.dark) .canonical-summary article,
  :global(body.dark) .canonical-hobby-summary article,
  :global(html.dark) .canonical-chart,
  :global(body.dark) .canonical-chart {
    background: #0f172a;
  }

  :global(html.dark) .canonical-summary strong,
  :global(html.dark) .canonical-hobby-summary strong,
  :global(body.dark) .canonical-summary strong,
  :global(body.dark) .canonical-hobby-summary strong {
    color: #f8fafc;
  }
</style>

<script>
  import { getDailyMeta, getYears } from '../utils/dailyData';
  import type { DailyMeta, DailyRecord } from '../utils/dailyData';

  const NS = 'http://www.w3.org/2000/svg';
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  type MetricKey = 'guitar' | 'audiobook' | 'running' | 'diary' | 'dance' | 'work' | 'language' | 'treadmill';
  type ViewKey = 'monthly' | 'daily' | 'cumulative';
  type Metric = {
    key: MetricKey;
    label: string;
    icon: string;
    unit: string;
    digits: number;
    value: (record: DailyRecord) => number | null;
  };
  type SeriesPoint = {
    label: string;
    date?: string;
    value: number | null;
    future: boolean;
  };

  const METRICS: Metric[] = [
    { key: 'guitar', label: 'Guitar', icon: '🎸', unit: 'hours', digits: 1, value: (record) => record.hobbies.guitarMinutes === null ? null : record.hobbies.guitarMinutes / 60 },
    { key: 'audiobook', label: 'Audiobooks', icon: '📚', unit: 'hours', digits: 1, value: (record) => record.audiobook.minutes === null ? null : record.audiobook.minutes / 60 },
    { key: 'running', label: 'Running', icon: '🏃', unit: 'miles', digits: 1, value: (record) => record.hobbies.runningMiles },
    { key: 'diary', label: 'Diary', icon: '📓', unit: 'words', digits: 0, value: (record) => record.diary.words },
    { key: 'dance', label: 'Dance', icon: '💃', unit: 'hours', digits: 1, value: (record) => record.hobbies.danceMinutes === null ? null : record.hobbies.danceMinutes / 60 },
    { key: 'work', label: 'Work & study', icon: '🧠', unit: 'hours', digits: 1, value: (record) => record.work.hours },
    { key: 'language', label: 'Language study', icon: '🌍', unit: 'hours', digits: 1, value: (record) => record.hobbies.languageMinutes === null ? null : record.hobbies.languageMinutes / 60 },
    { key: 'treadmill', label: 'Treadmill', icon: '🚶', unit: 'hours', digits: 1, value: (record) => record.hobbies.treadmillMinutes === null ? null : record.hobbies.treadmillMinutes / 60 },
  ];

  const HOBBIES = [
    { key: 'guitar', label: 'Guitar', icon: '🎸', color: '#2563eb', value: METRICS[0].value },
    { key: 'audiobook', label: 'Audiobooks', icon: '📚', color: '#6d28d9', value: METRICS[1].value },
    { key: 'dance', label: 'Dance', icon: '💃', color: '#e11d48', value: METRICS[4].value },
    { key: 'running', label: 'Running estimate', icon: '🏃', color: '#059669', value: (record: DailyRecord) => record.hobbies.runningMiles === null ? null : record.hobbies.runningMiles / 6 },
    { key: 'treadmill', label: 'Treadmill', icon: '🚶', color: '#ea580c', value: METRICS[7].value },
    { key: 'language', label: 'Language study', icon: '🌍', color: '#a16207', value: METRICS[6].value },
  ];

  const parseIso = (value: string) => new Date(`${value}T12:00:00`);
  const toIso = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  const format = (value: number | null, digits = 0) => value === null || !Number.isFinite(value)
    ? '—'
    : new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
  const sum = (values: Array<number | null>) => values.reduce((total, value) => total + (value ?? 0), 0);
  const average = (values: Array<number | null>) => {
    const valid = values.filter((value): value is number => value !== null && Number.isFinite(value));
    return valid.length ? sum(valid) / valid.length : null;
  };
  const escape = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
  const svg = (tag: string, attrs: Record<string, string | number> = {}) => {
    const node = document.createElementNS(NS, tag);
    Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, String(value)));
    return node;
  };
  const setText = (root: ParentNode, selector: string, value: string) => {
    const node = root.querySelector(selector);
    if (node) node.textContent = value;
  };
  const waitFor = async (selector: string, attempts = 120) => {
    for (let index = 0; index < attempts; index += 1) {
      const node = document.querySelector(selector);
      if (node instanceof HTMLElement) return node;
      await new Promise((resolve) => setTimeout(resolve, 25));
    }
    return null;
  };

  function metricByKey(key: string) {
    return METRICS.find((metric) => metric.key === key) || METRICS[0];
  }

  function recordsForYear(records: DailyRecord[], year: number) {
    return records.filter((record) => Number(record.date.slice(0, 4)) === year);
  }

  function monthlySeries(records: DailyRecord[], year: number, metric: Metric, meta: DailyMeta): SeriesPoint[] {
    const yearRecords = recordsForYear(records, year);
    const throughYear = Number((meta.dataThrough || '').slice(0, 4));
    const throughMonth = meta.dataThrough && throughYear === year ? Number(meta.dataThrough.slice(5, 7)) - 1 : 11;

    return MONTHS.map((label, month) => {
      const values = yearRecords
        .filter((record) => parseIso(record.date).getMonth() === month)
        .map(metric.value)
        .filter((value): value is number => value !== null && Number.isFinite(value));
      const future = year === throughYear && month > throughMonth;
      return { label, value: future || !values.length ? null : sum(values), future };
    });
  }

  function cumulativeSeries(points: SeriesPoint[]) {
    let running = 0;
    return points.map((point) => {
      if (point.future) return { ...point, value: null };
      if (point.value !== null) running += point.value;
      return { ...point, value: point.value === null && running === 0 ? null : running };
    });
  }

  function dailySeries(records: DailyRecord[], year: number, metric: Metric, meta: DailyMeta): SeriesPoint[] {
    const map = new Map(recordsForYear(records, year).map((record) => [record.date, record]));
    const points: SeriesPoint[] = [];
    const end = new Date(year, 11, 31, 12);

    for (const date = new Date(year, 0, 1, 12); date <= end; date.setDate(date.getDate() + 1)) {
      const iso = toIso(date);
      const record = map.get(iso);
      const future = Boolean(meta.dataThrough && iso > meta.dataThrough);
      points.push({
        label: new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(date),
        date: iso,
        value: future || !record ? null : metric.value(record),
        future,
      });
    }
    return points;
  }

  function smoothPath(points: Array<{ x: number; y: number }>) {
    if (!points.length) return '';
    if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;
    let path = `M ${points[0].x} ${points[0].y}`;
    for (let index = 1; index < points.length; index += 1) {
      const previous = points[index - 1];
      const current = points[index];
      const midpoint = (previous.x + current.x) / 2;
      path += ` C ${midpoint} ${previous.y}, ${midpoint} ${current.y}, ${current.x} ${current.y}`;
    }
    return path;
  }

  function splitSegments(points: SeriesPoint[], x: (index: number) => number, y: (value: number) => number) {
    const segments: Array<Array<{ x: number; y: number }>> = [];
    let current: Array<{ x: number; y: number }> = [];
    points.forEach((point, index) => {
      if (point.value === null) {
        if (current.length) segments.push(current);
        current = [];
      } else {
        current.push({ x: x(index), y: y(point.value) });
      }
    });
    if (current.length) segments.push(current);
    return segments;
  }

  function drawLineChart(host: HTMLElement, selected: SeriesPoint[], comparison: SeriesPoint[] | null, metric: Metric, view: ViewKey, selectedYear: number, compareYear: number | null) {
    const width = 1000;
    const height = 390;
    const margin = { left: 72, right: 24, top: 30, bottom: 60 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const allValues = [...selected, ...(comparison || [])].map((point) => point.value).filter((value): value is number => value !== null);
    const maximum = Math.max(1, ...allValues);
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `${metric.label} ${view} chart` });

    for (let index = 0; index <= 5; index += 1) {
      const value = maximum * (5 - index) / 5;
      const y = margin.top + innerHeight * index / 5;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'canonical-grid' }));
      const label = svg('text', { x: margin.left - 10, y: y + 4, 'text-anchor': 'end', class: 'canonical-axis' });
      label.textContent = format(value, metric.digits);
      chart.append(label);
    }

    const slot = innerWidth / Math.max(1, selected.length - 1);
    const x = (index: number) => margin.left + slot * index;
    const y = (value: number) => margin.top + innerHeight - (value / maximum) * innerHeight;

    const firstFuture = selected.findIndex((point) => point.future);
    if (firstFuture >= 0) {
      const startX = Math.max(margin.left, x(firstFuture) - slot / 2);
      chart.append(svg('rect', { x: startX, y: margin.top, width: width - margin.right - startX, height: innerHeight, fill: 'rgba(148,163,184,.08)' }));
    }

    const drawSeries = (points: SeriesPoint[], color: string, dashed: boolean, year: number) => {
      splitSegments(points, x, y).forEach((segment) => {
        const path = svg('path', {
          d: smoothPath(segment),
          fill: 'none',
          stroke: color,
          'stroke-width': dashed ? 2.5 : 3,
          'stroke-linecap': 'round',
          'stroke-linejoin': 'round',
          ...(dashed ? { 'stroke-dasharray': '8 7' } : {}),
        });
        chart.append(path);
      });
      points.forEach((point, index) => {
        if (point.value === null) return;
        const circle = svg('circle', { cx: x(index), cy: y(point.value), r: dashed ? 3 : 4, fill: color, tabindex: 0 });
        const title = svg('title');
        title.textContent = `${point.label} ${year}: ${format(point.value, metric.digits)} ${metric.unit}`;
        circle.append(title);
        chart.append(circle);
      });
    };

    drawSeries(selected, '#2563eb', false, selectedYear);
    if (comparison && compareYear) drawSeries(comparison, '#d97706', true, compareYear);

    selected.forEach((point, index) => {
      const label = svg('text', { x: x(index), y: height - 28, 'text-anchor': 'middle', class: 'canonical-axis' });
      label.textContent = point.label;
      chart.append(label);
    });

    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = metric.unit;
    chart.append(yTitle);
    const xTitle = svg('text', { x: margin.left + innerWidth / 2, y: height - 7, 'text-anchor': 'middle', class: 'canonical-axis-title' });
    xTitle.textContent = 'Month';
    chart.append(xTitle);
    host.replaceChildren(chart);
  }

  function drawDailyChart(host: HTMLElement, points: SeriesPoint[], metric: Metric, year: number) {
    const width = 1100;
    const height = 390;
    const margin = { left: 72, right: 24, top: 30, bottom: 60 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const values = points.map((point) => point.value).filter((value): value is number => value !== null);
    const maximum = Math.max(1, ...values);
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `${metric.label} daily chart for ${year}` });

    for (let index = 0; index <= 5; index += 1) {
      const value = maximum * (5 - index) / 5;
      const y = margin.top + innerHeight * index / 5;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'canonical-grid' }));
      const label = svg('text', { x: margin.left - 10, y: y + 4, 'text-anchor': 'end', class: 'canonical-axis' });
      label.textContent = format(value, metric.digits);
      chart.append(label);
    }

    const slot = innerWidth / points.length;
    const barWidth = Math.max(1, slot * 0.78);
    const firstFuture = points.findIndex((point) => point.future);
    if (firstFuture >= 0) {
      const startX = margin.left + firstFuture * slot;
      chart.append(svg('rect', { x: startX, y: margin.top, width: width - margin.right - startX, height: innerHeight, fill: 'rgba(148,163,184,.08)' }));
    }

    points.forEach((point, index) => {
      if (point.future) return;
      const heightValue = point.value === null ? 3 : Math.max(point.value === 0 ? 2 : 3, (point.value / maximum) * innerHeight);
      const rect = svg('rect', {
        x: margin.left + slot * index + (slot - barWidth) / 2,
        y: margin.top + innerHeight - heightValue,
        width: barWidth,
        height: heightValue,
        rx: Math.min(2, barWidth / 2),
        fill: point.value === null ? '#cbd5e1' : point.value === 0 ? '#94a3b8' : '#2563eb',
        tabindex: 0,
      });
      const title = svg('title');
      title.textContent = `${point.label} ${year}: ${point.value === null ? 'not logged' : `${format(point.value, metric.digits)} ${metric.unit}`}`;
      rect.append(title);
      if (point.date) rect.addEventListener('click', () => location.href = `/day/?date=${point.date}`);
      chart.append(rect);
    });

    for (let month = 0; month < 12; month += 1) {
      const date = new Date(year, month, 1, 12);
      const dayIndex = Math.floor((date.getTime() - new Date(year, 0, 1, 12).getTime()) / 86400000);
      const label = svg('text', { x: margin.left + slot * dayIndex, y: height - 28, 'text-anchor': 'start', class: 'canonical-axis' });
      label.textContent = MONTHS[month];
      chart.append(label);
    }

    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = metric.unit;
    chart.append(yTitle);
    const xTitle = svg('text', { x: margin.left + innerWidth / 2, y: height - 7, 'text-anchor': 'middle', class: 'canonical-axis-title' });
    xTitle.textContent = 'Date';
    chart.append(xTitle);
    host.replaceChildren(chart);
  }

  function initExplorer(records: DailyRecord[], meta: DailyMeta) {
    const section = document.querySelector('#graphs');
    const oldShell = section?.querySelector('.explorer-shell');
    if (!(section instanceof HTMLElement) || !(oldShell instanceof HTMLElement) || section.querySelector('.canonical-explorer')) return;

    const description = section.querySelector('.section-heading > p:last-child');
    if (description) description.textContent = 'All views now come from the public daily archive. Monthly totals and cumulative totals are calculated from the same day-level records shown in Daily view.';

    const shell = document.createElement('div');
    shell.className = 'canonical-explorer';
    shell.innerHTML = `
      <div class="canonical-toolbar">
        <div>
          <span class="control-label">Metric</span>
          <div class="canonical-metrics" data-canonical-metrics>
            ${METRICS.map((metric, index) => `<button type="button" class="canonical-metric ${index === 0 ? 'is-active' : ''}" data-metric="${metric.key}">${metric.icon} ${metric.label}</button>`).join('')}
          </div>
        </div>
        <div class="canonical-control-row">
          <div>
            <span class="control-label">View</span>
            <div class="canonical-views" data-canonical-views>
              <button type="button" class="canonical-view is-active" data-view="monthly">Monthly</button>
              <button type="button" class="canonical-view" data-view="daily">Daily</button>
              <button type="button" class="canonical-view" data-view="cumulative">Cumulative</button>
            </div>
          </div>
          <label class="canonical-field">Period<select data-canonical-year>${meta.availableYears.slice().reverse().map((year) => `<option value="${year}">${year}</option>`).join('')}</select></label>
          <label class="canonical-field">Compare<select data-canonical-compare><option value="">No comparison</option>${meta.availableYears.slice().reverse().map((year) => `<option value="${year}">${year}</option>`).join('')}</select></label>
        </div>
      </div>
      <div class="canonical-summary">
        <article><span data-summary-total-label>Selected total</span><strong data-summary-total>—</strong></article>
        <article><span data-summary-average-label>Monthly average</span><strong data-summary-average>—</strong></article>
        <article><span data-summary-peak-label>Peak month</span><strong data-summary-peak>—</strong></article>
        <article><span data-summary-change-label>Change vs prior year</span><strong data-summary-change>—</strong></article>
      </div>
      <div class="canonical-chart-panel">
        <div class="canonical-chart-heading"><div><strong data-chart-title>Archive chart</strong><span data-chart-subtitle></span></div><span data-chart-unit></span></div>
        <div class="canonical-chart" data-canonical-chart><div class="daily-live-empty">Loading archive data…</div></div>
      </div>
      <div class="canonical-footer"><div class="canonical-legend" data-canonical-legend></div><span>Source: public daily archive · monthly and cumulative values are calculated in the browser.</span></div>
    `;
    oldShell.after(shell);

    const yearSelect = shell.querySelector('[data-canonical-year]') as HTMLSelectElement;
    const compareSelect = shell.querySelector('[data-canonical-compare]') as HTMLSelectElement;
    const latestYear = Number((meta.latestCompleteDate || meta.dataThrough || '').slice(0, 4)) || meta.availableYears.at(-1) || new Date().getFullYear();
    yearSelect.value = String(latestYear);

    const params = new URL(location.href).searchParams;
    let metricKey = metricByKey(params.get('metric') || '').key;
    let view: ViewKey = ['monthly', 'daily', 'cumulative'].includes(params.get('view') || '') ? params.get('view') as ViewKey : 'monthly';
    const requestedYear = Number(params.get('year'));
    if (meta.availableYears.includes(requestedYear)) yearSelect.value = String(requestedYear);

    const updateButtons = () => {
      shell.querySelectorAll('[data-metric]').forEach((button) => button.classList.toggle('is-active', (button as HTMLElement).dataset.metric === metricKey));
      shell.querySelectorAll('[data-view]').forEach((button) => button.classList.toggle('is-active', (button as HTMLElement).dataset.view === view));
      compareSelect.disabled = view === 'daily';
    };

    const render = () => {
      const metric = metricByKey(metricKey);
      const year = Number(yearSelect.value);
      const compareYear = compareSelect.value && view !== 'daily' ? Number(compareSelect.value) : null;
      const monthly = monthlySeries(records, year, metric, meta);
      const selected = view === 'daily' ? dailySeries(records, year, metric, meta) : view === 'cumulative' ? cumulativeSeries(monthly) : monthly;
      const comparisonMonthly = compareYear ? monthlySeries(records, compareYear, metric, meta) : null;
      const comparison = comparisonMonthly ? (view === 'cumulative' ? cumulativeSeries(comparisonMonthly) : comparisonMonthly) : null;
      const measured = selected.filter((point) => point.value !== null && !point.future);
      const baseForPeak = view === 'cumulative' ? monthly : selected;
      const peak = baseForPeak.reduce<SeriesPoint | null>((winner, point) => point.value === null ? winner : !winner || winner.value === null || point.value > winner.value ? point : winner, null);
      const selectedTotal = view === 'cumulative' ? [...measured].reverse()[0]?.value ?? null : sum(measured.map((point) => point.value));
      const selectedAverage = average(measured.map((point) => point.value));

      const benchmarkYear = compareYear || year - 1;
      const benchmarkMonthly = meta.availableYears.includes(benchmarkYear) ? monthlySeries(records, benchmarkYear, metric, meta) : null;
      let change: number | null = null;
      if (benchmarkMonthly) {
        const selectedMeasuredMonths = monthly.filter((point) => !point.future && point.value !== null).length;
        const selectedValue = sum(monthly.slice(0, selectedMeasuredMonths).map((point) => point.value));
        const benchmarkValue = sum(benchmarkMonthly.slice(0, selectedMeasuredMonths).map((point) => point.value));
        if (benchmarkValue !== 0) change = ((selectedValue - benchmarkValue) / Math.abs(benchmarkValue)) * 100;
      }

      setText(shell, '[data-summary-total-label]', view === 'cumulative' ? 'Cumulative total' : 'Selected total');
      setText(shell, '[data-summary-average-label]', view === 'daily' ? 'Average measured day' : 'Monthly average');
      setText(shell, '[data-summary-peak-label]', view === 'daily' ? 'Peak day' : 'Peak month');
      setText(shell, '[data-summary-total]', `${format(selectedTotal, metric.digits)} ${metric.unit}`);
      setText(shell, '[data-summary-average]', `${format(selectedAverage, metric.digits)} ${metric.unit}`);
      setText(shell, '[data-summary-peak]', peak && peak.value !== null ? `${peak.label} · ${format(peak.value, metric.digits)} ${metric.unit}` : 'No data');
      setText(shell, '[data-summary-change-label]', `Change vs ${benchmarkYear}`);
      setText(shell, '[data-summary-change]', change === null ? 'No comparable baseline' : `${change > 0 ? '+' : ''}${format(change, 1)}%`);
      setText(shell, '[data-chart-title]', `${metric.icon} ${metric.label} · ${year}`);
      setText(shell, '[data-chart-subtitle]', view === 'daily' ? 'One mark per calendar day' : view === 'cumulative' ? 'Running total by month' : 'Monthly totals calculated from daily entries');
      setText(shell, '[data-chart-unit]', metric.unit);

      const host = shell.querySelector('[data-canonical-chart]');
      if (host instanceof HTMLElement) {
        if (view === 'daily') drawDailyChart(host, selected, metric, year);
        else drawLineChart(host, selected, comparison, metric, view, year, compareYear);
      }

      const legend = shell.querySelector('[data-canonical-legend]');
      if (legend) legend.innerHTML = `<span><i style="--legend-color:#2563eb"></i>${year}</span>${compareYear ? `<span><i style="--legend-color:#d97706"></i>${compareYear} comparison</span>` : ''}`;

      const url = new URL(location.href);
      url.searchParams.set('metric', metricKey);
      url.searchParams.set('view', view);
      url.searchParams.set('year', String(year));
      if (compareYear) url.searchParams.set('compare', String(compareYear)); else url.searchParams.delete('compare');
      history.replaceState({}, '', url);
      updateButtons();
    };

    shell.querySelectorAll('[data-metric]').forEach((button) => button.addEventListener('click', () => { metricKey = (button as HTMLElement).dataset.metric as MetricKey; render(); }));
    shell.querySelectorAll('[data-view]').forEach((button) => button.addEventListener('click', () => { view = (button as HTMLElement).dataset.view as ViewKey; render(); }));
    yearSelect.addEventListener('change', () => {
      if (compareSelect.value === yearSelect.value) compareSelect.value = '';
      render();
    });
    compareSelect.addEventListener('change', () => {
      if (compareSelect.value === yearSelect.value) compareSelect.value = '';
      render();
    });

    const requestedCompare = Number(params.get('compare'));
    if (meta.availableYears.includes(requestedCompare) && requestedCompare !== Number(yearSelect.value)) compareSelect.value = String(requestedCompare);
    updateButtons();
    render();
  }

  function hobbyMonthly(records: DailyRecord[], year: number, value: (record: DailyRecord) => number | null) {
    const yearRecords = recordsForYear(records, year);
    return MONTHS.map((_, month) => {
      const values = yearRecords.filter((record) => parseIso(record.date).getMonth() === month).map(value);
      return sum(values);
    });
  }

  function drawHobbyBars(host: HTMLElement, series: Array<{ label: string; color: string; values: number[] }>, year: number) {
    const width = 1000;
    const height = 400;
    const margin = { left: 68, right: 24, top: 28, bottom: 58 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const totals = MONTHS.map((_, month) => sum(series.map((item) => item.values[month] || 0)));
    const maximum = Math.max(1, ...totals);
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `Stacked hobby hours in ${year}` });

    for (let index = 0; index <= 5; index += 1) {
      const value = maximum * (5 - index) / 5;
      const y = margin.top + innerHeight * index / 5;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'canonical-grid' }));
      const label = svg('text', { x: margin.left - 9, y: y + 4, 'text-anchor': 'end', class: 'canonical-axis' });
      label.textContent = format(value, 1);
      chart.append(label);
    }

    const slot = innerWidth / 12;
    const barWidth = slot * 0.62;
    MONTHS.forEach((month, monthIndex) => {
      let accumulated = 0;
      series.forEach((item) => {
        const value = item.values[monthIndex] || 0;
        const heightValue = value / maximum * innerHeight;
        const rect = svg('rect', {
          x: margin.left + slot * monthIndex + (slot - barWidth) / 2,
          y: margin.top + innerHeight - accumulated - heightValue,
          width: barWidth,
          height: heightValue,
          fill: item.color,
        });
        const title = svg('title');
        title.textContent = `${month} ${year} · ${item.label}: ${format(value, 1)} hours`;
        rect.append(title);
        chart.append(rect);
        accumulated += heightValue;
      });
      const label = svg('text', { x: margin.left + slot * monthIndex + slot / 2, y: height - 28, 'text-anchor': 'middle', class: 'canonical-axis' });
      label.textContent = month;
      chart.append(label);
    });

    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = 'Hours';
    chart.append(yTitle);
    host.replaceChildren(chart);
  }

  function drawHobbyCurves(host: HTMLElement, series: Array<{ label: string; color: string; values: number[] }>, year: number) {
    const width = 1000;
    const height = 400;
    const margin = { left: 68, right: 24, top: 28, bottom: 58 };
    const innerWidth = width - margin.left - margin.right;
    const innerHeight = height - margin.top - margin.bottom;
    const maximum = Math.max(1, ...series.flatMap((item) => item.values));
    const chart = svg('svg', { viewBox: `0 0 ${width} ${height}`, role: 'img', 'aria-label': `Curved hobby-hour chart in ${year}` });

    for (let index = 0; index <= 5; index += 1) {
      const value = maximum * (5 - index) / 5;
      const y = margin.top + innerHeight * index / 5;
      chart.append(svg('line', { x1: margin.left, x2: width - margin.right, y1: y, y2: y, class: 'canonical-grid' }));
      const label = svg('text', { x: margin.left - 9, y: y + 4, 'text-anchor': 'end', class: 'canonical-axis' });
      label.textContent = format(value, 1);
      chart.append(label);
    }

    const x = (month: number) => margin.left + innerWidth * month / 11;
    const y = (value: number) => margin.top + innerHeight - value / maximum * innerHeight;
    series.forEach((item) => {
      const points = item.values.map((value, month) => ({ x: x(month), y: y(value) }));
      chart.append(svg('path', { d: smoothPath(points), fill: 'none', stroke: item.color, 'stroke-width': 3, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }));
      item.values.forEach((value, month) => {
        const circle = svg('circle', { cx: x(month), cy: y(value), r: 4, fill: item.color, tabindex: 0 });
        const title = svg('title');
        title.textContent = `${MONTHS[month]} ${year} · ${item.label}: ${format(value, 1)} hours`;
        circle.append(title);
        chart.append(circle);
      });
    });

    MONTHS.forEach((month, index) => {
      const label = svg('text', { x: x(index), y: height - 28, 'text-anchor': 'middle', class: 'canonical-axis' });
      label.textContent = month;
      chart.append(label);
    });
    const yTitle = svg('text', { x: -(margin.top + innerHeight / 2), y: 18, transform: 'rotate(-90)', 'text-anchor': 'middle', class: 'canonical-axis-title' });
    yTitle.textContent = 'Hours';
    chart.append(yTitle);
    host.replaceChildren(chart);
  }

  function initHobby(records: DailyRecord[], meta: DailyMeta) {
    const section = document.querySelector('#hobby-time');
    const oldShell = section?.querySelector('.hobby-shell');
    if (!(section instanceof HTMLElement) || !(oldShell instanceof HTMLElement) || section.querySelector('.canonical-hobby')) return;

    const description = section.querySelector('.section-heading > p:last-child');
    if (description) description.textContent = 'Switch between stacked bars and the earlier curved-line view. Every monthly hour value is calculated from daily records, with a more contrasting activity palette.';

    const shell = document.createElement('div');
    shell.className = 'canonical-hobby';
    shell.innerHTML = `
      <div class="canonical-hobby-controls">
        <label class="canonical-field">Year<select data-hobby-year>${meta.availableYears.slice().reverse().map((year) => `<option value="${year}">${year}</option>`).join('')}</select></label>
        <div><span class="control-label">Activities shown</span><div class="canonical-hobby-options">${HOBBIES.map((item) => `<label class="canonical-hobby-toggle"><input type="checkbox" value="${item.key}" checked><span style="--metric-color:${item.color}">${item.icon} ${item.label}</span></label>`).join('')}</div></div>
        <div><span class="control-label">Chart style</span><div class="canonical-hobby-style"><button type="button" class="canonical-style-button is-active" data-style="bars">Stacked bars</button><button type="button" class="canonical-style-button" data-style="curves">Curves</button></div></div>
      </div>
      <div class="canonical-hobby-summary"><article><span>Total selected time</span><strong data-hobby-total>—</strong></article><article><span>Largest share</span><strong data-hobby-largest>—</strong></article><article><span>Chart style</span><strong data-hobby-style-label>Stacked bars</strong></article></div>
      <div class="canonical-hobby-chart" data-hobby-chart></div>
      <div class="canonical-footer"><div class="canonical-legend" data-hobby-legend></div><span>Running time is estimated at 10 minutes per mile.</span></div>
      <div class="canonical-hobby-shares" data-hobby-shares></div>
    `;
    oldShell.after(shell);

    const yearSelect = shell.querySelector('[data-hobby-year]') as HTMLSelectElement;
    yearSelect.value = String(Number((meta.dataThrough || '').slice(0, 4)) || meta.availableYears.at(-1));
    let style: 'bars' | 'curves' = 'bars';

    const render = () => {
      const year = Number(yearSelect.value);
      const selected = HOBBIES.filter((item) => (shell.querySelector(`input[value="${item.key}"]`) as HTMLInputElement)?.checked);
      const series = selected.map((item) => ({ label: item.label, color: item.color, values: hobbyMonthly(records, year, item.value) }));
      const totals = series.map((item) => ({ ...item, total: sum(item.values) })).sort((a, b) => b.total - a.total);
      const total = sum(totals.map((item) => item.total));
      setText(shell, '[data-hobby-total]', `${format(total, 1)} hours in ${year}`);
      setText(shell, '[data-hobby-largest]', totals[0] ? `${totals[0].label} · ${format(total ? totals[0].total / total * 100 : 0, 1)}%` : 'No activities');
      setText(shell, '[data-hobby-style-label]', style === 'bars' ? 'Stacked bars' : 'Curved lines');

      const host = shell.querySelector('[data-hobby-chart]');
      if (host instanceof HTMLElement) {
        if (!series.length) host.innerHTML = '<div class="daily-live-empty">Select at least one activity.</div>';
        else if (style === 'curves') drawHobbyCurves(host, series, year);
        else drawHobbyBars(host, series, year);
      }
      const legend = shell.querySelector('[data-hobby-legend]');
      if (legend) legend.innerHTML = totals.map((item) => `<span><i style="--legend-color:${item.color}"></i>${escape(item.label)}</span>`).join('');
      const shares = shell.querySelector('[data-hobby-shares]');
      if (shares) shares.innerHTML = totals.map((item) => `<article><span>${escape(item.label)}</span><strong>${format(item.total, 1)} h · ${format(total ? item.total / total * 100 : 0, 1)}%</strong></article>`).join('');
    };

    yearSelect.addEventListener('change', render);
    shell.querySelectorAll('input').forEach((input) => input.addEventListener('change', render));
    shell.querySelectorAll('[data-style]').forEach((button) => button.addEventListener('click', () => {
      style = (button as HTMLElement).dataset.style as 'bars' | 'curves';
      shell.querySelectorAll('[data-style]').forEach((item) => item.classList.toggle('is-active', item === button));
      render();
    }));
    render();
  }

  async function init() {
    const dashboard = await waitFor('.stats-dashboard');
    if (!dashboard || dashboard.dataset.canonicalExplorerReady === 'true') return;
    dashboard.dataset.canonicalExplorerReady = 'true';
    try {
      const meta = await getDailyMeta();
      const records = await getYears(meta.availableYears);
      initExplorer(records, meta);
      initHobby(records, meta);
    } catch (error) {
      console.error('Canonical Stats explorer failed', error);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else void init();
</script>
