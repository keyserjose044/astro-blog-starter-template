---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import VideoBg from './VideoBg.astro';
import PursuitsNav from './PursuitsNav.astro';
import { SITE_TITLE } from '../consts';

type PursuitSection = 'dance' | 'running' | 'languages';
type RoadmapStatus = 'established' | 'developing' | 'next' | 'future';

type RoadmapItem = {
  title: string;
  note: string;
  status: RoadmapStatus;
};

type Chapter = {
  title: string;
  note: string;
};

interface Props {
  active: PursuitSection;
  title: string;
  icon: string;
  kicker: string;
  description: string;
  started: string;
  currentState: string;
  currentFocus: string;
  nextMilestone: string;
  roadmap: RoadmapItem[];
  chapters: Chapter[];
  archiveNote: string;
}

const {
  active,
  title,
  icon,
  kicker,
  description,
  started,
  currentState,
  currentFocus,
  nextMilestone,
  roadmap,
  chapters,
  archiveNote,
} = Astro.props;

const statusLabels: Record<RoadmapStatus, string> = {
  established: 'Established',
  developing: 'Developing',
  next: 'Next up',
  future: 'Future',
};
---

<BaseHead
  title={`${SITE_TITLE} — Pursuits — ${title}`}
  description={`${description} A living LifeLoggerz page for progress, resources, milestones, and archived practice.`}
/>

<VideoBg>
  <Header />
  <main class:list={['pursuit-page', `pursuit-page--${active}`]}>
    <PursuitsNav active={active} />

    <section class="hero" aria-labelledby="pursuit-title">
      <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="hero-kicker">{kicker}</p>
        <span class="hero-icon" aria-hidden="true">{icon}</span>
        <h1 id="pursuit-title">{title}</h1>
        <p>{description}</p>
        <div class="hero-actions">
          <a href="#roadmap">See the development map ↓</a>
          <a href="/pursuits/#calendar">Open the calendar ↗</a>
        </div>
      </div>
    </section>

    <section class="snapshot" aria-label={`${title} pursuit snapshot`}>
      <article><span>Started</span><strong>{started}</strong></article>
      <article><span>Current state</span><strong>{currentState}</strong></article>
      <article><span>Current focus</span><strong>{currentFocus}</strong></article>
      <article><span>Next milestone</span><strong>{nextMilestone}</strong></article>
    </section>

    <section class="page-section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <p class="eyebrow">Development map</p>
        <h2 id="roadmap-title">Progress is not one straight ladder</h2>
        <p>Different abilities move at different speeds. This first map makes the branches visible now and can later be driven by milestone data from the archive.</p>
      </div>

      <div class="roadmap-grid">
        {roadmap.map((item, index) => (
          <article class="roadmap-item" data-status={item.status}>
            <span class="roadmap-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <span class="status">{statusLabels[item.status]}</span>
              <h3>{item.title}</h3>
              <p>{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section" aria-labelledby="chapters-title">
      <div class="section-heading">
        <p class="eyebrow">Journey chapters</p>
        <h2 id="chapters-title">The page will preserve more than totals</h2>
        <p>Statistics show consistency. These chapters preserve the methods, turning points, frustrations, discoveries, and resources behind the numbers.</p>
      </div>

      <div class="chapter-grid">
        {chapters.map((chapter) => (
          <article>
            <h3>{chapter.title}</h3>
            <p>{chapter.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section archive-section" aria-labelledby="archive-title">
      <div>
        <p class="eyebrow">Archive connection</p>
        <h2 id="archive-title">Built for the Google Sheets history</h2>
        <p>{archiveNote}</p>
      </div>
      <div class="archive-actions">
        <a class="primary" href="/pursuits/#calendar">View Pursuits calendar</a>
        <a href={`/stats/?metric=${active}&year=current#graphs`}>View related statistics</a>
      </div>
    </section>
  </main>
  <Footer />
</VideoBg>

<style>
  .pursuit-page { --accent:#405cf5; --accent-soft:#eef1ff; --accent-deep:#2c3fb8; min-height:100vh; padding-bottom:54px; }
  .pursuit-page--dance { --accent:#c3428f; --accent-soft:#fff0f8; --accent-deep:#912861; }
  .pursuit-page--running { --accent:#278a63; --accent-soft:#edf9f3; --accent-deep:#176244; }
  .pursuit-page--languages { --accent:#405cf5; --accent-soft:#eef1ff; --accent-deep:#2c3fb8; }
  * { box-sizing:border-box; }
  .hero { position:relative; display:grid; place-items:center; min-height:460px; margin:0 clamp(12px,3vw,48px) 24px; overflow:hidden; border-radius:30px; background:radial-gradient(circle at 20% 20%,color-mix(in srgb,var(--accent) 72%,#fff),transparent 34%),linear-gradient(135deg,var(--accent-deep),#111827 72%); color:#fff; box-shadow:0 24px 70px rgba(15,23,42,.2); }
  .hero::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(0,0,0,.22)); pointer-events:none; }
  .hero-orbit { position:absolute; border:1px solid rgba(255,255,255,.22); border-radius:50%; }
  .hero-orbit--one { width:420px; height:420px; right:-90px; top:-150px; }
  .hero-orbit--two { width:280px; height:280px; left:-75px; bottom:-135px; }
  .hero-copy { position:relative; z-index:1; max-width:850px; padding:48px 24px; text-align:center; text-shadow:0 3px 22px rgba(0,0,0,.35); }
  .hero-kicker { margin:0 0 7px; font-size:.73rem; font-weight:900; letter-spacing:.18em; text-transform:uppercase; opacity:.86; }
  .hero-icon { display:block; margin-bottom:8px; font-size:clamp(2.6rem,6vw,4.8rem); filter:drop-shadow(0 12px 20px rgba(0,0,0,.18)); }
  .hero h1 { margin:0; font-size:clamp(3.2rem,9vw,7rem); line-height:.88; letter-spacing:-.065em; }
  .hero p:not(.hero-kicker) { max-width:730px; margin:18px auto 0; font-size:clamp(1rem,2vw,1.28rem); line-height:1.58; }
  .hero-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:9px; margin-top:23px; }
  .hero-actions a { padding:10px 14px; border:1px solid rgba(255,255,255,.48); border-radius:999px; background:rgba(0,0,0,.2); color:#fff; font-size:.78rem; font-weight:800; text-decoration:none; backdrop-filter:blur(8px); }
  .hero-actions a:hover { background:rgba(255,255,255,.18); }
  .snapshot { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; max-width:1260px; margin:0 auto 44px; padding:0 clamp(12px,3vw,32px); }
  .snapshot article { padding:17px; border:1px solid #e2e7ee; border-radius:17px; background:rgba(255,255,255,.93); box-shadow:0 10px 28px rgba(15,23,42,.06); }
  .snapshot span { display:block; color:#747b88; font-size:.68rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  .snapshot strong { display:block; margin-top:6px; color:#171b25; font-size:clamp(.88rem,1.5vw,1.08rem); line-height:1.35; }
  .page-section { max-width:1260px; margin:0 auto 48px; padding:0 clamp(14px,3vw,32px); }
  .section-heading { max-width:790px; margin-bottom:18px; }
  .eyebrow { margin:0 0 5px; color:var(--accent-deep); font-size:.71rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  .section-heading h2, .archive-section h2 { margin:0; color:#141923; font-size:clamp(1.75rem,4vw,3rem); letter-spacing:-.045em; }
  .section-heading > p:last-child, .archive-section p:last-child { margin:8px 0 0; color:#626978; line-height:1.65; }
  .roadmap-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  .roadmap-item { display:grid; grid-template-columns:48px minmax(0,1fr); gap:14px; padding:18px; border:1px solid #e2e7ee; border-radius:19px; background:rgba(255,255,255,.93); box-shadow:0 10px 28px rgba(15,23,42,.055); }
  .roadmap-number { display:grid; place-items:center; width:44px; height:44px; border-radius:14px; background:var(--accent-soft); color:var(--accent-deep); font-weight:900; }
  .status { display:inline-block; margin-bottom:5px; color:#7a818e; font-size:.63rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .roadmap-item[data-status='developing'] .status, .roadmap-item[data-status='next'] .status { color:var(--accent-deep); }
  .roadmap-item[data-status='future'] { opacity:.68; border-style:dashed; }
  .roadmap-item h3 { margin:0 0 5px; color:#191e29; font-size:1rem; }
  .roadmap-item p { margin:0; color:#656d79; font-size:.82rem; line-height:1.52; }
  .chapter-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; }
  .chapter-grid article { min-height:165px; padding:20px; border:1px solid color-mix(in srgb,var(--accent) 24%,#e2e7ee); border-radius:20px; background:linear-gradient(145deg,var(--accent-soft),rgba(255,255,255,.94)); }
  .chapter-grid h3 { margin:0 0 8px; color:#171c27; font-size:1.05rem; }
  .chapter-grid p { margin:0; color:#626978; font-size:.84rem; line-height:1.58; }
  .archive-section { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:26px clamp(22px,4vw,42px); border:1px solid color-mix(in srgb,var(--accent) 25%,#e2e7ee); border-radius:25px; background:linear-gradient(135deg,var(--accent-soft),rgba(255,255,255,.95)); box-shadow:0 16px 42px rgba(15,23,42,.07); }
  .archive-section > div:first-child { max-width:760px; }
  .archive-actions { display:flex; flex-direction:column; gap:8px; min-width:215px; }
  .archive-actions a { padding:10px 14px; border:1px solid color-mix(in srgb,var(--accent) 35%,#dfe4ec); border-radius:999px; color:var(--accent-deep); font-size:.77rem; font-weight:850; text-align:center; text-decoration:none; }
  .archive-actions a.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
  @media (max-width:850px) {
    .hero { min-height:390px; border-radius:22px; }
    .snapshot { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .chapter-grid { grid-template-columns:1fr; }
    .archive-section { display:block; }
    .archive-actions { margin-top:18px; }
  }
  @media (max-width:600px) {
    .hero { min-height:370px; margin-inline:10px; }
    .snapshot, .roadmap-grid { grid-template-columns:1fr; }
    .snapshot { margin-bottom:34px; }
    .roadmap-item { grid-template-columns:40px minmax(0,1fr); padding:15px; }
    .roadmap-number { width:38px; height:38px; }
  }
</style>
