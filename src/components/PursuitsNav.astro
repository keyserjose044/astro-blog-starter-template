---
type PursuitSection = 'overview' | 'guitar' | 'dance' | 'running' | 'languages';

interface Props {
  active: PursuitSection;
}

const { active } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path: string) => `${base}${path}`;

const sections: Array<{ id: PursuitSection; label: string; href: string }> = [
  { id: 'overview', label: 'Overview', href: link('pursuits/') },
  { id: 'guitar', label: 'Guitar', href: link('pursuits/guitar/') },
  { id: 'dance', label: 'Dance', href: link('pursuits/dance/') },
  { id: 'running', label: 'Running', href: link('pursuits/running/') },
  { id: 'languages', label: 'Languages', href: link('pursuits/languages/') },
];
---

<nav class="pursuits-nav" aria-label="Pursuits sections">
  <div class="pursuits-nav__inner">
    {sections.map((section) => (
      <a
        href={section.href}
        class:list={['pursuits-nav__item', { 'pursuits-nav__item--active': active === section.id }]}
        aria-current={active === section.id ? 'page' : undefined}
      >
        {section.label}
      </a>
    ))}
  </div>
</nav>

<style is:global>
  /*
    Ordinary article pages use a 720px <main>. Pursuits pages are dashboards.
    Target their real page classes directly instead of relying on :has() to
    discover the navigation component from the parent.
  */
  main.pursuits-page {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 0 58px !important;
    overflow-x: clip;
    box-sizing: border-box;
  }

  main.pursuit-page {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 0 54px !important;
    overflow-x: clip;
    box-sizing: border-box;
  }

  /* Guitar still uses its older .wrap page shell. */
  main.wrap:has(> .pursuits-nav) {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 0 56px !important;
    overflow-x: clip;
    box-sizing: border-box;
  }

  main.pursuits-page #calendar,
  main.pursuit-page #roadmap,
  main.wrap #roadmap-section {
    scroll-margin-top: 7rem;
  }

  .pursuit-card:has(.card-link:focus-visible) {
    outline: 3px solid #405cf5;
    outline-offset: 4px;
  }

  .pursuit-card .card-link:focus-visible {
    outline: none;
  }

  .pursuit-card .sound-toggle:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .pursuits-nav {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 10px clamp(12px, 3vw, 48px) 20px;
    box-sizing: border-box;
  }

  .pursuits-nav__inner {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: min(100%, 780px);
    margin: 0 auto;
    padding: 4px;
    gap: 4px;
    border: 1px solid rgba(230, 233, 239, .96);
    border-radius: 999px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 8px 22px rgba(15, 23, 42, .07);
  }

  .pursuits-nav__item {
    min-width: 0;
    padding: 10px 12px;
    border-radius: 999px;
    color: #5e6573;
    font-size: .84rem;
    font-weight: 750;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: color .15s ease, background .15s ease, box-shadow .15s ease, transform .12s ease;
  }

  a.pursuits-nav__item:hover {
    color: #1f35b7;
    background: #f0f2ff;
    transform: translateY(-1px);
  }

  a.pursuits-nav__item:focus-visible {
    outline: 2px solid #405cf5;
    outline-offset: 2px;
  }

  .pursuits-nav__item--active {
    color: #fff;
    background: #405cf5;
    box-shadow: 0 6px 14px rgba(64, 92, 245, .24);
  }

  a.pursuits-nav__item--active:hover {
    color: #fff;
    background: #354edb;
  }

  /*
    Five tabs do not fit elegantly in one phone-width row. Use a centered
    three-over-two arrangement rather than a left-anchored scrolling strip.
  */
  @media (max-width: 640px) {
    .pursuits-nav {
      padding: 6px 10px 14px;
    }

    .pursuits-nav__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      width: min(100%, 520px);
      gap: 5px;
      border-radius: 22px;
    }

    .pursuits-nav__item {
      grid-column: span 2;
      min-width: 0;
      padding: 9px 6px;
      font-size: .75rem;
    }

    .pursuits-nav__item:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .pursuits-nav__item:nth-child(5) {
      grid-column: 4 / span 2;
    }
  }

  @media (max-width: 380px) {
    .pursuits-nav__item {
      padding-inline: 3px;
      font-size: .7rem;
    }
  }
</style>
