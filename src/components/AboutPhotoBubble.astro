---
export interface Props {
  src: string;
  alt?: string;
  bubbleText?: string;

  // Existing little José positioning overrides retained for compatibility.
  hotspotBottom?: string;
  hotspotLeft?: string;
  hotspotWidth?: string;
  hotspotHeight?: string;
  bubbleBottom?: string;
  bubbleLeft?: string;
}

const {
  src,
  alt = '',
