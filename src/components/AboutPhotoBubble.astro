---
import '../styles/about-photo-bubble.css';
import '../styles/about-photo-name-tag.css';
import '../styles/about-photo-extra-adornments.css';

export interface Props {
  src: string;
  alt?: string;
  bubbleText?: string;
  hotspotBottom?: string;
  hotspotLeft?: string;
  hotspotWidth?: string;
  hotspotHeight?: string;
  bubbleBottom?: string;
  bubbleLeft?: string;
}

const {
  src,
  alt = '',
  bubbleText = "One day I'll turn all of this into graphs.",
