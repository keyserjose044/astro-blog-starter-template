  { id:'little-jose', label:'Little José', quote:bubbleText, points:'250,327 278,316 308,322 327,338 330,363 319,385 338,397 365,420 389,453 401,501 211,501 218,458 228,420 247,395 239,380 241,353', left:'29.5%', top:'60%', placement:'above', tail:'15px', variant:'soft-left', tilt:'0.2deg', motion:'focused' },
  { id:'older-brother', label:'Older brother', quote:'Green eggs and ham...', points:'337,116 358,105 382,111 398,130 401,158 388,179 401,190 421,225 423,273 417,329 425,362 406,393 363,400 333,386 318,342 306,306 298,257 305,205 321,179 326,147', left:'36%', top:'23%', placement:'above', tail:'12px', variant:'compact', tilt:'-0.2deg', motion:'eager', adornment:'/images/about/cloud-adornments/older-brother-green-eggs.svg', adornmentAlt:'Green eggs and ham illustration', corner:'bottom-right', size:'older-brother', adornmentTilt:'-3deg' },
  { id:'grandfather', label:'Grandfather', quote:"¿'On' tá mi sombrero?", points:'453,100 479,91 505,103 520,124 519,150 504,169 515,184 539,217 549,270 555,330 552,387 537,429 506,446 464,439 429,409 414,364 411,304 414,247 426,193 445,171 443,135', left:'49%', top:'19%', placement:'above', tail:'1px', variant:'wide', tilt:'0.25deg', motion:'drift', adornment:'/images/about/cloud-adornments/grandfather-hat.svg?v=20260801-1800', adornmentAlt:'White cowboy hat', corner:'top-left', size:'grandfather', adornmentTilt:'-9deg' },
  { id:'grandmother', label:'Grandmother', quote:'♪ Ya viene amaneciendo, la luz ya nos alumbra… ♪', points:'555,110 577,99 600,107 615,128 617,154 606,176 624,192 647,226 654,281 652,339 648,399 637,450 604,468 561,458 530,431 515,386 512,330 516,274 526,221 543,180 546,146', left:'59%', top:'23%', placement:'above', tail:'-13px', variant:'soft-left', tilt:'-0.35deg', motion:'melody', adornment:'/images/about/cloud-adornments/grandmother-singer.svg', adornmentAlt:'Singer', corner:'top-right', size:'grandmother', adornmentTilt:'6deg' },
  { id:'little-cousin', label:'Little cousin', quote:"Ya 'amonos, tengo hambre...", points:'643,293 671,280 698,291 714,316 712,345 699,371 716,385 741,416 756,459 765,512 767,551 650,551 632,525 614,492 598,454 590,415 600,384 621,367 631,343 630,315', left:'68.5%', top:'59%', placement:'above', tail:'-4px', variant:'wide', tilt:'-0.3deg', motion:'hungry', adornment:'/images/about/cloud-adornments/little-cousin-shaggy.svg', adornmentAlt:'Shaggy holding a tall sandwich', corner:'bottom-right', size:'little-cousin', adornmentTilt:'-3deg' },
  { id:'uncle', label:'Uncle', quote:'líquido, lánguido, lúgubre, látigo...', points:'655,31 686,18 719,24 743,42 750,73 745,102 728,126 754,139 780,173 798,220 802,280 800,349 792,420 786,493 773,551 742,551 731,500 718,445 702,389 679,326 652,280 629,235 620,183 634,140 652,119', left:'70%', top:'17%', placement:'below', tail:'-10px', variant:'compact', tilt:'0.45deg', motion:'languid', adornment:'/images/about/cloud-adornments/uncle-reader.svg', adornmentAlt:'Reclining man reading', corner:'bottom-right', size:'uncle', adornmentTilt:'-4deg' },
  { id:'aunt', label:'Aunt', quote:'Hoy a las ocho, ¡solo por ESTRELLATV!', points:'853,67 878,54 900,60 919,81 924,110 916,137 904,153 929,166 953,202 973,246 985,290 985,551 904,551 881,510 861,462 844,412 829,360 814,308 804,253 810,203 828,166 845,143 844,100', left:'89%', top:'16%', placement:'below', tail:'-36px', variant:'soft-left', tilt:'-0.25deg', motion:'dramatic', adornment:'/images/about/cloud-adornments/aunt-swoon.svg', adornmentAlt:'Cowboy supporting a swooning woman', corner:'bottom-left', size:'aunt', adornmentTilt:'-2deg' },
];
---

<figure class="about-photo-block">
  <p id="family-photo-instructions" class="about-photo-sr-only">
    Interactive family portrait. Use Tab to move between people, then press Enter or Space to open a thought. Press Escape to close an open thought.
  </p>

  <div class="about-photo-wrapper" data-family-photo>
    <img src={src} alt={alt} class="about-photo-img" loading="lazy" draggable="false" />

    <svg class="family-hotspot-layer" viewBox="0 0 985 551" preserveAspectRatio="none" role="group" aria-label="Interactive family portrait" aria-describedby="family-photo-instructions">
      {familyMembers.map((member) => (
        <polygon
          class="person-hotspot has-quote"
          points={member.points}
          role="button"
          tabindex="0"
          aria-label={`Show ${member.label}'s thought`}
          aria-controls="family-thought-bubble"
          aria-expanded="false"
          data-person={member.id}
          data-label={member.label}
          data-quote={member.quote}
          data-bubble-left={member.left}
          data-bubble-top={member.top}
          data-placement={member.placement}
          data-tail-shift={member.tail}
          data-cloud-variant={member.variant}
          data-cloud-tilt={member.tilt}
          data-motion={member.motion}
          data-adornment={member.adornment || ''}
          data-adornment-alt={member.adornmentAlt || ''}
          data-corner={member.corner || ''}
          data-size={member.size || ''}
          data-adornment-tilt={member.adornmentTilt || '0deg'}
        ></polygon>
      ))}
    </svg>

    <div class="whos-who-layer" id="family-whos-who-layer" data-whos-who-layer data-visible="0" aria-hidden="true"></div>
    <div class="person-name-tag" data-visible="0" aria-hidden="true"></div>

    <div id="family-thought-bubble" class="speech-bubble" data-visible="0" data-placement="above" data-cloud-variant="wide" data-has-adornment="0" aria-hidden="true" role="status" aria-live="polite" aria-atomic="true">
      <p></p>
      <img class="cloud-adornment" alt="" src="" aria-hidden="true" />
    </div>
  </div>

  <figcaption class="about-photo-footer">
    <span class="about-photo-caption">Family photograph, Amarillas de Esparza, c. 2006 - José at work</span>
    <span class="about-photo-actions" role="group" aria-label="Family portrait controls">
      <button class="about-photo-action" type="button" data-random-thought aria-controls="family-thought-bubble">
        <span aria-hidden="true">↻</span> Random thought
      </button>
      <button class="about-photo-action" type="button" data-whos-who aria-controls="family-whos-who-layer" aria-pressed="false">
        Who’s Who
      </button>
    </span>
  </figcaption>
</figure>

<script is:inline src="/js/about-photo-bubble.js?v=20260801-portrait-polish-v1"></script>
<script is:inline src="/js/about-photo-name-tag.js?v=20260801-labels-v2"></script>