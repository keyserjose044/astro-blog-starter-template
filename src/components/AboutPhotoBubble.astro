    points: '453,100 479,91 505,103 520,124 519,150 504,169 515,184 539,217 549,270 555,330 552,387 537,429 506,446 464,439 429,409 414,364 411,304 414,247 426,193 445,171 443,135',
    bubbleLeft: '49%',
    bubbleTop: '19%',
    placement: 'above',
    isJose: false,
  },
  {
    id: 'grandmother',
    label: 'Grandmother',
    quote: '',
    points: '555,110 577,99 600,107 615,128 617,154 606,176 624,192 647,226 654,281 652,339 648,399 637,450 604,468 561,458 530,431 515,386 512,330 516,274 526,221 543,180 546,146',
    bubbleLeft: '59%',
