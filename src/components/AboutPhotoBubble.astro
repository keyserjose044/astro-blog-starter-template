---

<section class="about-photo-block">
  <div class="about-photo-wrapper" data-family-photo>
    <img
      src={src}
      alt={alt}
      class="about-photo-img"
      loading="lazy"
      draggable="false"
    />

    <svg
      class="family-hotspot-layer"
      viewBox="0 0 985 551"
      preserveAspectRatio="none"
      role="group"
      aria-label="Interactive family portrait"
    >
      {familyMembers.map((member) => (
        <polygon
          class:list={[
            'person-hotspot',
            { 'has-quote': Boolean(member.quote), 'is-jose': member.isJose },
          ]}
          points={member.points}
          role="button"
          tabindex={member.quote ? '0' : '-1'}
          aria-label={member.quote ? `Hear from ${member.label}` : member.label}
          aria-disabled={member.quote ? 'false' : 'true'}
          data-person={member.id}
          data-label={member.label}
          data-quote={member.quote}
          data-bubble-left={member.bubbleLeft}
          data-bubble-top={member.bubbleTop}
          data-placement={member.placement}
          data-jose={member.isJose ? 'true' : 'false'}
        >
          <title>{member.label}</title>
        </polygon>
      ))}
    </svg>

    <div
      class="speech-bubble"
      data-visible="0"
      data-placement="above"
      aria-hidden="true"
      role="status"
    >
      <p></p>
    </div>

    <div class="secret-bubble" data-visible="0"></div>
  </div>
</section>

<style>
  .about-photo-block {
    display: flex;
    justify-content: center;
  }

  .about-photo-wrapper {
    position: relative;
    display: inline-block;
    max-width: 100%;
    isolation: isolate;
  }

  .about-photo-img {
    display: block;
    max-width: 100%;
    height: auto;
    user-select: none;
  }

  .family-hotspot-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .person-hotspot {
    fill: rgba(255, 255, 255, 0.001);
    stroke: transparent;
    stroke-width: 0;
    pointer-events: none;
  }

  .person-hotspot.has-quote {
    cursor: pointer;
    pointer-events: all;
  }

  .person-hotspot.has-quote:focus-visible {
    outline: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .speech-bubble {
    position: absolute;
    z-index: 4;
    top: 60%;
    left: 50%;
    box-sizing: border-box;
    width: 190px;
    min-height: 58px;
    max-width: calc(100% - 24px);

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(253, 251, 247, 0.98);
    color: #111;
    padding: 0.8rem 1.15rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 50%;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);

    font-size: 0.86rem;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;

    opacity: 0;
    pointer-events: none;
    transform-origin: center bottom;
    transform: translate(-50%, calc(-100% - 12px)) scale(0.94);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .speech-bubble p {
    margin: 0;
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 11px 10px 0;
    border-style: solid;
    border-color: rgba(253, 251, 247, 0.98) transparent transparent;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.22));
  }

  .speech-bubble[data-placement='below'] {
    transform-origin: center top;
    transform: translate(-50%, 12px) scale(0.94);
  }

  .speech-bubble[data-placement='below']::after {
    top: auto;
    bottom: 100%;
    border-width: 0 10px 11px;
    border-color: transparent transparent rgba(253, 251, 247, 0.98);
  }

  .speech-bubble[data-visible='1'] {
    opacity: 1;
    transform: translate(-50%, calc(-100% - 12px)) scale(1);
  }

  .speech-bubble[data-visible='1'][data-placement='below'] {
    transform: translate(-50%, 12px) scale(1);
  }

  .secret-bubble {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 18%;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.95);
    color: #111827;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .secret-bubble[data-visible='1'] {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .speech-bubble {
      width: 155px;
      min-height: 50px;
      max-width: calc(100% - 18px);
      padding: 0.65rem 0.85rem;
      font-size: 0.76rem;
    }

    .secret-bubble {
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speech-bubble,
    .secret-bubble {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    if (typeof document === 'undefined') return;

    document.querySelectorAll('[data-family-photo]').forEach((wrapper) => {
      const bubble = wrapper.querySelector('.speech-bubble');
      const bubbleCopy = bubble?.querySelector('p');
      const hotspots = wrapper.querySelectorAll('.person-hotspot.has-quote');
      const secret = wrapper.querySelector('.secret-bubble');

      if (!bubble || !bubbleCopy) return;

      let pinnedHotspot = null;

      const hideBubble = () => {
        bubble.setAttribute('data-visible', '0');
        bubble.setAttribute('aria-hidden', 'true');
        bubble.removeAttribute('data-person');
      };

      const showBubble = (hotspot) => {
        const quote = hotspot.getAttribute('data-quote')?.trim();
        if (!quote) return;

        bubbleCopy.textContent = quote;
        bubble.style.left = hotspot.getAttribute('data-bubble-left') || '50%';
        bubble.style.top = hotspot.getAttribute('data-bubble-top') || '50%';
        bubble.setAttribute('data-placement', hotspot.getAttribute('data-placement') || 'above');
        bubble.setAttribute('data-person', hotspot.getAttribute('data-person') || '');
        bubble.setAttribute('data-visible', '1');
        bubble.setAttribute('aria-hidden', 'false');
      };

      hotspots.forEach((hotspot) => {
        hotspot.addEventListener('pointerenter', () => {
          if (!pinnedHotspot) showBubble(hotspot);
        });

        hotspot.addEventListener('pointerleave', () => {
          if (!pinnedHotspot && document.activeElement !== hotspot) hideBubble();
        });

        hotspot.addEventListener('focus', () => {
          if (!pinnedHotspot) showBubble(hotspot);
        });

        hotspot.addEventListener('blur', () => {
          if (!pinnedHotspot) hideBubble();
        });

        hotspot.addEventListener('click', (event) => {
          event.stopPropagation();

          if (pinnedHotspot === hotspot) {
            pinnedHotspot = null;
            hideBubble();
            return;
          }

          pinnedHotspot = hotspot;
          showBubble(hotspot);
        });

        hotspot.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            pinnedHotspot = null;
            hideBubble();
            hotspot.blur();
            return;
          }

          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            hotspot.dispatchEvent(new MouseEvent('click', { bubbles: true }));
          }
        });
      });

      wrapper.addEventListener('click', (event) => {
        if (event.target.closest?.('.person-hotspot')) return;
        pinnedHotspot = null;
        hideBubble();
      });

      if (secret) {
        const messages = [
          'Even then, I was building systems.',
          'Future LifeLogger in the making.',
          'Everything starts with a blank page.',
          'Tiny José, huge plans.',
          'Drafting v0.1 of my life-OS.'
        ];

        const today = new Date();
        secret.textContent = messages[today.getDate() % messages.length];

        wrapper.addEventListener('dblclick', (event) => {
          if (event.target.closest?.('.person-hotspot')) return;
          const visible = secret.getAttribute('data-visible') === '1';
          secret.setAttribute('data-visible', visible ? '0' : '1');
        });
      }
    });
  })();
</script>
