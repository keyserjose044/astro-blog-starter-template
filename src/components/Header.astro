---
import HeaderLink from './HeaderLink.astro';
import NavTooltipLink from './NavTooltipLink.astro';
import StatsDailyHusk from './StatsDailyHusk.astro';
import DailyDataRuntime from './DailyDataRuntime.astro';
import { SITE_TITLE } from '../consts';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path: string = '') => `${base}${path}`;
const iconSrc = `${base}favicon.svg`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '');
const isStatsPage = normalizedPath.endsWith('/stats');
const isDayPage = normalizedPath.endsWith('/day');

const navItems = [
  { href: '', label: 'Home', tip: 'Start here: overview and latest from the blog', exact: true },
  { href: 'blog/', label: 'Blog', tip: 'Essays on systems, stats, and experiments' },
  { href: 'templates/', label: 'Templates', tip: 'Downloadable tools and Google Sheets systems' },
  { href: 'stats/', label: 'Stats', tip: 'Live graphs and metrics from my Raw Data logs' },
  { href: 'day/', label: 'Day', tip: 'Explore one public-safe day from the LifeLoggerz archive' },
  { href: 'books/', label: 'Books', tip: 'Every book I’ve read, with genres and notes' },
  { href: 'music/albums/', label: 'Music', tip: 'Albums and classical music, powered by the archive' },
  { href: 'art/', label: 'Art', tip: 'Art I’ve logged that shaped my thinking' },
  { href: 'pursuits/', label: 'Pursuits', tip: 'Guitar, dance, running, languages, and future skills' },
  { href: 'inspirations/', label: 'Inspirations', tip: 'Ideas and people influencing LifeLoggerz' },
  { href: 'timeline/', label: 'Timeline', tip: 'My life up to this point…' },
  { href: 'about/', label: 'About', tip: 'What LifeLoggerz is and who’s behind it' },
  { href: 'faq/', label: 'FAQ', tip: 'Questions about the project, privacy, and tracking' },
];
---

<header class="site-header">
  <nav class="desktop-nav" aria-label="Primary navigation">
    <h2>
      <a href={base} class="brand-link">
        <span class="site-title">{SITE_TITLE}</span>
        <img class="brandmark" src={iconSrc} width="20" height="20" alt="" aria-hidden="true" />
      </a>
    </h2>

    <div class="internal-links" id="desktop-links">
      {navItems.map((item) => (
        <NavTooltipLink href={link(item.href)} exact={item.exact} tip={item.tip}>
          {item.label}
        </NavTooltipLink>
      ))}
    </div>

    <div class="right-rail">
      <a class="social reddit" href="https://www.reddit.com/user/LifeLoggerz/" aria-label="LifeLoggerz on Reddit" target="_blank" rel="noopener noreferrer">
        <img src="/reddit.svg" width="22" height="22" alt="Reddit" />
      </a>
      <a class="social youtube" href="https://www.youtube.com/@LifeLoggerz" aria-label="LifeLoggerz on YouTube" target="_blank" rel="noopener noreferrer">
        <img src="/youtube.svg" width="22" height="22" alt="YouTube" />
      </a>
      <div class="contact-button"><a href="mailto:lifeloggerz.official@gmail.com">Contact</a></div>
    </div>
  </nav>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    <h2 class="brand">
      <a href={base} class="brand-link">
        <span class="site-title">{SITE_TITLE}</span>
        <img class="brandmark" src={iconSrc} width="20" height="20" alt="" aria-hidden="true" />
      </a>
    </h2>

    <details class="nav-toggle">
      <summary aria-label="Open menu">☰</summary>
      <div class="menu-panel">
        <div class="internal-links">
          {navItems.map((item) => <HeaderLink href={link(item.href)}>{item.label}</HeaderLink>)}
        </div>
        <div class="social-row">
          <a class="social reddit" href="https://www.reddit.com/user/LifeLoggerz/" aria-label="LifeLoggerz on Reddit" target="_blank" rel="noopener noreferrer">
            <img src="/reddit.svg" width="22" height="22" alt="Reddit" />
          </a>
          <a class="social youtube" href="https://www.youtube.com/@LifeLoggerz" aria-label="LifeLoggerz on YouTube" target="_blank" rel="noopener noreferrer">
            <img src="/youtube.svg" width="22" height="22" alt="YouTube" />
          </a>
        </div>
        <a class="contact-btn" href="mailto:lifeloggerz.official@gmail.com">Contact</a>
      </div>
    </details>
  </nav>
</header>

{isStatsPage && <StatsDailyHusk />}
{(isStatsPage || isDayPage) && <DailyDataRuntime />}

<style>
  .site-header { margin:0; padding:0 1rem; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.05); position:sticky; top:0; z-index:50; }
  .desktop-nav { display:flex; align-items:center; justify-content:space-between; gap:.35rem; }
  .desktop-nav h2, .mobile-nav .brand { margin:0; font-size:1em; }
  .brand-link { display:inline-flex; align-items:center; gap:.4rem; color:var(--black,#0e121b); font-weight:600; text-decoration:none; }
  .brandmark { display:block; width:20px; height:20px; }
  .site-title { line-height:1; }
  .desktop-nav .internal-links { display:flex; flex-wrap:nowrap; gap:.08rem; }
  .desktop-nav .internal-links :global(a) { position:relative; padding:1em .42em; color:var(--black,#0e121b); text-decoration:none; transition:transform .15s ease-out; }
  .desktop-nav .internal-links :global(a)::after { content:''; position:absolute; left:0; bottom:.35rem; width:100%; height:3px; border-radius:999px; background:transparent; transform:scaleX(0); transform-origin:center; transition:transform .15s ease-out,background .15s ease-out; }
  .desktop-nav .internal-links :global(a:hover)::after,
  .desktop-nav .internal-links :global(a:focus-visible)::after { background:#3b7bff; transform:scaleX(1); }
  .desktop-nav .internal-links :global(a.active)::after { background:#2563eb; transform:scaleX(1); }
  .desktop-nav .internal-links :global(a:hover),
  .desktop-nav .internal-links :global(a:focus-visible) { transform:translateY(-2px); }
  .right-rail { display:flex; align-items:center; gap:.5rem; }
  .contact-button a, .contact-btn { background:transparent; color:#2563eb; border:2px solid #2563eb; padding:.5rem 1rem; border-radius:9999px; font-weight:600; transition:all .25s; text-decoration:none; white-space:nowrap; }
  .contact-button a:hover, .contact-btn:hover { background:#2563eb; color:#fff; }
  .social { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; transition:transform .2s ease,opacity .2s ease,background .2s ease; opacity:.9; }
  .social:hover { transform:translateY(-1px); opacity:1; }
  .social.reddit:hover { background:rgba(255,69,0,.1); }
  .social.youtube:hover { background:rgba(255,0,0,.1); }
  .mobile-nav { display:none; align-items:center; justify-content:space-between; gap:.5rem; position:relative; }
  .mobile-nav .nav-toggle > summary { display:inline-block; border:1px solid rgba(0,0,0,.12); background:#fff; border-radius:.6rem; padding:.45rem .65rem; font-size:1.15rem; line-height:1; cursor:pointer; list-style:none; user-select:none; }
  .mobile-nav .nav-toggle > summary::-webkit-details-marker { display:none; }
  .mobile-nav .menu-panel { position:absolute; left:0; right:0; top:100%; background:#fff; border-top:1px solid rgba(0,0,0,.06); box-shadow:0 8px 24px rgba(0,0,0,.06); display:none; flex-direction:column; align-items:stretch; padding:.25rem 0; z-index:40; }
  .mobile-nav .nav-toggle[open] .menu-panel { display:flex; }
  .mobile-nav .internal-links { display:grid; grid-template-columns:1fr 1fr; gap:0; }
  .mobile-nav .internal-links :global(a) { padding:.85rem 1rem; border-bottom:1px solid rgba(0,0,0,.04); color:var(--black,#0e121b); text-decoration:none; }
  .mobile-nav .social-row { display:flex; gap:.6rem; padding:.5rem 1rem .25rem; }
  .mobile-nav .contact-btn { margin:.35rem 1rem .6rem; text-align:center; }
  :global(main.day-explorer) { width:100% !important; max-width:none !important; margin:0 !important; padding:0 !important; }
  @media (max-width:1080px) {
    .desktop-nav .internal-links :global(a) { padding-inline:.3em; font-size:.91rem; }
    .right-rail { gap:.32rem; }
    .contact-button a { padding-inline:.75rem; }
  }
  @media (max-width:900px) { .desktop-nav { display:none; } .mobile-nav { display:flex; } }
</style>
