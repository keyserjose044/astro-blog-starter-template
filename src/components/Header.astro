---
import HeaderLink from './HeaderLink.astro';
import NavTooltipLink from './NavTooltipLink.astro';
import { SITE_TITLE } from '../consts';

type NavChild = {
  href: string;
  icon: string;
  label: string;
  description: string;
};

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path: string = '') => `${base}${path}`;
const iconSrc = `${base}favicon.svg`;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base === '/' ? '' : base.replace(/\/+$/, '');
const routePath = normalizedBase && normalizedPath.startsWith(normalizedBase)
  ? normalizedPath.slice(normalizedBase.length) || '/'
  : normalizedPath;

const isWithin = (...routes: string[]) =>
  routes.some((route) => {
    const cleanRoute = route.replace(/^\/+|\/+$/g, '');
    if (!cleanRoute) return routePath === '/';
    const target = `/${cleanRoute}`;
    return routePath === target || routePath.startsWith(`${target}/`);
  });

const statsExploreItems: NavChild[] = [
  {
    href: 'stats/',
    icon: '📊',
    label: 'Stats',
    description: 'Dashboards, records, totals, and long-term patterns',
  },
  {
    href: 'day/',
    icon: '🗓️',
    label: 'Day Explorer',
    description: 'Open a public-safe day from the LifeLoggerz archive',
  },
];

const pursuitExploreItems: NavChild[] = [
  {
    href: 'pursuits/',
    icon: '🎯',
    label: 'Pursuits Overview',
    description: 'Compare practices, history, gaps, and how limited time is allocated',
  },
  {
    href: 'pursuits/guitar/',
    icon: '🎸',
    label: 'Guitar',
    description: 'Practice hours, repertoire, technique, and consistency',
  },
  {
    href: 'pursuits/dance/',
    icon: '💃',
    label: 'Dance',
    description: 'Classes, styles, practice history, and developing movement',
  },
  {
    href: 'pursuits/running/',
    icon: '🏃',
    label: 'Running',
    description: 'Mileage, streaks, interruptions, returns, and records',
  },
  {
    href: 'pursuits/languages/',
    icon: '🌍',
    label: 'Languages',
    description: 'Study history, changing priorities, and skill development',
  },
];

const cultureItems: NavChild[] = [
  {
    href: 'books/',
    icon: '📚',
    label: 'Books',
    description: 'Reading history, genres, maps, and notes',
  },
  {
    href: 'music/albums/',
    icon: '💿',
    label: 'Albums',
    description: 'Albums, artists, listening history, and exploration views',
  },
  {
    href: 'music/composers/',
    icon: '🎼',
    label: 'Classical Music',
    description: 'Composers, works, listening history, and the classical archive',
  },
  {
    href: 'art/',
    icon: '🎨',
    label: 'Art',
    description: 'Art logged over time and the works that stayed with me',
  },
];

const buildItems: NavChild[] = [
  {
    href: 'templates/',
    icon: '🧰',
    label: 'Tools & Systems',
    description: 'Practical systems and downloadable tools you can reuse',
  },
  {
    href: 'blog/',
    icon: '🛠️',
    label: 'Projects & Experiments',
    description: 'Build notes, experiments, research, and lessons from making things',
  },
];

const aboutItems: NavChild[] = [
  {
    href: 'about/me/',
    icon: '👤',
    label: 'About Me',
    description: 'José through family roots, pursuits, data, writing, and culture',
  },
  {
    href: 'about/lifeloggerz/',
    icon: '◉',
    label: 'About LifeLoggerz',
    description: 'The project, system, philosophy, privacy, and origin story',
  },
  {
    href: 'timeline/',
    icon: '🕰️',
    label: 'Timeline',
    description: 'A life timeline through the years',
  },
  {
    href: 'inspirations/',
    icon: '💡',
    label: 'Inspirations',
    description: 'People, projects, and ideas that shaped LifeLoggerz',
  },
  {
    href: 'about/me/',
    icon: '🌎',
    label: 'Family Roots',
    description: 'Family origins, places, maps, photographs, and the story behind them',
  },
];

const statsExploreActive = isWithin('stats', 'day', 'pursuits');
const cultureActive = isWithin('books', 'music/albums', 'music/composers', 'art');
const buildActive = false;
const aboutActive = isWithin('about', 'timeline', 'inspirations');
---

<header class="site-header">
  <nav class="desktop-nav" aria-label="Primary navigation">
    <h2>
      <a href={base} class="brand-link">
        <span class="site-title">{SITE_TITLE}</span>
        <img class="brandmark" src={iconSrc} width="20" height="20" alt="" aria-hidden="true" />
      </a>
    </h2>

    <div class="desktop-links">
      <NavTooltipLink href={base} exact={true} tip="Start here: overview and latest from the blog">Home</NavTooltipLink>
      <NavTooltipLink href={link('blog/')} tip="Essays on systems, stats, and experiments">Blog</NavTooltipLink>
      <NavTooltipLink href={link('templates/')} tip="Downloadable tools and Google Sheets systems">Templates</NavTooltipLink>

      <details class:list={['desktop-dropdown', { 'section-active': statsExploreActive }]}> 
        <summary>
          <span>Stats &amp; Explore</span>
          <span class="chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="dropdown-panel stats-explore-panel">
          {statsExploreItems.map((item) => (
            <HeaderLink href={link(item.href)} class="dropdown-link">
              <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
              <span class="dropdown-copy">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>
              <span class="dropdown-arrow" aria-hidden="true">→</span>
            </HeaderLink>
          ))}
          <div class="dropdown-group-label">Pursuits</div>
          {pursuitExploreItems.map((item) => (
            <HeaderLink href={link(item.href)} class="dropdown-link">
              <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
              <span class="dropdown-copy">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>
              <span class="dropdown-arrow" aria-hidden="true">→</span>
            </HeaderLink>
          ))}
        </div>
      </details>

      <details class:list={['desktop-dropdown', { 'section-active': cultureActive }]}> 
        <summary>
          <span>Culture</span>
          <span class="chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="dropdown-panel culture-panel">
          {cultureItems.map((item) => (
            <HeaderLink href={link(item.href)} class="dropdown-link">
              <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
              <span class="dropdown-copy">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>
              <span class="dropdown-arrow" aria-hidden="true">→</span>
            </HeaderLink>
          ))}
        </div>
      </details>

      <details class:list={['desktop-dropdown', { 'section-active': buildActive }]}> 
        <summary>
          <span>Build</span>
          <span class="chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="dropdown-panel">
          {buildItems.map((item) => (
            <HeaderLink href={link(item.href)} class="dropdown-link">
              <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
              <span class="dropdown-copy">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>
              <span class="dropdown-arrow" aria-hidden="true">→</span>
            </HeaderLink>
          ))}
        </div>
      </details>

      <details class:list={['desktop-dropdown', { 'section-active': aboutActive }]}> 
        <summary>
          <span>About</span>
          <span class="chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="dropdown-panel about-panel">
          {aboutItems.map((item) => (
            <HeaderLink href={link(item.href)} class="dropdown-link">
              <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
              <span class="dropdown-copy">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>
              <span class="dropdown-arrow" aria-hidden="true">→</span>
            </HeaderLink>
          ))}
        </div>
      </details>

      <NavTooltipLink href={link('faq/')} tip="Questions about the project, privacy, and tracking">FAQ</NavTooltipLink>
    </div>

    <div class="right-rail">
      <a class="social reddit" href="https://www.reddit.com/user/LifeLoggerz/" aria-label="LifeLoggerz on Reddit" target="_blank" rel="noopener noreferrer">
        <img src="/reddit.svg" width="22" height="22" alt="Reddit" />
      </a>
      <a class="social youtube" href="https://www.youtube.com/@LifeLoggerz" aria-label="LifeLoggerz on YouTube" target="_blank" rel="noopener noreferrer">
        <img src="/youtube.svg" width="22" height="22" alt="YouTube" />
      </a>
      <div class="contact-button"><a href="mailto:lifeloggerz.official@gmail.com">Contact</a></div>
    </div>
  </nav>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    <h2 class="brand">
      <a href={base} class="brand-link">
        <span class="site-title">{SITE_TITLE}</span>
        <img class="brandmark" src={iconSrc} width="20" height="20" alt="" aria-hidden="true" />
      </a>
    </h2>

    <details class="nav-toggle">
      <summary aria-label="Open menu">
        <span aria-hidden="true">☰</span>
        <span class="sr-only">Menu</span>
      </summary>

      <div class="menu-panel">
        <div class="mobile-direct-links">
          <HeaderLink href={base} exact={true}>Home</HeaderLink>
          <HeaderLink href={link('blog/')}>Blog</HeaderLink>
          <HeaderLink href={link('templates/')}>Templates</HeaderLink>
        </div>

        <div class="mobile-groups">
          <details class:list={['mobile-group', { 'section-active': statsExploreActive }]}> 
            <summary>
              <span>Stats &amp; Explore</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="mobile-submenu">
              {statsExploreItems.map((item) => (
                <HeaderLink href={link(item.href)} class="mobile-submenu-link">
                  <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </HeaderLink>
              ))}
              <p class="mobile-submenu-label">Pursuits</p>
              {pursuitExploreItems.map((item) => (
                <HeaderLink href={link(item.href)} class="mobile-submenu-link">
                  <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </HeaderLink>
              ))}
            </div>
          </details>

          <details class:list={['mobile-group', { 'section-active': cultureActive }]}> 
            <summary>
              <span>Culture</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="mobile-submenu">
              {cultureItems.map((item) => (
                <HeaderLink href={link(item.href)} class="mobile-submenu-link">
                  <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </HeaderLink>
              ))}
            </div>
          </details>

          <details class:list={['mobile-group', { 'section-active': buildActive }]}> 
            <summary>
              <span>Build</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="mobile-submenu">
              {buildItems.map((item) => (
                <HeaderLink href={link(item.href)} class="mobile-submenu-link">
                  <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </HeaderLink>
              ))}
            </div>
          </details>

          <details class:list={['mobile-group', { 'section-active': aboutActive }]}> 
            <summary>
              <span>About</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="mobile-submenu">
              {aboutItems.map((item) => (
                <HeaderLink href={link(item.href)} class="mobile-submenu-link">
                  <span class="dropdown-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </HeaderLink>
              ))}
            </div>
          </details>
        </div>

        <div class="mobile-direct-links mobile-direct-links-bottom">
          <HeaderLink href={link('faq/')}>FAQ</HeaderLink>
        </div>

        <div class="mobile-footer">
          <div class="social-row">
            <a class="social reddit" href="https://www.reddit.com/user/LifeLoggerz/" aria-label="LifeLoggerz on Reddit" target="_blank" rel="noopener noreferrer">
              <img src="/reddit.svg" width="22" height="22" alt="Reddit" />
            </a>
            <a class="social youtube" href="https://www.youtube.com/@LifeLoggerz" aria-label="LifeLoggerz on YouTube" target="_blank" rel="noopener noreferrer">
              <img src="/youtube.svg" width="22" height="22" alt="YouTube" />
            </a>
          </div>
          <a class="contact-btn" href="mailto:lifeloggerz.official@gmail.com">Contact</a>
        </div>
      </div>
    </details>
  </nav>
</header>

<script>
  const desktopDropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.desktop-dropdown'));

  const closeDesktopDropdowns = (except?: HTMLDetailsElement) => {
    desktopDropdowns.forEach((dropdown) => {
      if (dropdown !== except) dropdown.open = false;
    });
  };

  desktopDropdowns.forEach((dropdown) => {
    let closeTimer: number | undefined;
    const summary = dropdown.querySelector('summary');

    const openDropdown = () => {
      if (!window.matchMedia('(min-width: 1001px)').matches) return;
      window.clearTimeout(closeTimer);
      closeDesktopDropdowns(dropdown);
      dropdown.open = true;
    };

    const scheduleClose = () => {
      if (!window.matchMedia('(min-width: 1001px)').matches) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!dropdown.matches(':hover') && !dropdown.matches(':focus-within')) dropdown.open = false;
      }, 120);
    };

    dropdown.addEventListener('mouseenter', openDropdown);
    dropdown.addEventListener('mouseleave', scheduleClose);
    dropdown.addEventListener('focusin', openDropdown);
    dropdown.addEventListener('focusout', scheduleClose);

    summary?.addEventListener('click', (event) => {
      if (!window.matchMedia('(min-width: 1001px)').matches) return;
      event.preventDefault();
      openDropdown();
    });

    dropdown.querySelectorAll('a').forEach((anchor) => {
      anchor.addEventListener('click', () => closeDesktopDropdowns());
    });
  });

  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Node | null;
    if (target && !desktopDropdowns.some((dropdown) => dropdown.contains(target))) {
      closeDesktopDropdowns();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDesktopDropdowns();
  });

  const mobileGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.mobile-group'));
  mobileGroups.forEach((group) => {
    group.addEventListener('toggle', () => {
      if (!group.open) return;
      mobileGroups.forEach((other) => {
        if (other !== group) other.open = false;
      });
    });
  });
</script>

<style>
  .site-header { margin:0; padding:0 1rem; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.05); position:sticky; top:0; z-index:50; }
  .desktop-nav { min-height:62px; display:flex; align-items:center; justify-content:space-between; gap:.65rem; }
  .desktop-nav h2,.mobile-nav .brand { margin:0; font-size:1em; }
  .brand-link { display:inline-flex; align-items:center; gap:.4rem; color:var(--black,#0e121b); font-weight:600; text-decoration:none; white-space:nowrap; }
  .brandmark { display:block; width:20px; height:20px; }
  .site-title { line-height:1; }
  .desktop-links { display:flex; align-items:stretch; justify-content:center; gap:.1rem; min-width:0; }
  .desktop-links :global(.nav-tooltip-wrapper) { display:inline-flex; align-items:stretch; }
  .desktop-links :global(.nav-tooltip-wrapper > a),.desktop-dropdown > summary { position:relative; display:inline-flex; align-items:center; min-height:62px; padding:0 .58rem; color:var(--black,#0e121b); font-size:1.04rem; font-weight:700; line-height:1; text-decoration:none!important; white-space:nowrap; cursor:pointer; transition:transform .15s ease-out,color .15s ease-out,background .15s ease-out; }
  .desktop-links :global(.nav-tooltip-wrapper > a)::after,.desktop-dropdown > summary::after { content:''; position:absolute; left:.5rem; right:.5rem; bottom:.42rem; height:3px; border-radius:999px; background:#2563eb; transform:scaleX(0); transform-origin:center; transition:transform .15s ease-out; }
  .desktop-links :global(.nav-tooltip-wrapper > a:hover),.desktop-links :global(.nav-tooltip-wrapper > a:focus-visible),.desktop-dropdown > summary:hover,.desktop-dropdown > summary:focus-visible { color:#1d4ed8; background:rgba(37,99,235,.035); transform:translateY(-1px); }
  .desktop-links :global(.nav-tooltip-wrapper > a:hover)::after,.desktop-links :global(.nav-tooltip-wrapper > a:focus-visible)::after,.desktop-links :global(.nav-tooltip-wrapper > a.active)::after,.desktop-dropdown:hover > summary::after,.desktop-dropdown:focus-within > summary::after,.desktop-dropdown[open] > summary::after,.desktop-dropdown.section-active > summary::after { transform:scaleX(1); }
  .desktop-dropdown { position:relative; }
  .desktop-dropdown > summary { list-style:none; user-select:none; }
  .desktop-dropdown > summary::-webkit-details-marker { display:none; }
  .chevron { margin-left:.3rem; font-size:.78rem; transform:translateY(-1px); transition:transform .16s ease-out; }
  .desktop-dropdown[open] > summary .chevron,.mobile-group[open] > summary .chevron { transform:rotate(180deg) translateY(1px); }
  .dropdown-panel { position:absolute; top:calc(100% - .12rem); left:50%; width:min(300px,82vw); padding:.45rem; border:1px solid rgba(15,23,42,.08); border-radius:.85rem; background:rgba(255,255,255,.985); box-shadow:0 18px 45px rgba(15,23,42,.14); opacity:0; visibility:hidden; pointer-events:none; transform:translate(-50%,.45rem); transition:opacity .14s ease-out,transform .14s ease-out,visibility .14s ease-out; z-index:70; }
  .desktop-dropdown[open] > .dropdown-panel { opacity:1; visibility:visible; pointer-events:auto; transform:translate(-50%,0); }
  .stats-explore-panel { width:min(340px,86vw); max-height:calc(100vh - 82px); overflow-y:auto; }
  .about-panel { left:auto; right:0; transform:translate(0,.45rem); }
  .desktop-dropdown[open] > .about-panel { transform:translate(0,0); }
  .dropdown-group-label { margin:.38rem .5rem .2rem; padding:.52rem .2rem .25rem; border-top:1px solid rgba(148,163,184,.22); color:#7c8595; font-size:.64rem; font-weight:900; letter-spacing:.11em; text-transform:uppercase; }
  :global(a.dropdown-link) { position:relative; display:grid; grid-template-columns:1.65rem minmax(0,1fr) 1.15rem; gap:.58rem; align-items:center; width:100%; min-height:44px; padding:.62rem .65rem; border:1px solid transparent; border-radius:.65rem; color:#0f172a; text-decoration:none!important; cursor:pointer; transition:background .14s ease-out,border-color .14s ease-out,color .14s ease-out,transform .14s ease-out,box-shadow .14s ease-out; }
  :global(a.dropdown-link:hover),:global(a.dropdown-link:focus-visible) { color:#1d4ed8; background:#f5f8ff; border-color:rgba(37,99,235,.12); box-shadow:0 4px 12px rgba(37,99,235,.07); transform:translateX(3px); outline:none; }
  :global(a.dropdown-link.active) { color:#1d4ed8; background:#edf3ff; border-color:rgba(37,99,235,.14); }
  :global(a.dropdown-link:active) { background:#e6efff; transform:translateX(3px) scale(.985); }
  .dropdown-icon { display:inline-flex; align-items:center; justify-content:center; min-width:1.5rem; font-size:1rem; line-height:1.3; }
  .dropdown-copy { min-width:0; }
  :global(a.dropdown-link) strong { display:block; font-size:.94rem; line-height:1.2; font-weight:720; }
  :global(a.dropdown-link) small { display:block; max-height:0; margin-top:0; overflow:hidden; color:#64748b; font-size:.73rem; line-height:1.35; font-weight:450; opacity:0; transform:translateY(-3px); transition:max-height .18s ease-out,margin-top .18s ease-out,opacity .14s ease-out,transform .18s ease-out; }
  :global(a.dropdown-link:hover) small,:global(a.dropdown-link:focus-visible) small { max-height:3.2em; margin-top:.28rem; opacity:1; transform:translateY(0); }
  .dropdown-arrow { justify-self:end; color:#94a3b8; font-size:.92rem; opacity:.25; transform:translateX(-3px); transition:opacity .14s ease-out,transform .14s ease-out,color .14s ease-out; }
  :global(a.dropdown-link:hover) .dropdown-arrow,:global(a.dropdown-link:focus-visible) .dropdown-arrow,:global(a.dropdown-link.active) .dropdown-arrow { color:#2563eb; opacity:1; transform:translateX(1px); }
  .right-rail { display:flex; align-items:center; gap:.45rem; flex:0 0 auto; }
  .contact-button a,.contact-btn { background:transparent; color:#2563eb; border:2px solid #2563eb; padding:.48rem .85rem; border-radius:9999px; font-weight:600; transition:all .25s; text-decoration:none; white-space:nowrap; }
  .contact-button a:hover,.contact-btn:hover { background:#2563eb; color:#fff; }
  .social { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; transition:transform .2s ease,opacity .2s ease,background .2s ease; opacity:.9; }
  .social:hover { transform:translateY(-1px); opacity:1; }
  .social.reddit:hover { background:rgba(255,69,0,.1); }
  .social.youtube:hover { background:rgba(255,0,0,.1); }
  .mobile-nav { display:none; min-height:56px; align-items:center; justify-content:space-between; gap:.5rem; position:relative; }
  .mobile-nav .nav-toggle > summary { display:inline-flex; align-items:center; justify-content:center; width:42px; height:38px; border:1px solid rgba(0,0,0,.12); background:#fff; border-radius:.65rem; font-size:1.15rem; line-height:1; cursor:pointer; list-style:none; user-select:none; }
  .mobile-nav .nav-toggle > summary::-webkit-details-marker,.mobile-group > summary::-webkit-details-marker { display:none; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .mobile-nav .menu-panel { position:absolute; left:-1rem; right:-1rem; top:calc(100% + 1px); max-height:calc(100vh - 58px); overflow-y:auto; background:#fff; border-top:1px solid rgba(15,23,42,.06); box-shadow:0 18px 38px rgba(15,23,42,.13); display:none; z-index:40; }
  .mobile-nav .nav-toggle[open] .menu-panel { display:block; }
  .mobile-direct-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-bottom:1px solid rgba(15,23,42,.06); }
  .mobile-direct-links-bottom { grid-template-columns:1fr; border-top:1px solid rgba(15,23,42,.06); }
  .mobile-direct-links :global(a) { padding:.95rem .85rem; color:#0f172a; font-weight:650; text-align:center; text-decoration:none!important; transition:color .14s ease-out,background .14s ease-out,transform .12s ease-out; }
  .mobile-direct-links :global(a + a) { border-left:1px solid rgba(15,23,42,.06); }
  .mobile-direct-links :global(a:hover),.mobile-direct-links :global(a:focus-visible),.mobile-direct-links :global(a.active) { color:#1d4ed8; background:#f8faff; }
  .mobile-direct-links :global(a:active) { transform:scale(.98); }
  .mobile-groups { padding:.45rem .8rem; }
  .mobile-group { border-bottom:1px solid rgba(15,23,42,.07); }
