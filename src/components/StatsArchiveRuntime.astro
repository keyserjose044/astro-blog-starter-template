  function pearson(pairs:Array<{x:number;y:number}>){if(pairs.length<3)return null;const xm=average(pairs.map(pair=>pair.x)),ym=average(pairs.map(pair=>pair.y));if(xm===null||ym===null)return null;let top=0,xs=0,ys=0;pairs.forEach(pair=>{const xd=pair.x-xm,yd=pair.y-ym;top+=xd*yd;xs+=xd*xd;ys+=yd*yd;});const bottom=Math.sqrt(xs*ys);return bottom?top/bottom:null;}
