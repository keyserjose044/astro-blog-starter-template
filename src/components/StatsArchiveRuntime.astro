  function drawScatter(host:HTMLElement,pairs:Array<{x:number;y:number;label:string}>,xLabel:string,yLabel:string){const width=900,height=430,margin={left:78,right:26,top:28,bottom:68},innerW=width-margin.left-margin.right,innerH=height-margin.top-margin.bottom,xMax=Math.max(1,...pairs.map(pair=>pair.x)),yMax=Math.max(1,...pairs.map(pair=>pair.y));const chart=svg('svg',{viewBox:`0 0 ${width} ${height}`,role:'img','aria-label':`${xLabel} compared with ${yLabel}`});for(let i=0;i<=4;i+=1){const y=margin.top+innerH*i/4;chart.append(svg('line',{x1:margin.left,x2:width-margin.right,y1:y,y2:y,class:'daily-grid'}));const label=svg('text',{x:margin.left-8,y:y+4,'text-anchor':'end',class:'daily-axis'});label.textContent=format(yMax*(4-i)/4,1);chart.append(label);}for(let i=0;i<=5;i+=1){const x=margin.left+innerW*i/5;const label=svg('text',{x,y:height-35,'text-anchor':'middle',class:'daily-axis'});label.textContent=format(xMax*i/5,1);chart.append(label);}pairs.forEach(pair=>{const circle=svg('circle',{cx:margin.left+pair.x/xMax*innerW,cy:margin.top+innerH-pair.y/yMax*innerH,r:5,fill:'#2563eb',tabindex:0});const title=svg('title');title.textContent=`${pair.label}: ${format(pair.x,2)} · ${format(pair.y,2)}`;circle.append(title);chart.append(circle);});if(pairs.length>=2){const xm=average(pairs.map(pair=>pair.x))!,ym=average(pairs.map(pair=>pair.y))!,den=sum(pairs.map(pair=>(pair.x-xm)**2));if(den>0){const slope=sum(pairs.map(pair=>(pair.x-xm)*(pair.y-ym)))/den,intercept=ym-slope*xm;const y1=Math.max(0,intercept),y2=Math.max(0,intercept+slope*xMax);chart.append(svg('line',{x1:margin.left,y1:margin.top+innerH-y1/yMax*innerH,x2:width-margin.right,y2:margin.top+innerH-y2/yMax*innerH,stroke:'#d97706','stroke-width':2}));}}const xt=svg('text',{x:margin.left+innerW/2,y:height-8,'text-anchor':'middle',class:'daily-axis-title'});xt.textContent=xLabel;chart.append(xt);const yt=svg('text',{x:-(margin.top+innerH/2),y:18,transform:'rotate(-90)','text-anchor':'middle',class:'daily-axis-title'});yt.textContent=yLabel;chart.append(yt);host.replaceChildren(chart);}

