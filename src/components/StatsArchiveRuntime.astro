  .daily-live-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin:1rem 0}.daily-live-summary article{padding:.85rem;border:1px solid rgba(148,163,184,.22);border-radius:.95rem;background:rgba(255,255,255,.82)}.daily-live-summary span{display:block;color:#64748b;font-size:.7rem;font-weight:850;letter-spacing:.04em;text-transform:uppercase}.daily-live-summary strong{display:block;margin-top:.36rem;color:#0f172a;font-size:1.22rem;line-height:1.25}
  .daily-live-chart-shell{padding:1rem;border:1px solid rgba(148,163,184,.22);border-radius:1rem;background:rgba(255,255,255,.84)}.daily-live-chart-head{display:flex;justify-content:space-between;gap:1rem;margin-bottom:.65rem}.daily-live-chart-head strong,.daily-live-chart-head span{display:block}.daily-live-chart-head span{margin-top:.2rem;color:#64748b;font-size:.78rem}.daily-live-chart{min-height:330px;overflow-x:auto;border-radius:.85rem;background:#f8fafc}.daily-live-chart svg{display:block;width:100%;min-width:760px;height:auto}.daily-axis{fill:#64748b;font-size:12px}.daily-axis-title{fill:#475569;font-size:12px;font-weight:700}.daily-grid{stroke:rgba(148,163,184,.25);stroke-width:1}.daily-future{fill:rgba(148,163,184,.08)}.daily-future-label{fill:#94a3b8;font-size:12px}.daily-bar{fill:#3b82f6}.daily-bar:hover,.daily-bar:focus{fill:#1d4ed8;outline:none}.daily-zero{fill:#94a3b8}.daily-missing{fill:#cbd5e1}.daily-calendar-cell{stroke:rgba(255,255,255,.7);stroke-width:.6}.daily-calendar-missing{fill:#e2e8f0}.daily-calendar-future{fill:#f1f5f9}.daily-live-footer{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(148,163,184,.2)}.daily-live-footer p{margin:0;color:#64748b;font-size:.84rem}.daily-live-footer a{color:#1d4ed8;font-weight:750;text-decoration:none}
  .snapshot-grid--daily{margin-top:1rem}.snapshot-card--dance .snapshot-card__icon{background:#fce7f3}.snapshot-card--work .snapshot-card__icon{background:#e0f2fe}.snapshot-card--language .snapshot-card__icon{background:#ede9fe}.snapshot-card--treadmill .snapshot-card__icon{background:#dcfce7}
  .daily-analysis-note{margin:.9rem 0 0;color:#64748b;font-size:.82rem}
  .daily-hobby-shell,.daily-correlation-shell{overflow:hidden;border:1px solid rgba(15,23,42,.12);border-radius:28px;background:rgba(255,255,255,.88);box-shadow:0 22px 60px rgba(15,23,42,.09)}.daily-analysis-controls{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;padding:1.1rem 1.25rem;border-bottom:1px solid rgba(15,23,42,.1);background:linear-gradient(120deg,rgba(235,242,255,.88),rgba(235,250,243,.8))}.daily-analysis-controls label{display:grid;gap:.38rem;color:#667085;font-size:.7rem;font-weight:850;text-transform:uppercase}.daily-analysis-controls select{min-width:155px;min-height:2.65rem;padding:.55rem .7rem;border:1px solid rgba(15,23,42,.13);border-radius:.8rem;background:#fff;color:#111827;font:inherit;font-weight:700}.daily-analysis-toggles{display:flex;flex-wrap:wrap;gap:.42rem}.daily-analysis-toggle input{position:absolute;opacity:0;pointer-events:none}.daily-analysis-toggle span{display:inline-flex;align-items:center;gap:.35rem;padding:.48rem .68rem;border:1px solid rgba(148,163,184,.3);border-radius:999px;background:#fff;color:#475569;font-size:.78rem;font-weight:750;cursor:pointer}.daily-analysis-toggle input:checked+span{border-color:var(--metric-color);box-shadow:inset 0 0 0 1px var(--metric-color);color:#0f172a}.daily-analysis-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;padding:1rem 1.25rem}.daily-analysis-summary article{padding:.85rem;border:1px solid rgba(148,163,184,.22);border-radius:.9rem;background:#f8fafc}.daily-analysis-summary span{display:block;color:#64748b;font-size:.7rem;font-weight:850;text-transform:uppercase}.daily-analysis-summary strong{display:block;margin-top:.32rem;color:#0f172a;font-size:1.15rem}.daily-analysis-chart{padding:0 1.25rem 1.25rem;overflow-x:auto}.daily-analysis-chart svg{display:block;width:100%;min-width:720px;height:auto}.daily-analysis-legend{display:flex;flex-wrap:wrap;gap:.75rem;padding:0 1.25rem 1.2rem;color:#475569;font-size:.78rem}.daily-analysis-legend span{display:inline-flex;align-items:center;gap:.35rem}.daily-analysis-legend i{width:.65rem;height:.65rem;border-radius:50%;background:var(--legend-color)}.daily-share-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;padding:0 1.25rem 1.25rem}.daily-share-list article{padding:.75rem;border:1px solid rgba(148,163,184,.2);border-radius:.85rem}.daily-share-list span{display:block;color:#64748b;font-size:.72rem}.daily-share-list strong{display:block;margin-top:.25rem}
  .daily-records-heading{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin:1.5rem 0 .85rem}.daily-records-heading h3{margin:0}.daily-records-heading p{max-width:620px;margin:0;color:#64748b;font-size:.86rem}.records-grid--daily{margin-top:0}.record-card--daily dl{grid-template-columns:1fr}.record-card--daily dd{font-size:.9rem}
  @media(max-width:900px){.daily-live-controls{grid-template-columns:1fr 1fr}.daily-live-control:first-child{grid-column:1/-1}.daily-live-summary,.stats-dashboard .daily-preview__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.daily-share-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.stats-dashboard .view-toggle{grid-template-columns:1fr!important}.daily-live-controls,.daily-live-summary,.stats-dashboard .daily-preview__metrics,.daily-analysis-summary,.daily-share-list{grid-template-columns:1fr}.daily-live-control:first-child{grid-column:auto}.daily-live-footer,.daily-records-heading{align-items:stretch;flex-direction:column}.daily-analysis-controls{align-items:stretch;flex-direction:column}.daily-analysis-controls select{width:100%}}
  :global(html.dark) .daily-live-select,:global(html.dark) .daily-live-buttons button,:global(html.dark) .daily-live-summary article,:global(html.dark) .daily-live-chart-shell,:global(html.dark) .daily-hobby-shell,:global(html.dark) .daily-correlation-shell,:global(html.dark) .daily-analysis-controls select,:global(html.dark) .daily-analysis-toggle span,:global(body.dark) .daily-live-select,:global(body.dark) .daily-live-buttons button,:global(body.dark) .daily-live-summary article,:global(body.dark) .daily-live-chart-shell,:global(body.dark) .daily-hobby-shell,:global(body.dark) .daily-correlation-shell,:global(body.dark) .daily-analysis-controls select,:global(body.dark) .daily-analysis-toggle span{background:#111827;color:#f8fafc;border-color:rgba(148,163,184,.2)}
  :global(html.dark) .daily-live-summary strong,:global(html.dark) .daily-analysis-summary strong,:global(body.dark) .daily-live-summary strong,:global(body.dark) .daily-analysis-summary strong{color:#f8fafc}:global(html.dark) .daily-live-chart,:global(body.dark) .daily-live-chart{background:#0f172a}:global(html.dark) .daily-analysis-summary article,:global(body.dark) .daily-analysis-summary article{background:#0f172a}
</style>

<script>
  import {
    dailyMetricValue,
    getDailyMeta,
    getDay,
    getYear,
    getYears,
    prefetchYear,
  } from '../utils/dailyData';
  import type { DailyMeta, DailyRecord } from '../utils/dailyData';

  const NS = 'http://www.w3.org/2000/svg';
  const RUN_MINUTES_PER_MILE = 10;
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const COLORS = ['#2563eb','#7c3aed','#db2777','#0f8a5f','#0891b2','#d97706'];

  type MetricKey = 'guitar'|'audiobook'|'running'|'diary'|'sleep'|'dance'|'work'|'language'|'treadmill';
  type Point = { date:string; value:number|null; state:'recorded'|'missing'|'future' };
  type MonthlyValue = { key:string; year:number; month:number; value:number|null };

  const METRICS: Record<MetricKey,{label:string;api:string;unit:string;digits:number;kind:'sum'|'average'}> = {
    guitar:{label:'Guitar',api:'guitarMinutes',unit:'minutes',digits:0,kind:'sum'},
    audiobook:{label:'Audiobooks',api:'audiobookMinutes',unit:'minutes',digits:0,kind:'sum'},
    running:{label:'Running',api:'runningMiles',unit:'miles',digits:1,kind:'sum'},
    diary:{label:'Diary',api:'diaryWords',unit:'words',digits:0,kind:'sum'},
    sleep:{label:'Sleep',api:'sleepHours',unit:'hours',digits:1,kind:'average'},
    dance:{label:'Dance',api:'danceMinutes',unit:'minutes',digits:0,kind:'sum'},
    work:{label:'Work & study',api:'workHours',unit:'hours',digits:1,kind:'sum'},
    language:{label:'Language study',api:'languageMinutes',unit:'minutes',digits:0,kind:'sum'},
    treadmill:{label:'Treadmill',api:'treadmillMinutes',unit:'minutes',digits:0,kind:'sum'},
  };

  const parseIso=(value:string)=>new Date(`${value}T12:00:00`);
  const toIso=(date:Date)=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
  const shortDate=(value:string)=>new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric'}).format(parseIso(value));
  const longDate=(value:string)=>new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).format(parseIso(value));
  const format=(value:number|null,digits=0)=>value===null||!Number.isFinite(value)?'—':new Intl.NumberFormat('en-US',{maximumFractionDigits:digits}).format(value);
  const sum=(values:Array<number|null>)=>values.reduce((total,value)=>total+(value??0),0);
  const average=(values:Array<number|null>)=>{const valid=values.filter((value):value is number=>value!==null&&Number.isFinite(value));return valid.length?sum(valid)/valid.length:null;};
  const waitFor=async(selector:string,attempts=120)=>{for(let i=0;i<attempts;i+=1){const node=document.querySelector(selector);if(node instanceof HTMLElement)return node;await new Promise(resolve=>setTimeout(resolve,25));}return null;};
  const setText=(root:ParentNode,selector:string,value:string)=>{const node=root.querySelector(selector);if(node)node.textContent=value;};
  const svg=(tag:string,attrs:Record<string,string|number>={})=>{const node=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,String(value)));return node;};
  const escape=(value:unknown)=>String(value??'').replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]||char));

  function monthKey(date:string){return date.slice(0,7);}
  function recordsByMonth(records:DailyRecord[]){
    const groups=new Map<string,DailyRecord[]>();
    records.forEach(record=>{const key=monthKey(record.date);if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(record);});
    return groups;
  }
  function monthly(records:DailyRecord[],value:(record:DailyRecord)=>number|null,mode:'sum'|'average'='sum'){
    const groups=recordsByMonth(records);const output:MonthlyValue[]=[];
    groups.forEach((list,key)=>{const values=list.map(value);output.push({key,year:Number(key.slice(0,4)),month:Number(key.slice(5,7))-1,value:mode==='average'?average(values):sum(values)});});
    return output.sort((a,b)=>a.key.localeCompare(b.key));
  }
  function best<T>(items:T[],value:(item:T)=>number|null){return items.reduce<T|null>((winner,item)=>{const candidate=value(item);if(candidate===null)return winner;if(!winner)return item;const current=value(winner);return current===null||candidate>current?item:winner;},null);}

  function fillPoints(records:DailyRecord[],year:number,metric:MetricKey,range:string,meta:DailyMeta):Point[]{
    const config=METRICS[metric];const map=new Map(records.map(record=>[record.date,record]));
    const yearStart=new Date(year,0,1,12);const yearEnd=new Date(year,11,31,12);
    const dataEnd=meta.dataThrough&&Number(meta.dataThrough.slice(0,4))===year?parseIso(meta.dataThrough):yearEnd;
    let start=new Date(yearStart);let end=new Date(yearEnd);
    if(range==='ytd')end=new Date(dataEnd);
    if(range==='30'||range==='90'){end=new Date(dataEnd);start=new Date(end);start.setDate(start.getDate()-Number(range)+1);if(start<yearStart)start=yearStart;}
    const points:Point[]=[];for(const date=new Date(start);date<=end;date.setDate(date.getDate()+1)){const iso=toIso(date);const record=map.get(iso);const future=meta.dataThrough?iso>meta.dataThrough:false;points.push({date:iso,value:record?dailyMetricValue(record,config.api):null,state:future?'future':record?'recorded':'missing'});}return points;
  }

  function drawTimeline(host:HTMLElement,points:Point[],config:typeof METRICS[MetricKey]){
    const width=1000,height=340,margin={left:62,right:22,top:25,bottom:52};const innerW=width-margin.left-margin.right,innerH=height-margin.top-margin.bottom;
    const values=points.filter(point=>point.state==='recorded'&&point.value!==null).map(point=>point.value as number);const max=Math.max(1,...values);const chart=svg('svg',{viewBox:`0 0 ${width} ${height}`,role:'img','aria-label':`${config.label} daily chart`});
    for(let i=0;i<=4;i+=1){const value=max*(4-i)/4;const y=margin.top+innerH*i/4;chart.append(svg('line',{x1:margin.left,x2:width-margin.right,y1:y,y2:y,class:'daily-grid'}));const label=svg('text',{x:margin.left-10,y:y+4,'text-anchor':'end',class:'daily-axis'});label.textContent=format(value,config.digits);chart.append(label);}
    const firstFuture=points.findIndex(point=>point.state==='future');if(firstFuture>=0){const startX=margin.left+innerW*firstFuture/Math.max(1,points.length);chart.append(svg('rect',{x:startX,y:margin.top,width:width-margin.right-startX,height:innerH,class:'daily-future'}));const label=svg('text',{x:startX+8,y:margin.top+16,class:'daily-future-label'});label.textContent='Future dates';chart.append(label);}
    const slot=innerW/Math.max(1,points.length);const barWidth=Math.max(1,slot*.74);
    points.forEach((point,index)=>{if(point.state==='future')return;const x=margin.left+slot*index+(slot-barWidth)/2;const value=point.value;const h=value===null?3:Math.max(value===0?2:3,(value/max)*innerH);const rect=svg('rect',{x,y:margin.top+innerH-h,width:barWidth,height:h,rx:Math.min(2,barWidth/2),class:value===null?'daily-missing':value===0?'daily-zero':'daily-bar',tabindex:0,role:'link'});const title=svg('title');title.textContent=`${longDate(point.date)}: ${value===null?'not logged':`${format(value,config.digits)} ${config.unit}`}`;rect.append(title);const open=()=>{location.href=`/day/?date=${point.date}`;};rect.addEventListener('click',open);rect.addEventListener('keydown',(event)=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open();}});chart.append(rect);});
    const labelCount=points.length>200?12:points.length>80?8:6;for(let i=0;i<labelCount;i+=1){const index=Math.round((points.length-1)*i/Math.max(1,labelCount-1));const point=points[index];if(!point)continue;const x=margin.left+slot*index+slot/2;const label=svg('text',{x,y:height-25,'text-anchor':'middle',class:'daily-axis'});label.textContent=shortDate(point.date);chart.append(label);}
    const yTitle=svg('text',{x:-(margin.top+innerH/2),y:16,transform:'rotate(-90)','text-anchor':'middle',class:'daily-axis-title'});yTitle.textContent=config.unit;chart.append(yTitle);const xTitle=svg('text',{x:margin.left+innerW/2,y:height-5,'text-anchor':'middle',class:'daily-axis-title'});xTitle.textContent='Date';chart.append(xTitle);host.replaceChildren(chart);
  }

  function drawCalendar(host:HTMLElement,points:Point[],config:typeof METRICS[MetricKey]){
    const start=parseIso(points[0]?.date||'2023-01-01');const offset=start.getDay();const weeks=Math.ceil((offset+points.length)/7);const cell=14,gap=3,margin={left:42,right:20,top:34,bottom:28};const width=margin.left+margin.right+weeks*(cell+gap),height=margin.top+margin.bottom+7*(cell+gap);const chart=svg('svg',{viewBox:`0 0 ${Math.max(760,width)} ${height}`,role:'img','aria-label':`${config.label} calendar chart`});const values=points.filter(point=>point.value!==null&&point.state==='recorded').map(point=>point.value as number);const max=Math.max(1,...values);
    ['Sun','Tue','Thu','Sat'].forEach((label,index)=>{const row=index*2;const text=svg('text',{x:margin.left-8,y:margin.top+row*(cell+gap)+11,'text-anchor':'end',class:'daily-axis'});text.textContent=label;chart.append(text);});
    points.forEach((point,index)=>{const position=offset+index,week=Math.floor(position/7),day=position%7,x=margin.left+week*(cell+gap),y=margin.top+day*(cell+gap);const level=point.value===null?0:Math.max(0,Math.min(1,(point.value||0)/max));const fill=point.state==='future'?'#f1f5f9':point.value===null?'#e2e8f0':point.value===0?'#cbd5e1':`rgba(37,99,235,${.22+.78*level})`;const rect=svg('rect',{x,y,width:cell,height:cell,rx:3,fill,class:`daily-calendar-cell ${point.state==='future'?'daily-calendar-future':point.value===null?'daily-calendar-missing':''}`,tabindex:point.state==='future'?-1:0});const title=svg('title');title.textContent=`${longDate(point.date)}: ${point.state==='future'?'future date':point.value===null?'not logged':`${format(point.value,config.digits)} ${config.unit}`}`;rect.append(title);if(point.state!=='future')rect.addEventListener('click',()=>location.href=`/day/?date=${point.date}`);chart.append(rect);});
    const seen=new Set<number>();points.forEach((point,index)=>{const date=parseIso(point.date),month=date.getMonth();if(seen.has(month)||date.getDate()>7)return;seen.add(month);const week=Math.floor((offset+index)/7);const text=svg('text',{x:margin.left+week*(cell+gap),y:18,class:'daily-axis-title'});text.textContent=MONTHS[month];chart.append(text);});host.replaceChildren(chart);
  }

  function updatePreview(preview:HTMLElement,record:DailyRecord){
    const pieces=longDate(record.date).split(', ');setText(preview,'[data-daily-preview-weekday]',pieces[0]||'Archive day');setText(preview,'[data-daily-preview-date]',pieces.slice(1).join(', '));
    const cards=preview.querySelector('.daily-preview__metrics');if(!(cards instanceof HTMLElement))return;
    const treadmillMiles=record.hobbies.treadmillMiles;const running=record.hobbies.runningMiles;const movement=record.hobbies.totalDistanceMiles;
    const items=[
      ['Sleep',format(record.sleep.hours,1),'hours'],
      ['Guitar',format(record.hobbies.guitarMinutes),'minutes'],
      ['Movement',format(movement,1),`${format(running,1)} run + ${format(treadmillMiles,1)} treadmill mi`],
      ['Diary',format(record.diary.words),'words'],
      ['Work & study',format(record.work.hours,1),'hours'],
      ['Audiobooks',format(record.audiobook.minutes),'minutes'],
      ['Dance',format(record.hobbies.danceMinutes),'minutes'],
      ['Language',format(record.hobbies.languageMinutes),'minutes'],
    ];
    cards.replaceChildren();items.forEach(([label,value,note])=>{const card=document.createElement('article');card.innerHTML=`<span>${escape(label)}</span><strong>${escape(value)}</strong><small>${escape(note)}</small>`;cards.append(card);});
    setText(preview,'.daily-preview__date p','Latest completed public-safe Archive record. Movement is combined distance; the breakdown keeps running and treadmill miles separate.');const status=preview.querySelector('.daily-preview__status');if(status instanceof HTMLElement){status.replaceChildren();const dot=document.createElement('span');dot.setAttribute('aria-hidden','true');status.append(dot,document.createTextNode(' Live daily archive'));}const link=preview.querySelector('a');if(link instanceof HTMLAnchorElement)link.href=`/day/?date=${record.date}`;
  }

  async function initDailyExplorer(dashboard:HTMLElement,meta:DailyMeta){
    const preview=await waitFor('.stats-dashboard .daily-preview');const mode=await waitFor('.stats-dashboard .daily-mode');const yearSelect=dashboard.querySelector('#graph-year') as HTMLSelectElement|null;
    const latestDate=meta.latestCompleteDate||meta.dataThrough;if(latestDate&&preview){const year=Number(latestDate.slice(0,4));prefetchYear(year);const yearRecords=await getYear(year);const latest=yearRecords.find(record=>record.date===latestDate)||await getDay(latestDate);updatePreview(preview,latest);}
    if(!mode)return;
    mode.innerHTML=`<div class="daily-mode__topline"><div><p class="daily-mode__eyebrow">Daily archive view</p><h3 data-live-title>Daily values</h3><p class="daily-mode__lede">Full-year is the default. Unelapsed dates remain empty, recorded zeroes remain zero, and missing values remain distinct.</p></div><span class="daily-mode__badge" data-live-status>Ready</span></div><div class="daily-live-controls"><label class="daily-live-control"><span>Daily metric</span><select class="daily-live-select" data-daily-metric>${Object.entries(METRICS).map(([key,item])=>`<option value="${key}">${item.label}</option>`).join('')}</select></label><div class="daily-live-control"><span>Range</span><div class="daily-live-buttons" data-range><button class="is-active" data-value="year">Full year</button><button data-value="ytd">Year to date</button><button data-value="90">90 days</button><button data-value="30">30 days</button></div></div><div class="daily-live-control"><span>Chart</span><div class="daily-live-buttons" data-chart-type><button class="is-active" data-value="timeline">Timeline</button><button data-value="calendar">Calendar</button></div></div></div><div class="daily-live-summary"><article><span data-total-label>Period total</span><strong data-total>—</strong></article><article><span>Average measured day</span><strong data-average>—</strong></article><article><span>Peak day</span><strong data-peak>—</strong></article><article><span>Active / measured</span><strong data-active>—</strong></article></div><div class="daily-live-chart-shell"><div class="daily-live-chart-head"><div><strong data-chart-title>Daily chart</strong><span data-period></span></div><span data-unit></span></div><div class="daily-live-chart" data-chart><div class="daily-live-empty">Loading daily values…</div></div></div><div class="daily-live-footer"><p data-updated>Daily metadata loaded.</p><a href="/day/">Open the full Day Explorer →</a></div>`;
    let metric:MetricKey='guitar',range='year',chartType='timeline',request=0;const metricSelect=mode.querySelector('[data-daily-metric]') as HTMLSelectElement;const compare=dashboard.querySelector('#graph-compare') as HTMLSelectElement|null;
    const selectedYear=()=>{const value=Number(yearSelect?.value);return meta.availableYears.includes(value)?value:Number((meta.latestCompleteDate||meta.dataThrough||'').slice(0,4));};
