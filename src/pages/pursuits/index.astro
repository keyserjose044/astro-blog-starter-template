---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import PursuitsNav from '../../components/PursuitsNav.astro';
import PursuitCalendar from '../../components/PursuitCalendar.astro';
import { SITE_TITLE } from '../../consts';
---

<BaseHead
  title={`${SITE_TITLE} — Pursuits`}
  description="Guitar, dance, running, languages, and future disciplines: the active skills and practices developed through the LifeLoggerz archive."
/>

<VideoBg>
  <Header />
  <main class="pursuits-page">
    <section class="pursuits-hero" aria-labelledby="pursuits-title">
      <div class="pursuits-hero__copy">
        <p class="pursuits-hero__eyebrow">The practiced side of LifeLoggerz</p>
        <h1 id="pursuits-title" class="pursuits-hero__title">Pursuits</h1>
        <p class="pursuits-hero__lede">Not everything meaningful is something I consumed. These are the skills, disciplines, and physical practices I have tried to build through repetition.</p>
        <p class="pursuits-hero__note">The pages preserve progress, resources, dead ends, turning points, and the allocation of limited time—not merely lifetime totals.</p>
      </div>

      <div class="pursuits-hero__media" aria-label="Guitar practice clip">
        <video id="hero-guitar-video" autoplay muted loop playsinline preload="metadata">
          <source src="/videos/guitar.mp4" type="video/mp4" />
        </video>
        <div class="pursuits-hero__shade" aria-hidden="true"></div>
        <div class="pursuits-hero__caption">
          <span>Practice in motion</span>
          <strong>Guitar</strong>
          <p>Lifetime practice · <b id="hero-guitar-lifetime">—</b></p>
        </div>
        <button id="hero-audio-toggle" class="pursuits-hero__audio" type="button" aria-label="Unmute guitar clip" aria-pressed="false">🔇</button>
      </div>
    </section>

    <PursuitsNav active="overview" />
    <div class="hero pursuits-live-anchor" aria-hidden="true"></div>

    <div id="calendar"><PursuitCalendar /></div>

    <section class="growth-section" aria-labelledby="growth-title">
      <div>
        <p class="growth-eyebrow">Expandable by design</p>
        <h2 id="growth-title">The section can grow as life grows</h2>
        <p>Calligraphy, photography, cooking, strength training, or another serious practice can eventually join the same structure without crowding the main header. A new pursuit earns a page when there is enough history, learning, or material worth preserving.</p>
      </div>
      <div class="growth-path" aria-hidden="true">
        <span class="active">Now</span><i></i><span>Calligraphy?</span><i></i><span>Whatever comes next</span>
      </div>
    </section>
  </main>
  <Footer />
</VideoBg>

<script>
  import { getDailyMeta, getYears } from '../../utils/dailyData';

  const video = document.querySelector<HTMLVideoElement>('#hero-guitar-video');
  const button = document.querySelector<HTMLButtonElement>('#hero-audio-toggle');
  const lifetime = document.querySelector<HTMLElement>('#hero-guitar-lifetime');

  if (video && button) {
    button.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => undefined);
      button.textContent = video.muted ? '🔇' : '🔊';
      button.setAttribute('aria-pressed', String(!video.muted));
      button.setAttribute('aria-label', video.muted ? 'Unmute guitar clip' : 'Mute guitar clip');
    });
  }

  if (lifetime) {
    getDailyMeta().then(async (meta) => {
      const records = await getYears(meta.availableYears);
      const dataThrough = meta.dataThrough || records.at(-1)?.date || '9999-12-31';
      const minutes = records.reduce((total, record) => {
        if (record.date < '2023-09-27' || record.date > dataThrough) return total;
        const value = record.hobbies.guitarMinutes;
        return total + (typeof value === 'number' && Number.isFinite(value) ? value : 0);
      }, 0);
      lifetime.textContent = `${new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 }).format(minutes / 60)} hours`;
    }).catch(() => {
      lifetime.textContent = 'Archive connected';
    });
  }
</script>

<style>
  * { box-sizing:border-box; }
  .pursuits-page { min-height:100vh; padding-bottom:58px; }
  .pursuits-live-anchor { display:none!important; width:0!important; height:0!important; min-height:0!important; margin:0!important; padding:0!important; }

  /* This component intentionally does NOT use the shared .hero class. */
  .pursuits-hero {
    display:grid;
    grid-template-columns:minmax(0,1fr) 470px;
    align-items:center;
    gap:clamp(44px,4vw,70px);
    width:min(1500px,calc(100% - 40px));
    height:auto;
    min-height:0;
    margin:24px auto 12px;
    padding:54px 62px;
    overflow:hidden;
    border:1px solid rgba(218,224,235,.96);
    border-radius:32px;
    background:
      radial-gradient(circle at 84% 20%,rgba(64,92,245,.11),transparent 34%),
      radial-gradient(circle at 10% 82%,rgba(195,66,143,.075),transparent 31%),
      linear-gradient(135deg,rgba(247,249,255,.97),rgba(255,255,255,.95));
    color:#141923;
    box-shadow:0 18px 52px rgba(15,23,42,.09);
    backdrop-filter:blur(10px);
  }

  .pursuits-hero__copy { min-width:0; max-width:780px; }
  .pursuits-hero__eyebrow,
  .growth-eyebrow { margin:0 0 10px; color:#405cf5; font-size:.72rem; font-weight:900; letter-spacing:.17em; text-transform:uppercase; }

  .pursuits-hero__title {
    width:max-content;
    margin:0;
    color:#111827;
    font-size:clamp(5.6rem,7vw,7.7rem);
    line-height:.84;
    letter-spacing:-.075em;
    white-space:nowrap;
    word-break:normal;
    overflow-wrap:normal;
    hyphens:none;
    text-shadow:none;
  }

  .pursuits-hero__lede { max-width:760px; margin:30px 0 0; color:#252b38; font-size:clamp(1.08rem,1.45vw,1.32rem); line-height:1.55; }
  .pursuits-hero__note { max-width:700px; margin:17px 0 0; color:#626978; font-size:.98rem; line-height:1.62; }

  .pursuits-hero__media {
    position:relative;
    width:470px;
    max-width:100%;
    aspect-ratio:1;
    justify-self:end;
    align-self:center;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.82);
    border-radius:28px;
    background:#111827;
    box-shadow:0 24px 55px rgba(15,23,42,.18),0 0 0 1px rgba(15,23,42,.06);
  }
  .pursuits-hero__media video { width:100%; height:100%; display:block; object-fit:cover; filter:saturate(.9) contrast(1.03); transform:scale(1.012); }
  .pursuits-hero__shade { position:absolute; inset:0; background:linear-gradient(180deg,transparent 43%,rgba(5,8,15,.8)); pointer-events:none; }
  .pursuits-hero__caption { position:absolute; left:26px; right:82px; bottom:23px; z-index:1; color:#fff; text-shadow:0 3px 18px rgba(0,0,0,.65); }
  .pursuits-hero__caption > span { display:block; margin-bottom:4px; font-size:.67rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; opacity:.85; }
  .pursuits-hero__caption > strong { display:block; font-size:clamp(2rem,3vw,3rem); line-height:.94; letter-spacing:-.045em; }
  .pursuits-hero__caption > p { margin:9px 0 0; color:rgba(255,255,255,.9); font-size:.75rem; font-weight:700; line-height:1.35; text-shadow:0 2px 12px rgba(0,0,0,.72); }
  .pursuits-hero__caption b { color:#fff; font-weight:900; }
  .pursuits-hero__audio { position:absolute; z-index:2; right:18px; bottom:18px; display:grid; width:46px; height:46px; place-items:center; border:1px solid rgba(255,255,255,.55); border-radius:50%; background:rgba(0,0,0,.52); color:#fff; font-size:1rem; cursor:pointer; backdrop-filter:blur(8px); transition:transform .18s ease,background .18s ease; }
  .pursuits-hero__audio:hover { transform:scale(1.06); background:rgba(0,0,0,.72); }
  .pursuits-hero__audio:focus-visible { outline:3px solid rgba(255,255,255,.8); outline-offset:3px; }

  .growth-section {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:40px;
    max-width:1284px;
    margin:0 auto;
    padding:30px clamp(22px,4vw,44px);
    border:1px solid #e0e5ed;
    border-radius:26px;
    background:linear-gradient(135deg,rgba(240,242,255,.95),rgba(255,255,255,.94));
    box-shadow:0 16px 40px rgba(15,23,42,.07);
  }
  .growth-section > div:first-child { max-width:760px; }
  .growth-section h2 { margin:0; color:#141923; font-size:clamp(1.9rem,4vw,3.3rem); letter-spacing:-.05em; }
  .growth-section p:last-child { margin:9px 0 0; color:#626978; line-height:1.65; }
  .growth-path { display:flex; align-items:center; gap:10px; flex:0 0 auto; }
  .growth-path span { padding:8px 11px; border:1px solid #dfe4ed; border-radius:999px; background:#fff; color:#687080; font-size:.72rem; font-weight:800; white-space:nowrap; }
  .growth-path span.active { border-color:#405cf5; background:#405cf5; color:#fff; }
  .growth-path i { width:24px; height:1px; background:#ccd3df; }

  @media (max-width:1250px) and (min-width:881px) {
    .pursuits-hero {
      grid-template-columns:minmax(0,1fr) 390px;
      gap:36px;
      padding:44px 44px;
    }
    .pursuits-hero__title { font-size:clamp(4.7rem,7vw,6rem); }
    .pursuits-hero__lede { margin-top:25px; font-size:1.08rem; }
    .pursuits-hero__note { font-size:.92rem; }
    .pursuits-hero__media { width:390px; }
  }

  /* Mobile is intentionally different: copy first, wide visual below. */
  @media (max-width:880px) {
    .pursuits-hero {
      display:flex;
      flex-direction:column;
      align-items:stretch;
      gap:28px;
      width:calc(100% - 20px);
      margin:14px 10px 10px;
      padding:34px 26px 26px;
      border-radius:26px;
    }
    .pursuits-hero__copy { max-width:none; }
    .pursuits-hero__title { width:auto; max-width:100%; font-size:clamp(4.2rem,18vw,6.2rem); white-space:normal; line-height:.84; }
    .pursuits-hero__lede { max-width:none; margin-top:24px; font-size:1.05rem; line-height:1.52; }
    .pursuits-hero__note { max-width:none; margin-top:13px; font-size:.9rem; line-height:1.56; }
    .pursuits-hero__media { width:100%; max-width:none; aspect-ratio:4/3; border-radius:22px; box-shadow:0 18px 40px rgba(15,23,42,.16),0 0 0 1px rgba(15,23,42,.06); }
    .pursuits-hero__media video { object-position:center 48%; }
    .pursuits-hero__caption { left:20px; right:72px; bottom:18px; }
    .pursuits-hero__caption > strong { font-size:2.1rem; }
    .pursuits-hero__caption > p { margin-top:6px; font-size:.7rem; }
    .pursuits-hero__audio { right:14px; bottom:14px; width:42px; height:42px; }
    .growth-section { align-items:flex-start; flex-direction:column; margin-left:10px; margin-right:10px; }
  }

  @media (max-width:480px) {
    .pursuits-page { padding-bottom:38px; }
    .pursuits-hero { padding:30px 20px 20px; gap:24px; border-radius:22px; }
    .pursuits-hero__eyebrow { font-size:.66rem; }
    .pursuits-hero__title { font-size:clamp(3.7rem,19vw,5rem); }
    .pursuits-hero__lede { margin-top:20px; font-size:1rem; }
    .pursuits-hero__note { font-size:.86rem; }
    .pursuits-hero__media { aspect-ratio:1; border-radius:18px; }
    .pursuits-hero__caption { left:17px; bottom:16px; }
    .pursuits-hero__caption > strong { font-size:1.9rem; }
    .growth-section { padding:24px 20px; border-radius:22px; }
    .growth-path { width:100%; flex-wrap:wrap; }
  }

  html.dark .pursuits-hero, body.dark .pursuits-hero, html[data-theme='dark'] .pursuits-hero {
    border-color:rgba(148,163,184,.18);
    background:
      radial-gradient(circle at 82% 18%,rgba(64,92,245,.14),transparent 34%),
      radial-gradient(circle at 10% 82%,rgba(195,66,143,.1),transparent 31%),
      linear-gradient(135deg,rgba(17,24,39,.96),rgba(15,23,42,.95));
  }
  html.dark .pursuits-hero__title, body.dark .pursuits-hero__title, html[data-theme='dark'] .pursuits-hero__title,
  html.dark .pursuits-hero__lede, body.dark .pursuits-hero__lede, html[data-theme='dark'] .pursuits-hero__lede,
  html.dark .growth-section h2, body.dark .growth-section h2, html[data-theme='dark'] .growth-section h2 { color:#f8fafc; }
  html.dark .pursuits-hero__note, body.dark .pursuits-hero__note, html[data-theme='dark'] .pursuits-hero__note,
  html.dark .growth-section p:last-child, body.dark .growth-section p:last-child, html[data-theme='dark'] .growth-section p:last-child { color:#aeb7c7; }
  html.dark .growth-section, body.dark .growth-section, html[data-theme='dark'] .growth-section { border-color:rgba(148,163,184,.18); background:linear-gradient(135deg,rgba(25,31,54,.95),rgba(17,24,39,.94)); }
  html.dark .growth-path span, body.dark .growth-path span, html[data-theme='dark'] .growth-path span { border-color:rgba(148,163,184,.22); background:#111827; color:#b6c0cf; }
  html.dark .growth-path span.active, body.dark .growth-path span.active, html[data-theme='dark'] .growth-path span.active { border-color:#405cf5; background:#405cf5; color:#fff; }

  @media (prefers-reduced-motion:reduce) {
    .pursuits-hero__media video { transform:none; }
    .pursuits-hero__audio { transition:none; }
    .pursuits-hero__audio:hover { transform:none; }
  }
</style>