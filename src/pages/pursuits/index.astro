---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import PursuitsNav from '../../components/PursuitsNav.astro';
import PursuitCalendar from '../../components/PursuitCalendar.astro';
import { SITE_TITLE } from '../../consts';
---

<BaseHead
  title={`${SITE_TITLE} — Pursuits`}
  description="Guitar, dance, running, languages, and future disciplines: the active skills and practices developed through the LifeLoggerz archive."
/>

<VideoBg>
  <Header />
  <main class="pursuits-page">
    <PursuitsNav active="overview" />

    <section class="hero" aria-labelledby="pursuits-title">
      <div class="hero-copy">
        <p class="eyebrow">The practiced side of LifeLoggerz</p>
        <h1 id="pursuits-title">Pursuits</h1>
        <p class="hero-lede">Not everything meaningful is something I consumed. These are the skills, disciplines, and physical practices I have tried to build through repetition.</p>
        <p class="hero-note">The pages preserve progress, resources, dead ends, turning points, and the allocation of limited time—not merely lifetime totals.</p>
      </div>

      <div class="hero-media" aria-label="Guitar practice clip">
        <video id="hero-guitar-video" autoplay muted loop playsinline preload="metadata">
          <source src="/videos/guitar.mp4" type="video/mp4" />
        </video>
        <div class="hero-media-shade" aria-hidden="true"></div>
        <div class="hero-media-caption">
          <span>Practice in motion</span>
          <strong>Guitar</strong>
        </div>
        <button id="hero-audio-toggle" class="hero-audio-toggle" type="button" aria-label="Unmute guitar clip" aria-pressed="false">🔇</button>
      </div>
    </section>

    <div id="calendar"><PursuitCalendar /></div>

    <section class="growth-section" aria-labelledby="growth-title">
      <div>
        <p class="eyebrow">Expandable by design</p>
        <h2 id="growth-title">The section can grow as life grows</h2>
        <p>Calligraphy, photography, cooking, strength training, or another serious practice can eventually join the same structure without crowding the main header. A new pursuit earns a page when there is enough history, learning, or material worth preserving.</p>
      </div>
      <div class="growth-path" aria-hidden="true">
        <span class="active">Now</span><i></i><span>Calligraphy?</span><i></i><span>Whatever comes next</span>
      </div>
    </section>
  </main>
  <Footer />
</VideoBg>

<script>
  const video = document.querySelector<HTMLVideoElement>('#hero-guitar-video');
  const button = document.querySelector<HTMLButtonElement>('#hero-audio-toggle');

  if (video && button) {
    button.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => undefined);
      button.textContent = video.muted ? '🔇' : '🔊';
      button.setAttribute('aria-pressed', String(!video.muted));
      button.setAttribute('aria-label', video.muted ? 'Unmute guitar clip' : 'Mute guitar clip');
    });
  }
</script>

<style>
  * { box-sizing:border-box; }
  .pursuits-page { min-height:100vh; padding-bottom:58px; }

  .hero {
    display:grid;
    grid-template-columns:minmax(0,1.18fr) minmax(330px,.72fr);
    align-items:center;
    gap:clamp(34px,5vw,76px);
    max-width:1380px;
    min-height:500px;
    margin:22px auto 48px;
    padding:clamp(40px,5vw,70px);
    border:1px solid rgba(218,224,235,.96);
    border-radius:32px;
    background:
      radial-gradient(circle at 82% 18%,rgba(64,92,245,.11),transparent 34%),
      radial-gradient(circle at 10% 82%,rgba(195,66,143,.075),transparent 31%),
      linear-gradient(135deg,rgba(247,249,255,.97),rgba(255,255,255,.95));
    color:#141923;
    box-shadow:0 18px 52px rgba(15,23,42,.09);
    backdrop-filter:blur(10px);
  }

  .hero-copy { min-width:0; }
  .eyebrow { margin:0 0 6px; color:#405cf5; font-size:.72rem; font-weight:900; letter-spacing:.17em; text-transform:uppercase; }
  .hero h1 { margin:0; color:#111827; font-size:clamp(4.3rem,10vw,8.6rem); line-height:.82; letter-spacing:-.075em; text-shadow:none; }
  .hero-lede { max-width:760px; margin:28px 0 0; color:#252b38; font-size:clamp(1.08rem,2.1vw,1.48rem); line-height:1.52; }
  .hero-note { max-width:720px; margin:15px 0 0; color:#626978; font-size:1rem; line-height:1.62; }

  .hero-media {
    position:relative;
    justify-self:end;
    width:min(100%,460px);
    aspect-ratio:1;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.78);
    border-radius:28px;
    background:#111827;
    box-shadow:0 24px 55px rgba(15,23,42,.18),0 0 0 1px rgba(15,23,42,.06);
  }
  .hero-media video { width:100%; height:100%; display:block; object-fit:cover; filter:saturate(.88) contrast(1.03); transform:scale(1.015); }
  .hero-media-shade { position:absolute; inset:0; background:linear-gradient(180deg,transparent 52%,rgba(5,8,15,.72)); pointer-events:none; }
  .hero-media-caption { position:absolute; left:24px; right:76px; bottom:22px; z-index:1; color:#fff; text-shadow:0 3px 18px rgba(0,0,0,.65); }
  .hero-media-caption span { display:block; margin-bottom:3px; font-size:.66rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; opacity:.82; }
  .hero-media-caption strong { display:block; font-size:clamp(1.8rem,3vw,2.8rem); line-height:.95; letter-spacing:-.045em; }
  .hero-audio-toggle { position:absolute; z-index:2; right:18px; bottom:18px; display:grid; width:46px; height:46px; place-items:center; border:1px solid rgba(255,255,255,.55); border-radius:50%; background:rgba(0,0,0,.52); color:#fff; font-size:1rem; cursor:pointer; backdrop-filter:blur(8px); transition:transform .18s ease,background .18s ease; }
  .hero-audio-toggle:hover { transform:scale(1.06); background:rgba(0,0,0,.72); }
  .hero-audio-toggle:focus-visible { outline:3px solid rgba(255,255,255,.8); outline-offset:3px; }

  .growth-section {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:40px;
    max-width:1284px;
    margin:0 auto;
    padding:30px clamp(22px,4vw,44px);
    border:1px solid #e0e5ed;
    border-radius:26px;
    background:linear-gradient(135deg,rgba(240,242,255,.95),rgba(255,255,255,.94));
    box-shadow:0 16px 40px rgba(15,23,42,.07);
  }
  .growth-section > div:first-child { max-width:760px; }
  .growth-section h2 { margin:0; color:#141923; font-size:clamp(1.9rem,4vw,3.3rem); letter-spacing:-.05em; }
  .growth-section p:last-child { margin:9px 0 0; color:#626978; line-height:1.65; }
  .growth-path { display:flex; align-items:center; gap:10px; flex:0 0 auto; }
  .growth-path span { padding:8px 11px; border:1px solid #dfe4ed; border-radius:999px; background:#fff; color:#687080; font-size:.72rem; font-weight:800; white-space:nowrap; }
  .growth-path span.active { border-color:#405cf5; background:#405cf5; color:#fff; }
  .growth-path i { width:24px; height:1px; background:#ccd3df; }

  @media (max-width:900px) {
    .hero { grid-template-columns:1fr; min-height:0; }
    .hero-media { justify-self:start; width:min(100%,560px); }
    .growth-section { align-items:flex-start; flex-direction:column; }
  }

  @media (max-width:620px) {
    .pursuits-page { padding-bottom:38px; }
    .hero { margin:14px 10px 34px; padding:34px 22px; border-radius:24px; }
    .hero h1 { font-size:clamp(4rem,22vw,6rem); }
    .hero-lede { margin-top:22px; font-size:1.05rem; }
    .hero-note { font-size:.92rem; }
    .hero-media { width:100%; border-radius:21px; }
    .hero-media-caption { left:18px; bottom:17px; }
    .hero-audio-toggle { right:14px; bottom:14px; width:42px; height:42px; }
    .growth-section { margin:0 10px; padding:24px 20px; border-radius:22px; }
    .growth-path { width:100%; flex-wrap:wrap; }
  }

  html.dark .hero, body.dark .hero, html[data-theme='dark'] .hero {
    border-color:rgba(148,163,184,.18);
    background:
      radial-gradient(circle at 82% 18%,rgba(64,92,245,.14),transparent 34%),
      radial-gradient(circle at 10% 82%,rgba(195,66,143,.1),transparent 31%),
      linear-gradient(135deg,rgba(17,24,39,.96),rgba(15,23,42,.95));
  }
  html.dark .hero h1, body.dark .hero h1, html[data-theme='dark'] .hero h1,
  html.dark .hero-lede, body.dark .hero-lede, html[data-theme='dark'] .hero-lede,
  html.dark .growth-section h2, body.dark .growth-section h2, html[data-theme='dark'] .growth-section h2 { color:#f8fafc; }
  html.dark .hero-note, body.dark .hero-note, html[data-theme='dark'] .hero-note,
  html.dark .growth-section p:last-child, body.dark .growth-section p:last-child, html[data-theme='dark'] .growth-section p:last-child { color:#aeb7c7; }
  html.dark .growth-section, body.dark .growth-section, html[data-theme='dark'] .growth-section { border-color:rgba(148,163,184,.18); background:linear-gradient(135deg,rgba(25,31,54,.95),rgba(17,24,39,.94)); }
  html.dark .growth-path span, body.dark .growth-path span, html[data-theme='dark'] .growth-path span { border-color:rgba(148,163,184,.22); background:#111827; color:#b6c0cf; }
  html.dark .growth-path span.active, body.dark .growth-path span.active, html[data-theme='dark'] .growth-path span.active { border-color:#405cf5; background:#405cf5; color:#fff; }

  @media (prefers-reduced-motion:reduce) {
    .hero-media video { transform:none; }
    .hero-audio-toggle { transition:none; }
    .hero-audio-toggle:hover { transform:none; }
  }
</style>
