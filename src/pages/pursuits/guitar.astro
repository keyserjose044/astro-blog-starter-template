          <button class="path-card path-card--electric" type="button" data-path-button="electric" aria-pressed="false">
            <span class="unlock-mark" aria-hidden="true">?</span>
            <span class="path-art" aria-hidden="true">
              <svg class="guitar-icon" viewBox="0 0 120 220" fill="none">
                <rect x="56" y="10" width="8" height="102" rx="3" fill="currentColor"/>
                <rect x="50" y="1" width="20" height="19" rx="4" fill="currentColor"/>
                <path d="M59 96c-14-8-27-7-34 2-9 11-2 26 9 33-14 13-18 33-7 49 12 17 31 8 39-8 11 18 31 23 42 9 12-15 5-36-10-48 8-12 9-28-1-37-9-8-24-6-38 0Z" fill="currentColor"/>
                <path d="M55 93 42 127l20 10 18-38" stroke="#fff" stroke-width="5" opacity=".7"/>
                <path d="M58 20v142M60 20v142M62 20v142" stroke="#fff" stroke-width="1" opacity=".65"/>
              </svg>
            </span>
            <span class="path-copy">
              <span class="path-state path-state--future">Future path · undeveloped</span>
