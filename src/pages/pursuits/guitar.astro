          <div class="roadmap" id="guitar-roadmap" data-view="nylon">
            {roadmapStreams.map((stream) => (
              <article class="stream" data-path={stream.path} id={`stream-${stream.id}`}>
                <header class="stream-head">
                  <h3>{stream.title}</h3>
                  <p class="stream-subtitle">{stream.subtitle}</p>
                </header>
                <ol class="node-list">
                  {stream.nodes.map((node) => (
                    <li class="node" data-status={node.status}>
                      <span class="node-dot" aria-hidden="true">{node.status === 'comfortable' ? '✓' : node.status === 'developing' ? '↗' : node.status === 'next' ? '→' : '?'}</span>
                      <span>
                        <strong class="node-title">{node.title}</strong>
                        <span class="node-status">{statusLabels[node.status]}</span>
                        <p class="node-note">{node.note}</p>
                      </span>
