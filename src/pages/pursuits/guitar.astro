                <path d="M56 16h8l-1 72h-6l-1-72Z" fill="currentColor"/>
                <rect x="51" y="4" width="18" height="18" rx="4" fill="currentColor"/>
                <path d="M57 83c-19 4-33 25-33 51 0 34 18 64 36 64s36-30 36-64c0-26-14-47-33-51-1 8-3 15-3 15s-2-7-3-15Z" fill="currentColor"/>
                <ellipse cx="60" cy="131" rx="11" ry="13" fill="#fff" opacity=".85"/>
                <rect x="47" y="163" width="26" height="5" rx="2.5" fill="#fff" opacity=".82"/>
                <path d="M58 22v141M60 22v141M62 22v141" stroke="#fff" stroke-width="1" opacity=".7"/>
