---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import MusicNav from '../../components/MusicNav.astro';
import PursuitsLiveRuntime from '../../components/PursuitsLiveRuntime.astro';
import { SITE_TITLE } from '../../consts';
import { fetchAllRaindrops } from '../../utils/raindrop';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_GUITAR_ID || '59630582';

const guitar = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'guitar',
  placeholder: '/images_webp/album-placeholder.webp',
  cleanVideoCovers: true,
});

const tagCounts = new Map<string, number>();
guitar.forEach((item) => {
  item.tags.forEach((tag) => {
    const cleanTag = String(tag || '').trim();
    if (!cleanTag) return;
    tagCounts.set(cleanTag, (tagCounts.get(cleanTag) || 0) + 1);
  });
});

const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, count }));

const currentQuests = [
  {
    eyebrow: 'Rhythm',
    title: 'Build a steadier internal pulse',
    note: 'Use subdivisions, a metronome, and the actual rhythm of each song instead of relying on familiar strumming.',
  },
  {
    eyebrow: 'Ear',
    title: 'Start hearing before searching',
    note: 'Practice intervals, keys, chord quality, progressions, and short melodies by ear.',
  },
  {
    eyebrow: 'Performance',
    title: 'Polish one complete sing-and-play song',
    note: 'No phone, no stopping, secure lyrics, stable rhythm, and a recoverable performance from beginning to end.',
  },
];

const roadmapStreams = [
  {
    id: 'rhythm',
    path: 'nylon',
    title: 'Rhythm & Accompaniment',
    subtitle: 'Time, groove, strumming, and supporting a voice or ensemble.',
    nodes: [
      { title: 'Basic pulse & meter', status: 'comfortable', note: 'Keep time through simple chord accompaniment.' },
      { title: 'Open-chord transitions', status: 'comfortable', note: 'Move through common progressions without stopping.' },
      { title: 'Rumba & huapango patterns', status: 'comfortable', note: 'A familiar part of the nylon-string vocabulary.' },
      { title: 'Sing while playing', status: 'developing', note: 'Possible now; consistency and memorization remain uneven.' },
      { title: 'Song-specific rhythm', status: 'developing', note: 'Replace generic patterns with the rhythm the song actually needs.' },
      { title: 'Subdivision & syncopation', status: 'next', note: 'Strengthen eighths, sixteenths, accents, and off-beat control.' },
      { title: 'Flamenco compás', status: 'next', note: 'Develop reliable, palo-specific rhythmic structure.' },
      { title: 'Accompany cante & baile', status: 'locked', note: 'A longer-term ensemble and performance branch.' },
    ],
  },
  {
    id: 'nylon-technique',
    path: 'nylon',
    title: 'Nylon-String Technique',
    subtitle: 'Classical fingerstyle and coordinated melody with accompaniment.',
    nodes: [
      { title: 'Classical fingerstyle', status: 'comfortable', note: 'The primary right-hand approach.' },
      { title: 'Arpeggiated accompaniment', status: 'comfortable', note: 'Used across songs and classical study.' },
      { title: 'Finger independence', status: 'developing', note: 'Functional, but worth returning to deliberately.' },
      { title: 'Alternating bass', status: 'developing', note: 'Present in repertoire work; needs greater automaticity.' },
      { title: 'Melody over accompaniment', status: 'next', note: 'Bring melody and harmony forward simultaneously.' },
      { title: 'Classical tremolo', status: 'next', note: 'A focused future technique rather than casual noodling.' },
      { title: 'Complete solo arrangements', status: 'locked', note: 'Polished, memorized pieces that hold together as performances.' },
    ],
  },
  {
    id: 'flamenco-mariachi',
    path: 'nylon',
    title: 'Flamenco & Mariachi Vocabulary',
    subtitle: 'The stylistic language already closest to the center of the journey.',
    nodes: [
      { title: 'Basic rasgueado', status: 'comfortable', note: 'A long-used part of free playing and accompaniment.' },
      { title: 'Triplet rasgueo', status: 'comfortable', note: 'One of the stronger learned strumming tools.' },
      { title: 'Abanico', status: 'comfortable', note: 'Available, though it still benefits from rhythmic context.' },
      { title: 'Golpe integration', status: 'developing', note: 'Coordinate percussion without destabilizing time.' },
      { title: 'Palo-specific vocabulary', status: 'next', note: 'Connect techniques to musical forms instead of treating them as isolated tricks.' },
      { title: 'Picado', status: 'next', note: 'Develop clean, authentic alternating-finger scale work.' },
      { title: 'Alzapúa', status: 'next', note: 'Build controlled thumb-driven rhythmic and melodic playing.' },
      { title: 'Falsetas inside compás', status: 'locked', note: 'Place learned material correctly inside a living rhythmic framework.' },
    ],
  },
  {
    id: 'theory-ear',
    path: 'both',
    title: 'Fretboard, Theory & Ear',
    subtitle: 'Turn shapes and memory into understanding, recognition, and choice.',
    nodes: [
      { title: 'Major & minor scales', status: 'comfortable', note: 'Known as shapes and practice material.' },
      { title: 'Pentatonic positions', status: 'comfortable', note: 'Multiple positions have been learned.' },
      { title: 'Natural notes on the neck', status: 'developing', note: 'Partly mapped; speed and instant recall remain goals.' },
      { title: 'CAGED connections', status: 'developing', note: 'Introduced, but not yet an automatic whole-neck system.' },
      { title: 'Intervals & triads', status: 'next', note: 'The bridge between fretboard knowledge, chords, and ear training.' },
      { title: 'Chord construction & function', status: 'next', note: 'Understand why progressions work and transpose them intentionally.' },
      { title: 'Relative pitch & transcription', status: 'next', note: 'Identify notes, chords, and melodies without immediately reaching for a tutorial.' },
      { title: 'Improvisation through harmony', status: 'locked', note: 'Hear chord movement and choose notes with purpose.' },
    ],
  },
  {
    id: 'performance',
    path: 'both',
    title: 'Repertoire & Performance',
    subtitle: 'Convert fragments, chord knowledge, and lyrics into music that survives pressure.',
    nodes: [
      { title: 'Learn chord structure', status: 'comfortable', note: 'The entry point for many songs.' },
      { title: 'Play recognizable sections', status: 'comfortable', note: 'A common current level across the wider repertoire.' },
      { title: 'Add voice', status: 'developing', note: 'A real breakthrough, but not yet reliable across all songs.' },
      { title: 'Memorize lyrics & form', status: 'developing', note: 'Remove dependence on the phone and external prompts.' },
      { title: 'Hold rhythm through mistakes', status: 'next', note: 'Recover without restarting or breaking the performance.' },
      { title: 'Record a complete take', status: 'next', note: 'Use recordings as evidence and feedback, not only as a final product.' },
      { title: 'Maintain a live repertoire', status: 'locked', note: 'Keep older songs ready instead of relearning them from zero.' },
    ],
  },
  {
    id: 'electric',
    path: 'electric',
    title: 'Pick & Electric',
    subtitle: 'A dormant instrument and a separate physical vocabulary waiting to be developed.',
    nodes: [
      { title: 'Pick grip & attack', status: 'next', note: 'Find a relaxed, repeatable contact point.' },
      { title: 'Downstrokes & alternate picking', status: 'next', note: 'Build clean repetition and controlled string crossing.' },
      { title: 'Power chords & palm muting', status: 'locked', note: 'The basic rhythm-guitar language of the electric path.' },
      { title: 'Riffs across strings', status: 'locked', note: 'Coordinate picking, fretting, and unused-string muting.' },
      { title: 'Bends, vibrato & slides', status: 'locked', note: 'Develop expressive lead phrasing rather than only moving through shapes.' },
      { title: 'Pentatonic lead vocabulary', status: 'locked', note: 'Transfer known scale material into phrasing and call-and-response.' },
      { title: 'First complete electric song', status: 'locked', note: 'The milestone that visibly unlocks the second instrument path.' },
    ],
  },
];

const repertoireGroups = [
  {
    title: 'Playable / established',
    note: 'Songs with meaningful functional progress; exact readiness varies.',
    songs: ['El Rey', 'El Reloj', 'Esos Ojitos Negros', 'El Cascabel', 'Los Machetes', 'Cortijo'],
  },
  {
    title: 'Learning / needs polish',
    note: 'Material that may have chords, sections, or technique in place but still needs rhythm, memory, or completion.',
    songs: ['Piel Canela', 'La Bikina', 'La Cama Vacía', 'Deja Que Salga La Luna', 'Merceditas', 'Malagueña', 'Étude in E minor — Tárrega'],
  },
  {
    title: 'Future queue',
    note: 'Songs deliberately kept visible so they do not disappear into scattered notes.',
    songs: ['Pelea de Gallos', 'Vive', 'En Tu Pelo', 'Malagueña Salerosa', 'Lástima Que Seas Ajena', 'Pichak', 'Maruja Limón'],
  },
];

const statusLabels: Record<string, string> = {
  comfortable: 'Comfortable',
  developing: 'Developing',
  next: 'Next up',
  locked: 'Locked',
};

const allNodes = roadmapStreams.flatMap((stream) => stream.nodes);
const mappedSkills = allNodes.length;
const developingSkills = allNodes.filter((node) => node.status === 'developing').length;
---

<BaseHead
  title={`${SITE_TITLE} — Music — Guitar Journey`}
  description="A living map of my guitar practice, repertoire, skills, recordings, and future paths."
/>

<style>
  :root {
    --guitar-ink:#12151d;
    --guitar-muted:#626978;
    --guitar-line:#e4e8ef;
    --guitar-card:rgba(255,255,255,.94);
    --guitar-gold:#c77a30;
    --guitar-blue:#405cf5;
    --guitar-green:#278a63;
    --guitar-orange:#d97a24;
    --guitar-gray:#87909f;
  }

  * { box-sizing:border-box; }
  button, input, select { font:inherit; }
  .wrap { width:100%; margin:0 auto; padding:0 0 56px; }
  .hero { position:relative; width:100%; height:clamp(310px,52vh,620px); overflow:hidden; background:#11141a; }
  .hero video { width:100%; height:100%; object-fit:cover; display:block; filter:brightness(.52) saturate(.82); }
  .hero::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,rgba(4,7,13,.1),rgba(4,7,13,.18) 48%,rgba(4,7,13,.72)); pointer-events:none; }
  .hero-overlay { position:absolute; z-index:1; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px; color:#fff; text-align:center; text-shadow:0 3px 24px rgba(0,0,0,.75); }
  .hero-kicker { margin:0 0 8px; font-size:.76rem; font-weight:850; letter-spacing:.18em; text-transform:uppercase; opacity:.86; }
  .hero-overlay h1 { margin:0 0 10px; font-size:clamp(2.7rem,7vw,5.7rem); line-height:.92; letter-spacing:-.055em; }
  .hero-overlay p { max-width:760px; margin:0; font-size:clamp(1rem,2vw,1.3rem); line-height:1.5; }
  .audio-toggle { position:absolute; z-index:2; right:18px; bottom:18px; width:44px; height:44px; border:1px solid rgba(255,255,255,.55); border-radius:999px; background:rgba(0,0,0,.52); color:#fff; cursor:pointer; backdrop-filter:blur(8px); }

  .content { padding:28px clamp(12px,3vw,48px) 0; }
  .section { max-width:1260px; margin:0 auto 34px; }
  .section-head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:15px; }
  .section-kicker { margin:0 0 4px; color:var(--guitar-gold); font-size:.72rem; font-weight:900; letter-spacing:.15em; text-transform:uppercase; }
  .section h2 { margin:0; color:var(--guitar-ink); font-size:clamp(1.55rem,3vw,2.35rem); letter-spacing:-.035em; }
  .section-description { max-width:710px; margin:7px 0 0; color:var(--guitar-muted); line-height:1.62; }

  .journey-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .path-card { position:relative; display:grid; grid-template-columns:145px minmax(0,1fr); min-height:220px; overflow:hidden; padding:22px; border:1px solid var(--guitar-line); border-radius:24px; background:var(--guitar-card); color:var(--guitar-ink); text-align:left; box-shadow:0 14px 36px rgba(15,23,42,.09); cursor:pointer; transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease, opacity .18s ease, filter .18s ease; }
  .path-card:hover { transform:translateY(-3px); box-shadow:0 20px 44px rgba(15,23,42,.13); }
  .path-card[aria-pressed='true'] { border-color:rgba(199,122,48,.62); box-shadow:0 20px 50px rgba(199,122,48,.18); }
  .path-card--electric { opacity:.56; filter:grayscale(.92); }
  .path-card--electric:hover, .path-card--electric[aria-pressed='true'] { opacity:.88; filter:grayscale(.3); }
  .path-art { display:flex; align-items:center; justify-content:center; min-height:160px; color:var(--guitar-gold); }
  .path-card--electric .path-art { color:#394055; }
  .guitar-icon { width:112px; height:180px; overflow:visible; filter:drop-shadow(0 14px 13px rgba(15,23,42,.17)); }
  .path-copy { align-self:center; }
  .path-state { display:inline-flex; align-items:center; gap:6px; margin-bottom:12px; padding:6px 9px; border-radius:999px; background:#eef8f3; color:#236c50; font-size:.7rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .path-state--future { background:#f0f1f5; color:#5b6270; }
  .path-copy h3 { margin:0 0 7px; font-size:clamp(1.3rem,2.3vw,2rem); letter-spacing:-.035em; }
  .path-copy p { margin:0; color:var(--guitar-muted); line-height:1.55; }
  .path-action { display:block; margin-top:13px; font-size:.78rem; font-weight:850; color:#8a511f; }
  .unlock-mark { position:absolute; top:15px; right:18px; display:grid; place-items:center; width:44px; height:44px; border:2px solid currentColor; border-radius:50%; color:#565d6b; font-size:1.45rem; font-weight:950; box-shadow:0 8px 18px rgba(15,23,42,.12); }

  .metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-top:12px; }
  .metric { padding:15px 14px; border:1px solid var(--guitar-line); border-radius:16px; background:var(--guitar-card); box-shadow:0 9px 24px rgba(15,23,42,.055); }
  .metric strong { display:block; color:var(--guitar-ink); font-size:1.42rem; line-height:1.1; }
  .metric span { display:block; margin-top:4px; color:var(--guitar-muted); font-size:.75rem; }

  .quest-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; }
  .quest { position:relative; padding:19px; overflow:hidden; border:1px solid var(--guitar-line); border-radius:18px; background:var(--guitar-card); box-shadow:0 10px 26px rgba(15,23,42,.065); }
  .quest::before { content:''; position:absolute; inset:0 auto 0 0; width:4px; background:var(--guitar-gold); }
  .quest small { color:#995b25; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .quest h3 { margin:8px 0 7px; color:var(--guitar-ink); font-size:1.05rem; }
  .quest p { margin:0; color:var(--guitar-muted); font-size:.86rem; line-height:1.55; }

  .roadmap-shell { padding:18px; border:1px solid var(--guitar-line); border-radius:24px; background:rgba(255,255,255,.72); box-shadow:0 15px 40px rgba(15,23,42,.07); backdrop-filter:blur(8px); }
  .map-toolbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; margin-bottom:15px; }
  .status-filters { display:flex; flex-wrap:wrap; gap:7px; }
  .status-filter { min-height:34px; padding:7px 11px; border:1px solid var(--guitar-line); border-radius:999px; background:#fff; color:var(--guitar-muted); font-size:.75rem; font-weight:800; cursor:pointer; }
  .status-filter[aria-pressed='true'] { border-color:#26324a; background:#26324a; color:#fff; }
  .legend { display:flex; flex-wrap:wrap; gap:9px 14px; color:var(--guitar-muted); font-size:.72rem; }
  .legend span { display:inline-flex; align-items:center; gap:5px; }
  .legend i { width:9px; height:9px; border-radius:50%; }
  .legend .comfortable { background:var(--guitar-green); }
  .legend .developing { background:var(--guitar-orange); }
  .legend .next { background:var(--guitar-blue); }
  .legend .locked { background:var(--guitar-gray); }

  .roadmap { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  .stream { padding:17px; border:1px solid var(--guitar-line); border-radius:18px; background:#fff; transition:opacity .18s ease, transform .18s ease, filter .18s ease; }
  .stream[data-path='electric'] { border-style:dashed; background:linear-gradient(145deg,#fff,#f4f5f7); opacity:.58; filter:grayscale(.75); }
  .roadmap[data-view='electric'] .stream:not([data-path='electric']):not([data-path='both']) { opacity:.26; filter:grayscale(.9); }
  .roadmap[data-view='electric'] .stream[data-path='electric'] { opacity:1; filter:none; transform:translateY(-2px); border-color:#7b8495; }
  .roadmap[data-view='nylon'] .stream[data-path='electric'] { opacity:.42; }
  .stream-head { min-height:92px; margin-bottom:8px; }
  .stream h3 { margin:0 0 6px; color:var(--guitar-ink); font-size:1.05rem; }
  .stream-subtitle { margin:0; color:var(--guitar-muted); font-size:.78rem; line-height:1.45; }
  .node-list { position:relative; display:grid; gap:9px; margin:0; padding:0; list-style:none; }
  .node-list::before { content:''; position:absolute; left:14px; top:16px; bottom:16px; width:2px; background:#e7eaf0; }
  .node { position:relative; display:grid; grid-template-columns:29px minmax(0,1fr); gap:9px; align-items:start; padding:10px; border:1px solid #edf0f4; border-radius:13px; background:#fbfcfd; transition:opacity .15s ease, transform .15s ease; }
  .node[hidden] { display:none; }
  .node:hover { transform:translateX(2px); }
  .node-dot { position:relative; z-index:1; display:grid; place-items:center; width:29px; height:29px; border:4px solid #fff; border-radius:50%; color:#fff; font-size:.63rem; font-weight:900; box-shadow:0 0 0 1px #dfe3ea; }
  .node[data-status='comfortable'] .node-dot { background:var(--guitar-green); }
  .node[data-status='developing'] .node-dot { background:var(--guitar-orange); }
  .node[data-status='next'] .node-dot { background:var(--guitar-blue); }
  .node[data-status='locked'] .node-dot { background:var(--guitar-gray); }
  .node-title { display:block; color:var(--guitar-ink); font-size:.84rem; font-weight:830; line-height:1.28; }
  .node-status { display:block; margin-top:2px; color:var(--guitar-muted); font-size:.66rem; font-weight:800; text-transform:uppercase; letter-spacing:.055em; }
  .node-note { margin:7px 0 0; color:var(--guitar-muted); font-size:.73rem; line-height:1.42; }

  .repertoire-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; }
  .repertoire-card { padding:18px; border:1px solid var(--guitar-line); border-radius:18px; background:var(--guitar-card); box-shadow:0 10px 27px rgba(15,23,42,.06); }
  .repertoire-card h3 { margin:0 0 5px; color:var(--guitar-ink); font-size:1rem; }
  .repertoire-card p { min-height:42px; margin:0 0 12px; color:var(--guitar-muted); font-size:.76rem; line-height:1.45; }
  .song-list { display:flex; flex-wrap:wrap; gap:7px; margin:0; padding:0; list-style:none; }
  .song-list li { padding:7px 9px; border:1px solid #e5e8ef; border-radius:999px; background:#fff; color:#303645; font-size:.73rem; }

  .tracking-card { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr); gap:20px; align-items:center; padding:22px; border:1px solid rgba(199,122,48,.25); border-radius:22px; background:linear-gradient(135deg,rgba(255,250,242,.96),rgba(255,255,255,.95)); box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tracking-card h3 { margin:0 0 8px; color:var(--guitar-ink); font-size:1.18rem; }
  .tracking-card p { margin:0; color:var(--guitar-muted); line-height:1.6; }
  .tracking-rules { display:grid; gap:8px; margin:0; padding:0; list-style:none; }
  .tracking-rules li { display:grid; grid-template-columns:30px minmax(0,1fr); gap:9px; align-items:start; padding:10px; border:1px solid rgba(199,122,48,.18); border-radius:12px; background:rgba(255,255,255,.74); color:#414756; font-size:.78rem; line-height:1.4; }
  .tracking-rules strong { display:grid; place-items:center; width:28px; height:28px; border-radius:50%; background:#f6dfc7; color:#8a4f1a; }

  .resource-shell { padding:20px; border:1px solid var(--guitar-line); border-radius:24px; background:rgba(255,255,255,.82); box-shadow:0 15px 38px rgba(15,23,42,.07); }
  .toolbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:8px; max-width:920px; margin:0 auto 12px; }
  .toolbar input, .toolbar select { min-height:42px; border:1px solid var(--guitar-line); border-radius:12px; background:#fff; color:var(--guitar-ink); }
  .toolbar input { flex:1 1 300px; padding:10px 13px; }
  .toolbar select { flex:0 1 210px; padding:9px 11px; }
  .icon-button { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border:1px solid var(--guitar-line); border-radius:999px; background:#f0f2f7; color:var(--guitar-ink); text-decoration:none; font-weight:800; }
  .results { min-height:24px; margin:0 auto 16px; color:var(--guitar-muted); font-size:.82rem; text-align:center; }
  .resource-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(235px,1fr)); gap:19px; }
  .resource-card { display:flex; min-width:0; flex-direction:column; gap:7px; color:inherit; text-decoration:none; }
  .thumb { width:100%; aspect-ratio:16/9; object-fit:cover; border:1px solid var(--guitar-line); border-radius:12px; background:#f0f2f7; box-shadow:0 9px 22px rgba(0,0,0,.11); transition:transform .15s ease, box-shadow .15s ease; }
  .resource-card:hover .thumb { transform:translateY(-2px); box-shadow:0 13px 28px rgba(0,0,0,.16); }
  .resource-title { display:-webkit-box; overflow:hidden; color:var(--guitar-ink); font-weight:780; font-size:.9rem; line-height:1.3; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .resource-tags { color:var(--guitar-muted); font-size:.71rem; line-height:1.35; }
  .empty { padding:40px 16px; color:var(--guitar-muted); text-align:center; }

  @media (max-width:1050px) {
    .roadmap { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .metrics { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }

  @media (max-width:760px) {
    .hero { height:350px; }
    .content { padding-top:18px; }
    .section { margin-bottom:28px; }
    .section-head { display:block; }
    .journey-grid, .quest-grid, .repertoire-grid, .tracking-card { grid-template-columns:1fr; }
    .path-card { grid-template-columns:105px minmax(0,1fr); min-height:190px; padding:17px; }
    .path-art { min-height:140px; }
    .guitar-icon { width:82px; height:145px; }
    .roadmap { grid-template-columns:1fr; }
    .stream-head { min-height:auto; }
    .map-toolbar { align-items:flex-start; }
    .legend { width:100%; }
    .toolbar { display:grid; grid-template-columns:minmax(0,1fr) 42px; }
    .toolbar input { grid-column:1 / -1; width:100%; }
    .toolbar select { grid-column:1; width:100%; min-width:0; }
    .resource-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:15px 10px; }
    .resource-title { font-size:.78rem; }
    .resource-tags { display:none; }
  }

  @media (max-width:480px) {
    .path-card { grid-template-columns:85px minmax(0,1fr); padding:14px; border-radius:18px; }
    .path-copy p { font-size:.8rem; }
    .unlock-mark { width:36px; height:36px; font-size:1.15rem; }
    .metrics { gap:8px; }
    .metric strong { font-size:1.16rem; }
    .status-filters { gap:5px; }
    .status-filter { padding:6px 8px; font-size:.67rem; }
  }
</style>

<VideoBg>
