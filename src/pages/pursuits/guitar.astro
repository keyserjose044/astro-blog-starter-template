      </section>

      <section class="section" aria-labelledby="repertoire-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">Repertoire snapshot</p>
            <h2 id="repertoire-title">Songs kept visible instead of scattered</h2>
            <p class="section-description">This is a provisional husk reconstructed from previous guitar conversations. The future sheet will separate “know the chords,” “playable,” “singable,” “polished,” and “maintenance” more precisely.</p>
          </div>
        </div>
        <div class="repertoire-grid">
          {repertoireGroups.map((group) => (
            <article class="repertoire-card">
              <h3>{group.title}</h3>
              <p>{group.note}</p>
              <ul class="song-list">
                {group.songs.map((song) => <li>{song}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="tracking-title">
        <div class="tracking-card">
          <div>
            <p class="section-kicker">Tracking philosophy</p>
            <h2 id="tracking-title">More direction without turning practice into paperwork</h2>
            <p>The older log can remain honest: date and total minutes. Richer tracking should be event-driven. Update a song or skill only when its status changes, choose a weekly focus, and let the site calculate the rest. The map should reduce indecision, not create a second hobby made of data entry.</p>
          </div>
          <ol class="tracking-rules">
            <li><strong>1</strong><span><b>Every session:</b> keep the existing date and minutes.</span></li>
            <li><strong>2</strong><span><b>Only when useful:</b> optionally identify one focus, song, or skill.</span></li>
            <li><strong>3</strong><span><b>Only when changed:</b> move a roadmap node or repertoire status.</span></li>
            <li><strong>4</strong><span><b>Once a week:</b> choose the next three quests.</span></li>
          </ol>
        </div>
      </section>

      <section class="section" aria-labelledby="resources-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">Resource library</p>
            <h2 id="resources-title">Lessons, performances, techniques, and references</h2>
            <p class="section-description">The roadmap shows where I am going. This searchable Raindrop library preserves the material that can help me get there.</p>
          </div>
        </div>

        <div class="resource-shell">
          <div class="toolbar">
            <input id="guitar-search" type="search" placeholder="Search lesson, technique, song, or note…" aria-label="Search guitar resources" />
            <select id="tag-filter" aria-label="Filter guitar resources by tag">
              <option value="">All categories</option>
              {tags.map((tag) => <option value={tag.name.toLowerCase()}>{tag.name} ({tag.count})</option>)}
            </select>
            <a class="icon-button" href="/stats/?metric=guitar&amp;year=current#graphs" aria-label="View guitar statistics" title="View guitar statistics">📊</a>
          </div>
          <p class="results" id="guitar-results" aria-live="polite">Showing {guitar.length.toLocaleString('en-US')} resources</p>

          {guitar.length === 0 ? (
            <p class="empty">Guitar resources are temporarily unavailable because Raindrop returned no items during the build.</p>
          ) : (
            <div class="resource-grid" id="guitar-grid" role="list">
              {guitar.map((item) => (
                <a
                  class="resource-card"
                  role="listitem"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-search={`${item.title} ${item.note} ${item.tags.join(' ')}`.toLowerCase()}
                  data-tags={item.tags.map((tag) => tag.toLowerCase()).join('|')}
                >
                  <img class="thumb" src={item.cover} alt={item.title} loading="lazy" decoding="async" />
                  <span class="resource-title">{item.title} <span aria-hidden="true">↗</span></span>
                  {item.tags.length ? <span class="resource-tags">{item.tags.slice(0, 4).join(' · ')}</span> : null}
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</VideoBg>

<script>
  const search = document.querySelector('#guitar-search');
  const tagFilter = document.querySelector('#tag-filter');
  const grid = document.querySelector('#guitar-grid');
  const resultLabel = document.querySelector('#guitar-results');
  const roadmap = document.querySelector('#guitar-roadmap');
  const roadmapSection = document.querySelector('#roadmap-section');
  const video = document.querySelector('.hero video');
  const audioToggle = document.querySelector('#audio-toggle');

  const normalize = (value = '') => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  const filterCards = () => {
    if (!grid) return;
    const query = normalize(search?.value.trim() || '');
    const tag = normalize(tagFilter?.value || '');
    let visible = 0;

    grid.querySelectorAll('.resource-card').forEach((card) => {
      const text = normalize(card.dataset.search || '');
      const cardTags = normalize(card.dataset.tags || '').split('|');
      const matches = (!query || query.split(/\s+/).every((word) => text.includes(word))) && (!tag || cardTags.includes(tag));
      card.hidden = !matches;
      if (matches) visible += 1;
    });

    if (resultLabel) resultLabel.textContent = `Showing ${visible.toLocaleString('en-US')} resources`;
  };

  search?.addEventListener('input', filterCards);
  tagFilter?.addEventListener('change', filterCards);

  document.querySelectorAll('[data-path-button]').forEach((button) => {
    button.addEventListener('click', () => {
      const path = button.dataset.pathButton || 'nylon';
      document.querySelectorAll('[data-path-button]').forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      });
      roadmap?.setAttribute('data-view', path);
      roadmapSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll('[data-status-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const status = button.dataset.statusFilter || 'all';
      document.querySelectorAll('[data-status-filter]').forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      });
      document.querySelectorAll('.node').forEach((node) => {
        node.hidden = status !== 'all' && node.dataset.status !== status;
      });
    });
  });

  audioToggle?.addEventListener('click', () => {
    if (!video) return;
    video.muted = !video.muted;
    audioToggle.textContent = video.muted ? '🔇' : '🔊';
    audioToggle.setAttribute('aria-label', video.muted ? 'Unmute guitar video' : 'Mute guitar video');
    if (video.paused) video.play().catch(() => {});
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === '/' && event.target === document.body) {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape' && search) {
      search.value = '';
      if (tagFilter) tagFilter.value = '';
      filterCards();
    }
  });
</script>
