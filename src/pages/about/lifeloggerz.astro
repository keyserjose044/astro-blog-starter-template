---
import AboutLayout from '../../layouts/AboutLayout.astro';
import '../../styles/about-split.css';
import '../../styles/about-lifeloggerz-story.css';
import '../../styles/about-lifeloggerz-philosophy.css';

const proofStats = [
  { value: 'Jan. 1, 2023', label: 'Structured tracking since', note: 'A continuous, evolving daily record' },
  { value: '150+', label: 'Variables tracked', note: 'The archive is much broader than one dashboard' },
  { value: '≈ 5 min', label: 'Essential daily logging', note: 'Diary writing is separate and takes longer' },
  { value: '4+', label: 'Core tools', note: 'Sheets, scripts, Python, APIs, and whatever earns its place' },
];

const trackedAreas = [
  { group: 'time', icon: '⏱️', title: 'Time & effort', text: 'Work, study, projects, practical tasks, and other blocks that show where effort actually went.' },
  { group: 'routines', icon: '🌙', title: 'Sleep & routines', text: 'Sleep, wake and bed timing, recurring routines, and the ordinary structure that shapes a day.' },
  { group: 'pursuits', icon: '🎯', title: 'Habits & pursuits', text: 'Exercise, guitar, languages, dance, reading, and practices that recur through different phases.' },
  { group: 'culture', icon: '📚', title: 'Culture & collections', text: 'Books, audiobooks, albums, classical music, art, favorites, dates, notes, and context.' },
  { group: 'places', icon: '🗺️', title: 'Places & experiences', text: 'Travel, outings, social time, notable events, milestones, and experiences worth locating in time.' },
  { group: 'diary', icon: '📝', title: 'Diary & context', text: 'Events, reflections, questions, mistakes, ideas, and small moments that would lose meaning as numbers.' },
];

const trackingSamples = [
  { label: 'sleep', group: 'routines' },
  { label: 'wake time', group: 'routines' },
  { label: 'work', group: 'time' },
  { label: 'study', group: 'time' },
  { label: 'projects', group: 'time' },
  { label: 'guitar', group: 'pursuits' },
  { label: 'running', group: 'pursuits' },
  { label: 'dance', group: 'pursuits' },
  { label: 'languages', group: 'pursuits' },
  { label: 'books', group: 'culture' },
  { label: 'audiobooks', group: 'culture' },
  { label: 'albums', group: 'culture' },
  { label: 'art', group: 'culture' },
  { label: 'travel', group: 'places' },
  { label: 'meals', group: 'routines' },
  { label: 'diary', group: 'diary' },
  { label: 'blunders', group: 'diary' },
  { label: 'finances', group: 'time' },
];

const timeline = [
  {
    year: '2022 → 2023',
    title: 'Diary habit became structured tracking',
    text: 'Daily writing came first. In 2023, recurring details moved into a sheet that could be counted, filtered, and compared.',
    image: '/images_webp/rawdatapost/2023-raw-data-sheet.webp',
    alt: 'Early 2023 LifeLoggerz raw data spreadsheet',
  },
  {
    year: '2024',
    title: 'The sheet started becoming a system',
    text: 'More categories, graphs, formulas, and repeatable workflows made the archive useful beyond the day it was recorded.',
    image: '/images_webp/rawdatapost/2024-raw-data-sheet.webp',
    alt: '2024 LifeLoggerz raw data spreadsheet',
  },
  {
    year: '2025',
    title: 'Expansion met diminishing returns',
    text: 'Automation and complexity grew, but so did a clearer rule: a field has to earn the attention required to maintain it.',
    image: '/images_webp/rawdatapost/2025-raw-data-sheet.webp',
    alt: '2025 LifeLoggerz raw data spreadsheet',
  },
  {
    year: 'Now',
    title: 'The private archive turns outward',
    text: 'LifeLoggerz now exposes public-safe explorers, stories, templates, and interfaces without publishing the unrestricted archive beneath them.',
    image: '/images_webp/daily_snapshot.webp',
    alt: 'A modern LifeLoggerz daily snapshot interface',
  },
];

const outsideCore = [
  'Continuous biometric streams or wearables simply because they can collect data.',
  'Calories, heart rate, and screen time as default daily targets.',
  'Perfect minute-by-minute reconstruction of every day.',
  'Data whose maintenance costs more attention than it returns.',
  'Private information simply because it would make an interesting chart.',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About LifeLoggerz',
  description: 'What LifeLoggerz is, why it exists, what it preserves, and the principles that shape the project.',
  mainEntity: {
    '@type': 'CreativeWork',
    name: 'LifeLoggerz',
    creator: { '@type': 'Person', name: 'José' },
    description: 'A personal data, diary, archive, visualization, and systems project built from long-term daily logging.',
  },
};
---

<style is:global>
  .prose:has(> .lifeloggerz-story) > .title { display: none; }
</style>

<AboutLayout
  title="About LifeLoggerz"
  description="What LifeLoggerz is, why it exists, what I track, what I deliberately do not track, and what a long-term digital archive can become."
  pubDate="2026-08-08"
  updatedDate="2026-08-12"
  wide={true}
  showViews={false}
>
  <main class="about-split lifeloggerz-story">
    <section class="llz-story-hero" aria-labelledby="lifeloggerz-intro-title">
      <div class="llz-story-hero-copy">
        <p class="about-eyebrow">About LifeLoggerz · the archive, system, and philosophy</p>
        <h2 id="lifeloggerz-intro-title">A searchable record of a life in progress.</h2>
        <p class="about-lede">
          <strong>LifeLoggerz</strong> began as personal logging and grew into something harder to describe with one label:
          part data system, part diary archive, part memory aid, part experimental laboratory, and now part public toolkit.
        </p>
        <p>
          The purpose is not to turn life into a spreadsheet. It is to preserve more of what happened, make patterns easier to see,
          reduce repeated work, and build an archive that becomes more useful as the years accumulate.
        </p>
        <div class="about-inline-actions">
          <a class="about-button primary" href="/stats/">Explore the archive</a>
          <a class="about-button" href="/templates/">Build your own</a>
          <a class="about-button" href="/about/me/">Meet José</a>
        </div>
      </div>

      <div class="llz-story-montage" aria-label="Examples of LifeLoggerz records and explorers">
        <figure class="llz-story-shot llz-story-shot--sheet">
          <img src="/images_webp/raw_data_sheet.webp" alt="LifeLoggerz raw data spreadsheet" loading="eager" />
          <figcaption>Structured record</figcaption>
        </figure>
        <figure class="llz-story-shot llz-story-shot--diary">
          <img src="/images_webp/day-summary-diary-log.webp" alt="LifeLoggerz diary log interface" loading="eager" />
          <figcaption>Written context</figcaption>
        </figure>
        <figure class="llz-story-shot llz-story-shot--explorer">
          <img src="/images_webp/dailyvis.webp" alt="LifeLoggerz daily visualization" loading="eager" />
          <figcaption>Explore later</figcaption>
        </figure>
      </div>
    </section>

    <section class="llz-proof-strip" aria-label="LifeLoggerz at a glance">
      {proofStats.map((stat) => (
        <div class="llz-proof-item">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
          <small>{stat.note}</small>
        </div>
      ))}
    </section>

    <section class="about-section llz-why" aria-labelledby="why-title">
      <p class="about-eyebrow">Why it exists</p>
      <h2 id="why-title">Memory fades. Ordinary life deserves a second life.</h2>
      <p>
        Most days are made of small things that seem too ordinary to preserve until years have passed. LifeLoggerz gives those days enough structure to be found again—not so every minute can be optimized, but so memories, patterns, work, interests, mistakes, and changes do not have to depend entirely on recollection.
      </p>
    </section>

    <section class="about-section llz-track-section" id="what-i-track" aria-labelledby="track-title">
      <div class="about-section-head">
        <p class="about-eyebrow">What I track</p>
        <h2 id="track-title">There is no single “LifeLoggerz metric.”</h2>
        <p>
          More than 150 variables and many non-numeric records have accumulated over time. The point is not the raw count; it is that different parts of life deserve different kinds of evidence. Click a category to focus the examples below.
        </p>
      </div>

      <div class="llz-track-orbit" aria-label="Representative map of what LifeLoggerz preserves" data-track-orbit>
        <article class="llz-track-core" data-track-core>
          <strong>150+</strong>
          <span>tracked variables</span>
          <small>plus diary entries, collections, dates, places, notes, images, and other context</small>
          <span class="llz-track-focus" data-track-focus>Click a category to focus</span>
        </article>
        {trackedAreas.map((area) => (
          <button class="llz-track-node" type="button" data-track-group={area.group} aria-pressed="false">
            <span class="icon" aria-hidden="true">{area.icon}</span>
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </button>
        ))}
      </div>

      <div class="llz-track-samples" aria-label="Examples of tracked subjects" data-track-samples>
        {trackingSamples.map((sample) => <span data-track-group={sample.group}>{sample.label}</span>)}
        <span class="more">and many more</span>
      </div>
      <div class="about-link-row">
        <a class="about-link-chip" href="/faq/">See detailed tracking & privacy answers →</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="origin-title">
      <div class="about-section-head">
        <p class="about-eyebrow">How it became this</p>
        <h2 id="origin-title">You can see the system learning what it wants to be.</h2>
        <p>There was no master plan. Each useful layer survived; other ideas were simplified, automated, or abandoned when the maintenance stopped being worth it.</p>
      </div>

      <div class="llz-evolution" aria-label="Visual evolution of the LifeLoggerz system">
        {timeline.map((item) => (
          <article class="llz-evolution-frame">
            <div class="llz-evolution-image"><img src={item.image} alt={item.alt} loading="lazy" /></div>
            <div class="llz-evolution-copy">
              <span class="year">{item.year}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="about-link-row">
        <a class="about-link-chip" href="/blog/rawdatapost2025/">See the Raw Data system evolve in detail →</a>
        <a class="about-link-chip" href="/timeline/">Open the broader life timeline →</a>
      </div>
    </section>

    <section class="about-section llz-digital-lab" aria-labelledby="computer-title">
      <div class="llz-digital-intro">
        <p class="about-eyebrow">Why computer logging?</p>
        <h2 id="computer-title">A paper journal remembers. A digital archive can also answer.</h2>
        <p>
          Paper can preserve a life beautifully. Digital structure fits this project because years of records can also be retrieved, compared, visualized, filtered, and eventually questioned. Try the four examples.
        </p>
      </div>

      <div class="llz-digital-demo" aria-label="Illustrations of what digital records make possible">
        <input class="llz-digital-radio" type="radio" name="digital-demo" id="llz-search" checked />
        <input class="llz-digital-radio" type="radio" name="digital-demo" id="llz-compare" />
        <input class="llz-digital-radio" type="radio" name="digital-demo" id="llz-visualize" />
        <input class="llz-digital-radio" type="radio" name="digital-demo" id="llz-ask" />

        <div class="llz-digital-tabs" aria-label="Digital archive examples">
          <label class="llz-digital-tab" for="llz-search">🔎 Search</label>
          <label class="llz-digital-tab" for="llz-compare">↔ Compare</label>
          <label class="llz-digital-tab" for="llz-visualize">📈 Visualize</label>
          <label class="llz-digital-tab" for="llz-ask">🤖 Ask</label>
        </div>

        <div class="llz-digital-panels">
          <div class="llz-demo-panel panel-search">
            <p class="llz-demo-label">Example archive search</p>
            <div class="llz-searchbar"><span aria-hidden="true">⌕</span><span>guitar</span></div>
            <div class="llz-result-list">
              <div class="llz-result"><strong>Practice history</strong><span>Sessions, hours, gaps, and changing intensity across years</span></div>
              <div class="llz-result"><strong>Diary context</strong><span>Days where the instrument appears in the written record</span></div>
              <div class="llz-result"><strong>Pursuits calendar</strong><span>See when practice happened instead of trying to remember</span></div>
            </div>
          </div>

          <div class="llz-demo-panel panel-compare">
            <p class="llz-demo-label">Example comparison</p>
            <div class="llz-compare-grid">
              <div class="llz-day-card"><small>One period</small><strong>Practice is frequent</strong><p>The archive can show sustained phases instead of reducing them to a lifetime total.</p></div>
              <div class="llz-versus">VS</div>
              <div class="llz-day-card"><small>Another period</small><strong>A gap appears</strong><p>Absence becomes visible too: what stopped, what returned, and what competed for time.</p></div>
            </div>
          </div>

          <div class="llz-demo-panel panel-visualize">
            <p class="llz-demo-label">Example visualization</p>
            <div class="llz-mini-bars" aria-label="Illustrative bars showing activity changing across periods"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <p class="llz-mini-caption">The same repeated records can become calendars, timelines, maps, distributions, or data stories.</p>
          </div>

          <div class="llz-demo-panel panel-ask">
            <p class="llz-demo-label">Example archive question</p>
            <div class="llz-chat">
              <div class="llz-chat-q">When did I stop running, and when did I return?</div>
              <div class="llz-chat-a"><strong>Answer from the record</strong>An archive-aware assistant can point to the gap, dates, surrounding context, and supporting entries instead of guessing from memory.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section" id="what-i-dont-track" aria-labelledby="dont-track-title">
      <div class="about-section-head">
        <p class="about-eyebrow">What I don't track</p>
        <h2 id="dont-track-title">The archive has edges on purpose.</h2>
        <p>LifeLoggerz is expansive, but it is not a contest for maximum data density. Some categories sit inside the core; others remain occasional, secondary, or deliberately outside it.</p>
      </div>

      <div class="llz-boundary">
        <div class="llz-boundary-side">
          <p class="about-eyebrow">Inside the core</p>
          <h3>Records that repeatedly earn their place</h3>
          <p>These are useful because they preserve memory, expose patterns, support a pursuit, or gain meaning over time.</p>
          <div class="llz-boundary-chips">
            <span>time & effort</span><span>sleep & routines</span><span>pursuits</span><span>culture</span><span>places</span><span>diary context</span>
          </div>
        </div>
        <div class="llz-boundary-divider" aria-hidden="true"></div>
        <div class="llz-boundary-side">
          <p class="about-eyebrow" style="color:#9f3030!important">Outside / secondary</p>
          <h3>Measurable does not automatically mean worth maintaining</h3>
          <ul class="llz-outside-list">
            {outsideCore.map((item) => <li><b aria-hidden="true">×</b><span>{item}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="about-section llz-manifesto" aria-labelledby="philosophy-title">
      <div class="llz-manifesto-head">
        <p class="about-eyebrow">The philosophy</p>
        <span class="llz-principle-number">LifeLoggerz principle № 1</span>
        <h2 id="philosophy-title">The archive serves the life. The life does not serve the archive.</h2>
        <p class="llz-manifesto-lede">
          The system can grow indefinitely; attention cannot. Every field, automation, chart, and public page has to justify the time it asks for.
        </p>
      </div>

      <div class="llz-philosophy-layout">
        <div class="llz-manifesto-copy">
          <p>
            Useful records stay. Repetitive work gets automated. Private context can remain private. Anything that costs more attention than it returns should be simplified or removed.
          </p>
          <aside class="llz-manifesto-rule">
            <span>Guiding principle</span>
            <blockquote>“The purpose was never to spend my entire life maintaining a spreadsheet. It was to build systems that returned time and attention to me.”</blockquote>
          </aside>
        </div>

        <div class="llz-decision-board" aria-label="How LifeLoggerz decides whether a record belongs in the system">
          <p class="llz-decision-label">Before adding another metric</p>
          <div class="llz-decision-question">
            <span>Ask first</span>
            <strong>Does this record earn its place?</strong>
            <small>Preserve meaning without turning maintenance into the point of living.</small>
          </div>
          <div class="llz-decision-outcomes">
            <article class="llz-decision-card keep">
              <b>Keep it</b>
              <strong>It preserves something useful</strong>
              <p>Memory, context, patterns, a pursuit, or information that becomes more valuable over time.</p>
            </article>
            <article class="llz-decision-card automate">
              <b>Automate it</b>
              <strong>It matters, but repetition is the problem</strong>
              <p>Let formulas, scripts, or APIs remove routine work without obscuring the source.</p>
            </article>
            <article class="llz-decision-card private">
              <b>Keep it private</b>
              <strong>Useful does not mean publishable</strong>
              <p>The archive can retain value without turning private context into public entertainment.</p>
            </article>
            <article class="llz-decision-card remove">
              <b>Simplify / remove</b>
              <strong>Maintenance costs more than it returns</strong>
              <p>If a field creates friction without clarity, reduce it, demote it, or let it disappear.</p>
            </article>
          </div>
          <p class="llz-decision-foot">The goal is not maximum data density. It is a system that keeps returning attention to life.</p>
        </div>
      </div>
    </section>

    <section class="about-section llz-final" aria-labelledby="start-title">
      <p class="about-eyebrow">Start much smaller</p>
      <h2 id="start-title">You do not need 150 variables. Start with one useful thing.</h2>
      <p>Borrow the system rather than copying the scale.</p>
      <div class="about-inline-actions">
        <a class="about-button primary" href="/templates/">Use a template</a>
        <a class="about-button" href="/stats/">Explore my archive</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const orbit = document.querySelector('[data-track-orbit]');
      const samples = document.querySelector('[data-track-samples]');
      const core = document.querySelector('[data-track-core]');
      const focus = document.querySelector('[data-track-focus]');
      if (!orbit || !samples || !core || !focus) return;

      const nodes = Array.from(orbit.querySelectorAll('.llz-track-node[data-track-group]'));
      const sampleNodes = Array.from(samples.querySelectorAll('[data-track-group]'));

      const clear = () => {
        orbit.classList.remove('is-focused');
        samples.classList.remove('is-focused');
        core.classList.remove('is-focused');
        nodes.forEach((node) => node.setAttribute('aria-pressed', 'false'));
        sampleNodes.forEach((sample) => sample.classList.remove('is-active'));
        focus.textContent = 'Click a category to focus';
      };

      nodes.forEach((node) => {
        node.addEventListener('click', () => {
          const group = node.getAttribute('data-track-group');
          const alreadyActive = node.getAttribute('aria-pressed') === 'true';
          clear();
          if (alreadyActive || !group) return;

          orbit.classList.add('is-focused');
          samples.classList.add('is-focused');
          core.classList.add('is-focused');
          node.setAttribute('aria-pressed', 'true');
          sampleNodes.forEach((sample) => {
            sample.classList.toggle('is-active', sample.getAttribute('data-track-group') === group);
          });
          const title = node.querySelector('h3')?.textContent?.trim() || 'Selected category';
          focus.textContent = `Focused: ${title}`;
        });
      });
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</AboutLayout>