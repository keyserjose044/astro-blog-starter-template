---
import AboutLayout from '../../layouts/AboutLayout.astro';
import '../../styles/about-split.css';

const proofStats = [
  { value: 'Jan. 1, 2023', label: 'Structured tracking since', note: 'A continuous, evolving daily record' },
  { value: '150+', label: 'Variables tracked', note: 'From sleep and study to hobbies and blunders' },
  { value: '≈ 5 min', label: 'Essential daily logging', note: 'Diary writing is separate and takes longer' },
  { value: '4+', label: 'Core tools', note: 'Sheets, Apps Script, Python, APIs, and whatever earns its place' },
];

const trackedAreas = [
  { icon: '⏱️', title: 'Time & effort', text: 'Work, study, projects, practical tasks, and other blocks of time that show where effort actually went.' },
  { icon: '🌙', title: 'Sleep & routines', text: 'Sleep, wake and bed timing, recurring routines, and the ordinary structure that shapes a day.' },
  { icon: '🎯', title: 'Habits & pursuits', text: 'Exercise, guitar, languages, dance, reading, and skills or habits I return to over time.' },
  { icon: '📚', title: 'Culture & collections', text: 'Books, audiobooks, albums, classical music, art, and the dates, notes, favorites, and context attached to them.' },
  { icon: '🗺️', title: 'Places & experiences', text: 'Travel, outings, social time, notable events, milestones, and experiences that are better remembered with context.' },
  { icon: '📝', title: 'Diary & qualitative context', text: 'Daily events, reflections, questions, mistakes, ideas, and small moments that would lose meaning if reduced to a number.' },
];

const dayFlow = [
  { label: 'Life happens', title: 'An ordinary day', text: 'Sleep, work, study, practice, errands, conversations, books, mistakes, and small events produce the raw material.' },
  { label: 'A few minutes later', title: 'Record what matters', text: 'Structured fields capture repeatable facts while diary writing preserves context that would be flattened by a number.' },
  { label: 'Across years', title: 'Join the archive', text: 'Dates, schemas, formulas, scripts, and source records turn isolated entries into a consistent history instead of loose fragments.' },
  { label: 'Whenever useful', title: 'Explore it again', text: 'The same day can later reappear in Stats, Day Explorer, Pursuits, calendars, maps, timelines, search, or future analysis.' },
];

const timeline = [
  { year: '2022', title: 'The written record came first', text: 'Daily diary logging established the habit of preserving ordinary days before the structured data system became central.' },
  { year: '2023', title: 'Structured tracking began', text: 'A daily spreadsheet started capturing recurring details in a form that could be counted, compared, filtered, and revisited.' },
  { year: '2024–25', title: 'The system connected itself', text: 'Dashboards, formulas, scripts, APIs, automation, and experiments accumulated—until adding more data stopped automatically making the system better.' },
  { year: 'Now', title: 'The private system turned outward', text: 'LifeLoggerz is becoming a public-safe archive, toolkit, set of explorers, and demonstration of what long-term computer logging can become.' },
];

const digitalPossibilities = [
  { icon: '🔎', title: 'Search', text: 'Find a date, phrase, person, habit, place, or period without rereading years of notebooks.' },
  { icon: '↔️', title: 'Compare', text: 'Put days, months, years, pursuits, and phases beside one another instead of relying on memory to reconstruct them.' },
  { icon: '📈', title: 'Visualize', text: 'Turn repeated entries into calendars, maps, distributions, records, timelines, and Data Stories.' },
  { icon: '🤖', title: 'Ask', text: 'A structured, scrubbed archive can eventually be questioned with AI while the unrestricted private record remains private.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About LifeLoggerz',
  description: 'What LifeLoggerz is, why it exists, what it preserves, and the principles that shape the project.',
  mainEntity: {
    '@type': 'CreativeWork',
    name: 'LifeLoggerz',
    creator: { '@type': 'Person', name: 'José' },
    description: 'A personal data, diary, archive, visualization, and systems project built from long-term daily logging.',
  },
};
---

<AboutLayout
  title="About LifeLoggerz"
  description="What LifeLoggerz is, why it exists, what it preserves, and what I hope other people can take from it."
  pubDate="2026-08-08"
  wide={true}
  showViews={false}
  heroImage="/images_webp/faq-movie.webp"
>
  <main class="about-split">
    <section class="about-hero-copy" aria-labelledby="lifeloggerz-intro-title">
      <p class="about-eyebrow">The archive, system, and philosophy</p>
      <h2 id="lifeloggerz-intro-title">A searchable record of a life in progress</h2>
      <p class="about-lede">
        <strong>LifeLoggerz</strong> began as personal logging and grew into something harder to describe with one label:
        part data system, part diary archive, part memory aid, part experimental laboratory, and now part public toolkit.
      </p>
      <p>
        The purpose is not to turn life into a spreadsheet. It is to preserve more of what happened, make patterns easier to see,
        reduce repeated work, and create an archive that becomes more useful as the years accumulate.
      </p>
      <div class="about-inline-actions">
        <a class="about-button primary" href="/stats/">Explore the archive</a>
        <a class="about-button" href="/templates/">Build your own</a>
        <a class="about-button" href="/about/me/">Meet José</a>
      </div>
    </section>

    <section class="about-proof-grid" aria-label="LifeLoggerz at a glance">
      {proofStats.map((stat) => (
        <article class="about-proof">
          <strong>{stat.value}</strong>
          <h3>{stat.label}</h3>
          <span>{stat.note}</span>
        </article>
      ))}
    </section>

    <section class="about-section about-love-panel" aria-labelledby="why-title">
      <div class="about-section-head">
        <p class="about-eyebrow">Why it exists</p>
        <h2 id="why-title">Memory fades. A good archive can give ordinary life a second life.</h2>
        <p>
          Most days are made of small things that seem too ordinary to preserve until years have passed. LifeLoggerz gives those days enough structure to be found again—not so every minute can be optimized, but so patterns, memories, work, interests, and changes do not have to depend entirely on recollection.
        </p>
      </div>
    </section>

    <section class="about-section" id="what-i-track" aria-labelledby="track-title">
      <div class="about-section-head">
        <p class="about-eyebrow">What gets preserved</p>
        <h2 id="track-title">Numbers where numbers help. Context where numbers fail.</h2>
        <p>
          This is a representative map rather than an exhaustive inventory. LifeLoggerz mixes structured variables with collections, dates, places, and written context so the archive can preserve both patterns and stories.
        </p>
      </div>

      <div class="about-card-grid">
        {trackedAreas.map((area) => (
          <article class="about-card">
            <span class="about-card-icon" aria-hidden="true">{area.icon}</span>
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </article>
        ))}
      </div>

      <div class="about-link-row">
        <a class="about-link-chip" href="/faq/">See detailed tracking & privacy answers →</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="day-flow-title">
      <div class="about-section-head">
        <p class="about-eyebrow">One day through the system</p>
        <h2 id="day-flow-title">From ordinary life to something explorable</h2>
        <p>
          The website is only the visible end of the process. A normal day becomes useful later because the record moves through a few simple stages.
        </p>
      </div>

      <div class="about-system-flow">
        {dayFlow.map((step) => (
          <article class="about-system-step">
            <span class="about-system-number">{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>

      <div class="about-link-row">
        <a class="about-link-chip" href="/stats/">See the public explorers →</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="origin-title">
      <div class="about-section-head">
        <p class="about-eyebrow">How it became this</p>
        <h2 id="origin-title">Built one useful layer at a time</h2>
        <p>
          There was no master plan. Each layer survived because it solved a real problem; other ideas were simplified, automated, or abandoned when the maintenance stopped being worth it.
        </p>
      </div>

      <ol class="about-timeline">
        {timeline.map((item) => (
          <li>
            <span class="about-timeline-dot" aria-hidden="true"></span>
            <article class="about-timeline-card">
              <p class="about-timeline-year">{item.year}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          </li>
        ))}
      </ol>

      <div class="about-link-row">
        <a class="about-link-chip" href="/blog/rawdatapost2025/">See the Raw Data system evolve →</a>
        <a class="about-link-chip" href="/timeline/">Open the broader life timeline →</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="computer-title">
      <div class="about-section-head">
        <p class="about-eyebrow">Why computer logging?</p>
        <h2 id="computer-title">A paper journal remembers. A digital archive can also answer.</h2>
        <p>
          Paper can preserve a life beautifully. Digital structure fits this project because years of records can also be retrieved, compared, visualized, filtered, and eventually questioned in ways a stack of notebooks cannot do as easily.
        </p>
      </div>

      <div class="about-card-grid">
        {digitalPossibilities.map((item) => (
          <article class="about-card">
            <span class="about-card-icon" aria-hidden="true">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section about-philosophy" id="what-i-dont-track" aria-labelledby="philosophy-title">
      <div>
        <p class="about-eyebrow">Philosophy & boundaries</p>
        <h2 id="philosophy-title">The archive serves the life, not the other way around.</h2>
        <p>
          More data is not automatically better. A record earns its place when it preserves something useful, reduces mental load, answers a question, or becomes valuable with time. If maintaining it creates more friction than clarity, it should be simplified, automated, or removed.
        </p>
        <p>
          Missing and approximate data should be labeled honestly. Automation should remove repetition without hiding how the system works. Privacy matters more than publishing an interesting chart. And not everything meaningful needs to become a metric at all.
        </p>
        <p>
          LifeLoggerz also exists because other people once shared their own systems and experiments publicly. If this project gives even one person a better place to start—whether they preserve more of their life, build a smaller system, or push one of these ideas further—that is enough reason to keep making the work visible.
        </p>
      </div>
      <aside class="about-principles" aria-label="What LifeLoggerz deliberately does not prioritize">
        <h3>What stays outside the core</h3>
        <ul>
          <li>Continuous biometric streams or wearables for their own sake.</li>
          <li>Calories, heart rate, and screen time as default daily targets.</li>
          <li>Perfect minute-by-minute reconstruction of every day.</li>
          <li>Data whose maintenance costs more attention than it returns.</li>
          <li>Private information simply because it would make an interesting chart.</li>
        </ul>
      </aside>
    </section>

    <aside class="about-statement" aria-label="LifeLoggerz guiding principle">
      <blockquote>
        “The purpose was never to spend my entire life maintaining a spreadsheet. It was to build systems that returned time and attention to me.”
      </blockquote>
    </aside>

    <section class="about-section about-final-cta" aria-labelledby="start-title">
      <p class="about-eyebrow">Three ways forward</p>
      <h2 id="start-title">Explore it, borrow from it, or meet the person behind it.</h2>
      <p>
        Wander through the public archive, start with a much smaller system of your own, or see the life that generated all of this material in the first place.
      </p>
      <div class="about-inline-actions">
        <a class="about-button primary" href="/stats/">Explore the archive</a>
        <a class="about-button" href="/templates/">Build your own</a>
        <a class="about-button" href="/about/me/">Meet José</a>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</AboutLayout>
