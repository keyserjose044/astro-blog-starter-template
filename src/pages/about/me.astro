---
import AboutLayout from '../../layouts/AboutLayout.astro';
import AboutPhotoBubble from '../../components/AboutPhotoBubble.astro';
import JoseConstellation from '../../components/JoseConstellation.astro';
import AboutCultureFavorites from '../../components/AboutCultureFavorites.astro';
import '../../styles/about-split.css';
import '../../styles/about-capability-map.css';

const portraitCards = [
  {
    icon: '🌎',
    status: 'Live now',
    title: 'Where I come from',
    text: 'Family Roots traces both sides of my family from México into the specific communities my parents and grandparents knew, then connects the geography to photographs and family stories.',
    href: '#family-roots',
    cta: 'Open Family Roots above',
  },
  {
    icon: '📊',
    status: 'Growing',
    title: 'The Quantified Me',
    text: 'Instead of saying I read, practice guitar, study languages, or move through phases, the archive can show the evidence: totals, calendars, records, and long-term patterns.',
    href: '/stats/',
    cta: 'Explore the data',
  },
  {
    icon: '✍️',
    status: 'Planned',
    title: 'The Written Me',
    text: 'A public-safe diary corpus will eventually offer the qualitative counterpart: recurring themes, concerns, joys, phrases, values, and changes that statistics alone cannot describe.',
  },
  {
    icon: '✦',
    status: 'Live now',
    title: 'The José constellation',
    text: 'José José, José María Napoleón, Joseph, Yusuf, José Martí, José Rizal, and other namesakes orbit a central signature—part cultural collage, part playful identity map.',
    href: '#jose-constellation',
    cta: 'Enter the constellation',
  },
  {
    icon: '🎯',
    status: 'Live now',
    title: 'What I do',
    text: 'Guitar, dance, running, languages, research, building things, reading, and the pursuits that recur through different periods of my life.',
    href: '/pursuits/',
    cta: 'Explore my pursuits',
  },
  {
    icon: '♥',
    status: 'Growing',
    title: 'Things I love',
    text: 'Books I keep thinking about, music that moves me, paintings I stop for, people who shaped my thinking, words I love, and places that matter to me.',
    href: '#cultural-favorites',
    cta: 'See what stayed with me',
  },
];

const capabilityLanes = [
  {
    id: 'do',
    icon: '◆',
    eyebrow: 'Already part of my life',
    title: 'Things I do / can do',
    text: 'Skills and disciplines with real history behind them. Where the archive supports it, these can grow into evidence-backed totals instead of résumé adjectives.',
    items: [
      { emoji: '🎸', title: 'Guitar', meta: ['Active', 'Hours · sessions · streaks'], href: '/pursuits/guitar/' },
      { emoji: '🧪', title: 'Civil engineering research', meta: ['Deep practice', 'Years · projects · lab time'] },
      { emoji: '🌍', title: 'Languages', meta: ['Ongoing', 'Study time · languages'], href: '/pursuits/languages/' },
      { emoji: '💃', title: 'Dance', meta: ['Active', 'Classes · hours · styles'], href: '/pursuits/dance/' },
      { emoji: '🏃', title: 'Running', meta: ['Established', 'Mileage · hours · records'], href: '/pursuits/running/' },
      { emoji: '📊', title: 'Data & logging systems', meta: ['Core habit', 'Years · logs · build time'], href: '/stats/' },
    ],
  },
  {
    id: 'more',
    icon: '↗',
    eyebrow: 'Known, but underused',
    title: 'Things I want more of',
    text: 'Not every aspiration requires mastery. Some things simply deserve a larger share of life than they currently get.',
    items: [
      { emoji: '🏊', title: 'Swimming', meta: ['More often', 'Sessions · last done'] },
      { emoji: '⚽', title: 'Sports', meta: ['More often', 'Games · hours'] },
      { emoji: '🎬', title: 'Films', meta: ['Make room', 'Films · hours watched'] },
      { emoji: '🫂', title: 'Social outings', meta: ['More life', 'Outings · frequency'] },
      { emoji: '🧭', title: 'Travel & day trips', meta: ['Occasional', 'Trips · days'] },
      { emoji: '🥾', title: 'Outdoors & hiking', meta: ['More often', 'Outings · distance'] },
    ],
  },
  {
    id: 'learn',
    icon: '✦',
    eyebrow: 'The curiosity queue',
    title: 'Things I want to learn',
    text: 'Some are serious ambitions; others are gloriously specific curiosities. Either way, they reveal where my attention wants to wander next.',
    items: [
      { emoji: '✒️', title: 'Calligraphy', meta: ['Someday', 'Challenge candidate'] },
      { emoji: '🎙️', title: 'Auctioneer calling', meta: ['Curious', 'Challenge candidate'] },
      { emoji: '🤹', title: 'Juggling', meta: ['Someday', 'Challenge candidate'] },
      { emoji: '🚲', title: 'Ride a unicycle', meta: ['Someday', 'Challenge candidate'] },
      { emoji: '🔌', title: 'Electronics & appliance internals', meta: ['Curious', 'Projects · hours'] },
      { emoji: '✈️', title: 'Fly a plane', meta: ['Big goal', 'Training · hours'] },
      { emoji: '🎹', title: 'Piano', meta: ['Someday', 'Practice · repertoire'] },
      { emoji: '🎵', title: 'Harmonica', meta: ['Someday', 'Practice · repertoire'] },
    ],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About José',
  description: 'A portrait of José assembled from family roots, pursuits, recorded data, writing, and cultural interests.',
  mainEntity: {
    '@type': 'Person',
    name: 'José',
    jobTitle: 'Civil engineering PhD student and researcher',
    knowsAbout: ['Personal data tracking', 'Civil engineering research', 'Data visualization', 'Languages', 'Music'],
  },
};
---

<AboutLayout
  title="About Me"
  description="Who is José? A portrait assembled from family roots, pursuits, data, writing, and the things I love."
  pubDate="2026-08-09"
  wide={true}
  showViews={false}
>
  <div slot="hero" id="family-roots" style="width:100%">
    <AboutPhotoBubble
      src="/images/about-lifeloggerz.gif"
      alt="Family gathered while young José draws at the table."
      bubbleText="Déjenme terminar esto..."
      hotspotBottom="8%"
      hotspotLeft="27%"
      hotspotWidth="24%"
      hotspotHeight="32%"
      bubbleBottom="40%"
      bubbleLeft="45%"
    />
  </div>

  <main class="about-split">
    <section class="about-me-intro" aria-labelledby="about-me-title">
      <p class="about-eyebrow">The subject of the archive</p>
      <h2 id="about-me-title">A portrait assembled from evidence</h2>
      <p class="about-lede">
        A normal biography can tell you what I claim to be. LifeLoggerz gives me a more interesting option:
        show the family I come from, the things I repeatedly do, the culture I return to, and eventually what years of data and writing suggest about me.
      </p>
      <div class="about-inline-actions">
        <a class="about-button primary" href="/pursuits/">Explore Pursuits</a>
        <a class="about-button" href="/timeline/">Life Timeline</a>
        <a class="about-button" href="/inspirations/">Inspirations</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="portrait-title">
      <div class="about-section-head">
        <p class="about-eyebrow">Several answers to the same question</p>
        <h2 id="portrait-title">Who am I?</h2>
        <p>No single paragraph gets to own the answer. Each part of the archive sees the person from a different angle.</p>
      </div>

      <div class="about-card-grid about-person-grid">
        {portraitCards.map((card) => (
          <article class="about-card">
            <span class="about-card-icon" aria-hidden="true">{card.icon}</span>
            <span class:list={['about-card-status', { planned: card.status === 'Planned' }]}>{card.status}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            {card.href && <a class="about-card-link" href={card.href}>{card.cta} →</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="about-section about-capability-map" aria-labelledby="capability-title">
      <div class="about-capability-intro">
        <div>
          <p class="about-eyebrow">Abilities, appetite & unfinished curiosity</p>
          <h2 id="capability-title">What I can do, want more of, and still want to learn</h2>
          <p>
            A life is more than completed achievements. This is a moving map of the skills already built, experiences I would like to make more room for,
            and the odd or ambitious things I hope to learn someday.
          </p>
        </div>
        <div class="about-capability-key" aria-label="Capability map legend">
          <span>Do<br />built already</span>
          <span>Do more<br />make room</span>
          <span>Learn<br />curiosity queue</span>
        </div>
      </div>

      <div class="about-capability-lanes">
        {capabilityLanes.map((lane) => (
          <article class="about-capability-lane" data-lane={lane.id}>
            <div class="about-capability-lane-head">
              <span class="about-capability-lane-icon" aria-hidden="true">{lane.icon}</span>
              <p class="about-eyebrow">{lane.eyebrow}</p>
              <h3>{lane.title}</h3>
              <p>{lane.text}</p>
            </div>
            <div class="about-capability-items">
              {lane.items.map((item) => item.href ? (
                <a class="about-capability-item" href={item.href}>
                  <span class="about-capability-item-top">
                    <span class="about-capability-item-emoji" aria-hidden="true">{item.emoji}</span>
                    <strong>{item.title}</strong>
                    <span class="about-capability-item-arrow" aria-hidden="true">→</span>
                  </span>
                  <span class="about-capability-meta">
                    {item.meta.map((meta) => <span>{meta}</span>)}
                  </span>
                </a>
              ) : (
                <div class="about-capability-item">
                  <span class="about-capability-item-top">
                    <span class="about-capability-item-emoji" aria-hidden="true">{item.emoji}</span>
                    <strong>{item.title}</strong>
                  </span>
                  <span class="about-capability-meta">
                    {item.meta.map((meta) => <span>{meta}</span>)}
                  </span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="about-capability-note">
        <span aria-hidden="true">⏱️</span>
        <p>
          <strong>Designed to become data-backed.</strong> The second tag on each card is the metric slot: actual hours, sessions, years active, frequency,
          last practiced, mileage, classes, or another useful measure can replace the label as the archive gains a clean source of truth. No invented precision.
        </p>
      </div>
      <div class="about-capability-note">
        <span aria-hidden="true">🎲</span>
        <p>
          <strong>Future challenge mode:</strong> items in the learning queue can eventually become one-day, one-week, or longer experiments—pick a curiosity,
          define what “learned enough” means, track the effort, and preserve the result.
        </p>
      </div>
    </section>

    <JoseConstellation />

    <section class="about-section" aria-labelledby="evidence-title">
      <div class="about-section-head">
        <p class="about-eyebrow">The archive as a mirror</p>
        <h2 id="evidence-title">What the record can say that a résumé cannot</h2>
        <p>
          The most LifeLoggerz version of an About page is not a list of adjectives. It is a set of doors into the evidence behind them.
        </p>
      </div>

      <div class="about-evidence-strip">
        <a class="about-evidence-link" href="/stats/">
          <strong>My data says…</strong>
          <span>See the calendars, records, totals, and periods behind the habits.</span>
        </a>
        <a class="about-evidence-link" href="/pursuits/">
          <strong>My pursuits say…</strong>
          <span>See what I repeatedly choose to practice, abandon, revive, and learn.</span>
        </a>
        <a class="about-evidence-link" href="/timeline/">
          <strong>My timeline says…</strong>
          <span>See how projects, education, travel, interests, and milestones accumulated.</span>
        </a>
      </div>
    </section>

    <div id="cultural-favorites">
      <AboutCultureFavorites />
    </div>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline src="/js/about-family-roots-satellite.js?v=20260808-satellite-v2"></script>
  <script is:inline src="/js/about-family-roots-quick-facts.js?v=20260808-quick-facts-v2"></script>
  <script is:inline src="/js/about-family-roots-mobile-fit.js?v=20260809-mobile-fit-v4"></script>
  <script is:inline src="/js/about-family-roots-mobile-map-loader.js?v=20260809-mobile-map-loader-v3"></script>
  <script is:inline src="/js/about-jose-constellation-enhancements.js?v=20260809-modes-v1"></script>
  <script is:inline src="/js/about-jose-constellation-state-bridge.js?v=20260809-state-v1"></script>
</AboutLayout>
