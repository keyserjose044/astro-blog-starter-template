  .reference-link, .close-detail { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 8px 12px; border-radius: 10px; font: inherit; font-size: .78rem; font-weight: 800; text-decoration: none; cursor: pointer; }
