<script>
  (function () {
    const grid = document.querySelector('#composer-grid');
    if (!grid) return;

    const search = document.querySelector('#composer-search');
    const period = document.querySelector('#period-filter');
    const sort = document.querySelector('#composer-sort');
    const results = document.querySelector('#composer-results');
    const clear = document.querySelector('#clear-composer-filters');
    const luckyButton = document.querySelector('#feeling-lucky');
    const luckyRating = document.querySelector('#lucky-rating');
    const luckyStatus = document.querySelector('#lucky-status');
    const cards = Array.from(grid.querySelectorAll('.composer-card'));
    const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });
    let activeId = '';
    let host = null;

    const norm = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const parsePageData = () => {
      try {
        return JSON.parse(document.querySelector('#composer-page-data')?.textContent || '{}');
      } catch {
        return { luckyPool: [] };
      }
    };

    const pageData = parsePageData();

    function visibleCards() {
      return cards.filter((card) => card.style.display !== 'none');
    }

    function updateHash(id) {
      const url = new URL(window.location.href);
      url.hash = id ? `composer-${id}` : '';
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function closeDetail(options = {}) {
      const { preserveHash = false } = options;
      if (host) host.remove();
      host = null;
      activeId = '';
      cards.forEach((card) => {
        card.querySelector('[data-composer-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (!preserveHash) updateHash('');
    }

    function placeHostAfterRow(card) {
      if (!host || card.style.display === 'none') return;
      const top = card.offsetTop;
      const sameRow = visibleCards().filter((candidate) => Math.abs(candidate.offsetTop - top) < 4);
      const lastInRow = sameRow.at(-1) || card;
      lastInRow.insertAdjacentElement('afterend', host);
    }

    function setupEntryBrowser(detail) {
      const browser = detail.querySelector('[data-entry-browser]');
      if (!browser) return;

      const entrySearch = browser.querySelector('[data-entry-search]');
      const ratingFilter = browser.querySelector('[data-entry-rating]');
      const entrySort = browser.querySelector('[data-entry-sort]');
      const list = browser.querySelector('[data-entry-list]');
      const resultText = browser.querySelector('[data-entry-results]');
      const empty = browser.querySelector('[data-entry-empty]');
      const more = browser.querySelector('[data-entry-more]');
      const items = Array.from(browser.querySelectorAll('[data-entry-item]'));
      let visibleLimit = 40;

      if (!list || !items.length) return;

      function applyEntries() {
        const words = norm(entrySearch?.value).split(/\s+/).filter(Boolean);
        const selectedRating = ratingFilter?.value || 'all';
        const mode = entrySort?.value || 'latest';

        const filtered = items.filter((item) => {
          const searchMatches = !words.length || words.every((word) => (item.dataset.search || '').includes(word));
          const ratingMatches = selectedRating === 'all' || item.dataset.rating === selectedRating;
          return searchMatches && ratingMatches;
        });

        filtered.sort((a, b) => {
          let comparison = 0;
          if (mode === 'earliest') comparison = Number(a.dataset.date || 0) - Number(b.dataset.date || 0);
          else if (mode === 'title') comparison = collator.compare(a.dataset.title || '', b.dataset.title || '');
          else if (mode === 'longest') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
          else comparison = Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
          return comparison || Number(b.dataset.row || 0) - Number(a.dataset.row || 0);
        });

        items.forEach((item) => {
          item.hidden = true;
        });

        filtered.forEach((item, index) => {
          list.appendChild(item);
          item.hidden = index >= visibleLimit;
        });

        if (resultText) {
          const shown = Math.min(filtered.length, visibleLimit);
          resultText.textContent = filtered.length
            ? `Showing ${shown.toLocaleString()} of ${filtered.length.toLocaleString()} matching entries`
            : 'No matching entries';
        }
        if (empty) empty.hidden = filtered.length > 0;
        if (more) more.hidden = filtered.length <= visibleLimit;
      }

      entrySearch?.addEventListener('input', () => {
        visibleLimit = 40;
        applyEntries();
      });
      ratingFilter?.addEventListener('change', () => {
        visibleLimit = 40;
        applyEntries();
      });
      entrySort?.addEventListener('change', applyEntries);
      more?.addEventListener('click', () => {
        visibleLimit += 40;
        applyEntries();
      });

      applyEntries();
    }

    function openDetail(card, options = {}) {
      const { shouldScroll = true, updateUrl = true } = options;
      const button = card.querySelector('[data-composer-trigger]');
      const id = button?.dataset.composerTrigger;
      if (!button || !id) return;

      if (activeId === id) {
        closeDetail();
        button.focus();
        return;
      }

      closeDetail({ preserveHash: true });
      const template = document.querySelector(`#composer-template-${CSS.escape(id)}`);
      if (!template) return;

      host = document.createElement('div');
      host.className = 'composer-detail-host';
      host.appendChild(template.content.cloneNode(true));
      activeId = id;
      button.setAttribute('aria-expanded', 'true');
      placeHostAfterRow(card);

      const detail = host.querySelector('.composer-detail');
      setupEntryBrowser(detail);

      host.querySelector('[data-close-composer]')?.addEventListener('click', () => {
        closeDetail();
        button.focus();
      });

      if (updateUrl) updateHash(id);
      if (shouldScroll) {
        requestAnimationFrame(() => detail?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
      }
    }

    cards.forEach((card) => {
      card.querySelector('[data-composer-trigger]')?.addEventListener('click', () => openDetail(card));
    });

    function sortCards(options = {}) {
      const { closeOpen = true } = options;
      const mode = sort?.value || 'name-asc';
      const ordered = [...cards].sort((a, b) => {
        let comparison = 0;
        if (mode === 'entries-desc') comparison = Number(b.dataset.entries || 0) - Number(a.dataset.entries || 0);
        else if (mode === 'unique-desc') comparison = Number(b.dataset.unique || 0) - Number(a.dataset.unique || 0);
        else if (mode === 'hours-desc') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
        else if (mode === 'favorites-desc') comparison = Number(b.dataset.favorites || 0) - Number(a.dataset.favorites || 0);
        else if (mode === 'recent-desc') comparison = Number(b.dataset.lastListened || 0) - Number(a.dataset.lastListened || 0);
        else comparison = collator.compare(a.dataset.name || '', b.dataset.name || '');
        return comparison || Number(a.dataset.originalIndex || 0) - Number(b.dataset.originalIndex || 0);
      });

      if (closeOpen) closeDetail();
      ordered.forEach((card) => grid.appendChild(card));
    }

    function filterCards(options = {}) {
      const { closeOpen = true } = options;
      const words = norm(search?.value).split(/\s+/).filter(Boolean);
      const selectedPeriod = period?.value || '';
      let visible = 0;

      if (closeOpen) closeDetail();
      cards.forEach((card) => {
        const textMatches = !words.length || words.every((word) => (card.dataset.search || '').includes(word));
        const periodMatches = !selectedPeriod || card.dataset.period === selectedPeriod;
        const show = textMatches && periodMatches;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      if (results) results.textContent = `Showing ${visible.toLocaleString()} of ${cards.length.toLocaleString()} composer profiles`;
      if (clear) clear.hidden = !(search?.value.trim() || selectedPeriod);
    }

    function randomIndex(length) {
      if (window.crypto?.getRandomValues) {
        const values = new Uint32Array(1);
        window.crypto.getRandomValues(values);
        return values[0] % length;
      }
      return Math.floor(Math.random() * length);
    }

    luckyButton?.addEventListener('click', () => {
      const pool = Array.isArray(pageData.luckyPool) ? pageData.luckyPool : [];
      const selected = luckyRating?.value || 'gorgeous';
      const candidates = pool.filter((entry) => selected === 'favorites' || entry.rating === selected);

      if (!candidates.length) {
        if (luckyStatus) luckyStatus.textContent = 'No linked performances are available in that rating pool.';
        return;
      }

      const storageKey = 'lifeloggerz-classical-lucky-recent';
      let recent = [];
      try {
        recent = JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {
        recent = [];
      }
      if (!Array.isArray(recent)) recent = [];

      const fresh = candidates.filter((entry) => !recent.includes(entry.key));
      const available = fresh.length ? fresh : candidates;
      const choice = available[randomIndex(available.length)];

      recent = [choice.key, ...recent.filter((key) => key !== choice.key)].slice(0, 15);
      try {
        localStorage.setItem(storageKey, JSON.stringify(recent));
      } catch {
        // Storage is optional; selection still works without it.
      }

      if (luckyStatus) luckyStatus.textContent = `${choice.composer} — ${choice.piece}`;
      const opened = window.open(choice.url, '_blank');
      if (opened) opened.opener = null;
      else window.location.href = choice.url;
    });

    let debounceTimer;
    search?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => filterCards(), 80);
    });
    period?.addEventListener('change', () => filterCards());
    sort?.addEventListener('change', () => sortCards());
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      if (period) period.value = '';
      filterCards();
      search?.focus();
    });

    window.addEventListener('resize', () => {
      if (!activeId || !host) return;
      const card = cards.find((candidate) => candidate.dataset.composerId === activeId);
      if (card) placeHostAfterRow(card);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && activeId) closeDetail();
      else if (event.key === '/' && event.target === document.body) {
        event.preventDefault();
        search?.focus();
      }
    });

    window.addEventListener('hashchange', () => {
      const id = window.location.hash.replace(/^#composer-/, '');
      if (!id) {
        if (activeId) closeDetail({ preserveHash: true });
        return;
      }
      const card = cards.find((candidate) => candidate.dataset.composerId === id);
      if (card && activeId !== id) openDetail(card, { shouldScroll: true, updateUrl: false });
    });

    sortCards({ closeOpen: false });
    filterCards({ closeOpen: false });

    const initialId = window.location.hash.replace(/^#composer-/, '');
    if (initialId) {
      const initialCard = cards.find((candidate) => candidate.dataset.composerId === initialId);
      if (initialCard) requestAnimationFrame(() => openDetail(initialCard, { shouldScroll: true, updateUrl: false }));
    }
  })();
</script>
