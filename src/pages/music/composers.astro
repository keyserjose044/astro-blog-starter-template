  }

  @media (max-width: 700px) {
    .toolbar { display: grid; grid-template-columns: 1fr 1fr; position: sticky; top: 66px; z-index: 20; padding: 8px; border: 1px solid rgba(229, 232, 239, .9); border-radius: 13px; background: rgba(255, 255, 255, .95); box-shadow: 0 8px 24px rgba(15, 23, 42, .1); backdrop-filter: blur(12px); }
    .toolbar > input { grid-column: 1 / -1; width: 100%; }
    .toolbar > select, .toolbar > button { min-width: 0; width: 100%; }
