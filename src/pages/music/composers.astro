---
// src/pages/music/composers.astro
// Raindrop supplies composer portraits and metadata. A build-time Google Apps Script
// feed supplies the listening log, performance links, ratings, and statistics.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import MusicNav from '../../components/MusicNav.astro';
import { SITE_TITLE } from '../../consts';
import { fetchAllRaindrops } from '../../utils/raindrop';
import {
  formatListeningDate,
  formatListeningHours,
  normalizeText,
  parseClassicalListeningFeed,
  slugify,
  type ListeningEntry,
  type RatingBucket,
} from '../../utils/classicalListening';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_COMPOSERS_ID || '58399760';
const CLASSICAL_LISTENING_DATA_URL =
  import.meta.env.CLASSICAL_LISTENING_DATA_URL ||
  import.meta.env.CLASSICAL_LISTENING_CSV_URL;

const FALLBACK_PORTRAIT = '/images_webp/album-placeholder.webp';
const PERIODS = [
  'Medieval',
  'Renaissance',
  'Baroque',
  'Galant',
  'Classical',
  'Romantic',
  'Late Romantic',
  'Impressionist',
  'Modern',
  'Contemporary',
];

const NAME_FIXES: Record<string, string> = {
  'alesssandro scarlatti': 'Alessandro Scarlatti',
};

const RATING_PRIORITY: Record<RatingBucket, number> = {
  amazing: 3,
  gorgeous: 2,
  other: 1,
};

const ratingLabel = (bucket: RatingBucket, original = '') => {
  if (bucket === 'amazing') return 'Amazing';
  if (bucket === 'gorgeous') return 'Gorgeous';
  return original || 'Other';
};

const isFavoriteEntry = (entry: Pick<ListeningEntry, 'ratingBucket'>) =>
  entry.ratingBucket === 'amazing' || entry.ratingBucket === 'gorgeous';

const parseComposerMeta = (title: string, note?: string | null) => {
  const rawTitle = String(title || '').trim();
  const rawNote = String(note || '').trim();
  const combined = `${rawTitle} · ${rawNote}`;
  const lifespanMatch = combined.match(/\b(c\.?\s*)?(\d{3,4})\s*[–—-]\s*(c\.?\s*)?(\d{3,4}|present)\b/i);
  const cleaned = rawTitle
    .replace(/\s*[([]?c\.?\s*\d{3,4}\s*[–—-]\s*(?:c\.?\s*)?(?:\d{3,4}|present)[)\]]?\s*/i, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  const fixedName = NAME_FIXES[normalizeText(cleaned)] || cleaned || rawTitle;

  const parts = rawNote
    .split(/\s*(?:·|•|\||\n)\s*/)
    .map((part) => part.trim())
    .filter(Boolean)
    .filter((part) => !/^c\.?\s*\d{3,4}\s*[–—-]\s*(?:c\.?\s*)?(?:\d{3,4}|present)$/i.test(part));

  const period =
    PERIODS.find((candidate) => normalizeText(rawNote).includes(normalizeText(candidate))) || '';

  const nationality =
    parts.find(
      (part) =>
        !PERIODS.some((candidate) => normalizeText(part).includes(normalizeText(candidate))) &&
        !/\b(?:born|died|composer|music|biography)\b/i.test(part) &&
        part.length <= 45,
    ) || '';

  return {
    name: fixedName,
    id: slugify(fixedName),
    birthYear: lifespanMatch?.[2] || '',
    deathYear: lifespanMatch?.[4] || '',
    birthCirca: Boolean(lifespanMatch?.[1]),
    deathCirca: Boolean(lifespanMatch?.[3]),
    nationality,
    period,
    note: rawNote,
  };
};

const formatCompactDuration = (minutes: number) => {
  if (!minutes) return 'Length not logged';
  if (minutes < 90) return `${Math.round(minutes).toLocaleString('en-US')} min`;
  return formatListeningHours(minutes);
};

const formatGeneratedAt = (value: string) => {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'America/Chicago',
  }).format(date);
};

const formatCardDate = (date: Date | null) => {
  if (!date) return 'Not yet';
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: '2-digit',
    timeZone: 'UTC',
  }).format(date);
};

const formatLife = (composer: {
  birthYear: string;
  deathYear: string;
  birthCirca?: boolean;
  deathCirca?: boolean;
}) => {
  if (!composer.birthYear) return '';
  const birth = `${composer.birthCirca ? 'c.' : ''}${composer.birthYear}`;
  const death = composer.deathYear
    ? `${composer.deathCirca ? 'c.' : ''}${composer.deathYear}`
    : '';
  return `${birth}–${death}`;
};

const getInitials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 3)
    .map((part) => part[0]?.toUpperCase() || '')
    .join('');

let listeningEntries: ListeningEntry[] = [];
let feedGeneratedAt = '';
let feedRejectedRows = 0;
let sheetError = '';

if (CLASSICAL_LISTENING_DATA_URL) {
  try {
    const response = await fetch(CLASSICAL_LISTENING_DATA_URL, {
      headers: { Accept: 'application/json, text/csv;q=0.9, text/plain;q=0.8' },
    });
    if (!response.ok) throw new Error(`Listening feed returned ${response.status}`);

    const parsed = parseClassicalListeningFeed(
      await response.text(),
      response.headers.get('content-type') || '',
    );
    listeningEntries = parsed.entries;
    feedGeneratedAt = parsed.generatedAt;
    feedRejectedRows = parsed.rejectedRows;
  } catch (error) {
    sheetError = error instanceof Error ? error.message : String(error);
    console.warn('[Composers] Classical listening feed could not be loaded:', error);
  }
}

const composersRaw = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'composers',
  placeholder: FALLBACK_PORTRAIT,
});

const composerProfiles = composersRaw.map((composer, originalIndex) => {
  const meta = parseComposerMeta(composer.title, composer.note);
  return {
    ...meta,
    cover: composer.cover,
    href: composer.href,
    originalIndex,
    profiled: true,
  };
});

const byExactName = new Map(composerProfiles.map((composer) => [normalizeText(composer.name), composer.id]));
const bySlug = new Map(composerProfiles.map((composer) => [composer.id, composer.id]));
const composerNameById = new Map(composerProfiles.map((composer) => [composer.id, composer.name]));
const surnameCandidates = new Map<string, string[]>();

composerProfiles.forEach((composer) => {
  const surname = normalizeText(composer.name).split(' ').filter(Boolean).at(-1) || '';
  if (!surname) return;
  surnameCandidates.set(surname, [...(surnameCandidates.get(surname) || []), composer.id]);
});

const COMPOSER_ALIASES: Record<string, string> = {
  bach: 'johann sebastian bach',
  'j s bach': 'johann sebastian bach',
  'js bach': 'johann sebastian bach',
  'c p e bach': 'carl philipp emanuel bach',
  'cpe bach': 'carl philipp emanuel bach',
  'j c bach': 'johann christian bach',
  'jc bach': 'johann christian bach',
  'w f bach': 'wilhelm friedemann bach',
  'wf bach': 'wilhelm friedemann bach',
  scarlatti: 'domenico scarlatti',
  'd scarlatti': 'domenico scarlatti',
  'a scarlatti': 'alessandro scarlatti',
  haydn: 'joseph haydn',
  schumann: 'robert schumann',
  mendelssohn: 'felix mendelssohn',
  mozart: 'wolfgang amadeus mozart',
  'vaughn williams': 'ralph vaughan williams',
};

const resolveComposerId = (entry: ListeningEntry) => {
  if (entry.composerId && bySlug.has(entry.composerId)) return entry.composerId;

  const cleanedName = entry.composer.replace(/\?+/g, '').replace(/\s+/g, ' ').trim();
  const normalizedName = normalizeText(cleanedName);
  const exact = byExactName.get(normalizedName);
  if (exact) return exact;

  const aliasName = COMPOSER_ALIASES[normalizedName];
  if (aliasName) {
    const aliasId = byExactName.get(aliasName) || bySlug.get(slugify(aliasName));
    if (aliasId) return aliasId;
  }

  const surname = normalizedName.split(' ').filter(Boolean).at(-1) || '';
  const candidates = surnameCandidates.get(surname) || [];
  if (candidates.length === 1) return candidates[0];

  return entry.composerId || slugify(aliasName || cleanedName);
};

type ResolvedEntry = ListeningEntry & {
  resolvedComposerId: string;
  displayComposer: string;
};

type WorkRecord = ResolvedEntry & {
  listenCount: number;
  totalListeningMinutes: number;
};

const resolvedEntries: ResolvedEntry[] = listeningEntries.map((entry) => {
  const resolvedComposerId = resolveComposerId(entry);
  return {
    ...entry,
    resolvedComposerId,
    displayComposer: composerNameById.get(resolvedComposerId) || entry.composer.replace(/\?+/g, '').trim(),
  };
});

const entriesByComposer = new Map<string, ResolvedEntry[]>();
resolvedEntries.forEach((entry) => {
  entriesByComposer.set(entry.resolvedComposerId, [
    ...(entriesByComposer.get(entry.resolvedComposerId) || []),
    entry,
  ]);
});

const getDateBounds = (entries: ResolvedEntry[]) => {
  const dates = entries.map((entry) => entry.date).filter((date): date is Date => Boolean(date));
  return {
    first: dates.length ? new Date(Math.min(...dates.map((date) => date.getTime()))) : null,
    last: dates.length ? new Date(Math.max(...dates.map((date) => date.getTime()))) : null,
  };
};

const getTopForm = (entries: ResolvedEntry[]) => {
  const counts = new Map<string, number>();
  entries.forEach((entry) => {
    if (!entry.form) return;
    counts.set(entry.form, (counts.get(entry.form) || 0) + 1);
  });
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || '';
};

const getUniqueWorks = (entries: ResolvedEntry[]): WorkRecord[] => {
  const groups = new Map<string, ResolvedEntry[]>();

  entries.forEach((entry) => {
    const key = normalizeText(entry.piece);
    if (!key) return;
    groups.set(key, [...(groups.get(key) || []), entry]);
  });

  return [...groups.values()]
    .map((workEntries) => {
      const sorted = [...workEntries].sort(
        (a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber,
      );
      const latest = sorted[0];
      const bestRating = [...workEntries].sort(
        (a, b) => RATING_PRIORITY[b.ratingBucket] - RATING_PRIORITY[a.ratingBucket],
      )[0];
      const linked = sorted.find((entry) => entry.youtubeUrl);
      const metadata = sorted.find((entry) => entry.form || entry.period || entry.compositionYear) || latest;

      return {
        ...latest,
        youtubeUrl: linked?.youtubeUrl || latest.youtubeUrl,
        form: metadata.form || latest.form,
        period: metadata.period || latest.period,
        compositionYear: metadata.compositionYear || latest.compositionYear,
        rating: bestRating.rating,
        ratingBucket: bestRating.ratingBucket,
        listenCount: workEntries.length,
        totalListeningMinutes: workEntries.reduce((total, entry) => total + entry.minutes, 0),
      };
    })
    .sort((a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber);
};

const profileById = new Map(composerProfiles.map((composer) => [composer.id, composer]));
const allComposerIds = [...new Set([...composerProfiles.map((composer) => composer.id), ...entriesByComposer.keys()])];

const composers = allComposerIds.map((id, index) => {
  const entries = [...(entriesByComposer.get(id) || [])].sort(
    (a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber,
  );
  const works = getUniqueWorks(entries);
  const favorites = works.filter(isFavoriteEntry);
  const profile = profileById.get(id);
  const fallbackName = entries[0]?.displayComposer || id.replace(/-/g, ' ');
  const name = profile?.name || fallbackName;
  const totalMinutes = entries.reduce((total, entry) => total + entry.minutes, 0);
  const bounds = getDateBounds(entries);

  return {
    id,
    name,
    birthYear: profile?.birthYear || '',
    deathYear: profile?.deathYear || '',
    birthCirca: profile?.birthCirca || false,
    deathCirca: profile?.deathCirca || false,
    nationality: profile?.nationality || '',
    period: profile?.period || '',
    note: profile?.note || '',
    cover: profile?.cover || FALLBACK_PORTRAIT,
    href: profile?.href || '',
    originalIndex: profile?.originalIndex ?? composerProfiles.length + index,
    profiled: Boolean(profile),
    initials: getInitials(name),
    entries,
    works,
    favorites,
    totalMinutes,
    firstListened: bounds.first,
    lastListened: bounds.last,
    repeatCount: Math.max(0, entries.length - works.length),
    topForm: getTopForm(entries),
    favoriteRate: works.length ? (favorites.length / works.length) * 100 : 0,
    linkedCount: entries.filter((entry) => entry.youtubeUrl).length,
  };
});

const allWorks = composers
  .flatMap((composer) => composer.works)
  .sort((a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber);
const favoriteWorks = allWorks.filter(isFavoriteEntry);
const totalEntries = resolvedEntries.length;
const totalMinutes = resolvedEntries.reduce((total, entry) => total + entry.minutes, 0);
const totalComposersLogged = composers.filter((composer) => composer.entries.length > 0).length;
const globalBounds = getDateBounds(resolvedEntries);
const generatedLabel = formatGeneratedAt(feedGeneratedAt);
const hasListeningFeed = Boolean(CLASSICAL_LISTENING_DATA_URL && !sheetError);
const exploredPeriods = [...new Set(allWorks.map((work) => work.period).filter(Boolean))];
const unprofiledComposerCount = composers.filter((composer) => composer.entries.length && !composer.profiled).length;

const topHours = [...composers]
  .filter((composer) => composer.totalMinutes > 0)
  .sort((a, b) => b.totalMinutes - a.totalMinutes)
  .slice(0, 8);
const maxChartMinutes = Math.max(...topHours.map((composer) => composer.totalMinutes), 1);

const topFavorites = [...composers]
  .filter((composer) => composer.favorites.length > 0)
  .sort((a, b) => b.favorites.length - a.favorites.length || b.works.length - a.works.length)
  .slice(0, 8);
const maxFavoriteWorks = Math.max(...topFavorites.map((composer) => composer.works.length), 1);

const topFavoriteRates = [...composers]
  .filter((composer) => composer.works.length >= 5 && composer.favorites.length > 0)
  .sort((a, b) => b.favoriteRate - a.favoriteRate || b.works.length - a.works.length)
  .slice(0, 8);

const recentEntries = [...resolvedEntries]
  .filter((entry) => entry.date)
  .sort((a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber)
  .slice(0, 6);

const periodsInUse = [...new Set(composers.map((composer) => composer.period).filter(Boolean))].sort(
  (a, b) => {
    const aIndex = PERIODS.indexOf(a);
    const bIndex = PERIODS.indexOf(b);
    return (aIndex < 0 ? 999 : aIndex) - (bIndex < 0 ? 999 : bIndex);
  },
);
const workPeriods = [...new Set(allWorks.map((work) => work.period).filter(Boolean))].sort();
const workForms = [...new Set(allWorks.map((work) => work.form).filter(Boolean))].sort();
const workComposers = composers
  .filter((composer) => composer.works.length)
  .sort((a, b) => a.name.localeCompare(b.name));

const luckyPool = favoriteWorks
  .filter((work) => work.youtubeUrl)
  .map((work) => ({
    key: `${work.resolvedComposerId}|${normalizeText(work.piece)}`,
    composer: work.displayComposer,
    piece: work.piece,
    url: work.youtubeUrl,
  }));

const clientPageData = JSON.stringify({ luckyPool }).replace(/</g, '\\u003c');

if (unprofiledComposerCount) {
  console.warn(`[Composers] ${unprofiledComposerCount} explored composers are using generated fallback profiles.`);
}
if (feedRejectedRows) {
  console.warn(`[Composers] ${feedRejectedRows} feed rows were excluded because the date, composer, or piece was blank.`);
}
---

<BaseHead
  title={`${SITE_TITLE} — Music — Classical Music`}
  description="A searchable archive of classical composers, works, performances, listening time, and favorites."
/>

<style>
  :root {
    --classical-ink: #10131b;
    --classical-muted: #626a78;
    --classical-border: #e5e8ef;
    --classical-surface: rgba(255, 255, 255, .93);
    --classical-accent: #405cf5;
    --classical-accent-soft: #eef1ff;
    --classical-amazing: #d44f86;
    --classical-gorgeous: #9c55cd;
    --classical-heard: #dce2ff;
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  .wrap { width: 100%; margin: 0 auto; padding: 28px clamp(16px, 3vw, 48px) 52px; }
  .intro { max-width: 1160px; margin: 0 auto 18px; text-align: center; }
  h1 { margin: 0 0 9px; color: var(--classical-ink); font-weight: 800; letter-spacing: -.025em; }
  .hint { max-width: 78ch; margin: 0 auto 8px; color: var(--classical-muted); line-height: 1.55; }
  .updated-note { margin: 0 auto 15px; color: var(--classical-muted); font-size: .75rem; }
  .feed-notice { max-width: 880px; margin: 0 auto 18px; padding: 11px 14px; border: 1px solid var(--classical-border); border-radius: 12px; background: rgba(255, 255, 255, .86); color: var(--classical-muted); font-size: .84rem; line-height: 1.45; }
  .feed-notice strong { color: var(--classical-ink); }

  .overall-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 9px; max-width: 1160px; margin: 0 auto 17px; }
  .overall-stat { min-width: 0; padding: 13px 10px; border: 1px solid rgba(229, 232, 239, .96); border-radius: 13px; background: rgba(255, 255, 255, .9); box-shadow: 0 7px 20px rgba(15, 23, 42, .06); }
  .overall-stat strong, .overall-stat span { display: block; }
  .overall-stat strong { overflow: hidden; color: var(--classical-ink); font-size: 1.08rem; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .overall-stat span { margin-top: 4px; color: var(--classical-muted); font-size: .7rem; line-height: 1.25; }

  .page-tabs { display: inline-flex; gap: 4px; max-width: 100%; margin: 0 auto 18px; padding: 4px; overflow-x: auto; border: 1px solid var(--classical-border); border-radius: 13px; background: rgba(255, 255, 255, .9); box-shadow: 0 5px 16px rgba(15, 23, 42, .05); }
  .page-tab { flex: 0 0 auto; min-height: 38px; padding: 8px 15px; border: 0; border-radius: 9px; background: transparent; color: var(--classical-muted); font: inherit; font-size: .82rem; font-weight: 800; cursor: pointer; }
  .page-tab[aria-selected='true'] { background: var(--classical-accent); color: #fff; }
  .page-tab:focus-visible, .insight-tab:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid rgba(64, 92, 245, .42); outline-offset: 2px; }

  .page-panel { max-width: 1780px; margin: 0 auto; }
  .panel-heading { max-width: 1160px; margin: 0 auto 14px; text-align: center; }
  .panel-heading h2 { margin: 0 0 5px; color: var(--classical-ink); font-size: 1.35rem; }
  .panel-heading p { margin: 0; color: var(--classical-muted); font-size: .84rem; line-height: 1.5; }

  .overview-layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .8fr); gap: 14px; max-width: 1160px; margin: 0 auto; align-items: start; }
  .overview-card { min-width: 0; padding: 17px; border: 1px solid rgba(229, 232, 239, .96); border-radius: 15px; background: rgba(255, 255, 255, .92); box-shadow: 0 9px 24px rgba(15, 23, 42, .07); }
  .overview-card-header { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 13px; }
  .overview-card-header h3 { margin: 0; color: var(--classical-ink); font-size: 1rem; }
  .overview-card-header p { margin: 3px 0 0; color: var(--classical-muted); font-size: .72rem; line-height: 1.4; }
  .insight-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .insight-tab { min-height: 32px; padding: 6px 9px; border: 0; border-radius: 8px; background: #f1f3f7; color: var(--classical-muted); font: inherit; font-size: .69rem; font-weight: 800; cursor: pointer; }
  .insight-tab[aria-selected='true'] { background: var(--classical-accent-soft); color: #314bd8; }
  .chart-list { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
  .chart-row { display: grid; grid-template-columns: minmax(145px, 180px) minmax(0, 1fr) auto; gap: 9px; align-items: center; }
  .chart-name { color: #323946; font-size: .72rem; font-weight: 700; line-height: 1.25; }
  .bar-track { display: block; height: 9px; overflow: hidden; border-radius: 999px; background: #edf0f5; }
  .bar-fill { display: block; width: var(--bar-width); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #405cf5, #7284ff); }
  .works-width { display: block; width: var(--bar-width); height: 100%; overflow: hidden; border-radius: inherit; background: var(--classical-heard); }
  .favorite-fill { display: block; width: var(--favorite-width); height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--classical-gorgeous), var(--classical-amazing)); }
  .rate-fill { display: block; width: var(--bar-width); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #9c55cd, #d44f86); }
  .chart-value { color: var(--classical-muted); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .recent-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .recent-item { padding: 10px 11px; border: 1px solid #eceef4; border-radius: 10px; background: #fff; }
  .recent-item strong { display: block; color: var(--classical-ink); font-size: .78rem; line-height: 1.35; }
  .recent-item span { display: block; margin-top: 3px; color: var(--classical-muted); font-size: .68rem; line-height: 1.35; }
  .recent-item a { color: inherit; text-decoration: none; }
  .recent-item a:hover strong { color: #314bd8; }

  .toolbar { display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; max-width: 1160px; margin: 0 auto 10px; }
  .toolbar input, .toolbar select, .control-button { min-height: 42px; padding: 10px 12px; border: 1px solid var(--classical-border); border-radius: 12px; background: #fff; color: var(--classical-ink); font: inherit; font-size: .83rem; box-shadow: 0 1px 2px rgba(0, 0, 0, .03); }
  .toolbar input { width: min(320px, 100%); }
  .toolbar select { min-width: 145px; }
  .control-button { font-weight: 800; cursor: pointer; }
  .control-button.primary { border-color: var(--classical-accent); background: var(--classical-accent); color: #fff; }
  .control-button.primary:hover { background: #354edb; }
  .control-button:disabled { cursor: not-allowed; opacity: .55; }
  .lucky-status { min-height: 18px; margin: 0 auto 3px; color: var(--classical-muted); font-size: .72rem; }
  .results-row { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 28px; margin-bottom: 15px; color: var(--classical-muted); font-size: .8rem; }
  .results-row p { margin: 0; }
  .clear-filters { border: 0; background: transparent; color: #314bd8; font: inherit; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

