  .composer-detail { display: flex; min-height: 0; flex-direction: column; background: #fff; }
  .detail-header { display: flex; justify-content: space-between; gap: 18px; align-items: flex-start; padding: 20px 24px 16px; border-bottom: 1px solid var(--classical-border); background: #fff; }
  .detail-header h2 { margin: 0 0 5px; font-size: 1.5rem; }
