  .detail-tab { flex: 0 0 auto; min-height: 38px; padding: 8px 13px; border: 0; border-radius: 10px; background: transparent; color: var(--classical-muted); font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer; }
  .detail-tab[aria-selected='true'] { background: var(--classical-accent-soft); color: #314bd8; }
  .detail-panel-wrap { min-height: 0; flex: 1; overflow: auto; overscroll-behavior: contain; padding: 20px 24px 28px; }
  .detail-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-bottom: 18px; }
  .detail-summary div { min-width: 0; padding: 11px; border-radius: 11px; background: #f4f5f9; }
  .detail-summary strong, .detail-summary span { display: block; }
  .detail-summary strong { font-size: .92rem; line-height: 1.2; }
  .detail-summary span { margin-top: 3px; color: var(--classical-muted); font-size: .66rem; line-height: 1.25; }
  .overview-note { margin: 0; padding: 15px 16px; border: 1px solid #e8eafd; border-radius: 12px; background: #f8f8ff; color: #41495a; font-size: .84rem; line-height: 1.55; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 10px; }
  .section-heading h3 { margin: 0; font-size: 1.05rem; }
  .section-heading p { margin: 0; color: var(--classical-muted); font-size: .72rem; }
  .browser-toolbar { position: sticky; top: -20px; z-index: 4; display: grid; grid-template-columns: minmax(220px, 1fr) 180px 180px; gap: 8px; margin: -20px -24px 11px; padding: 14px 24px 10px; border-bottom: 1px solid rgba(229, 232, 239, .9); background: rgba(255, 255, 255, .96); backdrop-filter: blur(10px); }
  .browser-toolbar.two-controls { grid-template-columns: minmax(220px, 1fr) 180px; }
  .browser-toolbar input, .browser-toolbar select { min-height: 40px; padding: 8px 10px; border: 1px solid var(--classical-border); border-radius: 10px; background: #fff; color: var(--classical-ink); font: inherit; font-size: .76rem; }

  @media (max-width: 1080px) {
    .overall-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .overview-layout { grid-template-columns: 1fr; }
    .works-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .works-toolbar input { grid-column: 1 / -1; }
    .detail-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .wrap { padding: 18px 10px 38px; }
    h1 { font-size: 2rem; }
    .composer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; }
    .card-body { min-height: 142px; padding: 10px; }
    .composer-name { font-size: .88rem; }
    .composer-meta { font-size: .69rem; }
    .stat { padding: 6px; }
    .stat strong { font-size: .72rem; }
    .stat span { font-size: .57rem; }
    .browser-toolbar { grid-template-columns: 1fr 1fr; }
    .browser-toolbar input { grid-column: 1 / -1; }
