</style>

<VideoBg>
  <Header />
  <main class="wrap">
    <MusicNav active="composers" />

    <div class="intro">
      <h1>🎼 Classical Music</h1>
      <p class="hint">
        A personal archive of the composers, works, and performances I have explored since
        {globalBounds.first ? ` ${formatListeningDate(globalBounds.first)}` : ' November 2024'}.
      </p>
      {hasListeningFeed && generatedLabel ? <p class="updated-note">Last updated {generatedLabel}.</p> : null}

      {!CLASSICAL_LISTENING_DATA_URL ? (
        <p class="feed-notice">
          <strong>Composer portraits are connected.</strong> Add <code>CLASSICAL_LISTENING_DATA_URL</code>
          to connect the listening archive.
        </p>
      ) : sheetError ? (
        <p class="feed-notice">
          <strong>The composer gallery loaded, but the listening feed did not.</strong> {sheetError}
        </p>
      ) : null}

      {hasListeningFeed ? (
        <section class="overall-stats" aria-label="Classical listening totals">
          <div class="overall-stat"><strong>{totalEntries.toLocaleString('en-US')}</strong><span>listening entries</span></div>
          <div class="overall-stat"><strong>{allWorks.length.toLocaleString('en-US')}</strong><span>unique works</span></div>
          <div class="overall-stat"><strong>{formatListeningHours(totalMinutes)}</strong><span>listening time</span></div>
          <div class="overall-stat"><strong>{totalComposersLogged.toLocaleString('en-US')}</strong><span>composers explored</span></div>
          <div class="overall-stat"><strong>{favoriteWorks.length.toLocaleString('en-US')}</strong><span>favorite works</span></div>
          <div class="overall-stat"><strong>{exploredPeriods.length.toLocaleString('en-US')}</strong><span>periods represented</span></div>
        </section>
      ) : null}

      <div class="page-tabs" role="tablist" aria-label="Classical music views">
        <button type="button" class="page-tab" role="tab" data-page-tab="overview" aria-selected="false">Overview</button>
        <button type="button" class="page-tab" role="tab" data-page-tab="composers" aria-selected="true">Composers</button>
        <button type="button" class="page-tab" role="tab" data-page-tab="works" aria-selected="false">Works</button>
      </div>
    </div>

    <section class="page-panel" data-page-panel="overview" role="tabpanel" hidden>
      <div class="panel-heading">
        <h2>Listening Overview</h2>
        <p>See where the archive has concentrated and what entered the log most recently.</p>
      </div>

      <div class="overview-layout">
        <article class="overview-card">
          <div class="overview-card-header">
            <div>
              <h3>Composer Insights</h3>
              <p>Compare time, favorite counts, and favorite rates.</p>
            </div>
            <div class="insight-tabs" role="tablist" aria-label="Composer insight chart">
              <button type="button" class="insight-tab" data-insight-tab="time" aria-selected="true">Time</button>
              <button type="button" class="insight-tab" data-insight-tab="favorites" aria-selected="false">Favorites</button>
              <button type="button" class="insight-tab" data-insight-tab="rate" aria-selected="false">Favorite rate</button>
            </div>
          </div>

          <div data-insight-panel="time">
            <ol class="chart-list">
              {topHours.map((composer) => (
                <li class="chart-row">
                  <span class="chart-name">{composer.name}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span class="bar-fill" style={`--bar-width:${Math.max(2, (composer.totalMinutes / maxChartMinutes) * 100)}%`}></span>
                  </span>
                  <span class="chart-value">{formatListeningHours(composer.totalMinutes)}</span>
                </li>
              ))}
            </ol>
          </div>

          <div data-insight-panel="favorites" hidden>
            <ol class="chart-list">
              {topFavorites.map((composer) => (
                <li class="chart-row">
                  <span class="chart-name">{composer.name}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span class="works-width" style={`--bar-width:${Math.max(2, (composer.works.length / maxFavoriteWorks) * 100)}%`}>
                      <span class="favorite-fill" style={`--favorite-width:${composer.favoriteRate}%`}></span>
                    </span>
                  </span>
                  <span class="chart-value">{composer.favorites.length.toLocaleString('en-US')} / {composer.works.length.toLocaleString('en-US')}</span>
                </li>
              ))}
            </ol>
          </div>

          <div data-insight-panel="rate" hidden>
            <ol class="chart-list">
              {topFavoriteRates.map((composer) => (
                <li class="chart-row">
                  <span class="chart-name">{composer.name}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span class="rate-fill" style={`--bar-width:${composer.favoriteRate}%`}></span>
                  </span>
                  <span class="chart-value">{composer.favoriteRate.toFixed(0)}% · {composer.works.length.toLocaleString('en-US')} works</span>
                </li>
              ))}
            </ol>
          </div>
        </article>

        <article class="overview-card">
          <div class="overview-card-header">
            <div>
              <h3>Recently Heard</h3>
              <p>The latest dated entries in the listening log.</p>
            </div>
          </div>
          {recentEntries.length ? (
            <ol class="recent-list">
              {recentEntries.map((entry) => (
                <li class="recent-item">
                  {entry.youtubeUrl ? (
                    <a href={entry.youtubeUrl} target="_blank" rel="noopener noreferrer">
                      <strong>{entry.displayComposer} · {entry.piece}</strong>
                      <span>{entry.date ? formatListeningDate(entry.date) : entry.dateRaw} · {ratingLabel(entry.ratingBucket, entry.rating)}</span>
                    </a>
                  ) : (
                    <>
                      <strong>{entry.displayComposer} · {entry.piece}</strong>
                      <span>{entry.date ? formatListeningDate(entry.date) : entry.dateRaw} · {ratingLabel(entry.ratingBucket, entry.rating)}</span>
                    </>
                  )}
                </li>
              ))}
            </ol>
          ) : <p class="empty-detail">No dated listening entries are available.</p>}
        </article>
      </div>
    </section>

    <section class="page-panel" data-page-panel="composers" role="tabpanel">
      <div class="panel-heading">
        <h2>Composer Library</h2>
        <p>Every explored composer is included, even when a portrait profile has not been added yet.</p>
      </div>

      <div class="toolbar">
        <input id="composer-search" type="search" placeholder="Search composer, country, period, or form…" aria-label="Search composers" />
        <select id="period-filter" aria-label="Filter composers by period">
          <option value="">All periods</option>
          {periodsInUse.map((period) => <option value={period}>{period}</option>)}
        </select>
        <select id="status-filter" aria-label="Filter composers by listening status">
          <option value="">All composers</option>
          <option value="heard">Explored</option>
          <option value="unheard">To explore</option>
          <option value="favorites">Has favorites</option>
        </select>
        <select id="composer-sort" aria-label="Sort composers">
          <option value="name-asc">Composer A–Z</option>
          <option value="status-desc">Explored first</option>
          <option value="unique-desc">Most works heard</option>
          <option value="hours-desc">Most listening time</option>
          <option value="favorites-desc">Most favorites</option>
          <option value="rate-desc">Highest favorite rate</option>
          <option value="recent-desc">Most recently heard</option>
        </select>
        <button type="button" id="random-favorite" class="control-button primary" disabled={!luckyPool.length}>🎲 Random Favorite</button>
      </div>

      <p id="lucky-status" class="lucky-status" aria-live="polite"></p>
      <div class="results-row">
        <p id="composer-results" aria-live="polite">
          Showing {composers.length.toLocaleString('en-US')} composers · {totalComposersLogged.toLocaleString('en-US')} explored
        </p>
        <button type="button" id="clear-composer-filters" class="clear-filters" hidden>Clear filters</button>
      </div>

      {composers.length === 0 ? (
        <p class="empty">Composer data is temporarily unavailable.</p>
      ) : (
        <div id="composer-grid" class="composer-grid" role="list">
          {composers.map((composer) => {
            const life = formatLife(composer);
            const identity = [life, composer.nationality, composer.period].filter(Boolean).join(' · ');
            const status = composer.entries.length ? 'heard' : 'unheard';
            const searchText = normalizeText(
              `${composer.name} ${composer.nationality} ${composer.period} ${composer.note} ${composer.topForm} ${composer.entries.map((entry) => entry.form).join(' ')}`,
            );

            return (
              <article
                class="composer-card"
                role="listitem"
                data-composer-id={composer.id}
                data-name={composer.name}
                data-search={searchText}
                data-period={composer.period}
                data-status={status}
                data-entries={composer.entries.length}
                data-unique={composer.works.length}
                data-minutes={composer.totalMinutes}
                data-favorites={composer.favorites.length}
                data-rate={composer.favoriteRate}
                data-last-listened={composer.lastListened?.getTime() || 0}
                data-original-index={composer.originalIndex}
              >
                <button
                  type="button"
                  class="composer-button"
                  aria-expanded="false"
                  aria-haspopup="dialog"
                  aria-controls="composer-dialog"
                  data-composer-trigger={composer.id}
                >
                  <span class="portrait-wrap">
                    {composer.profiled ? (
                      <img
                        class="portrait"
                        src={composer.cover}
                        alt={`Portrait of ${composer.name}`}
                        loading="lazy"
                        decoding="async"
                        sizes="(max-width: 520px) 124px, (max-width: 900px) 50vw, 250px"
                      />
                    ) : (
                      <span class="portrait-fallback" aria-hidden="true">{composer.initials}</span>
                    )}
                    {!composer.profiled ? <span class="profile-badge">Profile pending</span> : null}
                    <span class="expand-cue" aria-hidden="true">View <span>›</span></span>
                  </span>

                  <span class="card-body">
                    <span class="composer-name">{composer.name}</span>
                    <span class="composer-meta">{identity || composer.note || 'Composer profile'}</span>
                    {hasListeningFeed && composer.entries.length ? (
                      <span class="composer-stats">
                        <span class="stat"><strong>{composer.works.length.toLocaleString('en-US')}</strong><span>works</span></span>
                        <span class="stat"><strong>{formatListeningHours(composer.totalMinutes)}</strong><span>time</span></span>
                        <span class="stat"><strong>{composer.favorites.length.toLocaleString('en-US')}</strong><span>favorites</span></span>
                      </span>
                    ) : (
                      <span class="unheard-note">Not yet explored</span>
                    )}
                  </span>
                </button>

                <template id={`composer-template-${composer.id}`}>
                  <article class="composer-detail" data-composer-detail>
                    <header class="detail-header">
                      <div>
                        <h2 id={`composer-dialog-title-${composer.id}`}>{composer.name}</h2>
                        <p class="detail-subtitle">
                          {[identity, composer.topForm ? `Most explored form: ${composer.topForm}` : '']
                            .filter(Boolean)
                            .join(' · ') || 'Composer listening profile'}
                        </p>
                      </div>
                      <div class="detail-actions">
                        {composer.href ? <a class="reference-link" href={composer.href} target="_blank" rel="noopener noreferrer">Reference ↗</a> : null}
                        <button type="button" class="close-detail" data-close-composer>Close</button>
                      </div>
                    </header>

                    {composer.entries.length ? (
                      <>
                        <div class="detail-tabs" role="tablist" aria-label={`${composer.name} listening sections`}>
                          <button type="button" class="detail-tab" role="tab" aria-selected="true" data-detail-tab="overview">Overview</button>
                          <button type="button" class="detail-tab" role="tab" aria-selected="false" tabindex="-1" data-detail-tab="favorites">Favorites ({composer.favorites.length.toLocaleString('en-US')})</button>
                          <button type="button" class="detail-tab" role="tab" aria-selected="false" tabindex="-1" data-detail-tab="history">Listening History ({composer.entries.length.toLocaleString('en-US')})</button>
                        </div>

                        <div class="detail-panel-wrap">
                          <section class="detail-panel" role="tabpanel" data-detail-panel="overview">
                            <div class="detail-summary">
                              <div><strong>{composer.entries.length.toLocaleString('en-US')}</strong><span>listening entries</span></div>
                              <div><strong>{composer.works.length.toLocaleString('en-US')}</strong><span>unique works</span></div>
                              <div><strong>{formatListeningHours(composer.totalMinutes)}</strong><span>listening time</span></div>
                              <div><strong>{composer.favorites.length.toLocaleString('en-US')}</strong><span>favorites ({composer.favoriteRate.toFixed(0)}%)</span></div>
                              <div><strong>{composer.firstListened ? formatListeningDate(composer.firstListened) : '—'}</strong><span>first heard</span></div>
                              <div><strong>{composer.lastListened ? formatListeningDate(composer.lastListened) : '—'}</strong><span>last heard</span></div>
                            </div>
                            <p class="overview-note">
                              {composer.favorites.length.toLocaleString('en-US')} of {composer.works.length.toLocaleString('en-US')} unique works are marked Amazing or Gorgeous.
                              {composer.repeatCount ? ` The archive also contains ${composer.repeatCount.toLocaleString('en-US')} repeat listening entr${composer.repeatCount === 1 ? 'y' : 'ies'}.` : ''}
                              {composer.topForm ? ` The most explored form is ${composer.topForm}.` : ''}
                            </p>
                          </section>

                          <section class="detail-panel" role="tabpanel" data-detail-panel="favorites" hidden>
                            <div class="section-heading">
                              <h3>Favorite Works</h3>
                              <p>{composer.favorites.length.toLocaleString('en-US')} of {composer.works.length.toLocaleString('en-US')} unique works</p>
                            </div>
                            {composer.favorites.length ? (
                              <div data-list-browser data-page-desktop="18" data-page-mobile="8" data-item-label="works">
                                <div class="browser-toolbar two-controls">
                                  <input type="search" placeholder="Search favorite works…" aria-label={`Search ${composer.name} favorite works`} data-list-search />
                                  <select aria-label="Sort favorite works" data-list-sort>
                                    <option value="latest">Latest heard</option>
                                    <option value="earliest">Earliest heard</option>
                                    <option value="title">Title A–Z</option>
                                    <option value="longest">Longest first</option>
                                  </select>
                                </div>
                                <p class="entry-results" data-list-results></p>
                                <ul class="entry-list" data-list>
                                  {composer.favorites.map((work) => (
                                    <li
                                      class="entry-item"
                                      data-list-item
                                      data-search={normalizeText(`${work.piece} ${work.form} ${work.compositionYear} ${work.period} ${ratingLabel(work.ratingBucket, work.rating)}`)}
                                      data-rating={work.ratingBucket}
                                      data-date={work.date?.getTime() || 0}
                                      data-minutes={work.minutes}
                                      data-title={normalizeText(work.piece)}
                                      data-row={work.rowNumber}
                                    >
                                      {work.youtubeUrl ? <a class="play-link" href={work.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${work.piece} on YouTube`}>▶</a> : <span class="play-missing">—</span>}
                                      <span class="entry-main">
                                        <span class="entry-title">{work.piece}</span>
                                        <span class="entry-meta">
                                          <span class={`rating ${work.ratingBucket}`}>{ratingLabel(work.ratingBucket, work.rating)}</span>
                                          {[work.form, work.period, work.compositionYear].filter(Boolean).join(' · ') || 'Metadata not logged'}
                                          {work.listenCount > 1 ? ` · ${work.listenCount} listens` : ''}
                                        </span>
                                      </span>
                                      <span class="entry-side">
                                        <time datetime={work.date?.toISOString().slice(0, 10) || undefined}>{work.date ? formatListeningDate(work.date) : work.dateRaw}</time>
                                        <span>{formatCompactDuration(work.minutes)}</span>
                                      </span>
                                    </li>
                                  ))}
                                </ul>
                                <p class="empty-detail" data-list-empty hidden>No favorite works match this search.</p>
                                <button type="button" class="show-more" data-list-more hidden>Show more</button>
                              </div>
                            ) : <p class="empty-detail">No works by this composer are currently marked Amazing or Gorgeous.</p>}
                          </section>

                          <section class="detail-panel" role="tabpanel" data-detail-panel="history" hidden>
                            <div class="section-heading">
                              <h3>Listening History</h3>
                              <p>{composer.linkedCount.toLocaleString('en-US')} of {composer.entries.length.toLocaleString('en-US')} entries include a performance link</p>
                            </div>
                            <div data-list-browser data-page-desktop="24" data-page-mobile="12" data-item-label="entries">
                              <div class="browser-toolbar">
                                <input type="search" placeholder="Search title, form, year, or rating…" aria-label={`Search ${composer.name} listening entries`} data-list-search />
                                <select aria-label="Filter listening entries" data-list-rating>
                                  <option value="all">All ratings</option>
                                  <option value="amazing">Amazing</option>
                                  <option value="gorgeous">Gorgeous</option>
                                  <option value="other">Other</option>
                                </select>
                                <select aria-label="Sort listening entries" data-list-sort>
                                  <option value="latest">Latest heard</option>
                                  <option value="earliest">Earliest heard</option>
                                  <option value="title">Title A–Z</option>
                                  <option value="longest">Longest first</option>
                                </select>
                              </div>
                              <p class="entry-results" data-list-results></p>
                              <ul class="entry-list" data-list>
                                {composer.entries.map((entry) => (
                                  <li
                                    class="entry-item"
                                    data-list-item
                                    data-search={normalizeText(`${entry.piece} ${entry.form} ${entry.compositionYear} ${ratingLabel(entry.ratingBucket, entry.rating)} ${entry.period}`)}
                                    data-rating={entry.ratingBucket}
                                    data-date={entry.date?.getTime() || 0}
                                    data-minutes={entry.minutes}
                                    data-title={normalizeText(entry.piece)}
                                    data-row={entry.rowNumber}
                                  >
                                    {entry.youtubeUrl ? <a class="play-link" href={entry.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${entry.piece} on YouTube`}>▶</a> : <span class="play-missing">—</span>}
                                    <span class="entry-main">
                                      <span class="entry-title">{entry.piece}</span>
                                      <span class="entry-meta">
                                        <span class={`rating ${entry.ratingBucket}`}>{ratingLabel(entry.ratingBucket, entry.rating)}</span>
                                        {[entry.form, entry.period, entry.compositionYear].filter(Boolean).join(' · ') || 'Metadata not logged'}
                                      </span>
                                    </span>
                                    <span class="entry-side">
                                      <time datetime={entry.date?.toISOString().slice(0, 10) || undefined}>{entry.date ? formatListeningDate(entry.date) : entry.dateRaw}</time>
                                      <span>{formatCompactDuration(entry.minutes)}</span>
                                    </span>
                                  </li>
                                ))}
                              </ul>
                              <p class="empty-detail" data-list-empty hidden>No entries match these filters.</p>
                              <button type="button" class="show-more" data-list-more hidden>Show more</button>
                            </div>
                          </section>
                        </div>
                      </>
                    ) : (
                      <div class="detail-panel-wrap">
                        <p class="empty-detail">This composer has a profile in the library but no dated listening entries yet.</p>
                      </div>
                    )}
                  </article>
                </template>
              </article>
            );
          })}
        </div>
      )}
    </section>

    <section class="page-panel" data-page-panel="works" role="tabpanel" hidden>
      <div class="panel-heading">
        <h2>Works Explorer</h2>
        <p>Search the complete archive across composers, forms, periods, ratings, and composition years.</p>
      </div>

      <div id="works-browser" class="works-browser" data-page-size="40">
        <div class="works-toolbar">
          <input id="works-search" type="search" placeholder="Search work, composer, form, period, or year…" aria-label="Search classical works" />
          <select id="works-composer-filter" aria-label="Filter works by composer">
            <option value="">All composers</option>
            {workComposers.map((composer) => <option value={composer.id}>{composer.name}</option>)}
          </select>
          <select id="works-period-filter" aria-label="Filter works by period">
            <option value="">All periods</option>
            {workPeriods.map((period) => <option value={period}>{period}</option>)}
          </select>
          <select id="works-form-filter" aria-label="Filter works by form">
            <option value="">All forms</option>
            {workForms.map((form) => <option value={form}>{form}</option>)}
          </select>
          <select id="works-rating-filter" aria-label="Filter works by rating">
            <option value="">All ratings</option>
            <option value="amazing">Amazing</option>
            <option value="gorgeous">Gorgeous</option>
            <option value="other">Other</option>
          </select>
          <select id="works-sort" aria-label="Sort works">
            <option value="latest">Recently heard</option>
            <option value="composer">Composer A–Z</option>
            <option value="title">Work A–Z</option>
            <option value="longest">Longest first</option>
            <option value="most-listened">Most listened</option>
          </select>
        </div>

        <div class="results-row">
          <p id="works-results">Showing {Math.min(40, allWorks.length).toLocaleString('en-US')} of {allWorks.length.toLocaleString('en-US')} works</p>
          <button type="button" id="clear-work-filters" class="clear-filters" hidden>Clear filters</button>
        </div>

        <ul id="work-list" class="work-list">
          {allWorks.map((work) => (
            <li
              class="work-item"
              data-work-item
              data-search={normalizeText(`${work.piece} ${work.displayComposer} ${work.form} ${work.period} ${work.compositionYear} ${ratingLabel(work.ratingBucket, work.rating)}`)}
              data-composer={work.resolvedComposerId}
              data-composer-name={normalizeText(work.displayComposer)}
              data-period={work.period}
              data-form={work.form}
              data-rating={work.ratingBucket}
              data-date={work.date?.getTime() || 0}
              data-minutes={work.minutes}
              data-listens={work.listenCount}
              data-title={normalizeText(work.piece)}
              data-row={work.rowNumber}
            >
              {work.youtubeUrl ? <a class="play-link" href={work.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${work.piece} on YouTube`}>▶</a> : <span class="play-missing">—</span>}
              <span class="entry-main">
                <span class="entry-composer">{work.displayComposer}</span>
                <span class="entry-title">{work.piece}</span>
                <span class="entry-meta">
                  <span class={`rating ${work.ratingBucket}`}>{ratingLabel(work.ratingBucket, work.rating)}</span>
                  {[work.form, work.period, work.compositionYear].filter(Boolean).join(' · ') || 'Metadata not logged'}
                  {work.listenCount > 1 ? ` · ${work.listenCount} listens` : ''}
                </span>
              </span>
              <span class="entry-side">
                <time datetime={work.date?.toISOString().slice(0, 10) || undefined}>{work.date ? formatListeningDate(work.date) : work.dateRaw}</time>
                <span>{formatCompactDuration(work.minutes)}</span>
              </span>
            </li>
          ))}
        </ul>
        <p id="works-empty" class="empty-detail" hidden>No works match these filters.</p>
        <button type="button" id="works-more" class="show-more" hidden>Show more</button>
      </div>
    </section>

    <dialog id="composer-dialog" class="composer-dialog" aria-modal="true">
      <div id="composer-dialog-content" class="composer-dialog-content"></div>
    </dialog>

    <script id="composer-page-data" type="application/json" set:html={clientPageData}></script>
  </main>
  <Footer />
</VideoBg>

<script>
  (function () {
    const norm = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });

    const pageTabs = Array.from(document.querySelectorAll('[data-page-tab]'));
    const pagePanels = Array.from(document.querySelectorAll('[data-page-panel]'));

    function activatePage(name, updateUrl = true) {
      const valid = pagePanels.some((panel) => panel.dataset.pagePanel === name) ? name : 'composers';
      pageTabs.forEach((tab) => tab.setAttribute('aria-selected', tab.dataset.pageTab === valid ? 'true' : 'false'));
      pagePanels.forEach((panel) => { panel.hidden = panel.dataset.pagePanel !== valid; });

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (valid === 'composers') url.searchParams.delete('view');
        else url.searchParams.set('view', valid);
        history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
      }
    }

    pageTabs.forEach((tab) => tab.addEventListener('click', () => activatePage(tab.dataset.pageTab || 'composers')));
    activatePage(new URL(window.location.href).searchParams.get('view') || 'composers', false);

    const insightTabs = Array.from(document.querySelectorAll('[data-insight-tab]'));
    const insightPanels = Array.from(document.querySelectorAll('[data-insight-panel]'));
    insightTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const name = tab.dataset.insightTab;
        insightTabs.forEach((candidate) => candidate.setAttribute('aria-selected', candidate === tab ? 'true' : 'false'));
        insightPanels.forEach((panel) => { panel.hidden = panel.dataset.insightPanel !== name; });
      });
    });

    const grid = document.querySelector('#composer-grid');
    const search = document.querySelector('#composer-search');
    const period = document.querySelector('#period-filter');
    const status = document.querySelector('#status-filter');
    const sort = document.querySelector('#composer-sort');
    const results = document.querySelector('#composer-results');
    const clear = document.querySelector('#clear-composer-filters');
    const luckyButton = document.querySelector('#random-favorite');
    const luckyStatus = document.querySelector('#lucky-status');
    const dialog = document.querySelector('#composer-dialog');
    const dialogContent = document.querySelector('#composer-dialog-content');
    const cards = grid ? Array.from(grid.querySelectorAll('.composer-card')) : [];
    let activeButton = null;
    let suppressFocusRestore = false;

    function parsePageData() {
      try { return JSON.parse(document.querySelector('#composer-page-data')?.textContent || '{}'); }
      catch { return { luckyPool: [] }; }
    }
    const pageData = parsePageData();

    function updateComposerHash(id) {
      const url = new URL(window.location.href);
      url.hash = id ? `composer-${id}` : '';
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function resetDialogState({ preserveHash = false } = {}) {
      cards.forEach((card) => card.querySelector('[data-composer-trigger]')?.setAttribute('aria-expanded', 'false'));
      if (dialogContent) dialogContent.replaceChildren();
      const buttonToRestore = activeButton;
      activeButton = null;
      if (!preserveHash) updateComposerHash('');
      if (!suppressFocusRestore) buttonToRestore?.focus();
      suppressFocusRestore = false;
    }

    function closeDialog(options = {}) {
      const { preserveHash = false, restoreFocus = true } = options;
      suppressFocusRestore = !restoreFocus;
      if (dialog?.open) {
        dialog.dataset.preserveHash = preserveHash ? 'true' : 'false';
        dialog.close();
      } else resetDialogState({ preserveHash });
    }

    function setupTabs(detail) {
      const tabs = Array.from(detail.querySelectorAll('[data-detail-tab]'));
      const panels = Array.from(detail.querySelectorAll('[data-detail-panel]'));
      if (!tabs.length) return;

      function activate(name, focus = false) {
        tabs.forEach((tab) => {
          const selected = tab.dataset.detailTab === name;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.detailPanel !== name; });
        detail.querySelector('.detail-panel-wrap')?.scrollTo({ top: 0, behavior: 'auto' });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.detailTab || 'overview'));
        tab.addEventListener('keydown', (event) => {
          let nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[nextIndex].dataset.detailTab || 'overview', true);
        });
      });
    }

    function setupListBrowser(browser) {
      const listSearch = browser.querySelector('[data-list-search]');
      const ratingFilter = browser.querySelector('[data-list-rating]');
      const listSort = browser.querySelector('[data-list-sort]');
      const list = browser.querySelector('[data-list]');
      const resultText = browser.querySelector('[data-list-results]');
      const empty = browser.querySelector('[data-list-empty]');
      const more = browser.querySelector('[data-list-more]');
      const items = Array.from(browser.querySelectorAll('[data-list-item]'));
      const mobile = window.matchMedia('(max-width: 620px)').matches;
      const pageSize = Number(mobile ? browser.dataset.pageMobile : browser.dataset.pageDesktop) || (mobile ? 10 : 24);
      const itemLabel = browser.dataset.itemLabel || 'works';
      let visibleLimit = pageSize;
      if (!list || !items.length) return;

      function applyItems() {
        const words = norm(listSearch?.value).split(/\s+/).filter(Boolean);
        const selectedRating = ratingFilter?.value || 'all';
        const mode = listSort?.value || 'latest';
        const filtered = items.filter((item) => {
          const searchMatches = !words.length || words.every((word) => (item.dataset.search || '').includes(word));
          const ratingMatches = selectedRating === 'all' || item.dataset.rating === selectedRating;
          return searchMatches && ratingMatches;
        });

        filtered.sort((a, b) => {
          let comparison = 0;
          if (mode === 'earliest') comparison = Number(a.dataset.date || 0) - Number(b.dataset.date || 0);
          else if (mode === 'title') comparison = collator.compare(a.dataset.title || '', b.dataset.title || '');
          else if (mode === 'longest') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
          else comparison = Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
          return comparison || Number(b.dataset.row || 0) - Number(a.dataset.row || 0);
        });

        items.forEach((item) => { item.hidden = true; });
        filtered.forEach((item, index) => {
          list.appendChild(item);
          item.hidden = index >= visibleLimit;
        });
        if (resultText) {
          const shown = Math.min(filtered.length, visibleLimit);
          resultText.textContent = filtered.length
            ? `Showing ${shown.toLocaleString()} of ${filtered.length.toLocaleString()} matching ${itemLabel}`
            : `No matching ${itemLabel}`;
        }
        if (empty) empty.hidden = filtered.length > 0;
        if (more) more.hidden = filtered.length <= visibleLimit;
      }

      listSearch?.addEventListener('input', () => { visibleLimit = pageSize; applyItems(); });
      ratingFilter?.addEventListener('change', () => { visibleLimit = pageSize; applyItems(); });
      listSort?.addEventListener('change', applyItems);
      more?.addEventListener('click', () => { visibleLimit += pageSize; applyItems(); });
      applyItems();
    }

    function openDetail(card, options = {}) {
      const { updateUrl = true, focusClose = true } = options;
      const button = card.querySelector('[data-composer-trigger]');
      const id = button?.dataset.composerTrigger;
      if (!button || !id || !dialog || !dialogContent) return;
      const template = document.querySelector(`#composer-template-${CSS.escape(id)}`);
      if (!template) return;

      if (dialog.open) closeDialog({ preserveHash: true, restoreFocus: false });
      dialogContent.replaceChildren(template.content.cloneNode(true));
      activeButton = button;
      button.setAttribute('aria-expanded', 'true');
      const detail = dialogContent.querySelector('[data-composer-detail]');
      if (!detail) return;
      dialog.setAttribute('aria-labelledby', `composer-dialog-title-${id}`);
      setupTabs(detail);
      detail.querySelectorAll('[data-list-browser]').forEach(setupListBrowser);
      detail.querySelector('[data-close-composer]')?.addEventListener('click', () => closeDialog());
      if (updateUrl) updateComposerHash(id);
      dialog.showModal();
      if (focusClose) requestAnimationFrame(() => detail.querySelector('[data-close-composer]')?.focus());
    }

    cards.forEach((card) => card.querySelector('[data-composer-trigger]')?.addEventListener('click', () => openDetail(card)));
    dialog?.addEventListener('close', () => {
      const preserveHash = dialog.dataset.preserveHash === 'true';
      delete dialog.dataset.preserveHash;
      resetDialogState({ preserveHash });
    });
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });

    function sortCards() {
      if (!grid) return;
      const mode = sort?.value || 'name-asc';
      const ordered = [...cards].sort((a, b) => {
        let comparison = 0;
        if (mode === 'status-desc') comparison = Number(b.dataset.entries || 0) - Number(a.dataset.entries || 0);
        else if (mode === 'unique-desc') comparison = Number(b.dataset.unique || 0) - Number(a.dataset.unique || 0);
        else if (mode === 'hours-desc') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
        else if (mode === 'favorites-desc') comparison = Number(b.dataset.favorites || 0) - Number(a.dataset.favorites || 0);
        else if (mode === 'rate-desc') comparison = Number(b.dataset.rate || 0) - Number(a.dataset.rate || 0);
        else if (mode === 'recent-desc') comparison = Number(b.dataset.lastListened || 0) - Number(a.dataset.lastListened || 0);
        else comparison = collator.compare(a.dataset.name || '', b.dataset.name || '');
        return comparison || collator.compare(a.dataset.name || '', b.dataset.name || '') || Number(a.dataset.originalIndex || 0) - Number(b.dataset.originalIndex || 0);
      });
      ordered.forEach((card) => grid.appendChild(card));
    }

    function filterCards() {
      const words = norm(search?.value).split(/\s+/).filter(Boolean);
      const selectedPeriod = period?.value || '';
      const selectedStatus = status?.value || '';
      let visible = 0;

      cards.forEach((card) => {
        const textMatches = !words.length || words.every((word) => (card.dataset.search || '').includes(word));
        const periodMatches = !selectedPeriod || card.dataset.period === selectedPeriod;
        const statusMatches = !selectedStatus ||
          (selectedStatus === 'favorites' ? Number(card.dataset.favorites || 0) > 0 : card.dataset.status === selectedStatus);
        const show = textMatches && periodMatches && statusMatches;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      if (results) results.textContent = `Showing ${visible.toLocaleString()} of ${cards.length.toLocaleString()} composers`;
      if (clear) clear.hidden = !(words.length || selectedPeriod || selectedStatus || (sort?.value || 'name-asc') !== 'name-asc');
    }

    search?.addEventListener('input', filterCards);
    period?.addEventListener('change', filterCards);
    status?.addEventListener('change', filterCards);
    sort?.addEventListener('change', () => { sortCards(); filterCards(); });
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      if (period) period.value = '';
      if (status) status.value = '';
      if (sort) sort.value = 'name-asc';
      sortCards();
      filterCards();
      search?.focus();
    });

    luckyButton?.addEventListener('click', () => {
      const pool = Array.isArray(pageData.luckyPool) ? pageData.luckyPool : [];
      if (!pool.length) return;
      let recent = [];
      try { recent = JSON.parse(localStorage.getItem('lifeloggerz-classical-lucky-recent') || '[]'); } catch {}
      const available = pool.filter((entry) => !recent.includes(entry.key));
      const candidates = available.length ? available : pool;
      const selected = candidates[Math.floor(Math.random() * candidates.length)];
      if (!selected) return;
      recent = [selected.key, ...recent.filter((key) => key !== selected.key)].slice(0, Math.min(25, pool.length));
      try { localStorage.setItem('lifeloggerz-classical-lucky-recent', JSON.stringify(recent)); } catch {}
      if (luckyStatus) luckyStatus.textContent = `${selected.composer} · ${selected.piece}`;
      window.open(selected.url, '_blank', 'noopener,noreferrer');
    });

    sortCards();
    filterCards();

    const hashId = decodeURIComponent(window.location.hash.replace(/^#composer-/, ''));
    if (hashId) {
      const card = cards.find((candidate) => candidate.dataset.composerId === hashId);
      if (card) {
        activatePage('composers', false);
        openDetail(card, { updateUrl: false, focusClose: false });
      }
    }

    const worksBrowser = document.querySelector('#works-browser');
    if (worksBrowser) {
      const workSearch = document.querySelector('#works-search');
      const composerFilter = document.querySelector('#works-composer-filter');
      const periodFilter = document.querySelector('#works-period-filter');
      const formFilter = document.querySelector('#works-form-filter');
      const ratingFilter = document.querySelector('#works-rating-filter');
      const workSort = document.querySelector('#works-sort');
      const workResults = document.querySelector('#works-results');
      const workClear = document.querySelector('#clear-work-filters');
      const workList = document.querySelector('#work-list');
      const workEmpty = document.querySelector('#works-empty');
      const workMore = document.querySelector('#works-more');
      const workItems = Array.from(document.querySelectorAll('[data-work-item]'));
      const pageSize = Number(worksBrowser.dataset.pageSize || 40);
      let visibleLimit = pageSize;

      function applyWorks() {
        const words = norm(workSearch?.value).split(/\s+/).filter(Boolean);
        const selectedComposer = composerFilter?.value || '';
        const selectedPeriod = periodFilter?.value || '';
        const selectedForm = formFilter?.value || '';
        const selectedRating = ratingFilter?.value || '';
        const mode = workSort?.value || 'latest';

        const filtered = workItems.filter((item) =>
          (!words.length || words.every((word) => (item.dataset.search || '').includes(word))) &&
          (!selectedComposer || item.dataset.composer === selectedComposer) &&
          (!selectedPeriod || item.dataset.period === selectedPeriod) &&
          (!selectedForm || item.dataset.form === selectedForm) &&
          (!selectedRating || item.dataset.rating === selectedRating)
        );

        filtered.sort((a, b) => {
          let comparison = 0;
          if (mode === 'composer') comparison = collator.compare(a.dataset.composerName || '', b.dataset.composerName || '') || collator.compare(a.dataset.title || '', b.dataset.title || '');
          else if (mode === 'title') comparison = collator.compare(a.dataset.title || '', b.dataset.title || '');
          else if (mode === 'longest') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
          else if (mode === 'most-listened') comparison = Number(b.dataset.listens || 0) - Number(a.dataset.listens || 0);
          else comparison = Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
          return comparison || Number(b.dataset.row || 0) - Number(a.dataset.row || 0);
        });

        workItems.forEach((item) => { item.hidden = true; });
        filtered.forEach((item, index) => {
          workList?.appendChild(item);
          item.hidden = index >= visibleLimit;
        });
        const shown = Math.min(filtered.length, visibleLimit);
        if (workResults) workResults.textContent = filtered.length
          ? `Showing ${shown.toLocaleString()} of ${filtered.length.toLocaleString()} works`
          : 'No matching works';
        if (workEmpty) workEmpty.hidden = filtered.length > 0;
        if (workMore) workMore.hidden = filtered.length <= visibleLimit;
        if (workClear) workClear.hidden = !(words.length || selectedComposer || selectedPeriod || selectedForm || selectedRating || mode !== 'latest');
      }

      [composerFilter, periodFilter, formFilter, ratingFilter].forEach((control) => control?.addEventListener('change', () => { visibleLimit = pageSize; applyWorks(); }));
      workSearch?.addEventListener('input', () => { visibleLimit = pageSize; applyWorks(); });
      workSort?.addEventListener('change', applyWorks);
      workMore?.addEventListener('click', () => { visibleLimit += pageSize; applyWorks(); });
      workClear?.addEventListener('click', () => {
        if (workSearch) workSearch.value = '';
        if (composerFilter) composerFilter.value = '';
        if (periodFilter) periodFilter.value = '';
        if (formFilter) formFilter.value = '';
        if (ratingFilter) ratingFilter.value = '';
        if (workSort) workSort.value = 'latest';
        visibleLimit = pageSize;
        applyWorks();
        workSearch?.focus();
      });
      applyWorks();
    }
  })();
</script>
