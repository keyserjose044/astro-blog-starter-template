  .profile-badge { position: absolute; left: 10px; top: 10px; padding: 5px 8px; border-radius: 999px; background: rgba(255, 255, 255, .88); color: #4f5868; font-size: .62rem; font-weight: 800; backdrop-filter: blur(5px); }
