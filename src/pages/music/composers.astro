---
// src/pages/music/composers.astro
// Raindrop supplies composer portraits/metadata. A build-time Google Apps Script
// JSON feed supplies the listening log, performance links, ratings, and statistics.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import MusicNav from '../../components/MusicNav.astro';
import { SITE_TITLE } from '../../consts';
import { fetchAllRaindrops } from '../../utils/raindrop';
import {
  formatListeningDate,
  formatListeningHours,
  normalizeText,
  parseClassicalListeningFeed,
  slugify,
  type ListeningEntry,
} from '../../utils/classicalListening';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_COMPOSERS_ID || '58399760';
const CLASSICAL_LISTENING_DATA_URL =
  import.meta.env.CLASSICAL_LISTENING_DATA_URL ||
  import.meta.env.CLASSICAL_LISTENING_CSV_URL;

const composersRaw = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'composers',
  placeholder: '/images_webp/album-placeholder.webp',
});

const PERIODS = [
  'Medieval',
  'Renaissance',
  'Baroque',
  'Galant',
  'Classical',
  'Romantic',
  'Late Romantic',
  'Impressionist',
  'Modern',
  'Contemporary',
];

const parseComposerMeta = (title: string, note?: string | null) => {
  const rawTitle = String(title || '').trim();
  const rawNote = String(note || '').trim();
  const combined = `${rawTitle} · ${rawNote}`;
  const lifespanMatch = combined.match(/\b(\d{3,4})\s*[–—-]\s*(\d{3,4}|present)\b/i);
  const cleanName = rawTitle
    .replace(/\s*[([]?\d{3,4}\s*[–—-]\s*(?:\d{3,4}|present)[)\]]?\s*/i, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const parts = rawNote
    .split(/\s*(?:·|•|\||\n)\s*/)
    .map((part) => part.trim())
    .filter(Boolean)
    .filter((part) => !/^\d{3,4}\s*[–—-]\s*(?:\d{3,4}|present)$/i.test(part));

  const period =
    PERIODS.find((candidate) => normalizeText(rawNote).includes(normalizeText(candidate))) || '';

  const nationality =
    parts.find(
      (part) =>
        !PERIODS.some((candidate) => normalizeText(part).includes(normalizeText(candidate))) &&
        !/\b(?:born|died|composer|music|biography)\b/i.test(part) &&
        part.length <= 45,
    ) || '';

  return {
    name: cleanName || rawTitle,
    id: slugify(cleanName || rawTitle),
    birthYear: lifespanMatch?.[1] || '',
    deathYear: lifespanMatch?.[2] || '',
    nationality,
    period,
    note: rawNote,
  };
};

const formatCompactDuration = (minutes: number) => {
  if (!minutes) return 'Length not logged';
  if (minutes < 90) return `${Math.round(minutes).toLocaleString('en-US')} min`;
  return formatListeningHours(minutes);
};

const formatGeneratedAt = (value: string) => {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'America/Chicago',
  }).format(date);
};

const formatCardDate = (date: Date | null) => {
  if (!date) return '—';
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: '2-digit',
    timeZone: 'UTC',
  }).format(date);
};

let listeningEntries: ListeningEntry[] = [];
let feedGeneratedAt = '';
let feedSourceSheet = '';
let feedRejectedRows = 0;
let sheetError = '';

if (CLASSICAL_LISTENING_DATA_URL) {
  try {
    const response = await fetch(CLASSICAL_LISTENING_DATA_URL, {
      headers: { Accept: 'application/json, text/csv;q=0.9, text/plain;q=0.8' },
    });
    if (!response.ok) throw new Error(`Listening feed returned ${response.status}`);

    const parsed = parseClassicalListeningFeed(
      await response.text(),
      response.headers.get('content-type') || '',
    );
    listeningEntries = parsed.entries;
    feedGeneratedAt = parsed.generatedAt;
    feedSourceSheet = parsed.sourceSheet;
    feedRejectedRows = parsed.rejectedRows;
  } catch (error) {
    sheetError = error instanceof Error ? error.message : String(error);
    console.warn('[Composers] Classical listening feed could not be loaded:', error);
  }
}

const composersBase = composersRaw.map((composer, originalIndex) => {
  const meta = parseComposerMeta(composer.title, composer.note);
  return {
    ...meta,
    cover: composer.cover,
    href: composer.href,
    originalIndex,
  };
});

const byExactName = new Map(composersBase.map((composer) => [normalizeText(composer.name), composer.id]));
const bySlug = new Map(composersBase.map((composer) => [composer.id, composer.id]));
const composerNameById = new Map(composersBase.map((composer) => [composer.id, composer.name]));
const surnameCandidates = new Map<string, string[]>();

composersBase.forEach((composer) => {
  const surname = normalizeText(composer.name).split(' ').filter(Boolean).at(-1) || '';
  if (!surname) return;
  surnameCandidates.set(surname, [...(surnameCandidates.get(surname) || []), composer.id]);
});

// Ambiguous abbreviations and recurring variants already present in the source sheet.
// The feed may later supply composer_id directly, which takes precedence over this map.
const COMPOSER_ALIASES: Record<string, string> = {
  bach: 'johann sebastian bach',
  'j s bach': 'johann sebastian bach',
  'js bach': 'johann sebastian bach',
  'c p e bach': 'carl philipp emanuel bach',
  'cpe bach': 'carl philipp emanuel bach',
  'j c bach': 'johann christian bach',
  'jc bach': 'johann christian bach',
  'w f bach': 'wilhelm friedemann bach',
  'wf bach': 'wilhelm friedemann bach',
  scarlatti: 'domenico scarlatti',
  'd scarlatti': 'domenico scarlatti',
  'a scarlatti': 'alessandro scarlatti',
  haydn: 'joseph haydn',
  schumann: 'robert schumann',
  mendelssohn: 'felix mendelssohn',
  mozart: 'wolfgang amadeus mozart',
  'vaughn williams': 'ralph vaughan williams',
};

const resolveComposerId = (entry: ListeningEntry) => {
  if (entry.composerId && bySlug.has(entry.composerId)) return entry.composerId;

  const cleanedName = entry.composer.replace(/\?+/g, '').replace(/\s+/g, ' ').trim();
  const normalizedName = normalizeText(cleanedName);
  const exact = byExactName.get(normalizedName);
  if (exact) return exact;

  const aliasName = COMPOSER_ALIASES[normalizedName];
  if (aliasName) {
    const aliasId = byExactName.get(aliasName) || bySlug.get(slugify(aliasName));
    if (aliasId) return aliasId;
  }

  const surname = normalizedName.split(' ').filter(Boolean).at(-1) || '';
  const candidates = surnameCandidates.get(surname) || [];
  if (candidates.length === 1) return candidates[0];

  return entry.composerId || slugify(aliasName || cleanedName);
};

type ResolvedEntry = ListeningEntry & {
  resolvedComposerId: string;
  displayComposer: string;
};

const resolvedEntries: ResolvedEntry[] = listeningEntries.map((entry) => {
  const resolvedComposerId = resolveComposerId(entry);
  return {
    ...entry,
    resolvedComposerId,
    displayComposer: composerNameById.get(resolvedComposerId) || entry.composer.replace(/\?+/g, '').trim(),
  };
});

const entriesByComposer = new Map<string, ResolvedEntry[]>();
resolvedEntries.forEach((entry) => {
  entriesByComposer.set(entry.resolvedComposerId, [
    ...(entriesByComposer.get(entry.resolvedComposerId) || []),
    entry,
  ]);
});

const isGorgeousEntry = (entry: ResolvedEntry) =>
  entry.ratingBucket === 'amazing' || entry.ratingBucket === 'gorgeous';

const getUniqueTitleCount = (entries: ResolvedEntry[]) =>
  new Set(entries.map((entry) => normalizeText(entry.piece)).filter(Boolean)).size;

const getDateBounds = (entries: ResolvedEntry[]) => {
  const dates = entries.map((entry) => entry.date).filter((date): date is Date => Boolean(date));
  return {
    first: dates.length ? new Date(Math.min(...dates.map((date) => date.getTime()))) : null,
    last: dates.length ? new Date(Math.max(...dates.map((date) => date.getTime()))) : null,
  };
};

const getTopForm = (entries: ResolvedEntry[]) => {
  const counts = new Map<string, number>();
  entries.forEach((entry) => {
    if (!entry.form) return;
    counts.set(entry.form, (counts.get(entry.form) || 0) + 1);
  });
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || '';
};

const getGorgeousWorks = (entries: ResolvedEntry[]) => {
  const unique = new Map<string, ResolvedEntry>();

  entries.filter(isGorgeousEntry).forEach((entry) => {
    const key = normalizeText(entry.piece);
    if (!key) return;
    const current = unique.get(key);
    const entryDate = entry.date?.getTime() || 0;
    const currentDate = current?.date?.getTime() || 0;
    const hasBetterLink = Boolean(entry.youtubeUrl && !current?.youtubeUrl);
    const sameLinkQuality = Boolean(entry.youtubeUrl) === Boolean(current?.youtubeUrl);

    if (!current || hasBetterLink || (sameLinkQuality && entryDate > currentDate)) unique.set(key, entry);
  });

  return [...unique.values()].sort(
    (a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber,
  );
};

const composers = composersBase.map((composer) => {
  const entries = [...(entriesByComposer.get(composer.id) || [])].sort(
    (a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber,
  );
  const totalMinutes = entries.reduce((total, entry) => total + entry.minutes, 0);
  const bounds = getDateBounds(entries);
  const uniqueTitleCount = getUniqueTitleCount(entries);
  const gorgeousWorks = getGorgeousWorks(entries);
  const gorgeousEntryCount = entries.filter(isGorgeousEntry).length;

  return {
    ...composer,
    entries,
    totalMinutes,
    firstListened: bounds.first,
    lastListened: bounds.last,
    uniqueTitleCount,
    repeatCount: Math.max(0, entries.length - uniqueTitleCount),
    topForm: getTopForm(entries),
    gorgeousWorks,
    gorgeousWorkCount: gorgeousWorks.length,
    gorgeousEntryCount,
    gorgeousRate: uniqueTitleCount ? (gorgeousWorks.length / uniqueTitleCount) * 100 : 0,
    linkedCount: entries.filter((entry) => entry.youtubeUrl).length,
  };
});

const globalComposerGroups = [...entriesByComposer.entries()].map(([id, entries]) => {
  const totalMinutes = entries.reduce((total, entry) => total + entry.minutes, 0);
  const gorgeousWorks = getGorgeousWorks(entries);
  return {
    id,
    name: composerNameById.get(id) || entries[0]?.displayComposer || id,
    entries: entries.length,
    uniqueTitles: getUniqueTitleCount(entries),
    totalMinutes,
    gorgeousWorks: gorgeousWorks.length,
    gorgeousEntries: entries.filter(isGorgeousEntry).length,
  };
});

const totalEntries = resolvedEntries.length;
const totalMinutes = resolvedEntries.reduce((total, entry) => total + entry.minutes, 0);
const totalUniqueTitles = new Set(
  resolvedEntries.map((entry) => `${entry.resolvedComposerId}|${normalizeText(entry.piece)}`),
).size;
const totalComposersLogged = globalComposerGroups.length;
const totalGorgeous = resolvedEntries.filter(isGorgeousEntry).length;
const totalOther = totalEntries - totalGorgeous;
const globalBounds = getDateBounds(resolvedEntries);
const profiledComposerIds = new Set(composersBase.map((composer) => composer.id));
const unprofiledComposerCount = globalComposerGroups.filter((group) => !profiledComposerIds.has(group.id)).length;
const unresolvedRows = resolvedEntries.filter((entry) => !profiledComposerIds.has(entry.resolvedComposerId));

if (unresolvedRows.length) {
  console.warn(
    `[Composers] ${unresolvedRows.length} dated listening rows across ${unprofiledComposerCount} composer labels do not currently match a Raindrop profile.`,
    [...new Set(unresolvedRows.map((entry) => entry.composer))].slice(0, 30),
  );
}

if (feedRejectedRows) {
  console.warn(
    `[Composers] ${feedRejectedRows} feed rows were excluded because the date, composer, or piece was blank.`,
  );
}

const topHours = [...globalComposerGroups]
  .filter((group) => group.totalMinutes > 0)
  .sort((a, b) => b.totalMinutes - a.totalMinutes)
  .slice(0, 12);
const maxChartMinutes = Math.max(...topHours.map((group) => group.totalMinutes), 1);

const topFavorites = [...globalComposerGroups]
  .filter((group) => group.gorgeousWorks > 0)
  .sort((a, b) => b.gorgeousWorks - a.gorgeousWorks || b.uniqueTitles - a.uniqueTitles)
  .slice(0, 12);
const maxFavoriteWorks = Math.max(...topFavorites.map((group) => group.uniqueTitles), 1);

const periodsInUse = [...new Set(composers.map((composer) => composer.period).filter(Boolean))].sort(
  (a, b) => {
    const aIndex = PERIODS.indexOf(a);
    const bIndex = PERIODS.indexOf(b);
    return (aIndex < 0 ? 999 : aIndex) - (bIndex < 0 ? 999 : bIndex);
  },
);

const hasListeningFeed = Boolean(CLASSICAL_LISTENING_DATA_URL && !sheetError);
const generatedLabel = formatGeneratedAt(feedGeneratedAt);

const luckyPool = resolvedEntries
  .filter((entry) => entry.youtubeUrl && isGorgeousEntry(entry))
  .map((entry) => ({
    key: `${entry.rowNumber}|${entry.youtubeUrl}`,
    composer: entry.displayComposer,
    piece: entry.piece,
    url: entry.youtubeUrl,
  }));

const clientPageData = JSON.stringify({ luckyPool }).replace(/</g, '\\u003c');
---

<BaseHead
  title={`${SITE_TITLE} — Music — Composers`}
  description="A data-driven archive of classical composers explored, listening hours, Gorgeous works, and performances worth revisiting."
/>

<style>
  :root {
    --ink: #0e121b;
    --muted: #5e6573;
    --border: #e6e9ef;
    --surface: rgba(255, 255, 255, .92);
    --accent: #405cf5;
    --gorgeous: #a85ed6;
    --heard: #dce2ff;
  }

  * { box-sizing: border-box; }
  .wrap { width: 100%; margin: 0 auto; padding: 28px clamp(16px, 3vw, 48px) 50px; }
  .intro { max-width: 1120px; margin: 0 auto 22px; text-align: center; }
  h1 { margin: 0 0 9px; font-weight: 800; letter-spacing: -.025em; }
  .hint { margin: 0 auto 10px; max-width: 78ch; color: var(--muted); line-height: 1.55; }
  .tracking-note { margin: 0 auto 13px; max-width: 83ch; color: #454d5c; font-size: .88rem; line-height: 1.55; }
  .updated-note { margin: 0 auto 17px; color: var(--muted); font-size: .74rem; }
  .feed-notice { max-width: 880px; margin: 0 auto 18px; padding: 11px 14px; border: 1px solid var(--border); border-radius: 12px; background: rgba(255, 255, 255, .84); color: var(--muted); font-size: .84rem; line-height: 1.45; }
  .feed-notice strong { color: var(--ink); }

  .overall-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 9px; max-width: 1120px; margin: 0 auto 20px; }
  .overall-stat { min-width: 0; padding: 13px 10px; border: 1px solid rgba(230, 233, 239, .94); border-radius: 13px; background: rgba(255, 255, 255, .88); box-shadow: 0 7px 20px rgba(15, 23, 42, .06); }
  .overall-stat strong, .overall-stat span { display: block; }
  .overall-stat strong { overflow: hidden; color: var(--ink); font-size: 1.08rem; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .overall-stat span { margin-top: 4px; color: var(--muted); font-size: .7rem; line-height: 1.25; }

  .insights-toggle { max-width: 1120px; margin: 0 auto 21px; }
  .insights-toggle > summary { display: none; }
  .insights-toggle:not([open]) > .charts { display: grid; }
  .charts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; text-align: left; }
  .chart-card { min-width: 0; padding: 16px; border: 1px solid rgba(230, 233, 239, .94); border-radius: 15px; background: rgba(255, 255, 255, .9); box-shadow: 0 9px 24px rgba(15, 23, 42, .07); }
  .chart-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
  .chart-header h2 { margin: 0; font-size: 1rem; }
  .chart-header p { margin: 3px 0 0; color: var(--muted); font-size: .72rem; line-height: 1.35; }
  .chart-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chart-row { display: grid; grid-template-columns: minmax(145px, 180px) minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .chart-name { color: #323946; font-size: .72rem; font-weight: 700; line-height: 1.25; }
  .bar-track { display: block; height: 9px; overflow: hidden; border-radius: 999px; background: #edf0f5; }
  .bar-fill { display: block; width: var(--bar-width); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #405cf5, #7284ff); }
  .works-width { display: block; width: var(--bar-width); height: 100%; overflow: hidden; border-radius: inherit; background: var(--heard); }
  .gorgeous-fill { display: block; width: var(--gorgeous-width); height: 100%; border-radius: inherit; background: var(--gorgeous); }
  .chart-value { color: var(--muted); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .chart-legend { display: flex; gap: 12px; align-items: center; color: var(--muted); font-size: .67rem; }
  .legend-item::before { display: inline-block; width: 8px; height: 8px; margin-right: 4px; border-radius: 999px; content: ''; }
  .legend-item.heard::before { background: var(--heard); }
  .legend-item.gorgeous::before { background: var(--gorgeous); }

  .toolbar { display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; max-width: 1120px; margin: 0 auto 10px; }
  .toolbar input, .toolbar select, .lucky-button { min-height: 42px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; background: #fff; color: var(--ink); font: inherit; font-size: .86rem; box-shadow: 0 1px 2px rgba(0, 0, 0, .03); }
  .toolbar input { width: min(320px, 100%); }
  .toolbar select { min-width: 150px; }
  .lucky-button { background: #405cf5; color: #fff; font-weight: 800; cursor: pointer; }
  .lucky-button:hover { background: #354edb; }
  .lucky-button:disabled { cursor: not-allowed; opacity: .55; }
  .lucky-status { min-height: 18px; margin: 0 auto 4px; color: var(--muted); font-size: .72rem; }
  .results-row { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 28px; margin-bottom: 15px; color: var(--muted); font-size: .82rem; }
  .results-row p { margin: 0; }
  .clear-filters { border: 0; background: transparent; color: #314bd8; font: inherit; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

  .composer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(205px, 1fr)); gap: 18px; max-width: 1780px; margin: 0 auto; align-items: start; }
  .composer-card { min-width: 0; }
  .composer-button { width: 100%; padding: 0; overflow: hidden; border: 0; border-radius: 15px; background: var(--surface); color: inherit; text-align: left; cursor: pointer; box-shadow: 0 9px 24px rgba(15, 23, 42, .09); transition: transform .16s ease, box-shadow .16s ease; }
  .composer-button:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(15, 23, 42, .14); }
  .composer-button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .composer-button[aria-expanded='true'] { box-shadow: 0 0 0 2px var(--accent), 0 14px 30px rgba(15, 23, 42, .13); }
  .portrait-wrap { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #eef0f5; }
  .portrait { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 18%; transition: transform .25s ease; }
  .composer-button:hover .portrait { transform: scale(1.025); }
  .expand-cue { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 31px; height: 31px; border-radius: 999px; background: rgba(14, 18, 27, .8); color: #fff; font-size: 1rem; line-height: 1; backdrop-filter: blur(5px); }
  .composer-button[aria-expanded='true'] .expand-cue { transform: rotate(45deg); }
  .card-body { display: block; min-height: 154px; padding: 13px 14px 14px; }
  .composer-name { display: block; margin-bottom: 4px; font-size: 1rem; font-weight: 800; line-height: 1.25; }
  .composer-meta { display: block; min-height: 2.55em; color: var(--muted); font-size: .78rem; line-height: 1.35; }
  .composer-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 11px; }
  .stat { min-width: 0; padding: 7px 8px; border-radius: 9px; background: #f4f5f9; }
  .stat strong, .stat span { display: block; }
  .stat strong { color: var(--ink); font-size: .85rem; line-height: 1.15; }
  .stat span { margin-top: 2px; color: var(--muted); font-size: .68rem; line-height: 1.2; }
  .not-connected { display: block; margin-top: 12px; color: var(--muted); font-size: .74rem; font-style: italic; }
  .empty { grid-column: 1 / -1; padding: 40px 16px; color: var(--muted); text-align: center; }

  .composer-dialog { width: min(1180px, calc(100vw - 40px)); max-width: none; height: min(88dvh, 900px); max-height: 88dvh; margin: auto; padding: 0; overflow: hidden; border: 0; border-radius: 18px; background: #fff; color: var(--ink); box-shadow: 0 28px 90px rgba(10, 17, 35, .28); }
  .composer-dialog::backdrop { background: rgba(9, 14, 25, .58); backdrop-filter: blur(4px); }
  .composer-dialog-content, .composer-detail { height: 100%; }
  .composer-detail { display: flex; min-height: 0; flex-direction: column; background: #fff; }
  .detail-header { display: flex; justify-content: space-between; gap: 18px; align-items: flex-start; padding: 20px 24px 16px; border-bottom: 1px solid var(--border); background: #fff; }
  .detail-header h2 { margin: 0 0 5px; font-size: 1.5rem; }
  .detail-subtitle { margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.45; }
  .detail-actions { display: flex; gap: 8px; flex: 0 0 auto; }
  .reference-link, .close-detail { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 8px 12px; border-radius: 10px; font: inherit; font-size: .8rem; font-weight: 800; text-decoration: none; cursor: pointer; }
  .reference-link { border: 1px solid rgba(64, 92, 245, .25); background: #f0f2ff; color: #314bd8; }
  .close-detail { min-width: 78px; border: 1px solid var(--border); background: #fff; color: var(--ink); }
  .detail-tabs { display: flex; gap: 4px; padding: 10px 24px; overflow-x: auto; border-bottom: 1px solid var(--border); background: #fff; }
  .detail-tab { flex: 0 0 auto; min-height: 38px; padding: 8px 13px; border: 0; border-radius: 10px; background: transparent; color: var(--muted); font: inherit; font-size: .82rem; font-weight: 800; cursor: pointer; }
  .detail-tab[aria-selected='true'] { background: #eef1ff; color: #314bd8; }
  .detail-panel-wrap { min-height: 0; flex: 1; overflow: auto; overscroll-behavior: contain; padding: 20px 24px 28px; }
  .detail-panel[hidden] { display: none; }
  .detail-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-bottom: 18px; }
  .detail-summary div { min-width: 0; padding: 11px; border-radius: 11px; background: #f4f5f9; }
  .detail-summary strong, .detail-summary span { display: block; }
  .detail-summary strong { font-size: .95rem; line-height: 1.2; }
  .detail-summary span { margin-top: 3px; color: var(--muted); font-size: .68rem; line-height: 1.25; }
  .overview-note { margin: 0; padding: 15px 16px; border: 1px solid #e8eafd; border-radius: 12px; background: #f8f8ff; color: #41495a; font-size: .85rem; line-height: 1.55; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 10px; }
  .section-heading h3 { margin: 0; font-size: 1.05rem; }
  .section-heading p { margin: 0; color: var(--muted); font-size: .72rem; }

  .browser-toolbar { position: sticky; top: -20px; z-index: 4; display: grid; grid-template-columns: minmax(220px, 1fr) 180px 180px; gap: 8px; margin: -20px -24px 11px; padding: 14px 24px 10px; border-bottom: 1px solid rgba(230, 233, 239, .9); background: rgba(255, 255, 255, .96); backdrop-filter: blur(10px); }
  .browser-toolbar.two-controls { grid-template-columns: minmax(220px, 1fr) 180px; }
  .browser-toolbar input, .browser-toolbar select { min-height: 40px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--ink); font: inherit; font-size: .78rem; }
  .entry-results { margin: 0 0 9px; color: var(--muted); font-size: .72rem; }
  .entry-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .entry-item { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; min-width: 0; padding: 11px 12px; border: 1px solid #eceef4; border-radius: 11px; background: #fff; }
  .entry-main { min-width: 0; }
  .entry-title { display: block; color: var(--ink); font-size: .84rem; font-weight: 800; line-height: 1.35; }
  .entry-meta { display: block; margin-top: 4px; color: var(--muted); font-size: .7rem; line-height: 1.4; }
  .entry-side { min-width: 100px; text-align: right; }
  .entry-side time, .entry-side span { display: block; color: var(--muted); font-size: .69rem; line-height: 1.4; }
  .play-link { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 38px; height: 34px; padding: 0 10px; border-radius: 9px; background: #eef1ff; color: #314bd8; font-size: .72rem; font-weight: 800; text-decoration: none; }
  .play-link:hover { background: #dde3ff; }
  .play-missing { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 38px; height: 34px; border-radius: 9px; background: #f1f2f5; color: #8a909b; font-size: .72rem; }
  .rating { display: inline-block; margin-right: 5px; padding: 2px 6px; border-radius: 999px; font-weight: 800; }
  .rating.gorgeous { background: #f5eafa; color: #8d43ba; }
  .rating.other { background: #f0f1f4; color: #656c78; }
  .show-more { display: block; min-height: 40px; margin: 12px auto 0; padding: 8px 15px; border: 1px solid rgba(64, 92, 245, .25); border-radius: 10px; background: #f0f2ff; color: #314bd8; font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer; }
  .empty-detail { margin: 0; padding: 15px; border-radius: 11px; background: #f5f6f9; color: var(--muted); font-size: .86rem; line-height: 1.5; }

  @media (max-width: 1050px) {
    .overall-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .detail-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .wrap { padding: 18px 10px 38px; }
    .intro { margin-bottom: 14px; padding-inline: 4px; }
    h1 { font-size: 2rem; }
    .hint, .tracking-note { font-size: .84rem; }
    .charts { grid-template-columns: 1fr; }
    .toolbar { display: grid; grid-template-columns: 1fr 1fr; }
    .toolbar > input { grid-column: 1 / -1; width: 100%; }
    .toolbar > select, .lucky-button { min-width: 0; width: 100%; }
    .lucky-button { grid-column: 1 / -1; }
    .composer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; }
    .card-body { min-height: 145px; padding: 10px; }
    .composer-name { font-size: .88rem; }
    .composer-meta { font-size: .7rem; }
    .composer-stats { gap: 5px; }
    .stat { padding: 6px; }
    .stat strong { font-size: .74rem; }
    .stat span { font-size: .62rem; }
    .browser-toolbar { grid-template-columns: 1fr 1fr; }
    .browser-toolbar input { grid-column: 1 / -1; }
    .browser-toolbar.two-controls { grid-template-columns: 1fr 1fr; }
    .browser-toolbar.two-controls input { grid-column: auto; }
  }

  @media (max-width: 700px) {
    .insights-toggle { margin-bottom: 12px; }
    .insights-toggle > summary { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 10px 13px; border: 1px solid var(--border); border-radius: 12px; background: rgba(255, 255, 255, .9); color: #314bd8; font-size: .82rem; font-weight: 800; cursor: pointer; list-style: none; }
    .insights-toggle > summary::-webkit-details-marker { display: none; }
    .insights-toggle > summary::after { content: '+'; font-size: 1.1rem; }
    .insights-toggle[open] > summary::after { content: '–'; }
    .insights-toggle:not([open]) > .charts { display: none; }
    .insights-toggle[open] > .charts { display: grid; margin-top: 10px; }
    .toolbar { position: sticky; top: 66px; z-index: 20; padding: 8px; border: 1px solid rgba(230, 233, 239, .9); border-radius: 13px; background: rgba(255, 255, 255, .94); box-shadow: 0 8px 24px rgba(15, 23, 42, .1); backdrop-filter: blur(12px); }
    .chart-row { grid-template-columns: 112px minmax(0, 1fr) auto; }
    .chart-name { font-size: .69rem; }
  }

  @media (max-width: 620px) {
    .overall-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .composer-dialog { inset: 0; width: 100vw; height: 100dvh; max-height: none; margin: 0; border-radius: 0; }
    .detail-header { padding: 15px 14px 12px; }
    .detail-header h2 { font-size: 1.25rem; }
    .detail-subtitle { font-size: .76rem; }
    .detail-actions { gap: 5px; }
    .reference-link { min-height: 36px; padding: 7px 9px; font-size: .72rem; }
    .close-detail { min-width: 64px; min-height: 36px; padding: 7px 9px; font-size: .72rem; }
    .detail-tabs { padding: 8px 12px; }
    .detail-tab { min-height: 36px; padding: 7px 11px; font-size: .76rem; }
    .detail-panel-wrap { padding: 14px 12px 22px; }
    .detail-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .browser-toolbar, .browser-toolbar.two-controls { top: -14px; grid-template-columns: 1fr; margin: -14px -12px 10px; padding: 10px 12px; }
    .browser-toolbar input, .browser-toolbar.two-controls input { grid-column: auto; }
    .entry-item { grid-template-columns: auto minmax(0, 1fr); align-items: start; }
    .entry-side { grid-column: 2; min-width: 0; text-align: left; }
    .entry-side time, .entry-side span { display: inline; }
    .entry-side span::before { content: ' · '; }
  }

  @media (max-width: 520px) {
    .composer-grid { grid-template-columns: 1fr; max-width: 430px; }
    .composer-button { display: grid; grid-template-columns: 124px minmax(0, 1fr); }
    .portrait-wrap { height: 155px; aspect-ratio: 4 / 5; }
    .card-body { min-height: 155px; }
    .chart-card { padding: 13px 11px; }
    .chart-row { grid-template-columns: 92px minmax(0, 1fr) auto; gap: 6px; }
  }
</style>

<VideoBg>
  <Header />
  <main class="wrap">
    <MusicNav active="composers" />

    <div class="intro">
      <h1>🎼 Classical Composers</h1>
      <p class="hint">
        A listening archive of the Western classical canon: composer profiles, performances heard,
        time invested, and the works I marked Gorgeous.
      </p>
      <p class="tracking-note">
        I began tracking this project on {globalBounds.first ? formatListeningDate(globalBounds.first) : 'November 23, 2024'},
        starting with Haydn’s symphonies and then moving through the wider repertoire of other composers.
        Select a composer to open the full listening record.
      </p>

      {hasListeningFeed && generatedLabel ? (
        <p class="updated-note">
          Listening data refreshed {generatedLabel}{feedSourceSheet ? ` from ${feedSourceSheet}` : ''}.
        </p>
      ) : null}

      {!CLASSICAL_LISTENING_DATA_URL ? (
        <p class="feed-notice">
          <strong>Composer portraits are connected.</strong> Add <code>CLASSICAL_LISTENING_DATA_URL</code>
          to connect the normalized Google Sheets feed and activate totals, links, charts, and Feeling Lucky.
        </p>
      ) : sheetError ? (
        <p class="feed-notice">
          <strong>The composer gallery loaded, but the listening feed did not.</strong> {sheetError}
        </p>
      ) : null}

      {hasListeningFeed ? (
        <>
          <section class="overall-stats" aria-label="Classical listening totals">
            <div class="overall-stat"><strong>{totalEntries.toLocaleString('en-US')}</strong><span>listening entries</span></div>
            <div class="overall-stat"><strong>{totalUniqueTitles.toLocaleString('en-US')}</strong><span>unique works logged</span></div>
            <div class="overall-stat"><strong>{formatListeningHours(totalMinutes)}</strong><span>total listening time</span></div>
            <div class="overall-stat"><strong>{totalComposersLogged.toLocaleString('en-US')}</strong><span>composers logged</span></div>
            <div class="overall-stat"><strong>{composers.length.toLocaleString('en-US')}</strong><span>portrait profiles</span></div>
            <div class="overall-stat"><strong>{totalGorgeous.toLocaleString('en-US')}</strong><span>rated Gorgeous</span></div>
          </section>

          {(topHours.length || topFavorites.length) ? (
            <details class="insights-toggle" open>
              <summary>View listening insights</summary>
              <section class="charts" aria-label="Classical listening charts">
                <article class="chart-card">
                  <div class="chart-header">
                    <div>
                      <h2>Most Explored by Time</h2>
                      <p>Top composers by recorded listening hours.</p>
                    </div>
                  </div>
                  <ol class="chart-list">
                    {topHours.map((group) => (
                      <li class="chart-row">
                        <span class="chart-name">{group.name}</span>
                        <span class="bar-track" aria-hidden="true">
                          <span class="bar-fill" style={`--bar-width:${Math.max(2, (group.totalMinutes / maxChartMinutes) * 100)}%`}></span>
                        </span>
                        <span class="chart-value">{formatListeningHours(group.totalMinutes)}</span>
                      </li>
                    ))}
                  </ol>
                </article>

                <article class="chart-card">
                  <div class="chart-header">
                    <div>
                      <h2>Favorites by Composer</h2>
                      <p>Unique works heard compared with those marked Gorgeous.</p>
                    </div>
                    <div class="chart-legend" aria-label="Chart legend">
                      <span class="legend-item heard">Works heard</span>
                      <span class="legend-item gorgeous">Gorgeous</span>
                    </div>
                  </div>
                  <ol class="chart-list">
                    {topFavorites.map((group) => (
                      <li class="chart-row">
                        <span class="chart-name">{group.name}</span>
                        <span class="bar-track" aria-hidden="true">
                          <span
                            class="works-width"
                            style={`--bar-width:${Math.max(2, (group.uniqueTitles / maxFavoriteWorks) * 100)}%`}
                          >
                            <span
                              class="gorgeous-fill"
                              style={`--gorgeous-width:${group.uniqueTitles ? (group.gorgeousWorks / group.uniqueTitles) * 100 : 0}%`}
                            ></span>
                          </span>
                        </span>
                        <span class="chart-value">{group.gorgeousWorks.toLocaleString('en-US')} / {group.uniqueTitles.toLocaleString('en-US')}</span>
                      </li>
                    ))}
                  </ol>
                </article>
              </section>
            </details>
          ) : null}
        </>
      ) : null}

      <div class="toolbar">
        <input id="composer-search" type="search" placeholder="Search composer, country, period, or form…" aria-label="Search composers" />

        <select id="period-filter" aria-label="Filter composers by period">
          <option value="">All periods</option>
          {periodsInUse.map((period) => <option value={period}>{period}</option>)}
        </select>

        <select id="composer-sort" aria-label="Sort composers">
          <option value="name-asc">Composer A–Z</option>
          <option value="entries-desc">Most entries</option>
          <option value="unique-desc">Most unique works</option>
          <option value="hours-desc">Most listening time</option>
          <option value="favorites-desc">Most Gorgeous works</option>
          <option value="recent-desc">Most recently heard</option>
        </select>

        <button type="button" id="feeling-lucky" class="lucky-button" disabled={!luckyPool.length}>
          🎲 Feeling Lucky
        </button>
      </div>

      <p id="lucky-status" class="lucky-status" aria-live="polite"></p>

      <div class="results-row">
        <p id="composer-results" aria-live="polite">
          Showing {composers.length.toLocaleString('en-US')} of {composers.length.toLocaleString('en-US')} portrait profiles · {totalComposersLogged.toLocaleString('en-US')} composers logged
        </p>
        <button type="button" id="clear-composer-filters" class="clear-filters" hidden>Clear filters</button>
      </div>
    </div>

    {composers.length === 0 ? (
      <p class="empty">Composer profiles are temporarily unavailable because Raindrop returned no items during the build.</p>
    ) : (
      <div
        id="composer-grid"
        class="composer-grid"
        role="list"
        data-listening-feed={hasListeningFeed ? 'connected' : 'not-connected'}
        data-unprofiled-composers={unprofiledComposerCount}
        data-other-ratings={totalOther}
      >
        {composers.map((composer) => {
          const life = composer.birthYear ? `${composer.birthYear}–${composer.deathYear || ''}` : '';
          const identity = [life, composer.nationality, composer.period].filter(Boolean).join(' · ');
          const searchText = normalizeText(
            `${composer.name} ${composer.nationality} ${composer.period} ${composer.note} ${composer.topForm} ${composer.entries.map((entry) => entry.form).join(' ')}`,
          );

          return (
            <article
              class="composer-card"
              role="listitem"
              data-composer-id={composer.id}
              data-name={composer.name}
              data-search={searchText}
              data-period={composer.period}
              data-entries={composer.entries.length}
              data-unique={composer.uniqueTitleCount}
              data-minutes={composer.totalMinutes}
              data-favorites={composer.gorgeousWorkCount}
              data-last-listened={composer.lastListened?.getTime() || 0}
              data-original-index={composer.originalIndex}
            >
              <button
                type="button"
                class="composer-button"
                aria-expanded="false"
                aria-haspopup="dialog"
                aria-controls="composer-dialog"
                data-composer-trigger={composer.id}
              >
                <span class="portrait-wrap">
                  <img
                    class="portrait"
                    src={composer.cover}
                    alt={`Portrait of ${composer.name}`}
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 520px) 124px, (max-width: 900px) 50vw, 240px"
                  />
                  <span class="expand-cue" aria-hidden="true">+</span>
                </span>

                <span class="card-body">
                  <span class="composer-name">{composer.name}</span>
                  <span class="composer-meta">{identity || composer.note || 'Composer profile'}</span>

                  {hasListeningFeed ? (
                    <span class="composer-stats">
                      <span class="stat"><strong>{composer.entries.length.toLocaleString('en-US')}</strong><span>entries logged</span></span>
                      <span class="stat"><strong>{formatListeningHours(composer.totalMinutes)}</strong><span>listening time</span></span>
                      <span class="stat"><strong>{composer.gorgeousWorkCount.toLocaleString('en-US')}</strong><span>Gorgeous works</span></span>
                      <span class="stat"><strong>{formatCardDate(composer.lastListened)}</strong><span>last heard</span></span>
                    </span>
                  ) : (
                    <span class="not-connected">Listening details ready to connect</span>
                  )}
                </span>
              </button>

              <template id={`composer-template-${composer.id}`}>
                <article class="composer-detail" data-composer-detail>
                  <header class="detail-header">
                    <div>
                      <h2 id={`composer-dialog-title-${composer.id}`}>{composer.name}</h2>
                      <p class="detail-subtitle">
                        {[identity, composer.topForm ? `Most explored form: ${composer.topForm}` : '']
                          .filter(Boolean)
                          .join(' · ') || 'Composer listening profile'}
                      </p>
                    </div>
                    <div class="detail-actions">
                      <a class="reference-link" href={composer.href} target="_blank" rel="noopener noreferrer">Reference ↗</a>
                      <button type="button" class="close-detail" data-close-composer>Close</button>
                    </div>
                  </header>

                  <div class="detail-tabs" role="tablist" aria-label={`${composer.name} listening sections`}>
                    <button
                      type="button"
                      class="detail-tab"
                      role="tab"
                      id={`tab-overview-${composer.id}`}
                      aria-controls={`panel-overview-${composer.id}`}
                      aria-selected="true"
                      data-detail-tab="overview"
                    >Overview</button>
                    <button
                      type="button"
                      class="detail-tab"
                      role="tab"
                      id={`tab-gorgeous-${composer.id}`}
                      aria-controls={`panel-gorgeous-${composer.id}`}
                      aria-selected="false"
                      tabindex="-1"
                      data-detail-tab="gorgeous"
                    >Gorgeous ({composer.gorgeousWorkCount.toLocaleString('en-US')})</button>
                    <button
                      type="button"
                      class="detail-tab"
                      role="tab"
                      id={`tab-all-${composer.id}`}
                      aria-controls={`panel-all-${composer.id}`}
                      aria-selected="false"
                      tabindex="-1"
                      data-detail-tab="all"
                    >All Listening ({composer.entries.length.toLocaleString('en-US')})</button>
                  </div>

                  <div class="detail-panel-wrap">
                    <section
                      class="detail-panel"
                      id={`panel-overview-${composer.id}`}
                      role="tabpanel"
                      aria-labelledby={`tab-overview-${composer.id}`}
                      data-detail-panel="overview"
                    >
                      {hasListeningFeed ? (
                        <>
                          <div class="detail-summary">
                            <div><strong>{composer.entries.length.toLocaleString('en-US')}</strong><span>entries logged</span></div>
                            <div><strong>{composer.uniqueTitleCount.toLocaleString('en-US')}</strong><span>unique works</span></div>
                            <div><strong>{formatListeningHours(composer.totalMinutes)}</strong><span>listening time</span></div>
                            <div><strong>{composer.gorgeousWorkCount.toLocaleString('en-US')}</strong><span>Gorgeous works ({composer.gorgeousRate.toFixed(0)}%)</span></div>
                            <div><strong>{composer.firstListened ? formatListeningDate(composer.firstListened) : '—'}</strong><span>first heard</span></div>
                            <div><strong>{composer.lastListened ? formatListeningDate(composer.lastListened) : '—'}</strong><span>last heard</span></div>
                          </div>
                          <p class="overview-note">
                            {composer.gorgeousWorkCount.toLocaleString('en-US')} of {composer.uniqueTitleCount.toLocaleString('en-US')} unique works are marked Gorgeous.
                            {composer.repeatCount ? ` The log also contains ${composer.repeatCount.toLocaleString('en-US')} repeat listening entr${composer.repeatCount === 1 ? 'y' : 'ies'}.` : ''}
                            {composer.topForm ? ` The most explored form is ${composer.topForm}.` : ''}
                          </p>
                        </>
                      ) : (
                        <p class="empty-detail">Listening details are not connected for this build.</p>
                      )}
                    </section>

                    <section
                      class="detail-panel"
                      id={`panel-gorgeous-${composer.id}`}
                      role="tabpanel"
                      aria-labelledby={`tab-gorgeous-${composer.id}`}
                      data-detail-panel="gorgeous"
                      hidden
                    >
                      <div class="section-heading">
                        <h3>Gorgeous Works</h3>
                        <p>{composer.gorgeousWorkCount.toLocaleString('en-US')} of {composer.uniqueTitleCount.toLocaleString('en-US')} unique works</p>
                      </div>

                      {composer.gorgeousWorks.length ? (
                        <div data-list-browser data-page-desktop="18" data-page-mobile="8" data-item-label="works">
                          <div class="browser-toolbar two-controls">
                            <input type="search" placeholder="Search Gorgeous works…" aria-label={`Search ${composer.name} Gorgeous works`} data-list-search />
                            <select aria-label="Sort Gorgeous works" data-list-sort>
                              <option value="latest">Latest heard</option>
                              <option value="earliest">Earliest heard</option>
                              <option value="title">Title A–Z</option>
                              <option value="longest">Longest first</option>
                            </select>
                          </div>
                          <p class="entry-results" data-list-results></p>
                          <ul class="entry-list" data-list>
                            {composer.gorgeousWorks.map((entry) => (
                              <li
                                class="entry-item"
                                data-list-item
                                data-search={normalizeText(`${entry.piece} ${entry.form} ${entry.compositionYear} ${entry.period}`)}
                                data-rating="gorgeous"
                                data-date={entry.date?.getTime() || 0}
                                data-minutes={entry.minutes}
                                data-title={normalizeText(entry.piece)}
                                data-row={entry.rowNumber}
                              >
                                {entry.youtubeUrl ? (
                                  <a class="play-link" href={entry.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${entry.piece} on YouTube`}>▶</a>
                                ) : (
                                  <span class="play-missing" title="No performance link was exported">—</span>
                                )}
                                <span class="entry-main">
                                  <span class="entry-title">{entry.piece}</span>
                                  <span class="entry-meta">
                                    <span class="rating gorgeous">Gorgeous</span>
                                    {[entry.form, entry.period, entry.compositionYear].filter(Boolean).join(' · ') || 'Metadata not logged'}
                                  </span>
                                </span>
                                <span class="entry-side">
                                  <time datetime={entry.date?.toISOString().slice(0, 10) || undefined}>{entry.date ? formatListeningDate(entry.date) : entry.dateRaw}</time>
                                  <span>{formatCompactDuration(entry.minutes)}</span>
                                </span>
                              </li>
                            ))}
                          </ul>
                          <p class="empty-detail" data-list-empty hidden>No Gorgeous works match this search.</p>
                          <button type="button" class="show-more" data-list-more hidden>Show more</button>
                        </div>
                      ) : (
                        <p class="empty-detail">No works by this composer are currently marked Gorgeous.</p>
                      )}
                    </section>

                    <section
                      class="detail-panel"
                      id={`panel-all-${composer.id}`}
                      role="tabpanel"
                      aria-labelledby={`tab-all-${composer.id}`}
                      data-detail-panel="all"
                      hidden
                    >
                      <div class="section-heading">
                        <h3>All Listening Entries</h3>
                        <p>{composer.linkedCount.toLocaleString('en-US')} of {composer.entries.length.toLocaleString('en-US')} include a performance link</p>
                      </div>

                      {composer.entries.length ? (
                        <div data-list-browser data-page-desktop="24" data-page-mobile="12" data-item-label="entries">
                          <div class="browser-toolbar">
                            <input type="search" placeholder="Search title, form, year, or rating…" aria-label={`Search ${composer.name} listening entries`} data-list-search />
                            <select aria-label="Filter listening entries" data-list-rating>
                              <option value="all">All ratings</option>
                              <option value="gorgeous">Gorgeous</option>
                              <option value="other">Other</option>
                            </select>
                            <select aria-label="Sort listening entries" data-list-sort>
                              <option value="latest">Latest heard</option>
                              <option value="earliest">Earliest heard</option>
                              <option value="title">Title A–Z</option>
                              <option value="longest">Longest first</option>
                            </select>
                          </div>
                          <p class="entry-results" data-list-results></p>
                          <ul class="entry-list" data-list>
                            {composer.entries.map((entry) => {
                              const gorgeous = isGorgeousEntry(entry);
                              return (
                                <li
                                  class="entry-item"
                                  data-list-item
                                  data-search={normalizeText(`${entry.piece} ${entry.form} ${entry.compositionYear} ${gorgeous ? 'Gorgeous' : entry.rating} ${entry.period}`)}
                                  data-rating={gorgeous ? 'gorgeous' : 'other'}
                                  data-date={entry.date?.getTime() || 0}
                                  data-minutes={entry.minutes}
                                  data-title={normalizeText(entry.piece)}
                                  data-row={entry.rowNumber}
                                >
                                  {entry.youtubeUrl ? (
                                    <a class="play-link" href={entry.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${entry.piece} on YouTube`}>▶</a>
                                  ) : (
                                    <span class="play-missing" title="No performance link was exported">—</span>
                                  )}
                                  <span class="entry-main">
                                    <span class="entry-title">{entry.piece}</span>
                                    <span class="entry-meta">
                                      <span class={`rating ${gorgeous ? 'gorgeous' : 'other'}`}>{gorgeous ? 'Gorgeous' : entry.rating || 'Other'}</span>
                                      {[entry.form, entry.period, entry.compositionYear].filter(Boolean).join(' · ') || 'Metadata not logged'}
                                    </span>
                                  </span>
                                  <span class="entry-side">
                                    <time datetime={entry.date?.toISOString().slice(0, 10) || undefined}>{entry.date ? formatListeningDate(entry.date) : entry.dateRaw}</time>
                                    <span>{formatCompactDuration(entry.minutes)}</span>
                                  </span>
                                </li>
                              );
                            })}
                          </ul>
                          <p class="empty-detail" data-list-empty hidden>No entries match these filters.</p>
                          <button type="button" class="show-more" data-list-more hidden>Show more</button>
                        </div>
                      ) : (
                        <p class="empty-detail">No dated listening entries matched this composer profile.</p>
                      )}
                    </section>
                  </div>
                </article>
              </template>
            </article>
          );
        })}
      </div>
    )}

    <dialog id="composer-dialog" class="composer-dialog" aria-modal="true">
      <div id="composer-dialog-content" class="composer-dialog-content"></div>
    </dialog>

    <script id="composer-page-data" type="application/json" set:html={clientPageData}></script>
  </main>
  <Footer />
</VideoBg>

<script>
  (function () {
    const grid = document.querySelector('#composer-grid');
    if (!grid) return;

    const search = document.querySelector('#composer-search');
    const period = document.querySelector('#period-filter');
    const sort = document.querySelector('#composer-sort');
    const results = document.querySelector('#composer-results');
    const clear = document.querySelector('#clear-composer-filters');
    const luckyButton = document.querySelector('#feeling-lucky');
    const luckyStatus = document.querySelector('#lucky-status');
    const dialog = document.querySelector('#composer-dialog');
    const dialogContent = document.querySelector('#composer-dialog-content');
    const cards = Array.from(grid.querySelectorAll('.composer-card'));
    const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });
    let activeId = '';
    let activeButton = null;
    let suppressFocusRestore = false;

    const norm = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const parsePageData = () => {
      try {
        return JSON.parse(document.querySelector('#composer-page-data')?.textContent || '{}');
      } catch {
        return { luckyPool: [] };
      }
    };

    const pageData = parsePageData();
    const insights = document.querySelector('.insights-toggle');
    if (window.matchMedia('(max-width: 700px)').matches) insights?.removeAttribute('open');

    function visibleCards() {
      return cards.filter((card) => card.style.display !== 'none');
    }

    function updateHash(id) {
      const url = new URL(window.location.href);
      url.hash = id ? `composer-${id}` : '';
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function resetDialogState({ preserveHash = false } = {}) {
      cards.forEach((card) => {
        card.querySelector('[data-composer-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (dialogContent) dialogContent.replaceChildren();
      const buttonToRestore = activeButton;
      activeId = '';
      activeButton = null;
      if (!preserveHash) updateHash('');
      if (!suppressFocusRestore) buttonToRestore?.focus();
      suppressFocusRestore = false;
    }

    function closeDialog(options = {}) {
      const { preserveHash = false, restoreFocus = true } = options;
      suppressFocusRestore = !restoreFocus;
      if (dialog?.open) {
        dialog.dataset.preserveHash = preserveHash ? 'true' : 'false';
        dialog.close();
      } else {
        resetDialogState({ preserveHash });
      }
    }

    function setupTabs(detail) {
      const tabs = Array.from(detail.querySelectorAll('[data-detail-tab]'));
      const panels = Array.from(detail.querySelectorAll('[data-detail-panel]'));
      if (!tabs.length) return;

      function activate(name, focus = false) {
        tabs.forEach((tab) => {
          const selected = tab.dataset.detailTab === name;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.detailPanel !== name;
        });
        detail.querySelector('.detail-panel-wrap')?.scrollTo({ top: 0, behavior: 'auto' });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.detailTab || 'overview'));
        tab.addEventListener('keydown', (event) => {
          let nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[nextIndex].dataset.detailTab || 'overview', true);
        });
      });
    }

    function setupListBrowser(browser) {
      const listSearch = browser.querySelector('[data-list-search]');
      const ratingFilter = browser.querySelector('[data-list-rating]');
      const listSort = browser.querySelector('[data-list-sort]');
      const list = browser.querySelector('[data-list]');
      const resultText = browser.querySelector('[data-list-results]');
      const empty = browser.querySelector('[data-list-empty]');
      const more = browser.querySelector('[data-list-more]');
      const items = Array.from(browser.querySelectorAll('[data-list-item]'));
      const mobile = window.matchMedia('(max-width: 620px)').matches;
      const pageSize = Number(mobile ? browser.dataset.pageMobile : browser.dataset.pageDesktop) || (mobile ? 10 : 24);
      const itemLabel = browser.dataset.itemLabel || 'works';
      let visibleLimit = pageSize;

      if (!list || !items.length) return;

      function applyItems() {
        const words = norm(listSearch?.value).split(/\s+/).filter(Boolean);
        const selectedRating = ratingFilter?.value || 'all';
        const mode = listSort?.value || 'latest';

        const filtered = items.filter((item) => {
          const searchMatches = !words.length || words.every((word) => (item.dataset.search || '').includes(word));
          const ratingMatches = selectedRating === 'all' || item.dataset.rating === selectedRating;
          return searchMatches && ratingMatches;
        });

        filtered.sort((a, b) => {
          let comparison = 0;
          if (mode === 'earliest') comparison = Number(a.dataset.date || 0) - Number(b.dataset.date || 0);
          else if (mode === 'title') comparison = collator.compare(a.dataset.title || '', b.dataset.title || '');
          else if (mode === 'longest') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
          else comparison = Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
          return comparison || Number(b.dataset.row || 0) - Number(a.dataset.row || 0);
        });

        items.forEach((item) => { item.hidden = true; });
        filtered.forEach((item, index) => {
          list.appendChild(item);
          item.hidden = index >= visibleLimit;
        });

        if (resultText) {
          const shown = Math.min(filtered.length, visibleLimit);
          resultText.textContent = filtered.length
            ? `Showing ${shown.toLocaleString()} of ${filtered.length.toLocaleString()} matching ${itemLabel}`
            : `No matching ${itemLabel}`;
        }
        if (empty) empty.hidden = filtered.length > 0;
        if (more) more.hidden = filtered.length <= visibleLimit;
      }

      listSearch?.addEventListener('input', () => { visibleLimit = pageSize; applyItems(); });
      ratingFilter?.addEventListener('change', () => { visibleLimit = pageSize; applyItems(); });
      listSort?.addEventListener('change', applyItems);
      more?.addEventListener('click', () => { visibleLimit += pageSize; applyItems(); });
      applyItems();
    }

    function openDetail(card, options = {}) {
      const { updateUrl = true, focusClose = true } = options;
      const button = card.querySelector('[data-composer-trigger]');
      const id = button?.dataset.composerTrigger;
      if (!button || !id || !dialog || !dialogContent) return;

      const template = document.querySelector(`#composer-template-${CSS.escape(id)}`);
      if (!template) return;

      if (dialog.open) closeDialog({ preserveHash: true, restoreFocus: false });
      dialogContent.replaceChildren(template.content.cloneNode(true));
      activeId = id;
      activeButton = button;
      button.setAttribute('aria-expanded', 'true');

      const detail = dialogContent.querySelector('[data-composer-detail]');
      if (!detail) return;
      dialog.setAttribute('aria-labelledby', `composer-dialog-title-${id}`);
      setupTabs(detail);
      detail.querySelectorAll('[data-list-browser]').forEach(setupListBrowser);
      detail.querySelector('[data-close-composer]')?.addEventListener('click', () => closeDialog());

      if (updateUrl) updateHash(id);
      dialog.showModal();
      if (focusClose) requestAnimationFrame(() => detail.querySelector('[data-close-composer]')?.focus());
    }

    cards.forEach((card) => {
      card.querySelector('[data-composer-trigger]')?.addEventListener('click', () => openDetail(card));
    });

    dialog?.addEventListener('close', () => {
      const preserveHash = dialog.dataset.preserveHash === 'true';
      delete dialog.dataset.preserveHash;
      resetDialogState({ preserveHash });
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });

    function sortCards() {
      const mode = sort?.value || 'name-asc';
      const ordered = [...cards].sort((a, b) => {
        let comparison = 0;
        if (mode === 'entries-desc') comparison = Number(b.dataset.entries || 0) - Number(a.dataset.entries || 0);
        else if (mode === 'unique-desc') comparison = Number(b.dataset.unique || 0) - Number(a.dataset.unique || 0);
        else if (mode === 'hours-desc') comparison = Number(b.dataset.minutes || 0) - Number(a.dataset.minutes || 0);
        else if (mode === 'favorites-desc') comparison = Number(b.dataset.favorites || 0) - Number(a.dataset.favorites || 0);
        else if (mode === 'recent-desc') comparison = Number(b.dataset.lastListened || 0) - Number(a.dataset.lastListened || 0);
        else comparison = collator.compare(a.dataset.name || '', b.dataset.name || '');
        return comparison || Number(a.dataset.originalIndex || 0) - Number(b.dataset.originalIndex || 0);
      });
      ordered.forEach((card) => grid.appendChild(card));
    }

    function filterCards() {
      const words = norm(search?.value).split(/\s+/).filter(Boolean);
      const selectedPeriod = period?.value || '';
      let visible = 0;

      cards.forEach((card) => {
        const textMatches = !words.length || words.every((word) => (card.dataset.search || '').includes(word));
        const periodMatches = !selectedPeriod || card.dataset.period === selectedPeriod;
        const show = textMatches && periodMatches;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      if (results) {
        const logged = Number(grid.dataset.unprofiledComposers || 0) + cards.length;
        results.textContent = `Showing ${visible.toLocaleString()} of ${cards.length.toLocaleString()} portrait profiles · ${logged.toLocaleString()} composers logged`;
      }
      if (clear) clear.hidden = !(words.length || selectedPeriod || (sort?.value || 'name-asc') !== 'name-asc');
    }

    search?.addEventListener('input', filterCards);
    period?.addEventListener('change', filterCards);
    sort?.addEventListener('change', () => { sortCards(); filterCards(); });
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      if (period) period.value = '';
      if (sort) sort.value = 'name-asc';
      sortCards();
      filterCards();
      search?.focus();
    });

    luckyButton?.addEventListener('click', () => {
      const pool = Array.isArray(pageData.luckyPool) ? pageData.luckyPool : [];
      if (!pool.length) return;

      let recent = [];
      try { recent = JSON.parse(localStorage.getItem('lifeloggerz-classical-lucky-recent') || '[]'); } catch {}
      const available = pool.filter((entry) => !recent.includes(entry.key));
      const candidates = available.length ? available : pool;
      const selected = candidates[Math.floor(Math.random() * candidates.length)];
      if (!selected) return;

      recent = [selected.key, ...recent.filter((key) => key !== selected.key)].slice(0, Math.min(25, pool.length));
      try { localStorage.setItem('lifeloggerz-classical-lucky-recent', JSON.stringify(recent)); } catch {}
      if (luckyStatus) luckyStatus.textContent = `${selected.composer} — ${selected.piece}`;
      window.open(selected.url, '_blank', 'noopener,noreferrer');
    });

    sortCards();
    filterCards();

    const hashId = decodeURIComponent(window.location.hash.replace(/^#composer-/, ''));
    if (hashId) {
      const card = cards.find((candidate) => candidate.dataset.composerId === hashId);
      if (card) openDetail(card, { updateUrl: false, focusClose: false });
    }
  })();
</script>
