---
// src/pages/music/composers.astro
// Raindrop supplies composer portraits/metadata. A build-time Google Apps Script
// JSON feed supplies the listening log, performance links, ratings, and statistics.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import MusicNav from '../../components/MusicNav.astro';
import { SITE_TITLE } from '../../consts';
import { fetchAllRaindrops } from '../../utils/raindrop';
import {
  formatListeningDate,
  formatListeningHours,
  normalizeText,
  parseClassicalListeningFeed,
  slugify,
  type ListeningEntry,
} from '../../utils/classicalListening';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_COMPOSERS_ID || '58399760';
const CLASSICAL_LISTENING_DATA_URL =
  import.meta.env.CLASSICAL_LISTENING_DATA_URL ||
  import.meta.env.CLASSICAL_LISTENING_CSV_URL;

const composersRaw = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'composers',
  placeholder: '/images_webp/album-placeholder.webp',
});

const PERIODS = [
  'Medieval',
  'Renaissance',
  'Baroque',
  'Galant',
  'Classical',
  'Romantic',
  'Late Romantic',
  'Impressionist',
  'Modern',
  'Contemporary',
];

const parseComposerMeta = (title: string, note?: string | null) => {
  const rawTitle = String(title || '').trim();
  const rawNote = String(note || '').trim();
  const combined = `${rawTitle} · ${rawNote}`;
  const lifespanMatch = combined.match(/\b(\d{3,4})\s*[–—-]\s*(\d{3,4}|present)\b/i);
  const cleanName = rawTitle
    .replace(/\s*[([]?\d{3,4}\s*[–—-]\s*(?:\d{3,4}|present)[)\]]?\s*/i, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const parts = rawNote
    .split(/\s*(?:·|•|\||\n)\s*/)
    .map((part) => part.trim())
    .filter(Boolean)
    .filter((part) => !/^\d{3,4}\s*[–—-]\s*(?:\d{3,4}|present)$/i.test(part));

  const period =
    PERIODS.find((candidate) => normalizeText(rawNote).includes(normalizeText(candidate))) || '';

  const nationality =
    parts.find(
      (part) =>
        !PERIODS.some((candidate) => normalizeText(part).includes(normalizeText(candidate))) &&
        !/\b(?:born|died|composer|music|biography)\b/i.test(part) &&
        part.length <= 45,
    ) || '';

  return {
    name: cleanName || rawTitle,
    id: slugify(cleanName || rawTitle),
    birthYear: lifespanMatch?.[1] || '',
    deathYear: lifespanMatch?.[2] || '',
    nationality,
    period,
    note: rawNote,
  };
};

const formatCompactDuration = (minutes: number) => {
  if (!minutes) return 'Length not logged';
  if (minutes < 90) return `${Math.round(minutes).toLocaleString('en-US')} min`;
  return formatListeningHours(minutes);
};

const formatGeneratedAt = (value: string) => {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'America/Chicago',
  }).format(date);
};

let listeningEntries: ListeningEntry[] = [];
let feedGeneratedAt = '';
let feedSourceSheet = '';
let feedRejectedRows = 0;
let sheetError = '';

if (CLASSICAL_LISTENING_DATA_URL) {
  try {
    const response = await fetch(CLASSICAL_LISTENING_DATA_URL, {
      headers: { Accept: 'application/json, text/csv;q=0.9, text/plain;q=0.8' },
    });
    if (!response.ok) throw new Error(`Listening feed returned ${response.status}`);

    const parsed = parseClassicalListeningFeed(
      await response.text(),
      response.headers.get('content-type') || '',
    );
    listeningEntries = parsed.entries;
    feedGeneratedAt = parsed.generatedAt;
    feedSourceSheet = parsed.sourceSheet;
    feedRejectedRows = parsed.rejectedRows;
  } catch (error) {
    sheetError = error instanceof Error ? error.message : String(error);
    console.warn('[Composers] Classical listening feed could not be loaded:', error);
  }
}

const composersBase = composersRaw.map((composer, originalIndex) => {
  const meta = parseComposerMeta(composer.title, composer.note);
  return {
    ...meta,
    cover: composer.cover,
    href: composer.href,
    originalIndex,
  };
});

const byExactName = new Map(composersBase.map((composer) => [normalizeText(composer.name), composer.id]));
const bySlug = new Map(composersBase.map((composer) => [composer.id, composer.id]));
const composerNameById = new Map(composersBase.map((composer) => [composer.id, composer.name]));
const surnameCandidates = new Map<string, string[]>();

composersBase.forEach((composer) => {
  const surname = normalizeText(composer.name).split(' ').filter(Boolean).at(-1) || '';
  if (!surname) return;
  surnameCandidates.set(surname, [...(surnameCandidates.get(surname) || []), composer.id]);
});

// Ambiguous abbreviations and recurring variants already present in the source sheet.
// The feed may later supply composer_id directly, which takes precedence over this map.
const COMPOSER_ALIASES: Record<string, string> = {
  bach: 'johann-sebastian-bach',
  'j s bach': 'johann-sebastian-bach',
  'js bach': 'johann-sebastian-bach',
  'c p e bach': 'carl-philipp-emanuel-bach',
  'cpe bach': 'carl-philipp-emanuel-bach',
  'j c bach': 'johann-christian-bach',
  'jc bach': 'johann-christian-bach',
  'w f bach': 'wilhelm-friedemann-bach',
  'wf bach': 'wilhelm-friedemann-bach',
  scarlatti: 'domenico-scarlatti',
  'd scarlatti': 'domenico-scarlatti',
  'a scarlatti': 'alessandro-scarlatti',
  haydn: 'joseph-haydn',
  schumann: 'robert-schumann',
  mendelssohn: 'felix-mendelssohn',
  mozart: 'wolfgang-amadeus-mozart',
  'vaughn williams': 'ralph-vaughan-williams',
};

const resolveComposerId = (entry: ListeningEntry) => {
  if (entry.composerId && bySlug.has(entry.composerId)) return entry.composerId;

  const cleanedName = entry.composer.replace(/\?+/g, '').replace(/\s+/g, ' ').trim();
  const normalizedName = normalizeText(cleanedName);
  const exact = byExactName.get(normalizedName);
  if (exact) return exact;

  const alias = COMPOSER_ALIASES[normalizedName];
  if (alias && bySlug.has(alias)) return alias;

  const surname = normalizedName.split(' ').filter(Boolean).at(-1) || '';
  const candidates = surnameCandidates.get(surname) || [];
  if (candidates.length === 1) return candidates[0];

  return entry.composerId || alias || slugify(cleanedName);
};

type ResolvedEntry = ListeningEntry & {
  resolvedComposerId: string;
  displayComposer: string;
};

const resolvedEntries: ResolvedEntry[] = listeningEntries.map((entry) => {
  const resolvedComposerId = resolveComposerId(entry);
  return {
    ...entry,
    resolvedComposerId,
    displayComposer: composerNameById.get(resolvedComposerId) || entry.composer.replace(/\?+/g, '').trim(),
  };
});

const entriesByComposer = new Map<string, ResolvedEntry[]>();
resolvedEntries.forEach((entry) => {
  entriesByComposer.set(entry.resolvedComposerId, [
    ...(entriesByComposer.get(entry.resolvedComposerId) || []),
    entry,
  ]);
});

const ratingRank = new Map([
  ['gorgeous', 3],
  ['amazing', 2],
  ['other', 1],
]);

const getUniqueTitleCount = (entries: ResolvedEntry[]) =>
  new Set(entries.map((entry) => normalizeText(entry.piece)).filter(Boolean)).size;

const getDateBounds = (entries: ResolvedEntry[]) => {
  const dates = entries.map((entry) => entry.date).filter((date): date is Date => Boolean(date));
  return {
    first: dates.length ? new Date(Math.min(...dates.map((date) => date.getTime()))) : null,
    last: dates.length ? new Date(Math.max(...dates.map((date) => date.getTime()))) : null,
  };
};

const getTopForm = (entries: ResolvedEntry[]) => {
  const counts = new Map<string, number>();
  entries.forEach((entry) => {
    if (!entry.form) return;
    counts.set(entry.form, (counts.get(entry.form) || 0) + 1);
  });
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || '';
};

const getRevisitEntries = (entries: ResolvedEntry[]) => {
  const unique = new Map<string, ResolvedEntry>();

  entries
    .filter((entry) => entry.ratingBucket === 'amazing' || entry.ratingBucket === 'gorgeous')
    .forEach((entry) => {
      const key = `${normalizeText(entry.piece)}|${entry.youtubeUrl}`;
      const current = unique.get(key);
      const entryRank = ratingRank.get(entry.ratingBucket) || 0;
      const currentRank = current ? ratingRank.get(current.ratingBucket) || 0 : -1;
      const entryDate = entry.date?.getTime() || 0;
      const currentDate = current?.date?.getTime() || 0;

      if (!current || entryRank > currentRank || (entryRank === currentRank && entryDate > currentDate)) {
        unique.set(key, entry);
      }
    });

  return [...unique.values()].sort((a, b) => {
    const ratingDifference = (ratingRank.get(b.ratingBucket) || 0) - (ratingRank.get(a.ratingBucket) || 0);
    if (ratingDifference) return ratingDifference;
    return (b.date?.getTime() || 0) - (a.date?.getTime() || 0);
  });
};

const composers = composersBase.map((composer) => {
  const entries = [...(entriesByComposer.get(composer.id) || [])].sort(
    (a, b) => (b.date?.getTime() || 0) - (a.date?.getTime() || 0) || b.rowNumber - a.rowNumber,
  );
  const totalMinutes = entries.reduce((total, entry) => total + entry.minutes, 0);
  const bounds = getDateBounds(entries);
  const amazingCount = entries.filter((entry) => entry.ratingBucket === 'amazing').length;
  const gorgeousCount = entries.filter((entry) => entry.ratingBucket === 'gorgeous').length;
  const favoriteCount = amazingCount + gorgeousCount;
  const uniqueTitleCount = getUniqueTitleCount(entries);

  return {
    ...composer,
    entries,
    totalMinutes,
    firstListened: bounds.first,
    lastListened: bounds.last,
    amazingCount,
    gorgeousCount,
    favoriteCount,
    favoriteRate: entries.length ? (favoriteCount / entries.length) * 100 : 0,
    uniqueTitleCount,
    repeatCount: Math.max(0, entries.length - uniqueTitleCount),
    topForm: getTopForm(entries),
    revisitEntries: getRevisitEntries(entries),
    linkedCount: entries.filter((entry) => entry.youtubeUrl).length,
  };
});

const globalComposerGroups = [...entriesByComposer.entries()].map(([id, entries]) => {
  const totalMinutes = entries.reduce((total, entry) => total + entry.minutes, 0);
  const amazingCount = entries.filter((entry) => entry.ratingBucket === 'amazing').length;
  const gorgeousCount = entries.filter((entry) => entry.ratingBucket === 'gorgeous').length;
  return {
    id,
    name: composerNameById.get(id) || entries[0]?.displayComposer || id,
    entries: entries.length,
    uniqueTitles: getUniqueTitleCount(entries),
    totalMinutes,
    amazingCount,
    gorgeousCount,
    favoriteCount: amazingCount + gorgeousCount,
  };
});

const totalEntries = resolvedEntries.length;
const totalMinutes = resolvedEntries.reduce((total, entry) => total + entry.minutes, 0);
const totalUniqueTitles = new Set(
  resolvedEntries.map((entry) => `${entry.resolvedComposerId}|${normalizeText(entry.piece)}`),
).size;
const totalComposersLogged = globalComposerGroups.length;
const totalAmazing = resolvedEntries.filter((entry) => entry.ratingBucket === 'amazing').length;
const totalGorgeous = resolvedEntries.filter((entry) => entry.ratingBucket === 'gorgeous').length;
const totalOther = totalEntries - totalAmazing - totalGorgeous;
const globalBounds = getDateBounds(resolvedEntries);
const profiledComposerIds = new Set(composersBase.map((composer) => composer.id));
const unprofiledComposerCount = globalComposerGroups.filter((group) => !profiledComposerIds.has(group.id)).length;
const unresolvedRows = resolvedEntries.filter((entry) => !profiledComposerIds.has(entry.resolvedComposerId));

if (unresolvedRows.length) {
  console.warn(
    `[Composers] ${unresolvedRows.length} dated listening rows across ${unprofiledComposerCount} composer labels do not currently match a Raindrop profile.`,
    [...new Set(unresolvedRows.map((entry) => entry.composer))].slice(0, 30),
  );
}

if (feedRejectedRows) {
  console.warn(
    `[Composers] ${feedRejectedRows} feed rows were excluded because the date, composer, or piece was blank.`,
  );
}

const topHours = [...globalComposerGroups]
  .filter((group) => group.totalMinutes > 0)
  .sort((a, b) => b.totalMinutes - a.totalMinutes)
  .slice(0, 12);
const maxChartMinutes = Math.max(...topHours.map((group) => group.totalMinutes), 1);

const topFavorites = [...globalComposerGroups]
  .filter((group) => group.favoriteCount > 0)
  .sort((a, b) => b.favoriteCount - a.favoriteCount || b.gorgeousCount - a.gorgeousCount)
  .slice(0, 12);
const maxFavoriteCount = Math.max(...topFavorites.map((group) => group.favoriteCount), 1);

const periodsInUse = [...new Set(composers.map((composer) => composer.period).filter(Boolean))].sort(
  (a, b) => {
    const aIndex = PERIODS.indexOf(a);
    const bIndex = PERIODS.indexOf(b);
    return (aIndex < 0 ? 999 : aIndex) - (bIndex < 0 ? 999 : bIndex);
  },
);

const hasListeningFeed = Boolean(CLASSICAL_LISTENING_DATA_URL && !sheetError);
const generatedLabel = formatGeneratedAt(feedGeneratedAt);

const luckyPool = resolvedEntries
  .filter(
    (entry) =>
      entry.youtubeUrl &&
      (entry.ratingBucket === 'amazing' || entry.ratingBucket === 'gorgeous'),
  )
  .map((entry) => ({
    key: `${entry.rowNumber}|${entry.youtubeUrl}`,
    composer: entry.displayComposer,
    piece: entry.piece,
    rating: entry.ratingBucket,
    url: entry.youtubeUrl,
  }));

const clientPageData = JSON.stringify({ luckyPool }).replace(/</g, '\\u003c');
---

<BaseHead
  title={`${SITE_TITLE} — Music — Composers`}
  description="A data-driven archive of classical composers explored, listening hours, ratings, and performances worth revisiting."
/>

<style>
  :root {
    --ink: #0e121b;
    --muted: #5e6573;
    --border: #e6e9ef;
    --surface: rgba(255, 255, 255, .92);
    --accent: #405cf5;
    --amazing: #6d7df7;
    --gorgeous: #b56ce5;
  }

  * { box-sizing: border-box; }
  .wrap { width: 100%; margin: 0 auto; padding: 28px clamp(16px, 3vw, 48px) 50px; }
  .intro { max-width: 1120px; margin: 0 auto 22px; text-align: center; }
  h1 { margin: 0 0 9px; font-weight: 800; letter-spacing: -.025em; }
  .hint { margin: 0 auto 10px; max-width: 78ch; color: var(--muted); line-height: 1.55; }
  .tracking-note { margin: 0 auto 18px; max-width: 83ch; color: #454d5c; font-size: .88rem; line-height: 1.55; }
  .updated-note { margin: -8px auto 17px; color: var(--muted); font-size: .74rem; }
  .feed-notice { max-width: 880px; margin: 0 auto 18px; padding: 11px 14px; border: 1px solid var(--border); border-radius: 12px; background: rgba(255, 255, 255, .84); color: var(--muted); font-size: .84rem; line-height: 1.45; }
  .feed-notice strong { color: var(--ink); }

  .overall-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 9px; max-width: 1120px; margin: 0 auto 20px; }
  .overall-stat { min-width: 0; padding: 13px 10px; border: 1px solid rgba(230, 233, 239, .94); border-radius: 13px; background: rgba(255, 255, 255, .88); box-shadow: 0 7px 20px rgba(15, 23, 42, .06); }
  .overall-stat strong, .overall-stat span { display: block; }
  .overall-stat strong { overflow: hidden; color: var(--ink); font-size: 1.08rem; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .overall-stat span { margin-top: 4px; color: var(--muted); font-size: .7rem; line-height: 1.25; }

  .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 1120px; margin: 0 auto 21px; text-align: left; }
  .chart-card { min-width: 0; padding: 16px; border: 1px solid rgba(230, 233, 239, .94); border-radius: 15px; background: rgba(255, 255, 255, .9); box-shadow: 0 9px 24px rgba(15, 23, 42, .07); }
  .chart-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
  .chart-header h2 { margin: 0; font-size: 1rem; }
  .chart-header p { margin: 3px 0 0; color: var(--muted); font-size: .72rem; line-height: 1.35; }
  .chart-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chart-row { display: grid; grid-template-columns: minmax(86px, 126px) minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .chart-name { overflow: hidden; color: #323946; font-size: .72rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .bar-track { display: block; height: 9px; overflow: hidden; border-radius: 999px; background: #edf0f5; }
  .bar-fill { display: block; width: var(--bar-width); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #405cf5, #7284ff); }
  .stack-width { display: block; width: var(--bar-width); height: 100%; }
  .stacked-bar { display: flex; width: 100%; height: 100%; overflow: hidden; border-radius: inherit; }
  .stacked-bar .amazing { width: var(--amazing-width); background: var(--amazing); }
  .stacked-bar .gorgeous { width: var(--gorgeous-width); background: var(--gorgeous); }
  .chart-value { color: var(--muted); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .chart-legend { display: flex; gap: 12px; align-items: center; color: var(--muted); font-size: .67rem; }
  .legend-item::before { display: inline-block; width: 8px; height: 8px; margin-right: 4px; border-radius: 999px; content: ''; }
  .legend-item.amazing::before { background: var(--amazing); }
  .legend-item.gorgeous::before { background: var(--gorgeous); }

  .toolbar { display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; max-width: 1120px; margin: 0 auto 10px; }
  .toolbar input, .toolbar select, .lucky-button { min-height: 42px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; background: #fff; color: var(--ink); font: inherit; font-size: .86rem; box-shadow: 0 1px 2px rgba(0, 0, 0, .03); }
  .toolbar input { width: min(300px, 100%); }
  .toolbar select { min-width: 145px; }
  .lucky-group { display: flex; align-items: stretch; }
  .lucky-group select { min-width: 128px; border-radius: 12px 0 0 12px; }
  .lucky-button { border-left: 0; border-radius: 0 12px 12px 0; background: #405cf5; color: #fff; font-weight: 800; cursor: pointer; }
  .lucky-button:hover { background: #354edb; }
  .lucky-button:disabled { cursor: not-allowed; opacity: .55; }
  .lucky-status { min-height: 18px; margin: 0 auto 4px; color: var(--muted); font-size: .72rem; }
  .results-row { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 28px; margin-bottom: 15px; color: var(--muted); font-size: .82rem; }
  .results-row p { margin: 0; }
  .clear-filters { border: 0; background: transparent; color: #314bd8; font: inherit; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

  .composer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(205px, 1fr)); gap: 18px; max-width: 1780px; margin: 0 auto; align-items: start; }
  .composer-card { min-width: 0; }
  .composer-button { width: 100%; padding: 0; overflow: hidden; border: 0; border-radius: 15px; background: var(--surface); color: inherit; text-align: left; cursor: pointer; box-shadow: 0 9px 24px rgba(15, 23, 42, .09); transition: transform .16s ease, box-shadow .16s ease; }
  .composer-button:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(15, 23, 42, .14); }
  .composer-button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .composer-button[aria-expanded='true'] { box-shadow: 0 0 0 2px var(--accent), 0 14px 30px rgba(15, 23, 42, .13); }
  .portrait-wrap { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #eef0f5; }
  .portrait { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 18%; transition: transform .25s ease; }
  .composer-button:hover .portrait { transform: scale(1.025); }
  .expand-cue { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 31px; height: 31px; border-radius: 999px; background: rgba(14, 18, 27, .78); color: #fff; font-size: 1.1rem; line-height: 1; backdrop-filter: blur(5px); }
  .composer-button[aria-expanded='true'] .expand-cue { transform: rotate(45deg); }
  .card-body { display: block; min-height: 154px; padding: 13px 14px 14px; }
  .composer-name { display: block; margin-bottom: 4px; font-size: 1rem; font-weight: 800; line-height: 1.25; }
  .composer-meta { display: block; min-height: 2.55em; color: var(--muted); font-size: .78rem; line-height: 1.35; }
  .composer-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 11px; }
  .stat { min-width: 0; padding: 7px 8px; border-radius: 9px; background: #f4f5f9; }
  .stat strong, .stat span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stat strong { color: var(--ink); font-size: .85rem; }
  .stat span { margin-top: 1px; color: var(--muted); font-size: .68rem; }
  .not-connected { display: block; margin-top: 12px; color: var(--muted); font-size: .74rem; font-style: italic; }

  .composer-detail-host { grid-column: 1 / -1; min-width: 0; }
  .composer-detail { padding: 21px; border: 1px solid rgba(64, 92, 245, .22); border-radius: 16px; background: rgba(255, 255, 255, .95); box-shadow: 0 16px 36px rgba(15, 23, 42, .11); scroll-margin-top: 18px; }
  .detail-header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 16px; }
  .detail-header h2 { margin: 0 0 5px; font-size: 1.4rem; }
  .detail-subtitle { margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.45; }
  .detail-actions { display: flex; gap: 8px; flex: 0 0 auto; }
  .reference-link, .close-detail { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 10px; font: inherit; font-size: .78rem; font-weight: 750; text-decoration: none; cursor: pointer; }
  .reference-link { border: 1px solid rgba(64, 92, 245, .25); background: #f0f2ff; color: #314bd8; }
  .close-detail { width: 36px; padding: 0; border: 1px solid var(--border); background: #fff; color: var(--ink); }
  .detail-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-bottom: 21px; }
  .detail-summary div { min-width: 0; padding: 10px 11px; border-radius: 11px; background: #f4f5f9; }
  .detail-summary strong, .detail-summary span { display: block; }
  .detail-summary strong { overflow: hidden; font-size: .95rem; text-overflow: ellipsis; white-space: nowrap; }
  .detail-summary span { margin-top: 2px; color: var(--muted); font-size: .68rem; }
  .detail-section + .detail-section { margin-top: 22px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 9px; }
  .section-heading h3 { margin: 0; font-size: 1rem; }
  .section-heading p { margin: 0; color: var(--muted); font-size: .72rem; }

  .revisit-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 9px; margin: 0; padding: 0; list-style: none; }
  .revisit-card { min-width: 0; padding: 11px 12px; border: 1px solid #eceef4; border-radius: 11px; background: #fff; }
  .revisit-top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
  .piece-title { display: block; color: var(--ink); font-size: .86rem; font-weight: 750; line-height: 1.35; }
  .piece-meta { display: block; margin-top: 5px; color: var(--muted); font-size: .72rem; line-height: 1.4; }
  .play-link { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 34px; height: 32px; padding: 0 9px; border-radius: 9px; background: #eef1ff; color: #314bd8; font-size: .72rem; font-weight: 800; text-decoration: none; }
  .play-link:hover { background: #dde3ff; }
  .play-missing { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 34px; height: 32px; border-radius: 9px; background: #f1f2f5; color: #8a909b; font-size: .72rem; }
  .rating { display: inline-block; margin-right: 5px; padding: 2px 6px; border-radius: 999px; font-weight: 800; }
  .rating.amazing { background: #edf0ff; color: #4054d8; }
  .rating.gorgeous { background: #f5eafa; color: #8d43ba; }
  .rating.other { background: #f0f1f4; color: #656c78; }

  .entry-toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) 170px 170px; gap: 8px; margin-bottom: 9px; }
  .entry-toolbar input, .entry-toolbar select { min-height: 39px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--ink); font: inherit; font-size: .78rem; }
  .entry-results { margin: 0 0 8px; color: var(--muted); font-size: .72rem; }
  .entry-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .entry-item { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; min-width: 0; padding: 10px 11px; border: 1px solid #eceef4; border-radius: 11px; background: #fff; }
  .entry-main { min-width: 0; }
  .entry-title { display: block; color: var(--ink); font-size: .82rem; font-weight: 750; line-height: 1.35; }
  .entry-meta { display: block; margin-top: 3px; color: var(--muted); font-size: .69rem; line-height: 1.35; }
  .entry-side { min-width: 96px; text-align: right; }
  .entry-side time, .entry-side span { display: block; color: var(--muted); font-size: .68rem; line-height: 1.35; }
  .show-more { display: block; min-height: 38px; margin: 11px auto 0; padding: 8px 14px; border: 1px solid rgba(64, 92, 245, .25); border-radius: 10px; background: #f0f2ff; color: #314bd8; font: inherit; font-size: .78rem; font-weight: 800; cursor: pointer; }
  .empty-detail { margin: 0; padding: 15px; border-radius: 11px; background: #f5f6f9; color: var(--muted); font-size: .86rem; line-height: 1.5; }
  .empty { grid-column: 1 / -1; padding: 40px 16px; color: var(--muted); text-align: center; }

  @media (max-width: 1050px) {
    .overall-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .detail-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .wrap { padding: 18px 10px 38px; }
    .intro { margin-bottom: 14px; padding-inline: 4px; }
    h1 { font-size: 2rem; }
    .hint, .tracking-note { font-size: .84rem; }
    .charts { grid-template-columns: 1fr; }
    .toolbar { display: grid; grid-template-columns: 1fr 1fr; }
    .toolbar > input { grid-column: 1 / -1; width: 100%; }
    .toolbar > select { min-width: 0; width: 100%; }
    .lucky-group { grid-column: 1 / -1; }
    .lucky-group select { flex: 1; min-width: 0; }
    .composer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; }
    .card-body { min-height: 145px; padding: 10px; }
    .composer-name { font-size: .88rem; }
    .composer-meta { font-size: .7rem; }
    .composer-stats { gap: 5px; }
    .stat { padding: 6px; }
    .stat strong { font-size: .74rem; }
    .stat span { font-size: .62rem; }
    .composer-detail { padding: 14px 12px; }
    .detail-header { display: block; }
    .detail-actions { margin-top: 11px; }
    .revisit-list { grid-template-columns: 1fr; }
    .entry-toolbar { grid-template-columns: 1fr 1fr; }
    .entry-toolbar input { grid-column: 1 / -1; }
  }

  @media (max-width: 620px) {
    .overall-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chart-row { grid-template-columns: 90px minmax(0, 1fr) auto; }
    .detail-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entry-item { grid-template-columns: auto minmax(0, 1fr); align-items: start; }
    .entry-side { grid-column: 2; min-width: 0; text-align: left; }
    .entry-side time, .entry-side span { display: inline; }
    .entry-side span::before { content: ' · '; }
  }

  @media (max-width: 520px) {
    .composer-grid { grid-template-columns: 1fr; max-width: 430px; }
    .composer-button { display: grid; grid-template-columns: 124px minmax(0, 1fr); }
    .portrait-wrap { height: 155px; aspect-ratio: 4 / 5; }
    .card-body { min-height: 155px; }
    .chart-card { padding: 13px 11px; }
    .chart-row { grid-template-columns: 78px minmax(0, 1fr) auto; gap: 6px; }
    .entry-toolbar { grid-template-columns: 1fr; }
    .entry-toolbar input { grid-column: auto; }
  }
</style>

<VideoBg>
  <Header />
  <main class="wrap">
