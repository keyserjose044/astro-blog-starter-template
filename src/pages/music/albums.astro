---
// src/pages/music/albums.astro
// Revision: internal album details, richer collection browsing, World/Timeline continuity — Aug 1, 2026
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VideoBg from '../../components/VideoBg.astro';
import { SITE_TITLE } from '../../consts';
import { fetchAllRaindrops } from '../../utils/raindrop';
import MusicNav from '../../components/MusicNav.astro';
import {
  formatAlbumDuration,
  getAlbumListenedYear,
  getAlbumReleaseInfo,
  parseAlbumLengthMinutes,
  parseAlbumMeta,
} from '../../utils/albumMetadata';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_ALBUMS_ID || '54514878';

const albums = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'albums',
  placeholder: '/images_webp/album-placeholder.webp',
  cleanVideoCovers: true,
  cleanVideoCoversAfter: '2026-07-20',
});

const totalListeningMinutes = Math.round(albums.reduce((total, album) => {
  const minutes = parseAlbumLengthMinutes(parseAlbumMeta(album.note).length);
  return total + (minutes ?? 0);
}, 0));

const totalListeningTime = formatAlbumDuration(totalListeningMinutes);
---

<BaseHead
  title={`${SITE_TITLE} — Music — Albums`}
  description="Explore my album-listening archive by artist, style, subgenre, mood, country, release period, and listening date."
/>

<VideoBg>
  <Header />
  <main class="albums-page">
    <MusicNav active="albums" />

    <div class="albums-intro" role="region" aria-label="Albums header">
      <h1>🎵 Albums</h1>
      <p class="albums-hint">
        {albums.length.toLocaleString('en-US')} full albums · <span>{totalListeningTime}</span> of intentional, front-to-back listening.
      </p>

      <div class="albums-toolbar">
        <input id="album-search" type="search" placeholder="Search album, artist, country, genre, or note…" aria-label="Search albums" />

        <button type="button" id="album-filters-toggle" class="albums-control-button" aria-controls="album-filters-panel" aria-expanded="false">
          <span>Filters</span>
          <span id="album-filters-count" class="albums-filter-count" hidden>0</span>
          <span class="albums-chevron" aria-hidden="true">▼</span>
        </button>

        <select id="album-sort" aria-label="Sort albums">
          <option value="date-desc">Newest listened</option>
          <option value="date-asc">Oldest listened</option>
          <option value="title-asc">Album A–Z</option>
          <option value="artist-asc">Artist A–Z</option>
          <option value="release-desc">Release: newest first</option>
          <option value="release-asc">Release: oldest first</option>
          <option value="length-desc">Longest</option>
          <option value="length-asc">Shortest</option>
        </select>

        <div class="albums-surprise" id="albums-surprise">
          <button type="button" id="albums-surprise-trigger" class="albums-control-button" aria-haspopup="menu" aria-expanded="false">
            <span aria-hidden="true">🎲</span>
            <span>Surprise Me</span>
            <span class="albums-chevron" aria-hidden="true">▼</span>
          </button>
          <div id="albums-surprise-menu" class="albums-surprise-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-surprise="album"><span>💿</span><span><strong>Random album</strong><small>Open one from the current results</small></span></button>
            <button type="button" role="menuitem" data-surprise="country"><span>🌍</span><span><strong>Random country</strong><small>Explore an artist origin</small></span></button>
            <button type="button" role="menuitem" data-surprise="style"><span>🎶</span><span><strong>Random style</strong><small>Jump into a broad genre</small></span></button>
            <button type="button" role="menuitem" data-surprise="release"><span>⌛</span><span><strong>Random release period</strong><small>Open a decade or century</small></span></button>
            <button type="button" role="menuitem" data-surprise="year"><span>🗓️</span><span><strong>Random listening year</strong><small>Revisit a year in the log</small></span></button>
          </div>
          <div id="albums-surprise-toast" class="albums-surprise-toast" role="status" aria-live="polite" hidden></div>
        </div>

        <button type="button" id="albums-info-toggle" class="albums-round-button" aria-label="About my album listening" aria-controls="albums-info" aria-expanded="false" aria-pressed="false">?</button>

        <a href="/stats/?metric=music&amp;year=current#graphs" class="albums-round-button" aria-label="View music stats" title="View music stats">📊</a>
      </div>

      <div id="album-filters-panel" class="albums-filters-panel" hidden>
        <label class="albums-filter-field"><span>Primary style</span><select id="album-style-filter"><option value="">All styles</option></select></label>
        <label class="albums-filter-field"><span>Subgenre</span><select id="album-subgenre-filter"><option value="">All subgenres</option></select></label>
        <label class="albums-filter-field"><span>Mood</span><select id="album-mood-filter"><option value="">All moods</option></select></label>
        <label class="albums-filter-field"><span>Country / origin</span><select id="album-country-filter"><option value="">All countries</option></select></label>
        <label class="albums-filter-field"><span>Year listened</span><select id="album-listened-year-filter"><option value="">All years</option></select></label>
        <label class="albums-filter-field"><span>Release period</span><select id="album-release-filter"><option value="">All release periods</option></select></label>
      </div>

      {albums.length > 0 ? (
        <div id="album-view-toggle" class="albums-view-toggle" role="group" aria-label="Choose album view">
          <button type="button" class="albums-view-button" data-album-view="list" aria-pressed="false"><span aria-hidden="true">▤</span><span>List</span></button>
          <button type="button" class="albums-view-button" data-album-view="quilt" aria-pressed="false"><span aria-hidden="true">▦</span><span>Quilt</span></button>
          <button type="button" class="albums-view-button" data-album-view="map" aria-pressed="false"><span aria-hidden="true">◎</span><span>World Map</span></button>
          <button type="button" class="albums-view-button" data-album-view="timeline" aria-pressed="false"><span aria-hidden="true">↝</span><span>Timeline</span></button>
        </div>
      ) : null}

      {albums.length > 0 ? (
        <div class="albums-results-row" aria-live="polite" aria-atomic="true">
          <p id="albums-results-summary">Showing {albums.length.toLocaleString('en-US')} of {albums.length.toLocaleString('en-US')} albums</p>
          <button type="button" id="albums-clear-filters" hidden>Clear filters</button>
        </div>
      ) : null}

      <section id="albums-info" class="albums-info-panel" hidden>
        <h2>Why I Log Albums</h2>
        <p>Music fills the stretches when an audiobook would demand too much attention. I log complete albums rather than shuffled playlists so the listening history remains a record of distinct works.</p>

        <h2>How the Metadata Works</h2>
        <p>The usual structure is <strong>Date · Album · Artist · Country · Primary Style · Subgenre · Mood · Length · Release Period</strong>. Older entries are sometimes sparse, so the page keeps unavailable fields out of the way rather than forcing them into the wrong category.</p>

        <h2>How to Browse</h2>
        <p>List and Quilt browse the collection itself. On desktop, Quilt adds a rich hover preview; clicking or tapping an album opens its LifeLoggerz details, while the ↗ control opens the original source. World Map uses artist-country metadata, including multinational labels such as USA/Italy. Timeline switches between album release history and the years when I listened.</p>
      </section>
    </div>

    {albums.length === 0 ? (
      <div class="albums-empty">Albums are temporarily unavailable because the Raindrop collection returned no items during the build.</div>
    ) : (
      <>
        <p id="albums-filter-empty" class="albums-empty" aria-live="polite" hidden>No albums match the current filters.</p>

        <section id="albums-explorer" class="albums-explorer" hidden aria-live="polite">
          <div id="albums-map-view" class="albums-explorer-view" hidden>
            <div class="albums-explorer-heading">
              <div>
                <p class="albums-eyebrow">Listening atlas</p>
                <h2>Where the artists come from</h2>
                <p>The map responds to the active filters. Multinational entries can count toward more than one country without duplicating the album total.</p>
              </div>
              <button type="button" class="albums-explorer-close" data-close-explorer aria-label="Close world map">×</button>
            </div>
            <div id="albums-map-metrics" class="albums-metrics"></div>
            <div class="albums-map-layout">
              <div id="albums-map-stage" class="albums-map-stage">
                <div id="albums-map-status" class="albums-map-status"><strong>Preparing the album map…</strong><span>Matching the country labels to a world atlas.</span></div>
                <div id="albums-map-tooltip" class="albums-map-tooltip" hidden></div>
              </div>
              <aside id="albums-country-panel" class="albums-country-panel" aria-label="Country details"></aside>
            </div>
            <p id="albums-map-note" class="albums-note"></p>
          </div>

          <div id="albums-timeline-view" class="albums-explorer-view" hidden>
            <div class="albums-explorer-heading">
              <div>
                <p class="albums-eyebrow">Music through time</p>
                <h2>The collection as a timeline</h2>
                <p>Move between when the music was released and when it entered my listening log. Selecting a period reveals its albums below.</p>
              </div>
              <button type="button" class="albums-explorer-close" data-close-explorer aria-label="Close timeline">×</button>
            </div>
            <div id="albums-timeline-metrics" class="albums-metrics"></div>
            <div class="albums-timeline-controls">
              <div role="group" aria-label="Timeline type">
                <button type="button" data-timeline-mode="release" aria-pressed="true">Release history</button>
                <button type="button" data-timeline-mode="listening" aria-pressed="false">My listening journey</button>
              </div>
              <p id="albums-timeline-help">Select a period to reveal its albums below.</p>
            </div>
            <div id="albums-timeline-content"></div>
          </div>

          <section id="albums-selection-shelf" class="albums-selection-shelf" hidden aria-live="polite">
            <div class="albums-selection-heading">
              <div>
                <h3 id="albums-selection-title">Selected albums</h3>
                <p id="albums-selection-summary"></p>
              </div>
              <button type="button" id="albums-selection-clear" class="albums-selection-clear">Clear selection</button>
            </div>
            <div id="albums-selection-grid" class="albums-selection-grid"></div>
          </section>
        </section>

        <div id="albums-grid" class="albums-grid" role="list" data-album-view="list">
          {albums.map((album, index) => {
            const meta = parseAlbumMeta(album.note);
            const release = getAlbumReleaseInfo(meta.yearReleased);
            const listenedYear = getAlbumListenedYear(meta.dateListened);
            const styleLine = [meta.style, meta.subgenre].filter(Boolean).join(' · ');
            const originLine = [meta.country, meta.mood].filter(Boolean).join(' · ');
            const listeningLine = [meta.dateListened ? `Listened ${meta.dateListened}` : '', meta.length].filter(Boolean).join(' · ');

            return (
              <article
                class="album-card"
                role="listitem"
                data-href={album.href}
                data-title={album.title}
                data-artist={meta.artist}
                data-country={meta.country}
                data-style={meta.style}
                data-subgenre={meta.subgenre}
                data-mood={meta.mood}
                data-date-listened={meta.dateListened}
                data-listened-year={listenedYear}
                data-release-label={release.label}
                data-release-year={release.year ?? ''}
                data-release-sort={release.sortYear ?? ''}
                data-release-period={release.periodKey}
                data-release-period-label={release.periodLabel}
                data-release-period-order={release.periodOrder}
                data-release-precision={release.precision}
                data-length={meta.length}
                data-length-minutes={parseAlbumLengthMinutes(meta.length) ?? ''}
                data-note-raw={album.note || ''}
                data-original-index={index}
              >
                <img class="album-cover" src={album.cover} alt={album.title} loading="lazy" decoding="async" sizes="(max-width: 559px) 112px, (max-width: 900px) 31vw, (min-width: 901px) 220px" />
                <div class="album-title">{album.title}</div>
                <div class="album-card-meta">
                  {meta.artist ? <span><strong>{meta.artist}</strong></span> : null}
                  {styleLine ? <span>{styleLine}</span> : null}
                  {originLine ? <span>{originLine}</span> : null}
                  {(release.label || listeningLine) ? <span>{[release.label !== 'Unknown' ? release.label : '', listeningLine].filter(Boolean).join(' · ')}</span> : null}
                </div>
                <button
                  type="button"
                  class="album-details-hit"
                  aria-label={`${album.title} — open album details`}
                  title="Open album details"
                ></button>
                <a
                  class="album-source-link"
                  href={album.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open the original source for ${album.title} in a new tab`}
                  title="Open original source"
                >↗</a>
              </article>
            );
          })}
        </div>

        <aside id="album-rich-preview" class="album-rich-preview" hidden aria-label="Album preview">
          <div class="album-rich-preview-shell">
            <img data-album-preview-image alt="" />
            <div class="album-rich-preview-copy">
              <p class="album-details-eyebrow" data-album-preview-date></p>
              <h3 data-album-preview-title></h3>
              <p class="album-details-artist" data-album-preview-artist></p>
              <dl data-album-preview-details></dl>
              <a class="album-details-source" data-album-preview-source target="_blank" rel="noopener noreferrer">Open original source <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </aside>

        <dialog id="album-details-dialog" class="album-details-dialog" aria-labelledby="album-details-title">
          <div class="album-details-shell">
            <button type="button" class="album-details-close" data-album-dialog-close aria-label="Close album details">×</button>
            <img data-album-dialog-image alt="" />
            <div class="album-details-copy">
              <p class="album-details-eyebrow" data-album-dialog-date></p>
              <h2 id="album-details-title" data-album-dialog-title></h2>
              <p class="album-details-artist" data-album-dialog-artist></p>
              <dl data-album-dialog-details></dl>
              <a class="album-details-source" data-album-dialog-source target="_blank" rel="noopener noreferrer">Open original source <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </dialog>
      </>
    )}
  </main>
  <Footer />
</VideoBg>
