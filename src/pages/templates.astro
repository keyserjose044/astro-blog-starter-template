---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import DownloadMeta from '../components/DownloadMeta.astro';
import VideoBg from '../components/VideoBg.astro';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

type Item = {
  title: string;
  description?: string;
  href: string;
  filetype: 'Google Sheet' | 'Excel' | 'PDF' | 'Word' | 'ZIP' | 'Other' | 'App';
  updated?: string;
  imageSrc?: string;
  imageAlt?: string;
  imageOrientation?: 'portrait' | 'landscape';
  postUrl?: string;
  downloadKey?: string;
  countOffset?: number;
};

const templates: Item[] = [
  {
    title: '2026 Raw Data Template (Google Sheets)',
    description: 'My 2026 life-tracking template: cleaner visuals, smarter formulas, and script-ready.',
    href: 'https://docs.google.com/spreadsheets/d/1bSoK1QHIGkvxMBjmG478fghTF-sZX2KH99Wd-KS7WVI/copy',
    filetype: 'Google Sheet',
    updated: 'Oct 2025',
    imageSrc: `${base}images/2026cleanrawdatatemplate.png`,
    imageAlt: '2026 Raw Data Template preview',
    imageOrientation: 'landscape',
    postUrl: `${base}blog/2026interactivegstemplate/`,
    downloadKey: 'template/2026-raw-data-template',
    // The current counter began at 6 after the key changed. Add 193 so the visible total resumes at 199.
    countOffset: 193,
  },
  {
    title: 'Weekly To-Do List Template',
    description: 'Simple, customizable weekly list with weekday blocks.',
    href: `${base}templates/Original-To-Do-List-Template.docx`,
    filetype: 'Word',
    updated: 'Oct 2025',
    imageSrc: `${base}templates/covers/todo-cover.png`,
    imageAlt: 'Preview of the To-Do List Template',
    imageOrientation: 'portrait',
    postUrl: `${base}blog/original-to-do-list-template/`,
  },
  {
    title: 'Research Paper Fill-In Template',
    description: 'Structured template for organized paper notes.',
    href: `${base}templates/Research-Paper-Fill-In-Template.docx`,
    filetype: 'Word',
    updated: 'Oct 2025',
    imageSrc: `${base}templates/covers/research-template-cover.png`,
    imageAlt: 'Preview of the Research Paper Fill-In Template',
    imageOrientation: 'portrait',
    postUrl: `${base}blog/research-paper-fill-in-template/`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Templates • Downloads"
      description="Download LifeLoggerz templates and read the guides explaining how each one is used."
    />
    <style>
      :root {
        --text: #0e121b;
        --muted: #5b6473;
        --accent: #405cf5;
        --ring: rgba(64, 92, 245, 0.25);
        --card: #f8fafc;
        --border: #e5e7eb;
      }

      .templates-page,
      .templates-page * {
        box-sizing: border-box;
      }

      .templates-page {
        display: block;
        inline-size: 100%;
        max-inline-size: 1120px;
        margin-inline: auto;
        padding: 2rem 1rem 4rem;
        overflow-x: hidden;
        contain: layout;
        text-align: center;
      }

      .templates-page section,
      .templates-page article,
      .templates-page .content {
        min-width: 0;
        max-inline-size: 100%;
      }

      .page-title {
        margin: 1.5rem 0 0.5rem;
        font-size: clamp(1.75rem, 3vw, 2.35rem);
        font-weight: 800;
        overflow-wrap: anywhere;
      }

      .subtitle {
        max-width: 760px;
        margin: 0 auto 2rem;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        gap: 1rem;
        align-items: stretch;
        inline-size: 100%;
        margin-inline: auto;
      }

      .card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        inline-size: 100%;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
        text-align: left;
        contain: content;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: #d5dcff;
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
      }

      .thumb {
        position: relative;
        display: block;
        inline-size: 100%;
        block-size: 300px;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        border-radius: 18px 18px 0 0;
        background: white;
        text-decoration: none;
      }

      .thumb img {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        margin: 0;
        padding: 0.35rem;
        border-radius: 0;
        background: white;
        object-fit: contain;
        transition: transform 0.3s ease, filter 0.3s ease;
      }

      .thumb:hover img {
        transform: scale(1.025);
        filter: brightness(0.94);
      }

      .thumb:focus-visible {
        outline: 4px solid var(--ring);
        outline-offset: -4px;
      }

      .guide-badge {
        position: absolute;
        z-index: 2;
        top: 0.8rem;
        left: 0.8rem;
        padding: 0.48rem 0.66rem;
        border: 1px solid rgba(64, 92, 245, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        color: #3049c9;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.1);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        line-height: 1;
        text-transform: uppercase;
        pointer-events: none;
      }

      .content {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        padding: 1.1rem 1rem 1rem;
        text-align: center;
      }

      .eyebrow,
      .card h3,
      .desc {
        min-width: 0;
        max-inline-size: 100%;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .eyebrow {
        color: var(--muted);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .card h3 {
        margin: 0.15rem 0;
        font-size: 1.08rem;
        line-height: 1.25;
      }

      .card h3 a {
        color: var(--text);
        text-decoration: none;
      }

      .card h3 a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      .card h3 a:focus-visible {
        outline: 3px solid var(--ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .desc {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.55;
      }

      .download-block {
        display: flex;
        width: 100%;
        margin-top: auto;
        padding-top: 0.45rem;
        align-items: center;
        justify-content: center;
      }

      @media (max-width: 768px) {
        .templates-page {
          padding-inline: clamp(1rem, 4vw, 2rem);
        }

        .grid {
          grid-template-columns: 1fr !important;
          justify-items: center;
        }

        .card {
          max-width: 520px;
          margin-inline: auto;
        }

        .card h3 {
          font-size: clamp(1rem, 4.5vw, 1.15rem);
        }

        .thumb {
          block-size: 280px;
        }
      }

      @media (max-width: 420px) {
        .thumb {
          block-size: 240px;
        }

        .guide-badge {
          top: 0.6rem;
          left: 0.6rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .card,
        .thumb img {
          transition: none;
        }

        .card:hover,
        .thumb:hover img {
          transform: none;
        }
      }
    </style>
  </head>

  <body>
    <VideoBg>
      <Header />
      <main class="templates-page">
        <h1 class="page-title">Templates & Downloads</h1>
        <p class="subtitle">
          Ready-to-use files for time-tracking, research, and productivity. Each template includes a short guide explaining how I use it.
        </p>

        <section class="grid" aria-label="Available templates">
          {templates.map((t) => (
            <article class="card">
              {t.imageSrc && (
                <a
                  class:list={[
                    'thumb',
                    (t.imageOrientation ?? 'portrait') === 'landscape'
                      ? 'landscape'
                      : 'portrait',
                  ]}
                  href={t.postUrl ?? t.href}
                  aria-label={t.postUrl ? `Read the guide for ${t.title}` : `Open ${t.title}`}
                >
                  <img src={t.imageSrc} alt={t.imageAlt ?? t.title} loading="lazy" />
                  {t.postUrl && <span class="guide-badge">Guide included</span>}
                </a>
              )}

              <div class="content">
                <div class="eyebrow">{t.filetype}</div>
                <h3>
                  {t.postUrl ? <a href={t.postUrl}>{t.title}</a> : t.title}
                </h3>
                {t.description && <p class="desc">{t.description}</p>}

                <div class="download-block">
                  <DownloadMeta
                    href={t.href}
                    updated={t.updated!}
                    text={t.filetype === 'Google Sheet' ? 'Make a copy' : 'Download'}
                    guideHref={t.postUrl}
                    guideText="View guide"
                    downloadKey={t.downloadKey}
                    countOffset={t.countOffset}
                  />
                </div>
              </div>
            </article>
          ))}
        </section>
      </main>
      <Footer />
    </VideoBg>
  </body>
</html>
