---
// src/pages/templates.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import DownloadMeta from '../components/DownloadMeta.astro';
import VideoBg from '../components/VideoBg.astro';

// GitHub Pages–safe base URL handling
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

type Item = {
  title: string;
  description?: string;
  href: string; // download link
  filetype: 'Google Sheet' | 'Excel' | 'PDF' | 'Word' | 'ZIP' | 'Other' | 'App';
  updated?: string;
  imageSrc?: string;
  imageAlt?: string;
  imageOrientation?: 'portrait' | 'landscape';
  postUrl?: string; // optional blog post link
  downloadKey?: string; // optional KV/download counter key
};

const templates: Item[] = [
  {
    title: '2026 Raw Data Template (Google Sheets)',
    description: 'My 2026 life-tracking template: cleaner visuals, smarter formulas, and script-ready.',
    href: 'https://docs.google.com/spreadsheets/d/1bSoK1QHIGkvxMBjmG478fghTF-sZX2KH99Wd-KS7WVI/copy',
    filetype: 'Google Sheet',
    updated: 'Oct 2025',
    imageSrc: `${base}images/2026cleanrawdatatemplate.png`,
    imageAlt: '2026 Raw Data Template preview',
    imageOrientation: 'landscape',
    postUrl: `${base}blog/2026interactivegstemplate/`,
    downloadKey: 'template/2026-raw-data-template',
  },

/*
  // New StudyTimer card
  {
    title: 'StudyTimer (Windows)',
    description:
      'A custom study timer app I use in my own workflow to track exact time spent working, packaged as a Windows .exe.',
    href: 'https://drive.google.com/uc?export=download&id=1NQiGppbn5UM5vrc66gBMaUwQPAlk5Nk9',
    filetype: 'App',
    updated: 'Nov 2025',
    imageSrc: `${base}images/studytimer.png`,
    imageAlt: 'StudyTimer app preview',
    imageOrientation: 'landscape',
    postUrl: `${base}blog/studytimer/`,
  },
*/

  {
    title: 'Weekly To-Do List Template',
    description: 'Simple, customizable weekly list with weekday blocks.',
    href: `${base}templates/Original-To-Do-List-Template.docx`,
    filetype: 'Word',
    updated: 'Oct 2025',
    imageSrc: `${base}templates/covers/todo-cover.png`,
    imageAlt: 'Preview of the To-Do List Template',
    imageOrientation: 'portrait',
    postUrl: `${base}blog/original-to-do-list-template/`,
  },
  {
    title: 'Research Paper Fill-In Template',
    description: 'Structured template for organized paper notes.',
    href: `${base}templates/Research-Paper-Fill-In-Template.docx`,
    filetype: 'Word',
    updated: 'Oct 2025',
    imageSrc: `${base}templates/covers/research-template-cover.png`,
    imageAlt: 'Preview of the Research Paper Fill-In Template',
    imageOrientation: 'portrait',
    postUrl: `${base}blog/research-paper-fill-in-template/`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Templates • Downloads"
      description="Download LifeLoggerz templates and read the guides explaining how each one is used."
    />
    <style>
      :root {
        --bg: #ffffff;
        --text: #0e121b;
        --muted: #5b6473;
        --accent: #405cf5;
        --ring: rgba(64, 92, 245, 0.25);
        --card: #f8fafc;
        --border: #e5e7eb;
      }

      .templates-page,
      .templates-page * { box-sizing: border-box; }

      .templates-page {
        display: block;
        inline-size: 100%;
        max-inline-size: 1120px;
        margin-inline: auto;
        padding: 2rem 1rem 4rem;
        text-align: center;
        overflow-x: hidden;
        contain: layout;
      }

      .templates-page section,
      .templates-page article,
      .templates-page .content {
        min-width: 0;
        max-inline-size: 100%;
      }

      .templates-page img,
      .templates-page video,
      .templates-page figure {
        display: block;
        max-inline-size: 100%;
        height: auto;
        margin-inline: auto;
      }

      .page-title {
        margin: 1.5rem 0 0.5rem;
        font-size: clamp(1.75rem, 3vw, 2.35rem);
        font-weight: 800;
        overflow-wrap: anywhere;
      }

      .subtitle {
        max-width: 760px;
        color: var(--muted);
        margin: 0 auto 2rem;
        font-size: 1.05rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        justify-items: stretch;
        align-items: stretch;
        margin-inline: auto;
        inline-size: 100%;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        inline-size: 100%;
        min-width: 0;
        text-align: left;
        contain: content;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: #d5dcff;
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
      }

      .thumb {
        position: relative;
        display: block;
        block-size: 300px;
        background: white;
        border-bottom: 1px solid var(--border);
        overflow: hidden;
        border-radius: 18px 18px 0 0;
        inline-size: 100%;
        text-decoration: none;
      }

      .thumb img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: contain;
        background: white;
        padding: 0.35rem;
        transition: transform 0.3s ease, filter 0.3s ease;
        display: block;
      }

      .thumb:hover img {
        transform: scale(1.025);
        filter: brightness(0.94);
      }

      .thumb:focus-visible {
        outline: 4px solid var(--ring);
        outline-offset: -4px;
      }

      .guide-badge,
      .thumb-cta {
        position: absolute;
        z-index: 2;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1;
        pointer-events: none;
      }

      .guide-badge {
        top: 0.8rem;
        left: 0.8rem;
        padding: 0.48rem 0.66rem;
        background: rgba(255, 255, 255, 0.94);
        color: #3049c9;
        border: 1px solid rgba(64, 92, 245, 0.25);
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.1);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .thumb-cta {
        right: 0.8rem;
        bottom: 0.8rem;
        padding: 0.58rem 0.78rem;
        background: rgba(14, 18, 27, 0.9);
        color: white;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.22);
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .thumb:hover .thumb-cta {
        transform: translateX(2px);
        background: #405cf5;
      }

      .content {
        flex: 1;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        text-align: center;
      }

      .eyebrow,
      .card h3,
      .desc {
        overflow-wrap: anywhere;
        word-break: break-word;
        min-width: 0;
        max-inline-size: 100%;
      }

      .eyebrow {
        font-size: 0.76rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .card h3 {
        margin: 0.15rem 0;
        font-size: 1.08rem;
        line-height: 1.25;
      }

      .card h3 a {
        color: var(--text);
        text-decoration: none;
      }

      .card h3 a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      .card h3 a:focus-visible {
        outline: 3px solid var(--ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .desc {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.55;
      }

      .download-block {
        width: 100%;
        margin-top: auto;
        padding-top: 0.55rem;
      }

      @media (max-width: 768px) {
        .templates-page { padding-inline: clamp(1rem, 4vw, 2rem); }
        .grid { grid-template-columns: 1fr !important; justify-items: center; text-align: center; }
        .card { max-width: 520px; text-align: center; }
        .card h3 { font-size: clamp(1rem, 4.5vw, 1.15rem); }
        .thumb { block-size: 280px; }
      }

      @media (max-width: 420px) {
        .thumb { block-size: 240px; }
        .guide-badge { top: 0.6rem; left: 0.6rem; }
        .thumb-cta { right: 0.6rem; bottom: 0.6rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .card,
        .thumb img,
        .thumb-cta { transition: none; }
        .card:hover,
        .thumb:hover img,
        .thumb:hover .thumb-cta { transform: none; }
      }
    </style>
  </head>

  <body>
    <VideoBg>
      <Header />
      <main class="templates-page">
        <h1 class="page-title">Templates & Downloads</h1>
        <p class="subtitle">
          Ready-to-use files for time-tracking, research, and productivity. Each template includes a short guide explaining how I use it.
        </p>

        <section class="grid" aria-label="Available templates">
          {templates.map((t) => (
            <article class="card">
              {t.imageSrc && (
                <a
                  class:list={[
                    'thumb',
                    (t.imageOrientation ?? 'portrait') === 'landscape'
                      ? 'landscape'
                      : 'portrait',
                  ]}
                  href={t.postUrl ?? t.href}
                  aria-label={t.postUrl ? `Read the guide for ${t.title}` : `Open ${t.title}`}
                >
                  <img src={t.imageSrc} alt={t.imageAlt ?? t.title} loading="lazy" />
                  {t.postUrl && <span class="guide-badge">Guide included</span>}
                  {t.postUrl && <span class="thumb-cta">View guide →</span>}
                </a>
              )}
              <div class="content">
                <div class="eyebrow">{t.filetype}</div>
                <h3>
                  {t.postUrl ? <a href={t.postUrl}>{t.title}</a> : t.title}
                </h3>
                {t.description && <p class="desc">{t.description}</p>}
                <div class="download-block">
                  <DownloadMeta
                    href={t.href}
                    updated={t.updated!}
                    text={t.filetype === 'Google Sheet' ? 'Make a copy' : 'Download'}
                    secondaryHref={t.postUrl}
                    secondaryText="Read guide"
                    downloadKey={t.downloadKey}
                  />
                </div>
              </div>
            </article>
          ))}
        </section>
      </main>
      <Footer />
    </VideoBg>
  </body>
</html>
