---
import Layout from '../layouts/BlogPost.astro';
import DailyDataRuntime from '../components/DailyDataRuntime.astro';
---

<Layout
  title="Day Explorer"
  description="Explore one public-safe day from the LifeLoggerz archive, compare it with nearby days and yearly baselines, and revisit the same date across years."
  wide={true}
  hideTitle={true}
  showViews={false}
>
  <main class="day-explorer" data-day-explorer aria-busy="true">
    <section class="day-hero" aria-labelledby="day-title">
      <div class="day-hero__glow" aria-hidden="true"></div>
      <div class="day-hero__copy">
        <p class="day-eyebrow">LifeLoggerz public archive</p>
        <h1 id="day-title">Day Explorer</h1>
        <p class="day-hero__lede">
          Move through the archive one day at a time. See what happened numerically, what stood out,
          the days around it, and how the same date changed across years—without exposing private notes,
          people, places, or raw meals.
        </p>
      </div>
      <div class="day-hero__status" data-day-status data-state="loading" role="status">
        <span aria-hidden="true"></span>
        <strong>Connecting to the daily archive…</strong>
      </div>
    </section>

    <nav class="day-toolbar" aria-label="Choose an archive day">
      <button class="day-nav-button" type="button" data-day-previous aria-label="Previous day">←</button>

      <label class="day-field day-field--date">
        <span>Date</span>
        <input id="day-date" type="date" />
      </label>

      <button class="day-nav-button" type="button" data-day-next aria-label="Next day">→</button>

      <label class="day-field day-field--year">
        <span>Year</span>
        <select data-day-year aria-label="Choose archive year"></select>
      </label>

      <button class="day-action-button" type="button" data-day-latest>Latest complete</button>
      <button class="day-action-button" type="button" data-day-current>Current record</button>
      <button class="day-action-button" type="button" data-day-random>🎲 Surprise me</button>
      <a class="day-action-button day-action-button--link" href="/stats/">Back to Stats</a>
    </nav>

    <section class="day-scrubber" aria-labelledby="day-scrubber-heading">
      <div>
        <p class="day-eyebrow">Year timeline</p>
        <h2 id="day-scrubber-heading" data-scrub-label>Archive year</h2>
      </div>
      <output data-scrub-output>—</output>
      <input data-day-scrubber type="range" min="1" max="365" value="1" aria-label="Day of selected year" />
    </section>

    <div class="day-error" data-day-error role="alert" hidden></div>

    <section class="selected-day" aria-labelledby="selected-day-heading">
      <div>
        <p class="day-eyebrow" data-selected-weekday>Selected day</p>
        <h2 id="selected-day-heading" data-selected-date>Loading date…</h2>
        <p class="selected-day__meta">
          <span data-day-number>Day — of the year</span>
          <span aria-hidden="true">·</span>
          <span data-record-state>Loading record state</span>
        </p>
      </div>
      <div class="selected-day__facts" aria-label="Selected day summary">
        <span data-completeness>— fields recorded</span>
        <span data-active-count>— active pursuits</span>
        <span data-day-marker>No day marker</span>
        <button class="day-copy-button" type="button" data-day-copy>Copy this day</button>
      </div>
    </section>

    <section class="day-section" aria-labelledby="overview-heading">
      <div class="day-section__heading">
        <div>
          <p class="day-eyebrow">Daily snapshot</p>
          <h2 id="overview-heading">The day in numbers</h2>
        </div>
        <p>Eight high-signal measures first. Recorded zeroes, unavailable values, and partial records remain visually distinct.</p>
      </div>
      <div class="day-metric-grid" data-day-metrics aria-live="polite"></div>
      <div class="day-state-legend" aria-label="Data state legend">
        <span><i data-state="recorded"></i>Recorded</span>
        <span><i data-state="zero"></i>Recorded zero</span>
        <span><i data-state="missing"></i>Unavailable</span>
        <span><i data-state="partial"></i>Partial record</span>
      </div>
    </section>

    <section class="day-section day-section--standouts" aria-labelledby="standouts-heading">
      <div class="day-section__heading">
        <div>
          <p class="day-eyebrow">Selected-year context</p>
          <h2 id="standouts-heading">What stood out about this day?</h2>
        </div>
        <p>Deterministic comparisons against the selected year—not generated commentary.</p>
      </div>
      <div class="day-highlight-grid" data-day-highlights aria-live="polite">
        <p>Loading what stood out…</p>
      </div>
      <div class="day-comparison-wrap">
        <div class="day-comparison-heading">
          <strong>All tracked comparisons</strong>
          <span data-baseline-year>Year</span>
        </div>
        <div class="day-comparison" data-day-comparison aria-live="polite"></div>
      </div>
    </section>

    <section class="day-section day-grid-two" aria-label="Narrative and context">
      <article class="day-panel day-panel--summary" aria-labelledby="summary-heading">
        <div class="day-panel__heading">
          <div>
            <p class="day-eyebrow">Public-safe summary</p>
            <h2 id="summary-heading">What this day says</h2>
          </div>
          <span>Curated only</span>
        </div>
        <div class="day-summary" data-day-summary>
          <strong>Loading public summary…</strong>
          <p>Only manually approved summary fields can appear here.</p>
        </div>
      </article>

      <article class="day-panel" aria-labelledby="context-heading">
        <div class="day-panel__heading">
          <div>
            <p class="day-eyebrow">Daily context</p>
            <h2 id="context-heading">Weather, meals, and media</h2>
          </div>
          <span>Public-safe</span>
        </div>
        <div class="day-context-grid" data-day-context></div>
      </article>
    </section>

    <section class="day-section day-grid-two" aria-label="Temporal context">
      <article class="day-panel" aria-labelledby="week-heading">
        <div class="day-panel__heading">
          <div>
            <p class="day-eyebrow">Seven-day neighborhood</p>
            <h2 id="week-heading">The days around it</h2>
          </div>
          <span>± 3 days</span>
        </div>
        <p class="day-panel__note">Click any nearby day to move through the archive without losing context.</p>
        <div class="day-week-strip" data-day-week aria-live="polite"></div>
      </article>

      <article class="day-panel day-panel--guide" aria-labelledby="guide-heading">
        <div class="day-panel__heading">
          <div>
            <p class="day-eyebrow">How to explore</p>
            <h2 id="guide-heading">Move through the archive</h2>
          </div>
          <span>Interactive</span>
        </div>
        <div class="day-guide-grid">
          <div><strong>← / →</strong><span>Move one day</span></div>
          <div><strong>Year</strong><span>Keep month/day, change year</span></div>
          <div><strong>Timeline</strong><span>Scrub anywhere in a year</span></div>
          <div><strong>🎲</strong><span>Jump to an actual archived day</span></div>
        </div>
      </article>
    </section>

    <details class="day-details">
      <summary>
        <span>
          <small>Record detail</small>
          <strong>Show tracked durations and activity states</strong>
        </span>
        <span class="day-details__chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="day-details__body day-grid-two">
        <article class="day-panel" aria-labelledby="durations-heading">
          <div class="day-panel__heading">
            <div>
              <p class="day-eyebrow">Tracked durations</p>
              <h2 id="durations-heading">Time-bearing activities</h2>
            </div>
            <span>May overlap</span>
          </div>
          <p class="day-panel__note">These durations are not a 24-hour budget. Audiobooks, treadmill walking, and work can overlap.</p>
          <div class="day-duration-list" data-day-durations></div>
        </article>

        <article class="day-panel" aria-labelledby="activities-heading">
          <div class="day-panel__heading">
            <div>
              <p class="day-eyebrow">Habits and activities</p>
              <h2 id="activities-heading">What was logged</h2>
            </div>
            <span>Zero ≠ missing</span>
          </div>
          <div class="day-activity-list" data-day-activities></div>
        </article>
      </div>
    </details>

    <section class="day-section" aria-labelledby="same-date-heading">
      <div class="day-section__heading">
        <div>
          <p class="day-eyebrow">Across the archive</p>
          <h2 id="same-date-heading">The same date in other years</h2>
        </div>
        <p>Keep the month and day fixed to see how the surrounding life changed from year to year.</p>
      </div>
      <div class="same-date-grid" data-same-date-grid aria-live="polite"></div>
    </section>

    <section class="day-callout">
      <div>
        <p class="day-eyebrow">Zoom out</p>
        <h2>One day is a record. Repetition becomes a pattern.</h2>
        <p>Use the Stats Explorer to move from this individual record to daily, weekly, monthly, cumulative, and lifetime views.</p>
      </div>
      <a href="/stats/#graphs">Open the Stats Explorer <span aria-hidden="true">→</span></a>
    </section>

    <p class="day-keyboard-hint">Keyboard: ←/→ move one day · L latest complete · R surprise me</p>
    <span class="day-sr-status" data-day-live-region aria-live="polite"></span>
  </main>

  <DailyDataRuntime />
</Layout>
