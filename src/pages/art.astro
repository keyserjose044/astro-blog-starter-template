---
// src/pages/art.astro
// Revision: Gallery, List, Artists, Timeline, World Map, filters, surprises, and artwork viewer — July 2026
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoBg from '../components/VideoBg.astro';
import { SITE_TITLE } from '../consts';
import { fetchAllRaindrops } from '../utils/raindrop';
import { getArtworkDateInfo, getArtViewedYear, parseArtMeta } from '../utils/artMetadata';

const RAINDROP_TOKEN = import.meta.env.RAINDROP_TOKEN;
const COLLECTION_ID = import.meta.env.RAINDROP_COLLECTION_ART_ID || '58506976';

const art = await fetchAllRaindrops({
  token: RAINDROP_TOKEN,
  collectionId: COLLECTION_ID,
  label: 'art',
  placeholder: '/images_webp/art-placeholder.webp',
});

const metadata = art.map((item) => parseArtMeta(item.note));
const artistCount = new Set(metadata.map((meta) => meta.artist.trim().toLowerCase()).filter(Boolean)).size;
---

<BaseHead
  title={`${SITE_TITLE} — Art`}
  description="Explore my visual diary by artwork, artist, movement, medium, country, art-historical period, and viewing date."
/>

<VideoBg>
  <Header />
  <main class="art-page">
    <div class="art-intro" role="region" aria-label="Art header">
      <h1>🎨 Art</h1>
      <p class="art-hint">
        One small museum visit a day through
        <a href="https://getdailyart.com" target="_blank" rel="noopener noreferrer"><strong>DailyArt</strong></a>:
        {art.length.toLocaleString('en-US')} works by {artistCount.toLocaleString('en-US')} artists.
      </p>

      <div class="art-toolbar">
        <input id="art-search" type="search" placeholder="Search artwork, artist, country, movement, or note…" aria-label="Search artworks" />

        <button type="button" id="art-filters-toggle" class="art-control-button" aria-controls="art-filters-panel" aria-expanded="false">
          <span>Filters</span>
          <span id="art-filters-count" class="art-filter-count" hidden>0</span>
          <span class="art-chevron" aria-hidden="true">▼</span>
        </button>

        <select id="art-sort" aria-label="Sort artworks">
          <option value="date-desc">Newest viewed</option>
          <option value="date-asc">Oldest viewed</option>
          <option value="title-asc">Artwork A–Z</option>
          <option value="artist-asc">Artist A–Z</option>
          <option value="artwork-desc">Artwork: newest first</option>
          <option value="artwork-asc">Artwork: oldest first</option>
        </select>

        <div class="art-surprise" id="art-surprise">
          <button type="button" id="art-surprise-trigger" class="art-control-button" aria-haspopup="menu" aria-expanded="false">
            <span aria-hidden="true">🎲</span><span>Surprise Me</span><span class="art-chevron" aria-hidden="true">▼</span>
          </button>
          <div id="art-surprise-menu" class="art-surprise-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-surprise="artwork"><span>🖼️</span><span><strong>Random artwork</strong><small>Open one from the current results</small></span></button>
            <button type="button" role="menuitem" data-surprise="artist"><span>👤</span><span><strong>Random artist</strong><small>Explore one artist's works</small></span></button>
            <button type="button" role="menuitem" data-surprise="movement"><span>🎨</span><span><strong>Random movement</strong><small>Enter an artistic tradition</small></span></button>
            <button type="button" role="menuitem" data-surprise="country"><span>🌍</span><span><strong>Random country</strong><small>Explore a recorded origin</small></span></button>
            <button type="button" role="menuitem" data-surprise="period"><span>⌛</span><span><strong>Random historical period</strong><small>Jump through art history</small></span></button>
            <button type="button" role="menuitem" data-surprise="year"><span>🗓️</span><span><strong>Random viewing year</strong><small>Revisit a year in the diary</small></span></button>
          </div>
          <div id="art-surprise-toast" class="art-surprise-toast" role="status" aria-live="polite" hidden></div>
        </div>

        <button type="button" id="art-info-toggle" class="art-round-button" aria-label="About my art viewing" aria-controls="art-info" aria-expanded="false" aria-pressed="false">?</button>
      </div>

      <div id="art-filters-panel" class="art-filters-panel" hidden>
        <label class="art-filter-field"><span>Artist</span><select id="art-artist-filter"><option value="">All artists</option></select></label>
        <label class="art-filter-field"><span>Movement</span><select id="art-movement-filter"><option value="">All movements</option></select></label>
        <label class="art-filter-field"><span>Medium</span><select id="art-medium-filter"><option value="">All media</option></select></label>
        <label class="art-filter-field"><span>Country / origin</span><select id="art-country-filter"><option value="">All countries</option></select></label>
        <label class="art-filter-field"><span>Year viewed</span><select id="art-viewed-year-filter"><option value="">All years</option></select></label>
        <label class="art-filter-field"><span>Historical period</span><select id="art-period-filter"><option value="">All periods</option></select></label>
      </div>

      {art.length > 0 ? (
        <div id="art-view-toggle" class="art-view-toggle" role="group" aria-label="Choose art view">
          <button type="button" class="art-view-button" data-art-view="gallery" aria-pressed="false"><span aria-hidden="true">▦</span><span>Gallery</span></button>
          <button type="button" class="art-view-button" data-art-view="list" aria-pressed="false"><span aria-hidden="true">▤</span><span>List</span></button>
          <button type="button" class="art-view-button" data-art-view="artists" aria-pressed="false"><span aria-hidden="true">◉</span><span>Artists</span></button>
          <button type="button" class="art-view-button" data-art-view="timeline" aria-pressed="false"><span aria-hidden="true">↝</span><span>Timeline</span></button>
          <button type="button" class="art-view-button" data-art-view="map" aria-pressed="false"><span aria-hidden="true">◎</span><span>World Map</span></button>
        </div>
      ) : null}

      {art.length > 0 ? (
        <div class="art-results-row" aria-live="polite" aria-atomic="true">
          <p id="art-results-summary">Showing {art.length.toLocaleString('en-US')} of {art.length.toLocaleString('en-US')} artworks</p>
          <button type="button" id="art-clear-filters" hidden>Clear filters</button>
        </div>
      ) : null}

      <section id="art-info" class="art-info-panel" hidden>
        <h2>A visual diary</h2>
        <p>I view one work at a time, read its story, and keep a structured record of the encounter. This is a personal collection explorer rather than a claim to a complete art-historical catalog.</p>
        <h2>How to browse</h2>
        <p>Gallery provides a stable framed overview without cropping the works. List exposes the metadata. Artists groups the collection by creator. Timeline moves between art history and my viewing journey. World Map uses the recorded country or nationality field when it can be matched confidently.</p>
        <h2>Metadata</h2>
        <p>The archive supports both <strong>Date · Title · Artist · Country · Medium · Movement · Year · Source</strong> and <strong>Date · Title · Artist · Year · Medium · Movement · Country · Source</strong>. Dates and historical groupings are approximate when entries use ranges, “circa,” or century labels.</p>
      </section>
    </div>

    {art.length === 0 ? (
      <div class="art-empty">Art is temporarily unavailable because the Raindrop collection returned no items during the build.</div>
    ) : (
      <>
        <p id="art-filter-empty" class="art-empty" aria-live="polite" hidden>No artworks match the current filters.</p>

        <section id="art-explorer" class="art-explorer" hidden aria-live="polite">
          <div id="art-artists-view" class="art-explorer-view" hidden>
            <div class="art-explorer-heading"><div><p class="art-eyebrow">People behind the collection</p><h2>Artists in my visual diary</h2><p>Artists are grouped from the current filters. Open a card to see the works represented in this archive.</p></div><button type="button" class="art-explorer-close" data-close-explorer aria-label="Close artists view">×</button></div>
            <div id="art-artists-metrics" class="art-metrics"></div>
            <div id="art-artists-content"></div>
          </div>

          <div id="art-timeline-view" class="art-explorer-view" hidden>
            <div class="art-explorer-heading"><div><p class="art-eyebrow">Art through time</p><h2>The collection as a timeline</h2><p>Move between the history of the works and the years when they entered my life.</p></div><button type="button" class="art-explorer-close" data-close-explorer aria-label="Close timeline">×</button></div>
            <div id="art-timeline-metrics" class="art-metrics"></div>
            <div class="art-timeline-controls">
              <div role="group" aria-label="Timeline type"><button type="button" data-timeline-mode="history" aria-pressed="true">Art history</button><button type="button" data-timeline-mode="viewing" aria-pressed="false">My viewing journey</button></div>
              <p id="art-timeline-help">Select a period to apply it as a filter.</p>
            </div>
            <div id="art-timeline-content"></div>
          </div>

          <div id="art-map-view" class="art-explorer-view" hidden>
            <div class="art-explorer-heading"><div><p class="art-eyebrow">Cultural atlas</p><h2>Where the recorded origins point</h2><p>The map uses the country or nationality stored with each work. Demonyms such as Dutch or French are matched to modern countries when possible.</p></div><button type="button" class="art-explorer-close" data-close-explorer aria-label="Close world map">×</button></div>
            <div id="art-map-metrics" class="art-metrics"></div>
            <div class="art-map-layout">
              <div id="art-map-stage" class="art-map-stage"><div id="art-map-status" class="art-map-status"><strong>Preparing the art map…</strong><span>Matching recorded origins to a world atlas.</span></div><div id="art-map-tooltip" class="art-map-tooltip" hidden></div></div>
              <aside id="art-country-panel" class="art-country-panel" aria-label="Country details"></aside>
            </div>
            <p id="art-map-note" class="art-note"></p>
          </div>
        </section>

        <div id="art-grid" class="art-grid" role="list" data-art-view="gallery">
          {art.map((item, index) => {
            const meta = parseArtMeta(item.note);
            const viewedYear = getArtViewedYear(meta.dateViewed);
            const dateInfo = getArtworkDateInfo(meta.artworkYear);
            return (
              <a class="art-card" role="listitem" href={item.href} target="_blank" rel="noopener noreferrer" title={`${item.title} — open artwork viewer`}
                data-title={item.title} data-artist={meta.artist} data-country={meta.country} data-medium={meta.medium} data-movement={meta.movement}
                data-date-viewed={meta.dateViewed} data-viewed-year={viewedYear} data-artwork-label={dateInfo.label} data-artwork-year={dateInfo.year ?? ''}
                data-artwork-sort={dateInfo.sortYear ?? ''} data-artwork-precision={dateInfo.precision} data-artwork-period={dateInfo.periodKey}
                data-artwork-period-label={dateInfo.periodLabel} data-artwork-period-order={dateInfo.periodOrder} data-source={meta.source}
                data-cover={item.cover} data-cover-fallbacks={JSON.stringify(item.coverFallbacks)} data-href={item.href} data-note-raw={item.note || ''} data-original-index={index}>
                <figure class="art-card-figure"><img class="art-cover" src={item.cover} data-cover-fallbacks={JSON.stringify(item.coverFallbacks)} alt={item.title} loading={index < 12 ? 'eager' : 'lazy'} decoding="async" /><figcaption class="art-gallery-caption"><strong>{item.title}</strong>{meta.artist ? <span>{meta.artist}</span> : null}</figcaption></figure>
                <div class="art-card-copy">
                  <div class="art-title">{item.title}<span aria-hidden="true">↗</span><span class="sr-only"> (opens artwork viewer)</span></div>
                  <div class="art-card-meta">
                    {meta.artist ? <span><strong>{meta.artist}</strong></span> : null}
                    {meta.movement || meta.artworkYear ? <span>{[meta.movement, meta.artworkYear].filter(Boolean).join(' · ')}</span> : null}
                    {meta.medium || meta.country ? <span>{[meta.medium, meta.country].filter(Boolean).join(' · ')}</span> : null}
                    {meta.dateViewed ? <span>Viewed {meta.dateViewed}</span> : null}
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <dialog id="art-viewer" class="art-viewer" aria-labelledby="art-viewer-title">
          <button type="button" id="art-viewer-close" class="art-viewer-close" aria-label="Close artwork viewer">×</button>
          <div class="art-viewer-layout">
            <div class="art-viewer-image-stage"><img id="art-viewer-image" alt="" /></div>
            <div class="art-viewer-copy">
              <p class="art-eyebrow">Artwork viewer</p><h2 id="art-viewer-title"></h2><p id="art-viewer-artist" class="art-viewer-artist"></p>
              <dl id="art-viewer-details" class="art-viewer-details"></dl><p id="art-viewer-note" class="art-viewer-note"></p>
              <div class="art-viewer-actions"><button type="button" id="art-viewer-prev">← Previous</button><button type="button" id="art-viewer-random">🎲 Random</button><button type="button" id="art-viewer-next">Next →</button><a id="art-viewer-source" target="_blank" rel="noopener noreferrer">Open source ↗</a></div>
            </div>
          </div>
        </dialog>
      </>
    )}
  </main>
  <Footer />
</VideoBg>

<script is:inline>
  function installArtworkImageFallbacks() {
    document
      .querySelectorAll('img.art-cover[data-cover-fallbacks]')
      .forEach((image) => {
        if (!(image instanceof HTMLImageElement)) return;
        if (image.dataset.fallbackInstalled === 'true') return;

        image.dataset.fallbackInstalled = 'true';

        let fallbacks = [];

        try {
          const parsed = JSON.parse(image.dataset.coverFallbacks || '[]');
          fallbacks = Array.isArray(parsed)
            ? parsed.filter((value) => typeof value === 'string' && value.trim())
            : [];
        } catch {
          fallbacks = [];
        }

        const tryNextImage = () => {
          const nextUrl = fallbacks.shift();
          image.dataset.coverFallbacks = JSON.stringify(fallbacks);

          if (!nextUrl) return;

          const card = image.closest('.art-card');
          if (card instanceof HTMLElement) {
            card.dataset.cover = nextUrl;
            card.dataset.coverFallbacks = JSON.stringify(fallbacks);
          }

          image.src = nextUrl;
        };

        image.addEventListener('error', tryNextImage);

        // Recover images that failed before this listener was installed.
        if (image.complete && image.naturalWidth === 0) {
          tryNextImage();
        }
      });
  }

  installArtworkImageFallbacks();
  document.addEventListener('astro:page-load', installArtworkImageFallbacks);
</script>
