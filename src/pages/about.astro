---
import AboutLayout from '../layouts/AboutLayout.astro';
import '../styles/about-split.css';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About LifeLoggerz and José',
  description: 'Choose between the person behind the archive and the LifeLoggerz project itself.',
};
---

<AboutLayout
  title="About"
  description="Two ways into LifeLoggerz: the person behind the archive, and the project, system, and philosophy itself."
  pubDate="2026-08-08"
  wide={true}
  showViews={false}
>
  <main class="about-split">
    <section class="about-gateway-intro" aria-labelledby="about-gateway-title">
      <p class="about-eyebrow">Two different questions</p>
      <h2 id="about-gateway-title">The subject of the archive, or the archive itself?</h2>
      <p>
        LifeLoggerz had outgrown a single About page. One side is about the person whose life is being recorded;
        the other is about the system, philosophy, tools, and project built around that record.
      </p>
    </section>

    <div class="about-choice-grid" aria-label="Choose an About page">
      <a class="about-choice" href="/about/me/" data-mark="J">
        <span class="about-choice-icon" aria-hidden="true">👤</span>
        <p class="about-choice-question">Who is José?</p>
        <h3>About Me</h3>
        <p>
          Family roots, pursuits, tastes, the patterns in my data and writing, and several different ways of answering who I am.
        </p>
        <span class="about-choice-cta">Meet the subject of the archive →</span>
      </a>

      <a class="about-choice" href="/about/lifeloggerz/" data-mark="L">
        <span class="about-choice-icon" aria-hidden="true">◉</span>
        <p class="about-choice-question">What is this project?</p>
        <h3>About LifeLoggerz</h3>
        <p>
          Why I track, how the system evolved, what I track and protect, how the archive works, and what I hope other people can take from it.
        </p>
        <span class="about-choice-cta">Explore the system and philosophy →</span>
      </a>
    </div>

    <nav class="about-secondary-nav" aria-label="Other About sections">
      <span>Other ways into the story:</span>
      <a href="/pursuits/">Pursuits</a>
      <a href="/timeline/">Timeline</a>
      <a href="/inspirations/">Inspirations</a>
      <a href="/about/me/#family-roots">Family Roots</a>
    </nav>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</AboutLayout>
