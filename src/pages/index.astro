---
/* src/pages/index.astro */
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoBg from '../components/VideoBg.astro';
import HeroTitleRipple from '../components/HeroTitleRipple.astro';
import { SITE_TITLE } from '../consts';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (p: string = '') => `${base}${p}`;

const rawPosts = await getCollection('blog', ({ data }) => data?.draft !== true);
const postsBySlug = new Map(rawPosts.map((post) => [post.slug, post]));

const featuredGuides = [
  {
    slug: 'rawdatapost2025',
    eyebrow: '01 · Raw data',
    title: 'The Raw Data Sheets',
    body: 'How each day gets recorded.',
  },
  {
    slug: 'daily-snapshot',
    eyebrow: '02 · Daily snapshot',
    title: 'The Daily Snapshot',
    body: 'How raw entries become a readable day.',
  },
  {
    slug: '2026interactivegstemplate',
    eyebrow: '03 · Template',
    title: 'The Google Sheet Template',
    body: 'Copy the system and make it yours.',
  },
].map((item) => ({
  ...item,
  post: postsBySlug.get(item.slug),
}));

const archiveLinks = [
  {
    eyebrow: 'Reading archive',
    title: 'Books',
    body: 'Audiobooks logged with dates, genres, notes, and listening context.',
    href: link('books/'),
    mediaClass: 'media-books',
    mediaLabel: 'BOOKS',
    mediaTag: 'LISTENED + LOGGED',
  },
  {
    eyebrow: 'Listening archive',
    title: 'Albums',
    body: 'Full albums preserved as part of the archive instead of disappearing into shuffled playlists.',
    href: link('albums/'),
    mediaClass: 'media-albums',
    mediaLabel: 'ALBUMS',
    mediaTag: 'FULL RECORDS',
  },
  {
    eyebrow: 'Visual archive',
    title: 'Art',
    body: 'Daily artworks collected into a visual diary of what shaped the years.',
    href: link('art/'),
    mediaClass: 'media-art',
    mediaLabel: 'ART',
    mediaTag: 'ONE WORK A DAY',
  },
  {
    eyebrow: 'Quantified archive',
    title: 'Stats Dashboard',
    body: 'The quantitative side of LifeLoggerz: graphs built from the long-running archive.',
    href: link('stats/'),
    mediaClass: 'media-stats',
    mediaLabel: 'STATS',
    mediaTag: 'LIVE GRAPHS',
  },
];

const storyLinks = [
  {
    eyebrow: 'About',
    title: 'Who built this?',
    body: 'The personal origin of LifeLoggerz and why the archive exists in the first place.',
    href: link('about/'),
    mediaClass: 'media-about',
    mediaLabel: 'ABOUT',
    mediaTag: 'THE ORIGIN',
  },
  {
    eyebrow: 'Timeline',
    title: 'Life at a glance',
    body: 'A year-level view of the project, the routines, and the systems coming together.',
    href: link('timeline/'),
    mediaClass: 'media-timeline',
    mediaLabel: 'TIME',
    mediaTag: 'YEAR BY YEAR',
  },
  {
    eyebrow: 'Influences',
    title: 'Inspirations',
    body: 'The people, projects, and ideas that helped spark LifeLoggerz.',
    href: link('inspirations/'),
    mediaClass: 'media-inspirations',
    mediaLabel: 'IDEAS',
    mediaTag: 'WHAT SHAPED IT',
  },
  {
    eyebrow: 'Questions',
    title: 'FAQ',
    body: 'Practical answers about privacy, what to track first, how long logging takes, and why the system works this way.',
    href: link('faq/'),
    mediaClass: 'media-faq',
    mediaLabel: 'FAQ',
    mediaTag: 'START HERE',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description="LifeLoggerz is a public experiment in turning daily life into searchable, visual, useful data through Google Sheets, dashboards, templates, and essays."
      image="/images_webp/daily_snapshot.webp"
    />
  </head>

  <body>
    <VideoBg>
      <Header />

      <main class="home-main">
        <section class="hero" aria-labelledby="home-title">
          <p class="eyebrow">Life as a living archive</p>
          <HeroTitleRipple as="h1" class="hero-title" id="home-title">
            LifeLoggerz
          </HeroTitleRipple>

          <p class="hero-lede">
            A multi-year public experiment in turning ordinary days into
            <strong>searchable, visual, useful data</strong>.
          </p>

          <p class="hero-subcopy">
            I track everyday life through Google Sheets and automation, then turn it into templates,
            graphs, archives, and lessons others can build from.
          </p>

          <div class="hero-actions" aria-label="Primary homepage links">
            <a class="button button-primary" href={link('day/')}>Explore a day</a>
            <a class="button button-secondary" href={link('templates/')}>Get the template</a>
          </div>
        </section>

        <section class="featured-section" aria-labelledby="start-heading">
          <div class="featured-heading">
            <div>
              <p class="eyebrow">Start here</p>
              <h2 id="start-heading">How LifeLoggerz works</h2>
            </div>
            <a class="see-all" href={link('blog/')}>See all posts →</a>
          </div>

          <div class="guide-grid">
            {featuredGuides.map((guide) => (
              <a class="guide-card" href={link(`blog/${guide.slug}/`)}>
                {guide.post?.data.heroImage ? (
                  <div class="guide-media" aria-hidden="true">
                    <img src={guide.post.data.heroImage} alt="" loading="lazy" decoding="async" />
                  </div>
                ) : null}
                <div class="guide-copy">
                  <span class="card-eyebrow">{guide.eyebrow}</span>
                  <h3>{guide.title}</h3>
                  <p>{guide.body}</p>
                  <span class="card-link">Open →</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="home-section" aria-labelledby="archive-heading">
          <div class="section-heading centered">
            <p class="eyebrow">Data, not vibes</p>
            <h2 id="archive-heading">Explore the archive</h2>
            <p>
              The system records more than routines. Browse the books, albums, art, and live graphs
              that show what filled the years.
            </p>
          </div>

          <div class="nav-card-grid" aria-label="Archive destinations">
            {archiveLinks.map((item) => (
              <a class="nav-card" href={item.href}>
                <div
                  class={`nav-card-media ${item.mediaClass}`}
                  data-label={item.mediaLabel}
                  aria-hidden="true"
                >
                  <span>{item.mediaTag}</span>
                </div>
                <div class="nav-card-body">
                  <span class="card-eyebrow">{item.eyebrow}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <span class="card-link">Explore →</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="home-section" aria-labelledby="story-heading">
          <div class="section-heading centered">
            <p class="eyebrow">Story behind the system</p>
            <h2 id="story-heading">The map beyond the data</h2>
            <p>
              Meet the person behind the archive, follow its timeline, trace its influences,
              and get practical answers before going deeper.
            </p>
          </div>

          <div class="nav-card-grid" aria-label="LifeLoggerz background pages">
            {storyLinks.map((item) => (
              <a class="nav-card" href={item.href}>
                <div
                  class={`nav-card-media ${item.mediaClass}`}
                  data-label={item.mediaLabel}
                  aria-hidden="true"
                >
                  <span>{item.mediaTag}</span>
                </div>
                <div class="nav-card-body">
                  <span class="card-eyebrow">{item.eyebrow}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <span class="card-link">Open →</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="home-section mission-card" aria-labelledby="mission-heading">
          <figure class="mission-image">
            <img
              src="/images/about-lifeloggerz.gif"
              alt="A childhood image from the LifeLoggerz about page"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Déjenme terminar esto...</figcaption>
          </figure>

          <div class="mission-copy">
            <p class="eyebrow">Why this exists</p>
            <h2 id="mission-heading">The point is not to optimize every minute.</h2>
            <p>
              The point is to remember life clearly, study habits honestly, and leave a trail
              that another curious person can build from. Even if one person creates a better
              system after seeing this, LifeLoggerz has done its job.
            </p>
            <div class="mission-actions">
              <a class="button button-primary" href={link('about/')}>Read the about page</a>
              <a class="button button-secondary" href={link('faq/')}>Read the FAQ</a>
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </VideoBg>
  </body>
</html>

<style>
  .home-main,
  .home-main *,
  .home-main *::before,
  .home-main *::after {
    box-sizing: border-box;
  }

  .home-main {
    width: min(1120px, calc(100% - 2rem));
    max-width: 1120px;
    padding: clamp(1rem, 2.5vw, 2.4rem) 0 3.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #0f4cff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero {
    max-width: 930px;
    margin: 0 auto clamp(1.35rem, 3vw, 2.25rem);
    text-align: left;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 6rem);
    letter-spacing: -0.07em;
    line-height: 0.93;
  }

  .hero-lede {
    max-width: 19ch;
    margin: 0.8rem 0 0.7rem;
    color: rgb(var(--black));
    font-size: clamp(1.75rem, 4.2vw, 3.15rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.01;
  }

  .hero-subcopy {
    max-width: 72ch;
    margin: 0 0 1rem;
    color: rgb(var(--gray-dark));
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.55;
  }

  .hero-actions,
  .mission-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(15, 76, 255, 0.18);
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .button:hover,
  .button:focus-visible,
  .guide-card:hover,
  .guide-card:focus-visible,
  .nav-card:hover,
  .nav-card:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0f4cff;
    color: #fff;
    box-shadow: 0 10px 22px rgba(15, 76, 255, 0.2);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    color: #fff;
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.94);
    color: #0f4cff;
    box-shadow: 0 8px 20px rgba(15, 18, 25, 0.07);
  }

  .featured-section {
    margin: 0 0 clamp(2.25rem, 5vw, 4rem);
  }

  .featured-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .featured-heading h2,
  .section-heading h2,
  .mission-card h2 {
    margin: 0;
    color: rgb(var(--black));
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .see-all {
    flex: 0 0 auto;
    padding: 0.42rem 0.7rem;
    border: 1px solid rgba(15, 76, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    color: #0f4cff;
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .guide-card,
  .nav-card,
  .mission-card {
    border: 1px solid rgba(var(--gray-light), 0.95);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 28px rgba(15, 18, 25, 0.07);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .guide-card {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(112px, 0.78fr) minmax(0, 1.22fr);
    overflow: hidden;
    border-radius: 18px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .guide-card:hover,
  .guide-card:focus-visible,
  .nav-card:hover,
  .nav-card:focus-visible {
    color: inherit;
    border-color: rgba(15, 76, 255, 0.32);
    box-shadow: 0 16px 34px rgba(15, 18, 25, 0.11);
  }

  .guide-media {
    min-height: 138px;
    overflow: hidden;
    border-right: 1px solid rgba(var(--gray-light), 0.92);
    background: #f8fafc;
  }

  .guide-media img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: top left;
  }

  .guide-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.9rem;
  }

  .card-eyebrow {
    color: #0f4cff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .guide-copy h3,
  .nav-card-body h3 {
    margin: 0.34rem 0 0.26rem;
    color: rgb(var(--black));
    font-size: 1.08rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .guide-copy p,
  .nav-card-body p {
    margin: 0;
    color: rgb(var(--gray-dark));
    font-size: 0.82rem;
    line-height: 1.38;
  }

  .card-link {
    margin-top: auto;
    padding-top: 0.55rem;
    color: #0f4cff;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .home-section {
    margin-block: clamp(2.8rem, 7vw, 5rem);
  }

  .section-heading {
    max-width: 720px;
    margin: 0 auto 1.2rem;
  }

  .centered {
    text-align: center;
  }

  .section-heading p:not(.eyebrow),
  .mission-copy > p:not(.eyebrow) {
    margin: 0.75rem 0 0;
    color: rgb(var(--gray-dark));
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .nav-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .nav-card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    border-radius: 22px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .nav-card-media {
    position: relative;
    display: flex;
    height: 128px;
    overflow: hidden;
    align-items: flex-end;
    padding: 0.78rem;
    border-bottom: 1px solid rgba(var(--gray-light), 0.85);
    isolation: isolate;
  }

  .nav-card-media::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 18% 20%, rgba(255, 255, 255, 0.72), transparent 31%),
      repeating-linear-gradient(118deg, transparent 0 18px, rgba(255, 255, 255, 0.18) 18px 20px);
    content: '';
  }

  .nav-card-media::after {
    position: absolute;
    right: -0.05em;
    bottom: -0.16em;
    color: rgba(255, 255, 255, 0.76);
    content: attr(data-label);
    font-size: clamp(2.25rem, 4vw, 3.7rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.8;
    white-space: nowrap;
  }

  .nav-card-media span {
    position: relative;
    z-index: 1;
    padding: 0.28rem 0.42rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .media-books { background: linear-gradient(135deg, #1b3f8b, #3779e8); }
  .media-albums { background: linear-gradient(135deg, #4d176f, #b045c8); }
  .media-art { background: linear-gradient(135deg, #b33b1c, #ef9d3b); }
  .media-stats { background: linear-gradient(135deg, #005f5a, #23a89c); }
  .media-about { background: linear-gradient(135deg, #383d49, #7b8498); }
  .media-timeline { background: linear-gradient(135deg, #6a321f, #c97543); }
  .media-inspirations { background: linear-gradient(135deg, #173e73, #28a4d4); }
  .media-faq { background: linear-gradient(135deg, #244f2e, #63aa56); }

  .nav-card-body {
    display: flex;
    min-height: 178px;
    flex: 1;
    flex-direction: column;
    padding: 0.9rem;
  }

  .mission-card {
    display: grid;
    max-width: 950px;
    grid-template-columns: minmax(220px, 0.43fr) minmax(0, 0.57fr);
    gap: clamp(1rem, 4vw, 2rem);
    align-items: center;
    margin-inline: auto;
    border-radius: 28px;
    padding: clamp(1.1rem, 3vw, 1.7rem);
  }

  .mission-image {
    margin: 0;
  }

  .mission-image img {
    display: block;
    width: 100%;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 10px 24px rgba(15, 18, 25, 0.1);
  }

  .mission-image figcaption {
    margin-top: 0.45rem;
    color: rgb(var(--gray-dark));
    font-size: 0.76rem;
    font-style: italic;
    text-align: center;
  }

  .mission-actions {
    margin-top: 0.95rem;
  }

  @media (max-width: 900px) {
    .hero {
      max-width: 760px;
      text-align: center;
    }

    .hero-lede,
    .hero-subcopy {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .guide-card {
      grid-template-columns: 105px minmax(0, 1fr);
    }

    .nav-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mission-card {
      grid-template-columns: 1fr;
      max-width: 620px;
    }
  }

  @media (max-width: 700px) {
    main.home-main {
      width: min(calc(100% - 1.2rem), 430px);
      max-width: 430px;
      padding: 0.55rem 0 2.25rem;
      overflow-x: clip;
    }

    .hero {
      margin-bottom: 1.35rem;
    }

    .eyebrow {
      margin-bottom: 0.3rem;
      font-size: 0.64rem;
      letter-spacing: 0.1em;
    }

    .hero-title {
      font-size: clamp(2.45rem, 12.8vw, 3.35rem);
    }

    .hero-lede {
      max-width: 17rem;
      margin-top: 0.58rem;
      margin-bottom: 0.52rem;
      font-size: clamp(1.28rem, 6.5vw, 1.72rem);
      line-height: 1.06;
    }

    .hero-subcopy {
      max-width: 34ch;
      margin-bottom: 0.7rem;
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .hero-actions {
      gap: 0.42rem;
    }

    .button {
      min-height: 36px;
      padding: 0.46rem 0.72rem;
      font-size: 0.78rem;
    }

    .featured-section {
      margin-bottom: 2rem;
    }

    .featured-heading {
      align-items: center;
      margin-bottom: 0.62rem;
    }

    .featured-heading h2,
    .section-heading h2,
    .mission-card h2 {
      font-size: clamp(1.35rem, 7vw, 1.75rem);
      line-height: 1.07;
    }

    .see-all {
      padding: 0.34rem 0.52rem;
      font-size: 0.68rem;
    }

    .guide-grid {
      grid-template-columns: 1fr;
      gap: 0.48rem;
    }

    .guide-card {
      grid-template-columns: 92px minmax(0, 1fr);
      border-radius: 14px;
    }

    .guide-media {
      min-height: 96px;
    }

    .guide-copy {
      min-height: 96px;
      padding: 0.62rem 0.68rem;
    }

    .card-eyebrow {
      font-size: 0.58rem;
      letter-spacing: 0.075em;
    }

    .guide-copy h3,
    .nav-card-body h3 {
      margin: 0.22rem 0 0.16rem;
      font-size: 0.9rem;
    }

    .guide-copy p,
    .nav-card-body p {
      font-size: 0.72rem;
      line-height: 1.28;
    }

    .card-link {
      padding-top: 0.32rem;
      font-size: 0.68rem;
    }

    .home-section {
      margin-block: 2.2rem;
    }

    .section-heading {
      max-width: 34ch;
      margin-bottom: 0.7rem;
    }

    .section-heading p:not(.eyebrow),
    .mission-copy > p:not(.eyebrow) {
      margin-top: 0.45rem;
      font-size: 0.8rem;
      line-height: 1.4;
    }

    .nav-card-grid {
      grid-template-columns: 1fr;
      gap: 0.52rem;
    }

    .nav-card {
      display: grid;
      grid-template-columns: 82px minmax(0, 1fr);
      border-radius: 14px;
    }

    .nav-card-media {
      height: 100%;
      min-height: 112px;
      padding: 0.42rem;
      border-right: 1px solid rgba(var(--gray-light), 0.85);
      border-bottom: 0;
    }

    .nav-card-media::after {
      right: -0.04em;
      bottom: -0.09em;
      font-size: 1.55rem;
      letter-spacing: -0.08em;
      transform: rotate(-90deg) translateX(100%);
      transform-origin: right bottom;
    }

    .nav-card-media span {
      max-width: 70px;
      padding: 0.22rem 0.3rem;
      font-size: 0.47rem;
      line-height: 1.1;
    }

    .nav-card-body {
      min-height: 112px;
      padding: 0.62rem 0.68rem;
    }

    .mission-card {
      max-width: 100%;
